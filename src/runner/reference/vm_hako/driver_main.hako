using selfhost.vm.entry_s0 as MiniVmS0EntryBox

static box DriverPayloadBox {
  resolve_from_env() {
    local inline = env.get("HAKO_VM_HAKO_DRIVER_PAYLOAD_JSON")
    local file = env.get("HAKO_VM_HAKO_DRIVER_PAYLOAD_FILE")
    if inline != null && inline != "" {
      if file != null && file != "" { return null }
      return "" + inline
    }
    if file != null && file != "" {
      return me._read_payload_file("" + file)
    }
    return null
  }

  _read_payload_file(path) {
    local fb = new FileBox()
    local ok = fb.open(path, "r")
    if ok != 1 { return null }
    local content = fb.read()
    fb.close()
    return content
  }
}

static box Main {
  main(args) {
    local j = DriverPayloadBox.resolve_from_env()
    if j == null || j == "" {
      print("[vm-hako/contract][missing-payload]")
      return 1
    }
    return MiniVmS0EntryBox.run_min(j)
  }
}

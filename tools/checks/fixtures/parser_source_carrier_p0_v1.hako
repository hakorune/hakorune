    local b = SourceCarrierBuilderV1Box.open()
    local list = b.create_list(SourceVocabularyV1Box.family_stmt())
    local ret = b.add_return_absent()
    if b.list_push(list, ret) == false || b.seal_list(list) == false { return 41 }
    if b.list_push(list, ret) != false { return 42 }
    if b.issue().reason() != "internal.carrier.list_mutation_after_seal" { return 43 }

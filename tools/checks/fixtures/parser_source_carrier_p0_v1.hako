  foreign_list_ref_poison() {
    local b = SourceCarrierBuilderV1Box.open()
    local foreign = SourceCarrierBuilderV1Box.open()
    local list = foreign.create_list(SourceVocabularyV1Box.family_stmt())
    if b.seal_list(list) != false { return 71 }
    if b.issue().reason() != "internal.carrier.list_ref_foreign" { return 72 }

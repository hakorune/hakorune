    local b = SourceCarrierBuilderV1Box.open()
    local foreign = SourceCarrierBuilderV1Box.open()
    local bad = foreign.add_literal_int(99)
    if b.add_unary_neg(bad) != null { return 21 }
    if b.state() != "Poisoned" { return 22 }
    if b.issue().reason() != "internal.carrier.node_ref_foreign" { return 23 }
    if b.add_return_absent() != null { return 24 }

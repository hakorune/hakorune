static box SourceCarrierP0FixtureV1Box {
  success_tree() {
    local b = SourceCarrierBuilderV1Box.open()
    local body = b.create_list(SourceVocabularyV1Box.family_stmt())
    local ret = b.add_return_absent()
    if b.list_push(body, ret) == false { return 1 }
    if b.seal_list(body) == false { return 2 }
    local root = b.add_source_body(body)
    if root == null { return 3 }
    local result = b.finish()
    if result.status() != "Ready" { return 4 }
    if b.state() != "Sealed" || b.published_tree_count() != 1 { return 5 }
    local tree = result.tree()
    if tree.node_count() != 2 || tree.list_count() != 1 { return 6 }
    if tree.root_ref().index() != 1 { return 7 }
    if tree.node(0).kind() != SourceVocabularyV1Box.kind_return() { return 8 }
    if tree.node(1).kind() != SourceVocabularyV1Box.kind_source_body() { return 9 }
    if tree.list(0).node_ref(0).index() != 0 { return 10 }
    return 0
  }

  products() {
    local carrier = SourceCarrierBuilderV1Box.open()
    local ref = carrier.add_literal_int(2)
    local typed = ParserNodeProductV1Box.typed(carrier, ref, "{\"type\":\"Int\",\"value\":2}", 10)
    if typed.kind() != "Typed" || typed.node_ref().index() != 0 || typed.next_pos() != 10 { return 11 }
    if typed.carrier() == null || typed.carrier().state() != "Open" { return 15 }
    if typed.compat_fragment() != "{\"type\":\"Int\",\"value\":2}" { return 16 }
    if typed.carrier().add_return_present(typed.node_ref()) == null { return 17 }
    local compat = ParserNodeProductV1Box.compat_only("legacy.return", "Return", "opaque", 12)
    if compat.kind() != "CompatOnly" || compat.branch_id() != "legacy.return" { return 12 }
    if compat.source_kind() != "Return" || compat.next_pos() != 12 { return 13 }

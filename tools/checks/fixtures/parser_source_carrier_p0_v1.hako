  incomplete_root() {
    local b = SourceCarrierBuilderV1Box.open()
    local result = b.finish()
    if result.status() != "InternalCarrierContractViolation" { return 51 }
    if result.issue().reason() != "internal.carrier.root_missing" { return 52 }

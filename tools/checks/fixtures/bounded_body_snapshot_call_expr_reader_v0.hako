using lang.compiler.analysis.bounded_body_snapshot.reader_expr_child_v0 as HakoProgramV0ChildExprReaderV0Box
using lang.compiler.analysis.bounded_body_snapshot.flat_publisher_v0 as FlatNodePublisherV0Box
using lang.compiler.analysis.bounded_body_snapshot.budget_v0 as BoundedBodySnapshotBudgetV0Box

static box SnapshotCallExprReaderFixtureV0Box {
  classify(session, root) {
    local result = me._read(session, root)
    if result.status() == "Ready" {
      local node = result.observation()
      if node.kind() == "Call" { return 1 }
      if node.kind() == "Method" { return 2 }
      if node.kind() == "Field" { return 3 }
      return 90
    }
    if result.status() == "Unsupported" {
      if result.reason() == "limit.max_arguments" { return 20 }
      if result.reason() == "limit.max_atom_bytes" { return 21 }
      if result.reason() == "unsupported.wire_kind" { return 22 }
      return 29
    }
    if result.status() != "InvalidInput" { return 99 }
    if result.reason() == "object.required_field_missing" { return 30 }
    if result.reason() == "object.forbidden_unknown_field" { return 31 }
    if result.reason() == "type.expected_string.got_number" { return 32 }
    if result.reason() == "type.expected_array.got_object" { return 33 }
    if result.reason() == "type.expected_object.got_null" { return 34 }
    return 39
  }

  outcome(session, root) {
    local result = me._read(session, root)
    return result.status() + "|" + result.path() + "|" + result.reason()
  }
  flat_signature(session, root) {
    local result = me._read(session, root)
    if result.status() != "Ready" { return "<not-ready>" }
    local table = FlatNodePublisherV0Box.publish(result.observation(), "$.body[0].expr")
    local text = "root=" + ("" + table.root_index()) local i = 0
    loop(i < table.node_count()) {
      local node = table.node(i)
      text = text + "|" + ("" + node.index()) + ":" + node.path() + ":" + node.kind()
      local j = 0
      loop(j < node.child_count()) {
        local edge = node.child(j)
        text = text + ":" + edge.role() + "=" + ("" + edge.target_index())
        j = j + 1
      }
      i = i + 1
    }
    return text
  }
  tree_signature(session, root) {
    local result = me._read(session, root)
    if result.status() != "Ready" { return "<not-ready>" }
    return me._tree(result.observation())
  }
  _tree(node) {
    local text = node.kind() local i = 0
    loop(i < node.child_count()) {
      local edge = node.child(i)
      local child = edge.observation()
      if child == null { text = text + ":" + edge.role() + "=<null>" }
      else { text = text + ":" + edge.role() + "=" + me._tree(child) }
      i = i + 1
    }
    return text
  }
  atom_value(session, root) {
    local result = me._read(session, root)
    if result.status() != "Ready" { return "<not-ready>" }
    return result.observation().atom(0).value()
  }
  _read(session, root) {
    return HakoProgramV0ChildExprReaderV0Box.read(session, root, "$.body[0].expr", 1, new BoundedBodySnapshotBudgetV0())
  }
}

static box Main { main() { return 0 } }

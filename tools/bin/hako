#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
BIN_HAKORUNE="$ROOT_DIR/target/release/hakorune"
BIN_NYASH="$ROOT_DIR/target/release/nyash"

if [[ -x "$BIN_HAKORUNE" ]]; then
  BIN="$BIN_HAKORUNE"
else
  BIN="$BIN_NYASH"
fi

if [[ ! -x "$BIN" ]]; then
  echo "[info] building (release) ..." >&2
  cargo build --release -q
fi

run_cached_emit() {
  local emit_flag="$1"
  local cache_enabled="$2"
  local cache_root="$3"
  local cache_suffix="$4"
  local executable_out="$5"
  shift 5

  if [[ "$cache_enabled" == "0" ]]; then
    return 1
  fi

  emit_out=""
  emit_seen=0
  for arg in "$@"; do
    if [[ "$emit_seen" -eq 1 ]]; then
      emit_out="$arg"
      break
    fi
    if [[ "$arg" == "$emit_flag" ]]; then
      emit_seen=1
    fi
  done

  if [[ -n "$emit_out" && "$#" -gt 0 ]]; then
    input="${!#}"
    if [[ -f "$input" ]]; then
      bin_fingerprint="$(stat -c '%n:%s:%Y' "$BIN" 2>/dev/null || printf '%s' "$BIN")"
      input_hash="$(sha256sum "$input" | awk '{ print $1 }')"
      canonical_args=()
      skip_next=0
      for arg in "$@"; do
        if [[ "$skip_next" -eq 1 ]]; then
          canonical_args+=("<emit-out>")
          skip_next=0
          continue
        fi
        case "$arg" in
          "$emit_flag")
            canonical_args+=("$arg")
            skip_next=1
            ;;
          *)
            if [[ "$arg" == "$input" ]]; then
              canonical_args+=("<input>")
            else
              canonical_args+=("$arg")
            fi
            ;;
        esac
      done
      args_key="$(printf '%s\0' "${canonical_args[@]}" | sha256sum | awk '{ print $1 }')"
      env_key="$(env | LC_ALL=C sort | awk '/^(HAKO|NYASH)_/' | sha256sum | awk '{ print $1 }')"
      key="$(printf '%s\n%s\n%s\n%s\n' \
        "$bin_fingerprint" "$input_hash" "$args_key" "$env_key" \
        | sha256sum | awk '{ print $1 }')"
      cache_path="$cache_root/${key}.${cache_suffix}"

      if [[ -s "$cache_path" ]]; then
        mkdir -p "$(dirname "$emit_out")"
        cp "$cache_path" "$emit_out"
        if [[ "$executable_out" == "1" ]]; then
          chmod +x "$emit_out"
        fi
        exit 0
      fi

      set +e
      "$BIN" "$@"
      rc=$?
      set -e
      if [[ "$rc" -eq 0 && -s "$emit_out" ]]; then
        mkdir -p "$cache_root"
        tmp_cache="$cache_path.$$"
        cp "$emit_out" "$tmp_cache"
        if [[ "$executable_out" == "1" ]]; then
          chmod +x "$tmp_cache"
        fi
        mv "$tmp_cache" "$cache_path"
      fi
      exit "$rc"
    fi
  fi
  return 1
}

if [[ "${HAKO_MIR_JSON_CACHE:-1}" != "0" ]]; then
  if run_cached_emit \
    "--emit-mir-json" \
    "${HAKO_MIR_JSON_CACHE:-1}" \
    "${HAKO_MIR_JSON_CACHE_DIR:-$ROOT_DIR/target/hako-mir-json-cache/v1}" \
    "mir.json" \
    "0" \
    "$@"; then
    exit 0
  fi
fi

if [[ "${HAKO_EMIT_EXE_CACHE:-1}" != "0" ]]; then
  if run_cached_emit \
    "--emit-exe" \
    "${HAKO_EMIT_EXE_CACHE:-1}" \
    "${HAKO_EMIT_EXE_CACHE_DIR:-$ROOT_DIR/target/hako-emit-exe-cache/v1}" \
    "exe" \
    "1" \
    "$@"; then
    exit 0
  fi
fi

exec "$BIN" "$@"

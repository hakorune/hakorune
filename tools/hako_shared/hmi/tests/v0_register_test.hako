using tools.hako_shared.hmi.state.error as HmiStateErrorV1
using tools.hako_shared.hmi.state.register_result as HmiScalarRegisterResultV1
using tools.hako_shared.hmi.state.register_storage as HmiScalarRegisterStorageV1

// S0 substrate fixture. I0/P0 extend this file with producer-backed owners.
static box Main {
    main() {
        local failures = 0
        local storage = new MapBox()

        HmiScalarRegisterStorageV1.put_proven(storage, 2, 10)
        if not HmiScalarRegisterStorageV1.contains(storage, 2) {
            failures = failures + 1
        } else {
            if HmiScalarRegisterStorageV1.read_present(storage, 2) != 10 {
                failures = failures + 1
            }
        }

        local empty = new HmiScalarRegisterResultV1()
        empty.set_register_empty_success()
        if not empty.accepted() or empty.has_scalar() {
            failures = failures + 1
        }

        local scalar = new HmiScalarRegisterResultV1()
        scalar.set_register_scalar_success("i64", 20)
        if not scalar.accepted() or not scalar.has_scalar() {
            failures = failures + 1
        } else {
            if scalar.scalar().kind() != "i64" or
               scalar.scalar().payload() != 20 {
                failures = failures + 1
            }
        }

        local rejected = new HmiScalarRegisterResultV1()
        rejected.set_register_failure(
            HmiStateErrorV1.undefined_register(9)
        )
        if rejected.accepted() or
           rejected.failure().kind() != "undefined-register" {
            failures = failures + 1
        }

        if failures != 0 {
            print("[hmi/s0-v0-r0-s0] failures=" + failures)
            return 1
        }
        print("[hmi/s0-v0-r0-s0] ok")
        return 0
    }
}

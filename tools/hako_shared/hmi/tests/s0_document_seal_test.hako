using tools.hako_shared.hmi.document_seal as HmiDocumentSealV1

static box Main {
    main() {
        local failures = 0
        failures = failures + this.test_scalar_document()
        failures = failures + this.test_scalar_rejections()
        failures = failures + this.test_value_use_profile()
        failures = failures + this.test_cfg_and_publication_profile()
        failures = failures + this.test_ownership_transport()
        if failures == 0 {
            print("[hmi/s0-t0-s0] ok")
            return 0
        }
        print("[hmi/s0-t0-s0] failed=" + failures)
        return 1
    }

    test_scalar_document() {
        local result = HmiDocumentSealV1.read(this.scalar_document())
        if not result.accepted() {
            print("[hmi/s0-t0-s0/test] scalar=" + result.failure().render())
            return 1
        }
        local view = result.document()
        if view == null {
            print("[hmi/s0-t0-s0/test] scalar-document-view=null")
            return 1
        }
        if view.function_count() != 1 { return 1 }
        if view.function_name(0) != "hmi_scalar_cfg" { return 1 }
        local function_view = view.function_view("hmi_scalar_cfg")
        if function_view.entry_block() != 7 { return 1 }
        if function_view.block_count() != 4 { return 1 }
        if function_view.value_type_kind(1) != "i1" { return 1 }
        if function_view.block(10).instruction(0).op() != "phi" { return 1 }
        if function_view.block(10).instruction(4).op() != "ret" { return 1 }
        return 0
    }

    test_scalar_rejections() {
        local failures = 0
        local text = this.scalar_document()
        if this.accepts_named("missing-edge", this.replace_once(
            text,
            ",\"control_edge_args_v1\":{\"schema_version\":1,\"mode\":\"exact_none\"}",
            ""
        )) { failures = failures + 1 }
        if this.accepts_named("bool-payload", this.replace_once(
            text,
            "\"dst\":1,\"value\":{\"type\":\"i64\",\"value\":1}",
            "\"dst\":1,\"value\":{\"type\":\"i64\",\"value\":2}"
        )) { failures = failures + 1 }
        if this.accepts_named("phi-predecessor", this.replace_once(
            text,
            "\"incoming\":[[2,8],[3,9]]",
            "\"incoming\":[[2,7],[3,9]]"
        )) { failures = failures + 1 }
        if this.accepts_named("unknown-field", this.replace_once(
            text,
            "\"op\":\"copy\",\"dst\":7,\"src\":6",
            "\"op\":\"copy\",\"dst\":7,\"src\":6,\"mystery\":0"
        )) { failures = failures + 1 }
        if this.accepts_named("cfg-successor", this.replace_once(
            text,
            "\"successors\":[8,9]",
            "\"successors\":[8]"
        )) { failures = failures + 1 }
        if this.accepts_named("reachable", this.replace_once(
            text,
            "\"id\":9,\"reachable\":true",
            "\"id\":9,\"reachable\":false"
        )) { failures = failures + 1 }
        return failures
    }

    test_value_use_profile() {
        local failures = 0
        if not this.accepts(this.parameter_cross_block_document()) {
            failures = failures + 1
        }
        local text = this.scalar_document()
        if this.accepts_named("same-block-use-before-definition",
            this.replace_once(
                text,
                "\"op\":\"copy\",\"dst\":7,\"src\":6",
                "\"op\":\"copy\",\"dst\":7,\"src\":7"
            )
        ) { failures = failures + 1 }
        if this.accepts_named("cross-block-non-phi",
            this.replace_once(
                text,
                "\"op\":\"binop\",\"dst\":6,\"lhs\":4,\"rhs\":5",
                "\"op\":\"binop\",\"dst\":6,\"lhs\":4,\"rhs\":2"
            )
        ) { failures = failures + 1 }
        if this.accepts_named("phi-value-from-wrong-predecessor",
            this.replace_once(
                text,
                "\"incoming\":[[2,8],[3,9]]",
                "\"incoming\":[[2,9],[3,8]]"
            )
        ) { failures = failures + 1 }
        return failures
    }

    test_cfg_and_publication_profile() {
        local failures = 0
        if not this.accepts(this.unreachable_document()) {
            failures = failures + 1
        }
        if not this.accepts(this.same_successor_document()) {
            failures = failures + 1
        }
        local failed = HmiDocumentSealV1.read(
            this.second_function_failure_document()
        )
        if failed.accepted() or failed.document() != null {
            failures = failures + 1
        }
        return failures
    }

    test_ownership_transport() {
        local text = this.ownership_document()
        local accepted = HmiDocumentSealV1.read(text)
        if not accepted.accepted() {
            print("[hmi/s0-t0-s0/test] ownership=" +
                accepted.failure().render())
            return 1
        }
        if this.accepts_named("ownership-none", this.replace_once(
            text, "\"0\":\"borrowed\"", "\"0\":\"none\""
        )) { return 1 }
        if this.accepts_named("ownership-box-type", this.replace_once(
            text,
            "\"1\":{\"kind\":\"handle\",\"box_type\":\"WidgetBox\"}",
            "\"1\":{\"kind\":\"handle\",\"box_type\":\"OtherBox\"}"
        )) { return 1 }
        if this.accepts_named("ownership-missing-op", this.replace_once(
            text,
            ",{\"block\":0,\"instruction_index\":1,\"op\":\"destroy_owned\",\"value\":1}",
            ""
        )) { return 1 }
        return 0
    }

    accepts(text) {
        return HmiDocumentSealV1.read(text).accepted()
    }

    accepts_named(name, text) {
        local result = HmiDocumentSealV1.read(text)
        if result.accepted() {
            print("[hmi/s0-t0-s0/test] unexpected-accept=" + name)
            return true
        }
        return false
    }

    scalar_document() {
        local metadata = "{\"value_types\":{\"1\":\"i1\"," +
            "\"2\":\"i64\",\"3\":\"i64\",\"4\":\"i64\",\"5\":\"i64\"," +
            "\"6\":\"i64\",\"7\":\"i64\"}," +
            "\"control_edge_args_v1\":{\"schema_version\":1," +
            "\"mode\":\"exact_none\"}}"
        local blocks = "["
        blocks = blocks + "{\"id\":8,\"instructions\":[" +
            "{\"op\":\"const\",\"dst\":2,\"value\":{\"type\":\"i64\",\"value\":2}}," +
            "{\"op\":\"jump\",\"target\":10}]},"
        blocks = blocks + "{\"id\":7,\"instructions\":[" +
            "{\"op\":\"const\",\"dst\":1,\"value\":{\"type\":\"i64\",\"value\":1}}," +
            "{\"op\":\"branch\",\"cond\":1,\"then\":8,\"else\":9}]},"
        blocks = blocks + "{\"id\":9,\"instructions\":[" +
            "{\"op\":\"const\",\"dst\":3,\"value\":{\"type\":\"i64\",\"value\":3}}," +
            "{\"op\":\"jump\",\"target\":10}]},"
        blocks = blocks + "{\"id\":10,\"instructions\":[" +
            "{\"op\":\"phi\",\"dst\":4,\"incoming\":[[2,8],[3,9]],\"dst_type\":\"i64\"}," +
            "{\"op\":\"const\",\"dst\":5,\"value\":{\"type\":\"i64\",\"value\":1}}," +
            "{\"op\":\"binop\",\"dst\":6,\"lhs\":4,\"rhs\":5,\"operation\":\"+\"," +
            "\"dst_type\":\"i64\"},{\"op\":\"copy\",\"dst\":7,\"src\":6}," +
            "{\"op\":\"ret\",\"value\":7}]}]"
        local function_json = "{\"name\":\"hmi_scalar_cfg\",\"params\":[]," +
            "\"blocks\":" + blocks + ",\"metadata\":" + metadata +
            ",\"attrs\":{\"runes\":[]}}"
        local cfg = "{\"name\":\"hmi_scalar_cfg\",\"entry_block\":7,\"blocks\":[" +
            "{\"id\":7,\"reachable\":true,\"successors\":[8,9],\"terminator\":\"Branch\"}," +
            "{\"id\":8,\"reachable\":true,\"successors\":[10],\"terminator\":\"Jump\"}," +
            "{\"id\":9,\"reachable\":true,\"successors\":[10],\"terminator\":\"Jump\"}," +
            "{\"id\":10,\"reachable\":true,\"successors\":[],\"terminator\":\"Return\"}]}"
        return this.root("[" + function_json + "]", "[" + cfg + "]")
    }

    ownership_document() {
        local metadata = "{\"value_types\":{" +
            "\"0\":{\"kind\":\"handle\",\"box_type\":\"WidgetBox\"}," +
            "\"1\":{\"kind\":\"handle\",\"box_type\":\"WidgetBox\"}}," +
            "\"control_edge_args_v1\":{\"schema_version\":1,\"mode\":\"exact_none\"}," +
            "\"ownership_ssa_v1\":{\"schema\":\"VerifiedOwnershipSsaV1\"," +
            "\"producer\":\"rust_ownership_ssa_verifier_v1\",\"owner\":41," +
            "\"backend\":\"llvm_py\",\"provider\":\"nyash_kernel\"," +
            "\"value_kinds\":{\"0\":\"borrowed\",\"1\":\"owned\"}," +
            "\"operations\":[{\"block\":0,\"instruction_index\":0," +
            "\"op\":\"copy_owned\",\"dst\":1,\"src\":0}," +
            "{\"block\":0,\"instruction_index\":1,\"op\":\"destroy_owned\"," +
            "\"value\":1}]}}"
        local function_json = "{\"name\":\"owned\",\"params\":[0],\"blocks\":[" +
            "{\"id\":0,\"instructions\":[{\"op\":\"copy_owned\",\"dst\":1,\"src\":0}," +
            "{\"op\":\"destroy_owned\",\"value\":1},{\"op\":\"ret\",\"value\":null}]}]," +
            "\"metadata\":" + metadata + ",\"attrs\":{\"runes\":[]}}"
        local cfg = "{\"name\":\"owned\",\"entry_block\":0,\"blocks\":[" +
            "{\"id\":0,\"reachable\":true,\"successors\":[]," +
            "\"terminator\":\"Return\"}]}"
        return this.root("[" + function_json + "]", "[" + cfg + "]")
    }

    parameter_cross_block_document() {
        local metadata = "{\"value_types\":{\"0\":\"i64\",\"1\":\"i64\"}," +
            "\"control_edge_args_v1\":{\"schema_version\":1," +
            "\"mode\":\"exact_none\"}}"
        local blocks = "[" +
            "{\"id\":3,\"instructions\":[{\"op\":\"jump\",\"target\":4}]}," +
            "{\"id\":4,\"instructions\":[" +
            "{\"op\":\"copy\",\"dst\":1,\"src\":0}," +
            "{\"op\":\"ret\",\"value\":1}]}]"
        local function_json = "{\"name\":\"parameter_cross_block\"," +
            "\"params\":[0],\"blocks\":" + blocks +
            ",\"metadata\":" + metadata +
            ",\"attrs\":{\"runes\":[]}}"
        local cfg = "{\"name\":\"parameter_cross_block\"," +
            "\"entry_block\":3,\"blocks\":[" +
            "{\"id\":3,\"reachable\":true,\"successors\":[4]," +
            "\"terminator\":\"Jump\"}," +
            "{\"id\":4,\"reachable\":true,\"successors\":[]," +
            "\"terminator\":\"Return\"}]}"
        return this.root("[" + function_json + "]", "[" + cfg + "]")
    }

    unreachable_document() {
        local metadata = "{\"value_types\":{}," +
            "\"control_edge_args_v1\":{\"schema_version\":1," +
            "\"mode\":\"exact_none\"}}"
        local function_json = "{\"name\":\"unreachable\",\"params\":[]," +
            "\"blocks\":[{\"id\":0,\"instructions\":[" +
            "{\"op\":\"ret\",\"value\":null}]}," +
            "{\"id\":1,\"instructions\":[" +
            "{\"op\":\"ret\",\"value\":null}]}]," +
            "\"metadata\":" + metadata + ",\"attrs\":{\"runes\":[]}}"
        local cfg = "{\"name\":\"unreachable\",\"entry_block\":0," +
            "\"blocks\":[{\"id\":0,\"reachable\":true,\"successors\":[]," +
            "\"terminator\":\"Return\"}," +
            "{\"id\":1,\"reachable\":false,\"successors\":[]," +
            "\"terminator\":\"Return\"}]}"
        return this.root("[" + function_json + "]", "[" + cfg + "]")
    }

    same_successor_document() {
        local metadata = "{\"value_types\":{\"0\":\"i1\"}," +
            "\"control_edge_args_v1\":{\"schema_version\":1," +
            "\"mode\":\"exact_none\"}}"
        local function_json = "{\"name\":\"same_successor\",\"params\":[]," +
            "\"blocks\":[{\"id\":0,\"instructions\":[" +
            "{\"op\":\"const\",\"dst\":0,\"value\":{" +
            "\"type\":\"i64\",\"value\":1}}," +
            "{\"op\":\"branch\",\"cond\":0,\"then\":1,\"else\":1}]}," +
            "{\"id\":1,\"instructions\":[" +
            "{\"op\":\"ret\",\"value\":null}]}]," +
            "\"metadata\":" + metadata + ",\"attrs\":{\"runes\":[]}}"
        local cfg = "{\"name\":\"same_successor\",\"entry_block\":0," +
            "\"blocks\":[{\"id\":0,\"reachable\":true,\"successors\":[1]," +
            "\"terminator\":\"Branch\"}," +
            "{\"id\":1,\"reachable\":true,\"successors\":[]," +
            "\"terminator\":\"Return\"}]}"
        return this.root("[" + function_json + "]", "[" + cfg + "]")
    }

    second_function_failure_document() {
        local metadata = "{\"value_types\":{\"0\":\"i64\"}," +
            "\"control_edge_args_v1\":{\"schema_version\":1," +
            "\"mode\":\"exact_none\"}}"
        local first = "{\"name\":\"first\",\"params\":[],\"blocks\":[" +
            "{\"id\":0,\"instructions\":[" +
            "{\"op\":\"const\",\"dst\":0,\"value\":{" +
            "\"type\":\"i64\",\"value\":1}}," +
            "{\"op\":\"ret\",\"value\":0}]}]," +
            "\"metadata\":" + metadata + ",\"attrs\":{\"runes\":[]}}"
        local second = "{\"name\":\"second\",\"params\":[],\"blocks\":[" +
            "{\"id\":0,\"instructions\":[" +
            "{\"op\":\"const\",\"dst\":0,\"value\":{" +
            "\"type\":\"i64\",\"value\":1},\"unknown\":0}," +
            "{\"op\":\"ret\",\"value\":0}]}]," +
            "\"metadata\":" + metadata + ",\"attrs\":{\"runes\":[]}}"
        local cfg_first = "{\"name\":\"first\",\"entry_block\":0," +
            "\"blocks\":[{\"id\":0,\"reachable\":true,\"successors\":[]," +
            "\"terminator\":\"Return\"}]}"
        local cfg_second = "{\"name\":\"second\",\"entry_block\":0," +
            "\"blocks\":[{\"id\":0,\"reachable\":true,\"successors\":[]," +
            "\"terminator\":\"Return\"}]}"
        return this.root(
            "[" + first + "," + second + "]",
            "[" + cfg_first + "," + cfg_second + "]"
        )
    }

    root(functions, cfg_functions) {
        local root = "{\"schema_version\":\"1.0\",\"capabilities\":[" +
            "\"unified_call\",\"phi\",\"effects\",\"callee_typing\"]," +
            "\"metadata\":{\"generator\":\"nyash-rust\",\"phase\":\"15.5\"," +
            "\"build_time\":\"test\",\"features\":[" +
            "\"mir_call_unification\",\"json_v1_schema\"]}," +
            "\"functions\":" + functions +
            ",\"cfg\":{\"functions\":" + cfg_functions + "}"
        local names = this.plan_names()
        local i = 0
        loop(i < names.length()) {
            root = root + ",\"" + names.get(i) + "\":[]"
            i = i + 1
        }
        return root + "}"
    }

    plan_names() {
        local names = new ArrayBox()
        names.push("user_box_decls")
        names.push("weak_field_contract_specs")
        names.push("record_decls")
        names.push("typed_object_plans")
        names.push("object_storage_plans")
        names.push("direct_state_plans")
        names.push("record_state_residence_plans")
        names.push("record_layout_plans")
        names.push("array_record_storage_plans")
        names.push("array_record_autouse_eligibility_plans")
        names.push("array_record_materialization_boundary_plans")
        names.push("array_record_packed_autouse_pilot_plans")
        names.push("source_packed_array_autouse_pilot_plans")
        names.push("source_packed_array_direct_read_consumption_plans")
        names.push("hako_alloc_aligned_small_packed_store_pilot_plans")
        names.push("hako_alloc_huge_page_packed_store_pilot_plans")
        names.push("static_table_contract_specs")
        names.push("static_data_plans")
        names.push("verified_static_table_contracts")
        names.push("enum_decls")
        names.push("boxed_sum_abi_plans")
        return names
    }

    replace_once(text, needle, replacement) {
        local index = text.indexOf(needle)
        if index < 0 { return text }
        return text.substring(0, index) + replacement +
            text.substring(index + needle.length(), text.length())
    }
}

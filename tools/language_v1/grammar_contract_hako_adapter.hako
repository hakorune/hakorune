// grammar_contract_hako_adapter.hako
//
// Independent evidence adapter for the selfhost parser. It intentionally uses
// ParserBox directly and returns its Program(JSON) text without Rust AST reuse.

using lang.compiler.parser.grammar_profile_facade as HakoGrammarProfileFacade

static box Main {
  method main(args) {
    local source = env.get("HAKO_GRAMMAR_CONTRACT_SOURCE")
    if source == null {
      print("[grammar-contract/hako-adapter] HAKO_GRAMMAR_CONTRACT_SOURCE required")
      return 2
    }
    local profile = "canonical"
    local profile_error = ""
    local i = 0
    if args != null {
      loop(i < args.length()) {
        local token = "" + args.get(i)
        if token == "--grammar-profile" {
          if i + 1 >= args.length() {
            profile_error = "parser/hako_profile_missing"
          } else {
            profile = "" + args.get(i + 1)
            i = i + 1
          }
        }
        i = i + 1
      }
    }
    if profile_error == "" {
      if HakoGrammarProfileFacade.profile_mode(profile) < 0 {
        profile_error = "parser/hako_profile_unknown"
      }
    }
    if profile_error != "" {
      local error_envelope = "{\"schema\":\"language-v1-hako-raw-evidence-v0\""
      error_envelope = error_envelope + ",\"status\":\"error\""
      error_envelope = error_envelope + ",\"stable_reject_tag\":\"" + profile_error + "\""
      error_envelope = error_envelope + ",\"deterministic\":true"
      error_envelope = error_envelope + ",\"raw_program_json_authority\":false}"
      print(error_envelope)
      return 0
    }
    env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
    env.set("HAKO_STAGEB_STMT_DEPTH", "0")
    local first = HakoGrammarProfileFacade.parse_with_profile(source, profile)
    env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
    env.set("HAKO_STAGEB_STMT_DEPTH", "0")
    local second = HakoGrammarProfileFacade.parse_with_profile(source, profile)
    local deterministic = "false"
    if first == second { deterministic = "true" }
    if first.indexOf("[freeze:contract][") == 0 {
      local rest = first.substring(18, first.length())
      local close = rest.indexOf("]")
      local stable_tag = "parser/hako_profile_mismatch"
      if close >= 0 { stable_tag = rest.substring(0, close) }
      local rejected = "{\"schema\":\"language-v1-hako-raw-evidence-v0\""
      rejected = rejected + ",\"status\":\"error\",\"stable_reject_tag\":\"" + stable_tag + "\""
      rejected = rejected + ",\"deterministic\":" + deterministic
      rejected = rejected + ",\"raw_program_json_authority\":false}"
      print(rejected)
      return 0
    }
    local envelope = "{\"schema\":\"language-v1-hako-raw-evidence-v0\""
    envelope = envelope + ",\"status\":\"ok\",\"stable_reject_tag\":\"\""
    envelope = envelope + ",\"profile\":\"" + profile + "\""
    envelope = envelope + ",\"deterministic\":" + deterministic
    envelope = envelope + ",\"raw_program_json_authority\":false"
    envelope = envelope + ",\"program\":" + first + "}"
    print(envelope)
    return 0
  }
}

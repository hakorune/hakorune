// hako-alloc-mimalloc-comparison-huge-ish-exe-proof
// Purpose: exact-EXE-friendly huge-ish comparison evidence app for phase-295x.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox
using selfhost.hako_alloc.memory.page_map_box as HakoAllocPageMapBox
using selfhost.hako_alloc.memory.huge_page_model_box as HakoAllocHugePageModelBox
using selfhost.hako_alloc.memory.huge_release_seam_box as HakoAllocHugeReleaseSeamBox

box HakoAllocMimallocComparisonHugeIshReport {
    workload_id: StringBox = "representative-huge-ish-v0"
    operation_family: StringBox = "huge-ish"
    operation_sequence_id: StringBox = "representative-huge-ish-v0-seq"
    free_order_id: StringBox = "ascending-release-v0"
    allocation_count: i64 = 2
    free_count: i64 = 2
    large_request_count: i64 = 1
    requested_bytes: i64 = 0
    committed_bytes: i64 = 0
    live_handles: i64 = 0
    release_count: i64 = 0
    source_ops: i64 = 0
    rejects: i64 = 0

    capture(requested_bytes, committed_bytes, live_handles, release_count, rejects) {
        me.requested_bytes = requested_bytes
        me.committed_bytes = committed_bytes
        me.live_handles = live_handles
        me.release_count = release_count
        me.source_ops = 0
        me.rejects = rejects
        return 1
    }

    workloadLine() { return "workload=representative-huge-ish-v0" }
    operationFamilyLine() { return "operation_family=huge-ish" }
    operationSequenceLine() { return "operation_sequence_id=representative-huge-ish-v0-seq" }
    freeOrderLine() { return "free_order_id=ascending-release-v0" }
    allocationCountLine() { return "allocation_count=2" }
    freeCountLine() { return "free_count=2" }
    largeRequestCountLine() { return "large_request_count=1" }
    requestedBytesLine() { return "requested_bytes=4194321" }
    summaryFieldsLine() { return "summary_fields=" + me.requested_bytes + "," + me.committed_bytes + "," + me.live_handles + "," + me.release_count + "," + me.source_ops + "," + me.rejects }
    summaryLine() { return "summary=ok" }
}

static box Main {
    main(args) {
        local report = new HakoAllocMimallocComparisonHugeIshReport()
        local huge_map = new HakoAllocPageMap()
        local huge_model = new HakoAllocHugePageModel(huge_map)
        local huge_release = new HakoAllocHugeReleaseSeam(huge_model)
        local huge_alloc = huge_model.allocateHuge(4194305, 4194305)
        local huge_ptr = huge_model.last_result_ptr
        local huge_requested = huge_model.last_requested_size
        local huge_committed = huge_model.last_committed_size
        local huge_release_ok = huge_release.releaseHugePtr(huge_ptr)

        local small_page = new HakoAllocPageModel(0, 16, 1, 1)
        local small_block = small_page.acquire_usize(16)
        local small_release = small_page.releaseLocal(small_block)

        local requested_bytes = huge_requested + small_page.requested_bytes
        local committed_bytes = huge_committed + (small_page.block_size * small_page.capacity)
        local live_handles = huge_model.live_count + small_page.used
        local release_count = huge_release.release_count + small_page.local_free_count
        local rejects = huge_model.reject_count + huge_release.reject_count + small_page.reject_count

        report.capture(requested_bytes, committed_bytes, live_handles, release_count, rejects)

        print("hako-alloc-mimalloc-comparison-huge-ish-exe-proof")
        print(report.workloadLine())
        print(report.operationFamilyLine())
        print(report.operationSequenceLine())
        print(report.freeOrderLine())
        print("huge=" + huge_alloc + "," + huge_ptr + "," + huge_requested + "," + huge_committed + "," + huge_release_ok)
        print("small=" + small_block + "," + small_release)
        print(report.allocationCountLine())
        print(report.freeCountLine())
        print(report.largeRequestCountLine())
        print(report.requestedBytesLine())
        print(report.summaryFieldsLine())
        print(report.summaryLine())
        return 0
    }
}

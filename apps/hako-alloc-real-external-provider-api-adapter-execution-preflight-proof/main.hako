// hako-alloc-real-external-provider-api-adapter-execution-preflight-proof
// Purpose: prove MIMAP-410A real external provider API adapter execution preflight.

using selfhost.hako_alloc.memory.provider_call_external_api_call_stub_execution_pilot_box as HakoAllocProviderCallExternalApiCallStubExecutionPilot
using selfhost.hako_alloc.memory.real_external_provider_api_adapter_execution_preflight_box as HakoAllocRealExternalProviderApiAdapterExecutionPreflight

static box Main {
    makeStub(): HakoAllocProviderCallExternalApiCallStubExecutionPilotReport {
        local report = new HakoAllocProviderCallExternalApiCallStubExecutionPilotReport {
            accepted: 1,
            reason: 0,
            external_stub_execution_present: 1,
            adapter_preflight_present: 1,
            adapter_preflight_accepted: 1,
            adapter_preflight_reason: 0,
            external_provider_adapter_present: 1,
            external_provider_adapter_valid: 1,
            external_provider_api_preflight_ready: 1,
            external_provider_api_stub_call_executed: 1,
            external_provider_api_stub_result_present: 1,
            external_provider_api_stub_result_code: 0,
            actual_external_provider_api_call_executed: 0,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_inactive: 1,
            execution_count: 1,
            accepted_count: 1,
            reject_count: 0,
            missing_preflight_reject_count: 0,
            rejected_preflight_reject_count: 0,
            not_ready_reject_count: 0,
            already_executed_reject_count: 0,
            closed_execution_reject_count: 0,
            closed_host_replacement_reject_count: 0,
            closed_hook_reject_count: 0,
            closed_backend_matcher_reject_count: 0,
            last_reason: 0,
            would_activate_provider: 1,
            would_call_provider: 1,
            would_execute_provider_api: 1,
            would_call_external_provider_api: 1,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return report
    }

    main(args) {
        local owner = new HakoAllocRealExternalProviderApiAdapterExecutionPreflight()
        local stub = Main.makeStub()
        local accepted = owner.preflightRealExternalProviderApiAdapterExecution(stub)

        local missing_stub = new HakoAllocProviderCallExternalApiCallStubExecutionPilotReport()
        local missing = owner.preflightRealExternalProviderApiAdapterExecution(missing_stub)

        local rejected_stub = Main.makeStub()
        rejected_stub.accepted = 0
        rejected_stub.reason = 2
        local rejected = owner.preflightRealExternalProviderApiAdapterExecution(rejected_stub)

        local not_ready = Main.makeStub()
        not_ready.external_provider_api_stub_call_executed = 0
        local not_ready_result = owner.preflightRealExternalProviderApiAdapterExecution(not_ready)

        local already_executed = Main.makeStub()
        already_executed.actual_external_provider_api_call_executed = 1
        local already_executed_result = owner.preflightRealExternalProviderApiAdapterExecution(already_executed)

        local execution_closed = Main.makeStub()
        execution_closed.would_call_external_provider_api = 0
        local execution_closed_result = owner.preflightRealExternalProviderApiAdapterExecution(execution_closed)

        local host_leak = Main.makeStub()
        host_leak.would_replace_host_allocator = 1
        local host_rejected = owner.preflightRealExternalProviderApiAdapterExecution(host_leak)

        local hook_leak = Main.makeStub()
        hook_leak.would_install_hook = 1
        local hook_rejected = owner.preflightRealExternalProviderApiAdapterExecution(hook_leak)

        local matcher_leak = Main.makeStub()
        matcher_leak.would_add_backend_matcher = 1
        local matcher_rejected = owner.preflightRealExternalProviderApiAdapterExecution(matcher_leak)

        local ok = check "mimap410a real external provider api adapter execution preflight" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "preflight present": accepted.real_external_preflight_present == 1
            "stub present": accepted.stub_execution_present == 1
            "stub accepted": accepted.stub_execution_accepted == 1
            "adapter present": accepted.external_provider_adapter_present == 1
            "adapter valid": accepted.external_provider_adapter_valid == 1
            "stub executed": accepted.external_provider_api_stub_call_executed == 1
            "stub result": accepted.external_provider_api_stub_result_present == 1
            "ready": accepted.real_external_provider_api_execution_ready == 1
            "actual external closed": accepted.actual_external_provider_api_call_executed == 0
            "host inactive": accepted.host_replacement_inactive == 1
            "hooks inactive": accepted.hooks_inactive == 1
            "matcher inactive": accepted.backend_matcher_inactive == 1
            "owner count": owner.preflight_count == 9
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 8
            "owner missing": owner.missing_stub_reject_count == 1
            "owner rejected stub": owner.rejected_stub_reject_count == 1
            "owner not ready": owner.not_ready_reject_count == 1
            "owner already executed": owner.already_executed_reject_count == 1
            "owner execution closed": owner.closed_execution_reject_count == 1
            "owner host closed": owner.closed_host_replacement_reject_count == 1
            "owner hook closed": owner.closed_hook_reject_count == 1
            "owner matcher closed": owner.closed_backend_matcher_reject_count == 1
            "last reason": owner.last_reason == 8
            "missing reason": missing.reason == 1
            "rejected reason": rejected.reason == 2
            "not ready reason": not_ready_result.reason == 3
            "already executed reason": already_executed_result.reason == 4
            "execution reason": execution_closed_result.reason == 5
            "host reason": host_rejected.reason == 6
            "hook reason": hook_rejected.reason == 7
            "matcher reason": matcher_rejected.reason == 8
            "would activate": accepted.would_activate_provider == 1
            "would call": accepted.would_call_provider == 1
            "would api": accepted.would_execute_provider_api == 1
            "would external": accepted.would_call_external_provider_api == 1
            "would real": accepted.would_execute_real_external_provider_api == 1
            "would host": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-real-external-provider-api-adapter-execution-preflight-proof")
        print("preflight=" + accepted.accepted + "," + accepted.reason + "," + accepted.real_external_preflight_present + "," + accepted.real_external_provider_api_execution_ready + "," + accepted.actual_external_provider_api_call_executed)
        print("stub=" + accepted.stub_execution_present + "," + accepted.stub_execution_accepted + "," + accepted.stub_execution_reason + "," + accepted.external_provider_api_stub_call_executed + "," + accepted.external_provider_api_stub_result_present)
        print("owner=" + owner.preflight_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_stub_reject_count + "," + owner.rejected_stub_reject_count + "," + owner.not_ready_reject_count + "," + owner.already_executed_reject_count + "," + owner.closed_execution_reject_count + "," + owner.closed_host_replacement_reject_count + "," + owner.closed_hook_reject_count + "," + owner.closed_backend_matcher_reject_count + "," + owner.last_reason)
        print("closed=" + accepted.host_replacement_inactive + "," + accepted.hooks_inactive + "," + accepted.backend_matcher_inactive + "," + accepted.would_activate_provider + "," + accepted.would_call_provider + "," + accepted.would_execute_provider_api + "," + accepted.would_call_external_provider_api + "," + accepted.would_execute_real_external_provider_api + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + rejected.reason + "," + not_ready_result.reason + "," + already_executed_result.reason + "," + execution_closed_result.reason + "," + host_rejected.reason + "," + hook_rejected.reason + "," + matcher_rejected.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

// mimalloc-remote-free-minimum-benchmark-run-proof
// Local alloc/realloc/free workload proof app for the exact-EXE-first minimum benchmark row.

using selfhost.hako_alloc.memory.allocator_facade_box as HakoAllocFacade

box HakoAllocRemoteFreeMinimumBenchmarkRunReport {
    operation_repeat: i64 = 128
    workload_id: StringBox = "local-alloc-free-cycle-v0"
    completed_ops: i64 = 0

    outputContractLine() {
        return "output_contract=mimalloc-comparison-remote-free-minimum-benchmark-run-v0"
    }

    benchmarkPackLine() {
        return "benchmark_pack=remote-free-minimum-v0"
    }

    backendScopeLine() {
        return "backend_scope=exact-exe-first"
    }

    backendSplitScopeLine() {
        return "backend_split_scope=remote-free-minimum-v0"
    }

    backendSplitFamilyLine() {
        return "backend_split_family=split-observation"
    }

    timingRepeatKindLine() {
        return "timing_repeat_kind=process-invocation-v0"
    }

    operationRepeatLine() {
        return "operation_repeat=" + me.operation_repeat
    }

    warmupCountLine() {
        return "warmup_count=1"
    }

    sampleCountLine() {
        return "sample_count=5"
    }

    workloadLine() {
        return "workload_id=" + me.workload_id
    }

    completedOpsLine() {
        return "completed_ops=" + me.completed_ops
    }

    stopLine() {
        return "stop_line=provider:0,replacement:0,winner:0"
    }

    ok() {
        if me.completed_ops != me.operation_repeat { return 0 }
        return 1
    }

    summaryLine() {
        if me.ok() == 1 {
            return "summary=ok"
        }
        return "summary=fail"
    }
}

static box Main {
    main(args) {
        local report = new HakoAllocRemoteFreeMinimumBenchmarkRunReport()
        local alloc = new HakoAllocProductionFacade()
        local repeat = report.operation_repeat
        local completed_ops = 0
        local i = 0
        local ok = 1

        loop(i < repeat) {
            if ok == 1 {
                local handle = alloc.allocate(16)
                if handle == null {
                    ok = 0
                } else {
                    local realloc_result = alloc.reallocResult(handle, 24)
                    if realloc_result.ok != 1 {
                        ok = 0
                    } else {
                        if alloc.release(realloc_result.handle) != 1 {
                            ok = 0
                        } else {
                            if alloc.outstandingBlocks() != 0 {
                                ok = 0
                            } else {
                                completed_ops = completed_ops + 1
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
        report.completed_ops = completed_ops

        if ok != 1 {
            print("mimalloc-remote-free-minimum-benchmark-run-proof")
            print(report.workloadLine())
            print(report.completedOpsLine())
            print("summary=fail")
            return 1
        }

        print("mimalloc-remote-free-minimum-benchmark-run-proof")
        print(report.outputContractLine())
        print(report.benchmarkPackLine())
        print(report.backendScopeLine())
        print(report.backendSplitScopeLine())
        print(report.backendSplitFamilyLine())
        print(report.timingRepeatKindLine())
        print(report.operationRepeatLine())
        print(report.warmupCountLine())
        print(report.sampleCountLine())
        print(report.workloadLine())
        print(report.completedOpsLine())
        print(report.stopLine())
        print(report.summaryLine())

        if report.ok() == 1 {
            return 0
        }
        return 1
    }
}

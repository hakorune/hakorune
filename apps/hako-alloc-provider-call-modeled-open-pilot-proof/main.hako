// hako-alloc-provider-call-modeled-open-pilot-proof
// Purpose: prove MIMAP-386A provider-call modeled open pilot.

using selfhost.hako_alloc.memory.provider_call_dry_run_unsupported_behavior_box as HakoAllocProviderCallDryRunUnsupportedBehavior
using selfhost.hako_alloc.memory.provider_call_modeled_open_pilot_box as HakoAllocProviderCallModeledOpenPilot

static box Main {
    makeDryRun(): HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
        local report = new HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
            accepted: 1,
            reason: 0,
            dry_run_attempted: 1,
            unsupported_outcome_present: 1,
            gate_present: 1,
            gate_accepted: 1,
            gate_reason: 0,
            provider_call_capability_present: 1,
            provider_call_capability_valid: 1,
            provider_call_unsupported: 1,
            provider_call_inactive: 1,
            provider_call_execution_closed: 1,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_inactive: 1,
            dry_run_count: 1,
            accepted_count: 1,
            reject_count: 0,
            missing_gate_reject_count: 0,
            rejected_gate_reject_count: 0,
            closed_execution_reject_count: 0,
            last_reason: 0,
            would_activate_provider: 1,
            would_call_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return report
    }

    main(args) {
        local owner = new HakoAllocProviderCallModeledOpenPilot()
        local dry_run = Main.makeDryRun()
        local opened = owner.openModeledProviderCall(dry_run)

        local missing_dry_run = new HakoAllocProviderCallDryRunUnsupportedBehaviorReport()
        local missing = owner.openModeledProviderCall(missing_dry_run)

        local rejected_dry_run = Main.makeDryRun()
        rejected_dry_run.accepted = 0
        rejected_dry_run.reason = 2
        local rejected = owner.openModeledProviderCall(rejected_dry_run)

        local missing_capability = Main.makeDryRun()
        missing_capability.provider_call_capability_present = 0
        local missing_capability_result = owner.openModeledProviderCall(missing_capability)

        local invalid_capability = Main.makeDryRun()
        invalid_capability.provider_call_capability_valid = 0
        local invalid_capability_result = owner.openModeledProviderCall(invalid_capability)

        local unsupported_missing = Main.makeDryRun()
        unsupported_missing.provider_call_unsupported = 0
        local unsupported_missing_result = owner.openModeledProviderCall(unsupported_missing)

        local call_leak = Main.makeDryRun()
        call_leak.would_call_provider = 1
        local call_rejected = owner.openModeledProviderCall(call_leak)

        local host_leak = Main.makeDryRun()
        host_leak.would_replace_host_allocator = 1
        local host_rejected = owner.openModeledProviderCall(host_leak)

        local hook_leak = Main.makeDryRun()
        hook_leak.would_install_hook = 1
        local hook_rejected = owner.openModeledProviderCall(hook_leak)

        local matcher_leak = Main.makeDryRun()
        matcher_leak.would_add_backend_matcher = 1
        local matcher_rejected = owner.openModeledProviderCall(matcher_leak)

        local ok = check "mimap386a provider call modeled open pilot" {
            "accepted": opened.accepted == 1
            "reason": opened.reason == 0
            "modeled present": opened.modeled_open_present == 1
            "dry run present": opened.dry_run_present == 1
            "dry run accepted": opened.dry_run_accepted == 1
            "gate present": opened.gate_present == 1
            "gate accepted": opened.gate_accepted == 1
            "capability present": opened.provider_call_capability_present == 1
            "capability valid": opened.provider_call_capability_valid == 1
            "unsupported": opened.provider_call_unsupported == 1
            "modeled open": opened.provider_call_modeled_open == 1
            "model active": opened.provider_call_model_active == 1
            "call no longer inactive": opened.provider_call_inactive == 0
            "execution still closed": opened.provider_call_execution_closed == 1
            "host inactive": opened.host_replacement_inactive == 1
            "hooks inactive": opened.hooks_inactive == 1
            "matcher inactive": opened.backend_matcher_inactive == 1
            "owner count": owner.modeled_open_count == 10
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 9
            "owner missing": owner.missing_dry_run_reject_count == 1
            "owner rejected dryrun": owner.rejected_dry_run_reject_count == 1
            "owner missing capability": owner.missing_capability_reject_count == 1
            "owner invalid capability": owner.invalid_capability_reject_count == 1
            "owner unsupported missing": owner.unsupported_outcome_reject_count == 1
            "owner call closed": owner.closed_call_reject_count == 1
            "owner host closed": owner.closed_host_replacement_reject_count == 1
            "owner hook closed": owner.closed_hook_reject_count == 1
            "owner matcher closed": owner.closed_backend_matcher_reject_count == 1
            "last reason": owner.last_reason == 9
            "missing reason": missing.reason == 1
            "rejected reason": rejected.reason == 2
            "missing capability reason": missing_capability_result.reason == 3
            "invalid capability reason": invalid_capability_result.reason == 4
            "unsupported missing reason": unsupported_missing_result.reason == 5
            "call reason": call_rejected.reason == 6
            "host reason": host_rejected.reason == 7
            "hook reason": hook_rejected.reason == 8
            "matcher reason": matcher_rejected.reason == 9
            "would activate": opened.would_activate_provider == 1
            "would call": opened.would_call_provider == 1
            "would host": opened.would_replace_host_allocator == 0
            "would hook": opened.would_install_hook == 0
            "would matcher": opened.would_add_backend_matcher == 0
            "would thread": opened.would_run_thread == 0
        }

        print("hako-alloc-provider-call-modeled-open-pilot-proof")
        print("opened=" + opened.accepted + "," + opened.reason + "," + opened.modeled_open_present + "," + opened.provider_call_modeled_open + "," + opened.provider_call_model_active + "," + opened.provider_call_inactive)
        print("dryrun=" + opened.dry_run_present + "," + opened.dry_run_accepted + "," + opened.dry_run_reason + "," + opened.provider_call_capability_present + "," + opened.provider_call_capability_valid + "," + opened.provider_call_unsupported + "," + opened.provider_call_execution_closed)
        print("owner=" + owner.modeled_open_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_dry_run_reject_count + "," + owner.rejected_dry_run_reject_count + "," + owner.missing_capability_reject_count + "," + owner.invalid_capability_reject_count + "," + owner.unsupported_outcome_reject_count + "," + owner.closed_call_reject_count + "," + owner.closed_host_replacement_reject_count + "," + owner.closed_hook_reject_count + "," + owner.closed_backend_matcher_reject_count + "," + owner.last_reason)
        print("closed=" + opened.provider_call_execution_closed + "," + opened.host_replacement_inactive + "," + opened.hooks_inactive + "," + opened.backend_matcher_inactive + "," + opened.would_activate_provider + "," + opened.would_call_provider + "," + opened.would_replace_host_allocator + "," + opened.would_install_hook + "," + opened.would_add_backend_matcher + "," + opened.would_run_thread)
        print("rejected=" + missing.reason + "," + rejected.reason + "," + missing_capability_result.reason + "," + invalid_capability_result.reason + "," + unsupported_missing_result.reason + "," + call_rejected.reason + "," + host_rejected.reason + "," + hook_rejected.reason + "," + matcher_rejected.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

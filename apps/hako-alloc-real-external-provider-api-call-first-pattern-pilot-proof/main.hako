// hako-alloc-real-external-provider-api-call-first-pattern-pilot-proof
// Purpose: prove MIMAP-415A first-pattern real external provider API call pilot.

using selfhost.hako_alloc.memory.real_external_provider_api_adapter_execution_preflight_box as HakoAllocRealExternalProviderApiAdapterExecutionPreflight
using selfhost.hako_alloc.memory.real_external_provider_api_call_first_pattern_pilot_box as HakoAllocRealExternalProviderApiCallFirstPatternPilot

static box Main {
    makePreflight(): HakoAllocRealExternalProviderApiAdapterExecutionPreflightReport {
        local report = new HakoAllocRealExternalProviderApiAdapterExecutionPreflightReport {
            accepted: 1,
            reason: 0,
            real_external_preflight_present: 1,
            stub_execution_present: 1,
            stub_execution_accepted: 1,
            stub_execution_reason: 0,
            external_provider_adapter_present: 1,
            external_provider_adapter_valid: 1,
            external_provider_api_stub_call_executed: 1,
            external_provider_api_stub_result_present: 1,
            real_external_provider_api_execution_ready: 1,
            actual_external_provider_api_call_executed: 0,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_inactive: 1,
            preflight_count: 1,
            accepted_count: 1,
            reject_count: 0,
            missing_stub_reject_count: 0,
            rejected_stub_reject_count: 0,
            not_ready_reject_count: 0,
            already_executed_reject_count: 0,
            closed_execution_reject_count: 0,
            closed_host_replacement_reject_count: 0,
            closed_hook_reject_count: 0,
            closed_backend_matcher_reject_count: 0,
            last_reason: 0,
            would_activate_provider: 1,
            would_call_provider: 1,
            would_execute_provider_api: 1,
            would_call_external_provider_api: 1,
            would_execute_real_external_provider_api: 1,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return report
    }

    main(args) {
        local owner = new HakoAllocRealExternalProviderApiCallFirstPatternPilot()
        local preflight = Main.makePreflight()
        local accepted = owner.executeRealExternalProviderApiCall(preflight)

        local missing_preflight = new HakoAllocRealExternalProviderApiAdapterExecutionPreflightReport()
        local missing = owner.executeRealExternalProviderApiCall(missing_preflight)

        local rejected_preflight = Main.makePreflight()
        rejected_preflight.accepted = 0
        rejected_preflight.reason = 2
        local rejected = owner.executeRealExternalProviderApiCall(rejected_preflight)

        local not_ready = Main.makePreflight()
        not_ready.real_external_provider_api_execution_ready = 0
        local not_ready_result = owner.executeRealExternalProviderApiCall(not_ready)

        local already_executed = Main.makePreflight()
        already_executed.actual_external_provider_api_call_executed = 1
        local already_executed_result = owner.executeRealExternalProviderApiCall(already_executed)

        local execution_closed = Main.makePreflight()
        execution_closed.would_execute_real_external_provider_api = 0
        local execution_closed_result = owner.executeRealExternalProviderApiCall(execution_closed)

        local host_leak = Main.makePreflight()
        host_leak.would_replace_host_allocator = 1
        local host_rejected = owner.executeRealExternalProviderApiCall(host_leak)

        local hook_leak = Main.makePreflight()
        hook_leak.would_install_hook = 1
        local hook_rejected = owner.executeRealExternalProviderApiCall(hook_leak)

        local matcher_leak = Main.makePreflight()
        matcher_leak.would_add_backend_matcher = 1
        local matcher_rejected = owner.executeRealExternalProviderApiCall(matcher_leak)

        local ok = check "mimap415a real external provider api call first pattern pilot" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "first pattern": accepted.first_pattern_present == 1
            "preflight present": accepted.real_external_preflight_present == 1
            "preflight accepted": accepted.preflight_accepted == 1
            "ready": accepted.real_external_provider_api_execution_ready == 1
            "call executed": accepted.real_external_provider_api_call_executed == 1
            "result present": accepted.real_external_provider_api_result_present == 1
            "result code": accepted.real_external_provider_api_result_code == 0
            "actual external": accepted.actual_external_provider_api_call_executed == 1
            "host inactive": accepted.host_replacement_inactive == 1
            "hooks inactive": accepted.hooks_inactive == 1
            "matcher inactive": accepted.backend_matcher_inactive == 1
            "owner count": owner.execution_count == 9
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 8
            "owner missing": owner.missing_preflight_reject_count == 1
            "owner rejected preflight": owner.rejected_preflight_reject_count == 1
            "owner not ready": owner.not_ready_reject_count == 1
            "owner already executed": owner.already_executed_reject_count == 1
            "owner execution closed": owner.closed_execution_reject_count == 1
            "owner host closed": owner.closed_host_replacement_reject_count == 1
            "owner hook closed": owner.closed_hook_reject_count == 1
            "owner matcher closed": owner.closed_backend_matcher_reject_count == 1
            "last reason": owner.last_reason == 8
            "missing reason": missing.reason == 1
            "rejected reason": rejected.reason == 2
            "not ready reason": not_ready_result.reason == 3
            "already executed reason": already_executed_result.reason == 4
            "execution reason": execution_closed_result.reason == 5
            "host reason": host_rejected.reason == 6
            "hook reason": hook_rejected.reason == 7
            "matcher reason": matcher_rejected.reason == 8
            "would activate": accepted.would_activate_provider == 1
            "would call": accepted.would_call_provider == 1
            "would api": accepted.would_execute_provider_api == 1
            "would external": accepted.would_call_external_provider_api == 1
            "would real": accepted.would_execute_real_external_provider_api == 1
            "would host": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-real-external-provider-api-call-first-pattern-pilot-proof")
        print("realcall=" + accepted.accepted + "," + accepted.reason + "," + accepted.first_pattern_present + "," + accepted.real_external_provider_api_call_executed + "," + accepted.real_external_provider_api_result_present + "," + accepted.real_external_provider_api_result_code)
        print("actual=" + accepted.actual_external_provider_api_call_executed + "," + accepted.host_replacement_inactive + "," + accepted.hooks_inactive + "," + accepted.backend_matcher_inactive)
        print("preflight=" + accepted.real_external_preflight_present + "," + accepted.preflight_accepted + "," + accepted.preflight_reason + "," + accepted.real_external_provider_api_execution_ready + "," + accepted.would_execute_real_external_provider_api)
        print("owner=" + owner.execution_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_preflight_reject_count + "," + owner.rejected_preflight_reject_count + "," + owner.not_ready_reject_count + "," + owner.already_executed_reject_count + "," + owner.closed_execution_reject_count + "," + owner.closed_host_replacement_reject_count + "," + owner.closed_hook_reject_count + "," + owner.closed_backend_matcher_reject_count + "," + owner.last_reason)
        print("closed=" + accepted.host_replacement_inactive + "," + accepted.hooks_inactive + "," + accepted.backend_matcher_inactive + "," + accepted.would_activate_provider + "," + accepted.would_call_provider + "," + accepted.would_execute_provider_api + "," + accepted.would_call_external_provider_api + "," + accepted.would_execute_real_external_provider_api + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + rejected.reason + "," + not_ready_result.reason + "," + already_executed_result.reason + "," + execution_closed_result.reason + "," + host_rejected.reason + "," + hook_rejected.reason + "," + matcher_rejected.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

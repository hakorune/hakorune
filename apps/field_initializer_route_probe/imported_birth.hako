using apps.field_initializer_route_probe.library as FieldInitRouteLib

static box Main {
    main() {
        local obj = FieldInitRouteLib.createBirth(42)
        if obj.ready() == 1 {
            print("imported_factory_birth=ok")
        } else {
            print("imported_factory_birth=fail")
        }
        return 0
    }
}

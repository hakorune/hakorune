using apps.field_initializer_route_probe.library as FieldInitRouteLib

static box Main {
    main() {
        local obj = FieldInitRouteLib.createOrderedLike()
        if obj.ready() == 1 {
            print("imported_factory_ordered_like=ok")
        } else {
            print("imported_factory_ordered_like=fail")
        }
        return 0
    }
}

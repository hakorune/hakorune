// convert_break_continue_fixture.hako — break/continue unsupported fixture wrapper.
//
// This wrapper owns only the fixture file route. Conversion logic stays in
// converter_core.hako.

using apps.rust_subset_to_hako.converter_core as RustSubsetConverter

static box Main {
    main() {
        local file = new FileBox()
        local opened = file.open("apps/rust-subset-to-hako/examples/break_continue_subset.json", "r")
        if opened == 0 {
            print("// error: break-continue fixture open failed")
            return 1
        }

        local text = file.read()
        file.close()
        if text == null {
            print("// error: break-continue fixture read failed")
            return 1
        }

        local converter = new RustSubsetConverter()
        local result = converter.convert(text)
        print(result)
        return 0
    }
}

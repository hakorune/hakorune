// converter_core.hako — RustSubset JSON v0 -> .hako skeleton converter core.
//
// This file owns conversion only. Input route selection, fixture embedding,
// FileBox, stdin, and adapter invocation belong to app-front wrappers.

using apps.lib.json_native.parser.parser as JsonParserUtils

box RustSubsetConverter {
    // ── main entry ──────────────────────────────────────

    convert(json_text) {
        local doc = JsonParserUtils.parse_json(json_text)
        if doc == null {
            return me.fail("invalid JSON")
        }

        local sv = doc.get_node("schema_version")
        if sv == null {
            return me.fail("missing schema_version")
        }
        if sv.as_int() != 0 {
            return me.fail("unsupported schema_version")
        }
        if me.node_str(doc.get_node("kind")) != "RustSubsetModule" {
            return me.fail("unsupported document kind")
        }

        local items = doc.get_node("items")
        if items == null {
            return "// empty module"
        }

        local method_names = me.collect_method_names(items)
        if method_names.indexOf("// error: ") == 0 {
            return method_names
        }
        local box_name = ""
        if method_names != "\n" {
            box_name = me.module_box_name(me.node_str(doc.get_node("module")))
            if box_name == "" {
                return me.fail("invalid RustSubset module name for static box")
            }
        }

        local item_count = items.length()
        local output = ""
        local methods = ""
        local i = 0
        loop(i < item_count) {
            local item = items.get_node(i)
            local kind = me.node_str(item.get_node("kind"))
            local item_text = ""
            if kind == "Function" {
                methods = me.append_block(methods, me.emit_method(item, "", method_names))
            } else {
                if kind == "Impl" {
                    local target = me.impl_target(item)
                    local impl_methods = item.get_node("methods")
                    if impl_methods == null {
                        item_text = "// impl " + target + " (no methods)"
                    } else {
                        if impl_methods.length() == 0 {
                            item_text = "// impl " + target + " (no methods)"
                        } else {
                            methods = me.append_block(methods, me.emit_impl(impl_methods, target, method_names))
                        }
                    }
                } else {
                    if kind == "Struct" && box_name != "" && me.emitted_name(item) == box_name {
                        return me.fail("static box name collides with struct: " + box_name)
                    }
                    item_text = me.emit_item(item)
                }
            }
            if item_text != "" {
                output = me.append_block(output, item_text)
            }
            i = i + 1
        }

        if methods != "" {
            return me.append_block(output, "static box " + box_name + " {\n" + methods + "\n}")
        }
        return output
    }

    append_block(output, block) {
        if output == "" { return block }
        return output + "\n\n" + block
    }

    module_box_name(module) {
        if module == "" { return "" }
        local box_name = "RustSubset_"
        local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
        local i = 0
        loop(i < module.length()) {
            local ch = module.substring(i, i + 1)
            if alphabet.indexOf(ch) >= 0 {
                box_name = box_name + ch
            } else {
                if ch == "_" {
                    box_name = box_name + "_u"
                } else {
                    if ch != ":" { return "" }
                    box_name = box_name + "_c"
                }
            }
            i = i + 1
        }
        return box_name
    }

    emitted_name(node) {
        local name = me.node_str(node.get_node("emitted_name"))
        if name == "" { return me.node_str(node.get_node("name")) }
        return name
    }

    impl_target(item) {
        local target = me.node_str(item.get_node("target_emitted_name"))
        if target == "" { return me.node_str(item.get_node("target")) }
        return target
    }

    method_name(func, target) {
        local name = me.emitted_name(func)
        if target == "" { return name }
        return target + "_" + name
    }

    insert_method_name(names, func, target) {
        local name = me.method_name(func, target)
        if names.indexOf("\n" + name + "\n") >= 0 {
            return me.fail("duplicate method name: " + name)
        }
        return names + name + "\n"
    }

    collect_method_names(items) {
        local names = "\n"
        local i = 0
        loop(i < items.length()) {
            local item = items.get_node(i)
            local kind = me.node_str(item.get_node("kind"))
            if kind == "Function" {
                names = me.insert_method_name(names, item, "")
                if names.indexOf("// error: ") == 0 { return names }
            }
            if kind == "Impl" {
                local target = me.impl_target(item)
                local methods = item.get_node("methods")
                if methods != null {
                    local j = 0
                    loop(j < methods.length()) {
                        names = me.insert_method_name(names, methods.get_node(j), target)
                        if names.indexOf("// error: ") == 0 { return names }
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
        return names
    }

    fail(message) {
        return "// error: " + message
    }

    // ── item emitters ───────────────────────────────────

    emit_item(item) {
        local kind = me.node_str(item.get_node("kind"))
        if kind == "Struct" {
            return me.emit_struct(item)
        }
        if kind == "Enum" {
            return me.emit_enum(item)
        }
        if kind == "Unsupported" {
            return me.emit_unsupported(item)
        }
        return me.fail("unknown item kind: " + kind)
    }

    emit_unsupported(item) {
        local summary = me.node_str(item.get_node("summary"))
        if summary == "" {
            summary = me.node_str(item.get_node("reason"))
        }
        if summary == "" {
            local rust_kind = me.node_str(item.get_node("rust_kind"))
            if rust_kind != "" {
                summary = rust_kind + " is out of v0 scope"
            }
        }
        if summary == "" {
            summary = "unsupported"
        }
        return "// TODO: " + summary
    }

    emit_struct(item) {
        local name = me.node_str(item.get_node("emitted_name"))
        if name == "" { name = me.node_str(item.get_node("name")) }
        local identity = me.node_str(item.get_node("identity"))
        local keyword = "record"
        if identity == "true" {
            keyword = "box"
        }

        local fields = item.get_node("fields")
        local body = ""
        if fields != null {
            local fc = fields.length()
            if fc == 0 {
                return "// TODO: empty " + keyword + " " + name + " is out of v0 skeleton scope"
            }
            local fi = 0
            loop(fi < fc) {
                local field = fields.get_node(fi)
                local fname = me.node_str(field.get_node("emitted_name"))
                if fname == "" { fname = me.node_str(field.get_node("name")) }
                local ftype = me.map_type(me.node_str(field.get_node("type")))
                body = body + "    " + fname + ": " + ftype
                fi = fi + 1
                if fi < fc {
                    body = body + "\n"
                }
            }
        }

        return keyword + " " + name + " {\n" + body + "\n}"
    }

    emit_enum(item) {
        local name = me.node_str(item.get_node("emitted_name"))
        if name == "" { name = me.node_str(item.get_node("name")) }
        local result = "// enum " + name
        local variants = item.get_node("variants")
        if variants != null {
            local vc = variants.length()
            local vi = 0
            loop(vi < vc) {
                local variant = variants.get_node(vi)
                local vname = me.node_str(variant.get_node("emitted_name"))
                if vname == "" { vname = me.node_str(variant.get_node("name")) }
                local fields = variant.get_node("fields")
                if fields != null {
                    local fc = fields.length()
                    if fc > 0 {
                        local types = ""
                        local fi = 0
                        loop(fi < fc) {
                            local field = fields.get_node(fi)
                            if types != "" { types = types + ", " }
                            types = types + me.node_str(field.get_node("type"))
                            fi = fi + 1
                        }
                        vname = vname + "(" + types + ")"
                    }
                }
                result = result + "\n//   " + vname
                vi = vi + 1
            }
        }
        return result
    }

    emit_impl(methods, target, method_names) {
        local result = ""
        local mi = 0
        loop(mi < methods.length()) {
            local method = methods.get_node(mi)
            result = me.append_block(result, me.emit_method(method, target, method_names))
            mi = mi + 1
        }
        return result
    }

    emit_method(func, target_prefix, method_names) {
        local name = me.method_name(func, target_prefix)

        // Build params
        local params = ""

        // Receiver: self_ref/self_mut/self_value -> receiver: TargetType
        local receiver = me.node_str(func.get_node("receiver"))
        if receiver != "none" && receiver != "" && target_prefix != "" {
            params = "receiver: " + target_prefix
        }

        // Explicit params
        local param_arr = func.get_node("params")
        if param_arr != null {
            local pc = param_arr.length()
            local pi = 0
            loop(pi < pc) {
                local p = param_arr.get_node(pi)
                local pname = me.node_str(p.get_node("emitted_name"))
                if pname == "" { pname = me.node_str(p.get_node("name")) }
                local ptype = me.map_type(me.node_str(p.get_node("type")))
                if params != "" { params = params + ", " }
                params = params + pname + ": " + ptype
                pi = pi + 1
            }
        }

        // Return type
        local return_type = me.node_str(func.get_node("return_type"))
        if return_type == "" { return_type = "void" }
        return_type = me.map_type(return_type)

        // Body
        local body_arr = func.get_node("body")
        local body = me.emit_stmt_list(body_arr, "        ", method_names)
        if body == "" { body = "        // empty body" }

        return "    " + name + "(" + params + "): " + return_type + " {\n" + body + "\n    }"
    }

    // ── statement emitter ───────────────────────────────

    emit_stmt_list(stmts, indent, method_names) {
        local result = ""
        if stmts != null {
            local sc = stmts.length()
            local si = 0
            loop(si < sc) {
                local stmt = stmts.get_node(si)
                result = result + me.emit_stmt(stmt, indent, method_names)
                si = si + 1
                if si < sc { result = result + "\n" }
            }
        }
        return result
    }

    emit_stmt(stmt, indent, method_names) {
        local kind = me.node_str(stmt.get_node("kind"))

        if kind == "Return" {
            local val = stmt.get_node("value")
            if val != null {
                return indent + "return " + me.emit_expr(val, method_names)
            }
            return indent + "return"
        }

        if kind == "Let" {
            local lname = me.node_str(stmt.get_node("emitted_name"))
            if lname == "" { lname = me.node_str(stmt.get_node("name")) }
            local ltype = me.map_type(me.node_str(stmt.get_node("type")))
            local lval = stmt.get_node("value")
            return indent + "local " + lname + ": " + ltype + " = " + me.emit_expr(lval, method_names)
        }

        if kind == "Expr" {
            return indent + me.emit_expr(stmt.get_node("value"), method_names)
        }

        if kind == "Assign" {
            local target = me.emit_expr(stmt.get_node("target"), method_names)
            local val = me.emit_expr(stmt.get_node("value"), method_names)
            return indent + target + " = " + val
        }

        if kind == "If" {
            local cond = me.emit_expr(stmt.get_node("cond"), method_names)
            local then_body = me.emit_stmt_list(stmt.get_node("then"), indent + "    ", method_names)
            local result = indent + "if " + cond + " {\n" + then_body + "\n" + indent + "}"
            local else_body = me.emit_stmt_list(stmt.get_node("else"), indent + "    ", method_names)
            if else_body != "" {
                result = result + " else {\n" + else_body + "\n" + indent + "}"
            }
            return result
        }

        if kind == "While" {
            return me.emit_while(stmt, indent, method_names)
        }

        if kind == "Unsupported" {
            local reason = me.node_str(stmt.get_node("reason"))
            if reason == "" { reason = "unsupported" }
            return indent + "/* TODO: " + reason + " */"
        }

        return indent + me.fail("unknown statement kind: " + kind)
    }

    emit_while(stmt, indent, method_names) {
        local cond = me.emit_expr(stmt.get_node("cond"), method_names)
        local body = me.emit_stmt_list(stmt.get_node("body"), indent + "    ", method_names)
        local result = indent + "loop(" + cond + ") {\n" + body + "\n" + indent + "}"
        return result
    }

    // ── expression emitter (recursive) ──────────────────

    emit_expr(expr, method_names) {
        if expr == null { return "null" }

        local kind = me.node_str(expr.get_node("kind"))

        if kind == "Literal" {
            return me.emit_literal_value(expr.get_node("value"))
        }

        if kind == "Name" {
            local n = me.node_str(expr.get_node("emitted_name"))
            if n == "" { n = me.node_str(expr.get_node("name")) }
            if n == "self" { return "receiver" }
            return n
        }

        if kind == "Field" {
            local base = me.emit_expr(expr.get_node("base"), method_names)
            local field = me.node_str(expr.get_node("emitted_name"))
            if field == "" { field = me.node_str(expr.get_node("field")) }
            return base + "." + field
        }

        if kind == "Index" {
            local target = me.emit_expr(expr.get_node("target"), method_names)
            local index = me.emit_expr(expr.get_node("index"), method_names)
            return target + "[" + index + "]"
        }

        if kind == "Binary" {
            local op = me.node_str(expr.get_node("op"))
            local left = me.emit_expr(expr.get_node("left"), method_names)
            local right = me.emit_expr(expr.get_node("right"), method_names)
            return left + " " + op + " " + right
        }

        if kind == "Call" {
            local callee = me.node_str(expr.get_node("callee"))
            local args = expr.get_node("args")
            local args_str = ""
            if args != null {
                local ac = args.length()
                local ai = 0
                loop(ai < ac) {
                    if args_str != "" { args_str = args_str + ", " }
                    args_str = args_str + me.emit_expr(args.get_node(ai), method_names)
                    ai = ai + 1
                }
            }
            return me.call_target(expr, callee, method_names) + "(" + args_str + ")"
        }

        if kind == "MethodCall" {
            local recv = me.emit_expr(expr.get_node("receiver"), method_names)
            local method = me.node_str(expr.get_node("method"))
            local args = expr.get_node("args")
            local args_str = ""
            if args != null {
                local ac = args.length()
                local ai = 0
                loop(ai < ac) {
                    if args_str != "" { args_str = args_str + ", " }
                    args_str = args_str + me.emit_expr(args.get_node(ai), method_names)
                    ai = ai + 1
                }
            }
            return recv + "." + method + "(" + args_str + ")"
        }

        if kind == "ArrayLiteral" {
            local elements = expr.get_node("elements")
            local result = "["
            if elements != null {
                local ec = elements.length()
                local ei = 0
                loop(ei < ec) {
                    if result != "[" { result = result + ", " }
                    result = result + me.emit_expr(elements.get_node(ei), method_names)
                    ei = ei + 1
                }
            }
            return result + "]"
        }

        if kind == "Unsupported" {
            local reason = me.node_str(expr.get_node("reason"))
            if reason == "" { reason = "unsupported" }
            return "null /* TODO: " + reason + " */"
        }

        return me.fail("unknown expression kind: " + kind)
    }

    map_type(ty) {
        if ty == "i8" { return "i64" }
        if ty == "i16" { return "i64" }
        if ty == "i32" { return "i64" }
        if ty == "i64" { return "i64" }
        if ty == "isize" { return "i64" }
        if ty == "u8" { return "i64" }
        if ty == "u16" { return "i64" }
        if ty == "u32" { return "i64" }
        if ty == "u64" { return "i64" }
        if ty == "usize" { return "usize" }
        if ty == "String" { return "String" }
        if ty == "&str" { return "String" }
        if ty == "str" { return "String" }
        if ty == "bool" { return "bool" }
        if ty.length() >= 5 && ty.substring(0, 4) == "Vec<" {
            return "Array"
        }
        return ty
    }

    call_target(expr, callee, method_names) {
        local path = expr.get_node("callee_source_path")
        if path != null {
            local size = path.length()
            if size > 1 {
                if me.node_str(path.get_node(0)) == "crate" {
                    local module = "crate"
                    local i = 1
                    loop(i < size - 1) {
                        module = module + "::" + me.node_str(path.get_node(i))
                        i = i + 1
                    }
                    local owner = me.module_box_name(module)
                    if owner != "" {
                        return owner + "." + me.node_str(path.get_node(size - 1))
                    }
                }
                return callee
            }
        }
        if method_names.indexOf("\n" + callee + "\n") >= 0 {
            return "me." + callee
        }
        return callee
    }

    emit_literal_value(node) {
        if node == null { return "null" }
        local kind = node.get_kind()
        if kind == "string" {
            return "\"" + node.as_string() + "\""
        }
        if kind == "bool" {
            if node.as_bool() { return "true" }
            return "false"
        }
        return me.node_str(node)
    }

    // ── JSON node helpers ───────────────────────────────

    // Extract string value from a JsonNode (handles string/int/bool nodes)
    node_str(node) {
        if node == null { return "" }
        local kind = node.get_kind()
        if kind == "string" { return node.as_string() }
        if kind == "int" { return "" + node.as_int() }
        if kind == "bool" {
            if node.as_bool() { return "true" }
            return "false"
        }
        if kind == "null" { return "" }
        return ""
    }
}

using apps.lib.json_native.core.node as JsonNode

static box Main {
    main() {
        local obj = JsonNode.create_object()
        local s = JsonNode.create_string("Program")
        obj.object_set("kind", s)
        local got = obj.get_node("kind")
        if got == null {
            print("got=language-null")
            return 1
        }
        print(got.get_kind())
        print(got.as_string())
        return 0
    }
}

using apps.lib.json_native.parser.parser as JsonParserUtils

static box Main {
    main() {
        local parsed = JsonParserUtils.parse_json("{\"kind\":\"Program\"}")
        local keys = parsed.object_keys()
        if keys.length() == 0 {
            print("no-key")
            return 1
        }
        local key = keys.get(0)
        local got = parsed.object_get(key)
        if got == null {
            print("self-key=null")
            return 2
        }
        print(got.get_kind())
        print(got.as_string())
        return 0
    }
}

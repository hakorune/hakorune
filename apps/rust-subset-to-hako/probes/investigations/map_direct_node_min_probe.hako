using apps.lib.json_native.core.node as JsonNode

static box Main {
    main() {
        local m = new MapBox()
        local s = JsonNode.create_string("Program")
        m.set("kind", s)
        local got = m.get("kind")
        if got == null {
            print("got=null")
            return 1
        }
        print(got.get_kind())
        print(got.as_string())
        return 0
    }
}

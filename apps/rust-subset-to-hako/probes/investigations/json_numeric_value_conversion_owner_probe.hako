// json_numeric_value_conversion_owner_probe.hako
//
// Owner-selection probe for scanner-derived numeric text after token storage
// is already green. This first slice isolates:
// scanner text -> StringUtils.parse_integer.

using apps.lib.json_native.lexer.scanner as JsonScanner
using apps.lib.json_native.utils.string as StringUtils

static box Main {
    main() {
        local scanner = new JsonScanner("")
        scanner.reset_text("123")
        local number_text = scanner.read_number()

        print("number_text=" + number_text)
        if number_text != "123" {
            print("json.numeric.owner=bad-scanner")
            return 2
        }

        local parsed = StringUtils.parse_integer(number_text)
        print("parsed=" + parsed)
        if parsed != 123 {
            print("json.numeric.owner=bad-parse-integer")
            return 3
        }

        print("json.numeric.owner=ok")
        return 0
    }
}

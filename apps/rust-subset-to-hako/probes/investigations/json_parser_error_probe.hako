using apps.lib.json_native.parser.parser as JsonParserModule

static box Main {
    main() {
        local parser = new JsonParser()
        local errors0 = parser.get_errors()
        print("errors.initial=" + errors0.length())
        parser.parse("[1,]")
        local errors1 = parser.get_errors()
        print("errors.after_invalid=" + errors1.length())
        return 0
    }
}

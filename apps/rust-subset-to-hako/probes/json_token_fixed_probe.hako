using apps.lib.json_native.lexer.tokenizer as JsonTokenizer

static box Main {
    main() {
        local tokenizer = new JsonTokenizer("{\"kind\":\"Program\"}")
        tokenizer.set_input("{\"kind\":\"Program\"}")
        local tokens = tokenizer.tokenize()
        print("tokens.length=" + tokens.length())
        local t0 = tokens.get(0)
        local t1 = tokens.get(1)
        local t2 = tokens.get(2)
        local t3 = tokens.get(3)
        local t4 = tokens.get(4)
        local t5 = tokens.get(5)
        print("t0=" + t0.get_type() + ":" + t0.get_value())
        print("t1=" + t1.get_type() + ":" + t1.get_value())
        print("t2=" + t2.get_type() + ":" + t2.get_value())
        print("t3=" + t3.get_type() + ":" + t3.get_value())
        print("t4=" + t4.get_type() + ":" + t4.get_value())
        print("t5=" + t5.get_type() + ":" + t5.get_value())
        print("errors=" + tokenizer.get_error_count())
        return tokenizer.get_error_count()
    }
}

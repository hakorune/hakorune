using apps.lib.json_native.lexer.tokenizer as JsonTokenizer

static box Main {
    main() {
        local tokenizer = new JsonTokenizer("{\"kind\":\"Program\",\"items\":[]}")
        tokenizer.set_input("{\"kind\":\"Program\",\"items\":[]}")
        local tokens = tokenizer.tokenize()
        print("tokens.length=" + tokens.length())
        print("errors=" + tokenizer.get_error_count())
        local i = 0
        loop(i < tokens.length()) {
            local tok = tokens.get(i)
            print("" + i + ":" + tok.get_type() + ":" + tok.get_value())
            i = i + 1
        }
        return 0
    }
}

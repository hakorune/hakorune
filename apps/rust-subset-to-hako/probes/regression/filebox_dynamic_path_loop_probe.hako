// Regression probe for 296x-1380.
//
// FileBox stays owned by Main/input-route code, but manifest-style routes need
// to read dynamic path strings in loop order. The EXE pure route must preserve
// FileBox receiver origin for `open/read/close` even when the MIR callee
// surface is RuntimeDataBox.

static box Main {
    main() {
        local paths = new ArrayBox()
        paths.push("CURRENT_TASK.md")
        paths.push("hako.toml")

        local i = 0
        local total = 0
        loop(i < paths.length()) {
            local path = paths.get(i)
            local file = new FileBox()
            local opened = file.open(path, "r")
            if opened == 0 {
                print("open failed")
                return 1
            }

            local text = file.read()
            file.close()
            total = total + text.length()
            i = i + 1
        }

        print(total)
        return 0
    }
}

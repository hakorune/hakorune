// convert_file.hako — FileBox input wrapper for RustSubset JSON v0.
//
// This wrapper owns only the file input route. Conversion logic stays in
// converter_core.hako.

using apps.rust_subset_to_hako.converter_core as RustSubsetConverter

static box Main {
    main() {
        local file = new FileBox()
        local opened = file.open("apps/rust-subset-to-hako/examples/simple_subset.json", "r")
        if opened == 0 {
            print("// error: file open failed")
            return 1
        }

        local text = file.read()
        file.close()
        if text == null {
            print("// error: file read failed")
            return 1
        }

        local converter = new RustSubsetConverter()
        local result = converter.convert(text)
        print(result)
        return 0
    }
}

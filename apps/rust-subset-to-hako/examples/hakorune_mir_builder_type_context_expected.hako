function TypeContext_restore_snapshot(receiver: TypeContext, snapshot: TypeContextSnapshot): void {
    receiver.value_types = snapshot.value_types
    receiver.value_kinds = snapshot.value_kinds
    receiver.value_origin_newbox = snapshot.value_origin_newbox
    receiver.string_literals = snapshot.string_literals
    receiver.map_value_types = snapshot.map_value_types

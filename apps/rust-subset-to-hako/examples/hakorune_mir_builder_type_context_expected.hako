function TypeContext_get_type(receiver: TypeContext, value_id: ValueId): Option<MirType> {
    return receiver.value_types.get(value_id)
}

function TypeContext_set_type(receiver: TypeContext, value_id: ValueId, ty: MirType): void {
    receiver.value_types.insert(value_id, ty)
}


function TypeContext_set_origin_box(receiver: TypeContext, value_id: ValueId, class_name: String): void {
    receiver.value_origin_newbox.insert(value_id, class_name)
}

function TypeContext_clear_origin_boxes(receiver: TypeContext): void {
    receiver.value_origin_newbox.clear()

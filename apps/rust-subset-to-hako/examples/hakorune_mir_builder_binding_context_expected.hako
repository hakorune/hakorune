    BindingContext_contains(receiver: BindingContext, name: String): bool {
        return receiver.binding_map.contains_key(name)
    }

    BindingContext_lookup(receiver: BindingContext, name: String): Option<BindingId> {
        return receiver.binding_map.get(name).copied()
    }

    BindingContext_insert(receiver: BindingContext, name: String, binding_id: BindingId): void {
        receiver.binding_map.insert(name, binding_id)
    }

    BindingContext_remove(receiver: BindingContext, name: String): Option<BindingId> {
        return receiver.binding_map.remove(name)
    }

    BindingContext_clear_for_function_entry(receiver: BindingContext): void {
        receiver.binding_map.clear()
    }

// convert.hako — startup wrapper for RustSubset JSON v0 -> .hako skeleton.
//
// Main owns only the current input route. Conversion logic lives in
// converter_core.hako, and embedded fixture data lives in fixtures/.

using apps.rust_subset_to_hako.converter_core as RustSubsetConverter
using apps.rust_subset_to_hako.fixtures.simple_subset_embedded as RustSubsetSimpleEmbeddedFixture

static box Main {
    main() {
        local converter = new RustSubsetConverter()
        local text = RustSubsetSimpleEmbeddedFixture.json_text()
        local result = converter.convert(text)
        print(result)
        return 0
    }
}

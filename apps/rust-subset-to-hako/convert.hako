// convert.hako — RustSubset JSON v0 -> .hako skeleton converter
// .hako native implementation (matches Python convert.py behavior for v0)
//
// Pipeline:
//   FileBox.open(path) -> read() -> close()
//   -> JsonParserUtils.parse_json(text)
//   -> navigate items -> emit .hako skeleton
//   -> print(result)
//
// Usage:
//   ./target/release/hakorune --backend vm apps/rust-subset-to-hako/convert.hako
//   (reads apps/rust-subset-to-hako/examples/simple_subset.json for v0)

using apps.lib.json_native.parser.parser as JsonParserUtils

static box Main {
    main() {
        // v0: hardcoded path for testing
        local path = "apps/rust-subset-to-hako/examples/simple_subset.json"
        local f = new FileBox()
        if f.open(path, "r") == 0 {
            print("// error: cannot open " + path)
            return 1
        }
        local text = f.read()
        f.close()

        local result = me.convert(text)
        print(result)
        return 0
    }

    // ── main entry ──────────────────────────────────────

    convert(json_text) {
        local doc = JsonParserUtils.parse_json(json_text)
        if doc == null {
            return "// parse error"
        }

        // Validate schema_version
        local sv = doc.get("schema_version")
        if sv == null {
            return "// error: missing schema_version"
        }

        local items = doc.get("items")
        if items == null {
            return "// empty module"
        }

        local item_count = items.length()
        local output = ""
        local i = 0

        loop(i < item_count) {
            local item = items.get(i)
            local kind = me.node_str(item.get("kind"))

            if kind == "Struct" {
                output = output + me.emit_struct(item)
            }
            if kind == "Enum" {
                output = output + me.emit_enum(item)
            }
            if kind == "Impl" {
                output = output + me.emit_impl(item)
            }
            if kind == "Function" {
                output = output + me.emit_function(item, "")
            }

            i = i + 1
            if i < item_count {
                output = output + "\n\n"
            }
        }

        return output + "\n"
    }

    // ── item emitters ───────────────────────────────────

    emit_struct(item) {
        local name = me.node_str(item.get("name"))
        local identity = me.node_str(item.get("identity"))
        local keyword = "record"
        if identity == "true" {
            keyword = "box"
        }

        local fields = item.get("fields")
        local body = ""
        if fields != null {
            local fc = fields.length()
            local fi = 0
            loop(fi < fc) {
                local field = fields.get(fi)
                local fname = me.node_str(field.get("name"))
                local ftype = me.node_str(field.get("type"))
                body = body + "    " + fname + ": " + ftype
                fi = fi + 1
                if fi < fc {
                    body = body + "\n"
                }
            }
        }

        return keyword + " " + name + " {\n" + body + "\n}"
    }

    emit_enum(item) {
        local name = me.node_str(item.get("name"))
        local result = "// enum " + name
        local variants = item.get("variants")
        if variants != null {
            local vc = variants.length()
            local vi = 0
            loop(vi < vc) {
                local variant = variants.get(vi)
                local vname = me.node_str(variant.get("name"))
                result = result + "\n//   " + vname
                vi = vi + 1
            }
        }
        return result
    }

    emit_impl(item) {
        local target = me.node_str(item.get("target"))
        local methods = item.get("methods")
        local result = ""
        if methods != null {
            local mc = methods.length()
            local mi = 0
            loop(mi < mc) {
                local method = methods.get(mi)
                result = result + me.emit_function(method, target)
                mi = mi + 1
                if mi < mc {
                    result = result + "\n\n"
                }
            }
        }
        return result
    }

    emit_function(func, target_prefix) {
        local name = me.node_str(func.get("name"))
        if target_prefix != "" {
            name = target_prefix + "_" + name
        }

        // Build params
        local params = ""

        // Receiver: self_ref/self_mut/self_value -> me: TargetType
        local receiver = me.node_str(func.get("receiver"))
        if receiver != "none" && receiver != "" && target_prefix != "" {
            params = "me: " + target_prefix
        }

        // Explicit params
        local param_arr = func.get("params")
        if param_arr != null {
            local pc = param_arr.length()
            local pi = 0
            loop(pi < pc) {
                local p = param_arr.get(pi)
                local pname = me.node_str(p.get("name"))
                local ptype = me.node_str(p.get("type"))
                if params != "" { params = params + ", " }
                params = params + pname + ": " + ptype
                pi = pi + 1
            }
        }

        // Return type
        local return_type = me.node_str(func.get("return_type"))
        if return_type == "" { return_type = "void" }

        // Body
        local body_arr = func.get("body")
        local body = ""
        if body_arr != null {
            local bc = body_arr.length()
            local bi = 0
            loop(bi < bc) {
                local stmt = body_arr.get(bi)
                body = body + "    " + me.emit_stmt(stmt)
                bi = bi + 1
                if bi < bc { body = body + "\n" }
            }
        }
        if body == "" { body = "    // empty body" }

        return "function " + name + "(" + params + "): " + return_type + " {\n" + body + "\n}"
    }

    // ── statement emitter ───────────────────────────────

    emit_stmt(stmt) {
        local kind = me.node_str(stmt.get("kind"))

        if kind == "Return" {
            local val = stmt.get("value")
            if val != null {
                return "return " + me.emit_expr(val)
            }
            return "return"
        }

        if kind == "Let" {
            local lname = me.node_str(stmt.get("name"))
            local ltype = me.node_str(stmt.get("type"))
            local lval = stmt.get("value")
            return "local " + lname + ": " + ltype + " = " + me.emit_expr(lval)
        }

        if kind == "Expr" {
            return me.emit_expr(stmt.get("value"))
        }

        return "// TODO: " + kind
    }

    // ── expression emitter (recursive) ──────────────────

    emit_expr(expr) {
        if expr == null { return "null" }

        local kind = me.node_str(expr.get("kind"))

        if kind == "Literal" {
            return me.node_str(expr.get("value"))
        }

        if kind == "Name" {
            local n = me.node_str(expr.get("name"))
            if n == "self" { return "me" }
            return n
        }

        if kind == "Field" {
            local base = me.emit_expr(expr.get("base"))
            local field = me.node_str(expr.get("field"))
            return base + "." + field
        }

        if kind == "Binary" {
            local op = me.node_str(expr.get("op"))
            local left = me.emit_expr(expr.get("left"))
            local right = me.emit_expr(expr.get("right"))
            return left + " " + op + " " + right
        }

        if kind == "Call" {
            local callee = me.node_str(expr.get("callee"))
            local args = expr.get("args")
            local args_str = ""
            if args != null {
                local ac = args.length()
                local ai = 0
                loop(ai < ac) {
                    if args_str != "" { args_str = args_str + ", " }
                    args_str = args_str + me.emit_expr(args.get(ai))
                    ai = ai + 1
                }
            }
            return callee + "(" + args_str + ")"
        }

        if kind == "MethodCall" {
            local recv = me.emit_expr(expr.get("receiver"))
            local method = me.node_str(expr.get("method"))
            local args = expr.get("args")
            local args_str = ""
            if args != null {
                local ac = args.length()
                local ai = 0
                loop(ai < ac) {
                    if args_str != "" { args_str = args_str + ", " }
                    args_str = args_str + me.emit_expr(args.get(ai))
                    ai = ai + 1
                }
            }
            return recv + "." + method + "(" + args_str + ")"
        }

        return "/* TODO: " + kind + " */"
    }

    // ── JSON node helpers ───────────────────────────────

    // Extract string value from a JsonNode (handles string/int/bool nodes)
    node_str(node) {
        if node == null { return "" }
        local kind = node.get_kind()
        if kind == "string" { return node.as_string() }
        if kind == "int" { return "" + node.as_int() }
        if kind == "bool" {
            if node.as_bool() { return "true" }
            return "false"
        }
        if kind == "null" { return "" }
        return node.stringify()
    }
}

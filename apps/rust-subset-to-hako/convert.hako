// convert.hako — RustSubset JSON v0 -> .hako skeleton converter
// .hako native implementation (matches Python convert.py behavior for v0)
//
// Pipeline:
//   embedded RustSubset JSON v0 fixture
//   -> JsonParserUtils.parse_json(text)
//   -> navigate items -> emit .hako skeleton
//   -> print(result)
//
// Usage:
//   ./target/release/hakorune --backend vm apps/rust-subset-to-hako/convert.hako
//   (uses the embedded simple_subset.json fixture for the first AOT slice)

using apps.lib.json_native.parser.parser as JsonParserUtils

static box Main {
    main() {
        local converter = new RustSubsetConverter()
        local text = converter.sample_json()
        local result = converter.convert(text)
        print(result)
        return 0
    }
}

box RustSubsetConverter {
    sample_json() {
        return "{\"schema_version\":0,\"kind\":\"RustSubsetModule\",\"module\":\"simple\",\"items\":[{\"kind\":\"Struct\",\"name\":\"Point\",\"identity\":false,\"fields\":[{\"name\":\"x\",\"type\":\"i64\"},{\"name\":\"y\",\"type\":\"i64\"}]},{\"kind\":\"Impl\",\"target\":\"Point\",\"methods\":[{\"kind\":\"Function\",\"name\":\"len2\",\"receiver\":\"self_ref\",\"params\":[],\"return_type\":\"i64\",\"body\":[{\"kind\":\"Return\",\"value\":{\"kind\":\"Binary\",\"op\":\"+\",\"left\":{\"kind\":\"Binary\",\"op\":\"*\",\"left\":{\"kind\":\"Field\",\"base\":{\"kind\":\"Name\",\"name\":\"self\"},\"field\":\"x\"},\"right\":{\"kind\":\"Field\",\"base\":{\"kind\":\"Name\",\"name\":\"self\"},\"field\":\"x\"}},\"right\":{\"kind\":\"Binary\",\"op\":\"*\",\"left\":{\"kind\":\"Field\",\"base\":{\"kind\":\"Name\",\"name\":\"self\"},\"field\":\"y\"},\"right\":{\"kind\":\"Field\",\"base\":{\"kind\":\"Name\",\"name\":\"self\"},\"field\":\"y\"}}}}]}]},{\"kind\":\"Function\",\"name\":\"add\",\"params\":[{\"name\":\"a\",\"type\":\"i64\"},{\"name\":\"b\",\"type\":\"i64\"}],\"return_type\":\"i64\",\"body\":[{\"kind\":\"Return\",\"value\":{\"kind\":\"Binary\",\"op\":\"+\",\"left\":{\"kind\":\"Name\",\"name\":\"a\"},\"right\":{\"kind\":\"Name\",\"name\":\"b\"}}}]}]}"
    }

    // ── main entry ──────────────────────────────────────

    convert(json_text) {
        local doc = JsonParserUtils.parse_json(json_text)
        if doc == null {
            return "// parse error"
        }

        // Validate schema_version
        local sv = doc.get_node("schema_version")
        if sv == null {
            return "// error: missing schema_version"
        }

        local items = doc.get_node("items")
        if items == null {
            return "// empty module"
        }

        local item_count = items.length()
        local output = ""
        local i = 0

        loop(i < item_count) {
            local item = items.get_node(i)
            local item_text = me.emit_item(item)
            if output != "" {
                output = output + "\n\n"
            }
            output = output + item_text
            i = i + 1
        }

        return output
    }

    // ── item emitters ───────────────────────────────────

    emit_item(item) {
        local kind = me.node_str(item.get_node("kind"))
        if kind == "Struct" {
            return me.emit_struct(item)
        }
        if kind == "Enum" {
            return me.emit_enum(item)
        }
        if kind == "Impl" {
            return me.emit_impl(item)
        }
        if kind == "Function" {
            return me.emit_function(item, "")
        }
        return "// TODO: " + kind
    }

    emit_struct(item) {
        local name = me.node_str(item.get_node("name"))
        local identity = me.node_str(item.get_node("identity"))
        local keyword = "record"
        if identity == "true" {
            keyword = "box"
        }

        local fields = item.get_node("fields")
        local body = ""
        if fields != null {
            local fc = fields.length()
            local fi = 0
            loop(fi < fc) {
                local field = fields.get_node(fi)
                local fname = me.node_str(field.get_node("name"))
                local ftype = me.node_str(field.get_node("type"))
                body = body + "    " + fname + ": " + ftype
                fi = fi + 1
                if fi < fc {
                    body = body + "\n"
                }
            }
        }

        return keyword + " " + name + " {\n" + body + "\n}"
    }

    emit_enum(item) {
        local name = me.node_str(item.get_node("name"))
        local result = "// enum " + name
        local variants = item.get_node("variants")
        if variants != null {
            local vc = variants.length()
            local vi = 0
            loop(vi < vc) {
                local variant = variants.get_node(vi)
                local vname = me.node_str(variant.get_node("name"))
                result = result + "\n//   " + vname
                vi = vi + 1
            }
        }
        return result
    }

    emit_impl(item) {
        local target = me.node_str(item.get_node("target"))
        local methods = item.get_node("methods")
        local result = ""
        if methods != null {
            local mc = methods.length()
            local mi = 0
            loop(mi < mc) {
                local method = methods.get_node(mi)
                result = result + me.emit_function(method, target)
                mi = mi + 1
                if mi < mc {
                    result = result + "\n\n"
                }
            }
        }
        return result
    }

    emit_function(func, target_prefix) {
        local name = me.node_str(func.get_node("name"))
        if target_prefix != "" {
            name = target_prefix + "_" + name
        }

        // Build params
        local params = ""

        // Receiver: self_ref/self_mut/self_value -> me: TargetType
        local receiver = me.node_str(func.get_node("receiver"))
        if receiver != "none" && receiver != "" && target_prefix != "" {
            params = "me: " + target_prefix
        }

        // Explicit params
        local param_arr = func.get_node("params")
        if param_arr != null {
            local pc = param_arr.length()
            local pi = 0
            loop(pi < pc) {
                local p = param_arr.get_node(pi)
                local pname = me.node_str(p.get_node("name"))
                local ptype = me.node_str(p.get_node("type"))
                if params != "" { params = params + ", " }
                params = params + pname + ": " + ptype
                pi = pi + 1
            }
        }

        // Return type
        local return_type = me.node_str(func.get_node("return_type"))
        if return_type == "" { return_type = "void" }

        // Body
        local body_arr = func.get_node("body")
        local body = ""
        if body_arr != null {
            local bc = body_arr.length()
            local bi = 0
            loop(bi < bc) {
                local stmt = body_arr.get_node(bi)
                body = body + "    " + me.emit_stmt(stmt)
                bi = bi + 1
                if bi < bc { body = body + "\n" }
            }
        }
        if body == "" { body = "    // empty body" }

        return "function " + name + "(" + params + "): " + return_type + " {\n" + body + "\n}"
    }

    // ── statement emitter ───────────────────────────────

    emit_stmt(stmt) {
        local kind = me.node_str(stmt.get_node("kind"))

        if kind == "Return" {
            local val = stmt.get_node("value")
            if val != null {
                return "return " + me.emit_expr(val)
            }
            return "return"
        }

        if kind == "Let" {
            local lname = me.node_str(stmt.get_node("name"))
            local ltype = me.node_str(stmt.get_node("type"))
            local lval = stmt.get_node("value")
            return "local " + lname + ": " + ltype + " = " + me.emit_expr(lval)
        }

        if kind == "Expr" {
            return me.emit_expr(stmt.get_node("value"))
        }

        return "// TODO: " + kind
    }

    // ── expression emitter (recursive) ──────────────────

    emit_expr(expr) {
        if expr == null { return "null" }

        local kind = me.node_str(expr.get_node("kind"))

        if kind == "Literal" {
            return me.node_str(expr.get_node("value"))
        }

        if kind == "Name" {
            local n = me.node_str(expr.get_node("name"))
            if n == "self" { return "me" }
            return n
        }

        if kind == "Field" {
            local base = me.emit_expr(expr.get_node("base"))
            local field = me.node_str(expr.get_node("field"))
            return base + "." + field
        }

        if kind == "Binary" {
            local op = me.node_str(expr.get_node("op"))
            local left = me.emit_expr(expr.get_node("left"))
            local right = me.emit_expr(expr.get_node("right"))
            return left + " " + op + " " + right
        }

        if kind == "Call" {
            local callee = me.node_str(expr.get_node("callee"))
            local args = expr.get_node("args")
            local args_str = ""
            if args != null {
                local ac = args.length()
                local ai = 0
                loop(ai < ac) {
                    if args_str != "" { args_str = args_str + ", " }
                    args_str = args_str + me.emit_expr(args.get_node(ai))
                    ai = ai + 1
                }
            }
            return callee + "(" + args_str + ")"
        }

        if kind == "MethodCall" {
            local recv = me.emit_expr(expr.get_node("receiver"))
            local method = me.node_str(expr.get_node("method"))
            local args = expr.get_node("args")
            local args_str = ""
            if args != null {
                local ac = args.length()
                local ai = 0
                loop(ai < ac) {
                    if args_str != "" { args_str = args_str + ", " }
                    args_str = args_str + me.emit_expr(args.get_node(ai))
                    ai = ai + 1
                }
            }
            return recv + "." + method + "(" + args_str + ")"
        }

        return "/* TODO: " + kind + " */"
    }

    // ── JSON node helpers ───────────────────────────────

    // Extract string value from a JsonNode (handles string/int/bool nodes)
    node_str(node) {
        if node == null { return "" }
        local kind = node.get_kind()
        if kind == "string" { return node.as_string() }
        if kind == "int" { return "" + node.as_int() }
        if kind == "bool" {
            if node.as_bool() { return "true" }
            return "false"
        }
        if kind == "null" { return "" }
        return ""
    }
}

// hako-alloc-allocator-comparison-c-mimalloc-explicit-runner-execution-pilot-proof
// Purpose: prove MIMAP-451A explicit C mimalloc runner execution evidence ledger.

using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_execution_inventory_box as HakoAllocAllocatorComparisonCMimallocExecutionInventory
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_execution_diagnostic_box as HakoAllocAllocatorComparisonCMimallocExecutionDiagnostic
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_explicit_runner_execution_pilot_box as HakoAllocAllocatorComparisonCMimallocExplicitRunnerExecutionPilot

static box Main {
    makeReadyDiagnostic(): HakoAllocAllocatorComparisonCMimallocExecutionDiagnosticReport {
        local inventory_owner = new HakoAllocAllocatorComparisonCMimallocExecutionInventory()
        local diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocExecutionDiagnostic()
        local inventory = inventory_owner.inventoryAllocatorComparisonCMimallocExecution(1, 1, 1, 1, 1, 1, 1, 3)
        return diagnostic_owner.diagnoseAllocatorComparisonCMimallocExecution(inventory)
    }

    makeBlockedDiagnostic(): HakoAllocAllocatorComparisonCMimallocExecutionDiagnosticReport {
        local inventory_owner = new HakoAllocAllocatorComparisonCMimallocExecutionInventory()
        local diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocExecutionDiagnostic()
        local inventory = inventory_owner.inventoryAllocatorComparisonCMimallocExecution(0, 1, 1, 1, 1, 1, 1, 3)
        return diagnostic_owner.diagnoseAllocatorComparisonCMimallocExecution(inventory)
    }

    main(args) {
        local owner = new HakoAllocAllocatorComparisonCMimallocExplicitRunnerExecutionPilot()
        local diagnostic = Main.makeReadyDiagnostic()
        local accepted = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 1, 1, 0, 1, 1, 1, 64, 64, 33254, 4096)

        local missing_diagnostic = new HakoAllocAllocatorComparisonCMimallocExecutionDiagnosticReport()
        local missing_diag = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(missing_diagnostic, 1, 1, 0, 1, 1, 1, 64, 64, 33254, 4096)
        local blocked_diagnostic = Main.makeBlockedDiagnostic()
        local blocked_diag = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(blocked_diagnostic, 1, 1, 0, 1, 1, 1, 64, 64, 33254, 4096)
        local missing_runner = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 0, 1, 0, 1, 1, 1, 64, 64, 33254, 4096)
        local missing_output = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 1, 0, 0, 1, 1, 1, 64, 64, 33254, 4096)
        local missing_memory = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 1, 1, 0, 0, 1, 1, 64, 64, 33254, 4096)
        local missing_contract = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 1, 1, 0, 1, 0, 1, 64, 64, 33254, 4096)
        local failed_runner = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 1, 1, 12, 1, 1, 1, 64, 64, 33254, 4096)
        local invalid_run = owner.recordAllocatorComparisonCMimallocExplicitRunnerExecution(diagnostic, 1, 1, 0, 1, 1, 0, 64, 64, 33254, 4096)

        local ok = check "mimap451a allocator comparison c mimalloc explicit runner execution pilot" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "pilot present": accepted.execution_pilot_present == 1
            "diagnostic present": accepted.diagnostic_present == 1
            "diagnostic ready": accepted.diagnostic_ready == 1
            "runner invoked": accepted.explicit_runner_invoked == 1
            "output": accepted.explicit_runner_output_present == 1
            "result code": accepted.explicit_runner_result_code == 0
            "evidence": accepted.c_mimalloc_execution_evidence_present == 1
            "memory": accepted.memory_usage_evidence_present == 1
            "stable output": accepted.stable_output_contract_present == 1
            "run count": accepted.run_count == 1
            "alloc count": accepted.allocation_count == 64
            "free count": accepted.free_count == 64
            "requested bytes": accepted.requested_bytes == 33254
            "peak rss": accepted.peak_rss_bytes == 4096
            "owner count": owner.pilot_count == 9
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 8
            "owner missing diag": owner.missing_diagnostic_reject_count == 1
            "owner rejected diag": owner.rejected_diagnostic_reject_count == 1
            "owner missing runner": owner.missing_runner_reject_count == 1
            "owner missing output": owner.missing_output_reject_count == 1
            "owner missing memory": owner.missing_memory_evidence_reject_count == 1
            "owner missing contract": owner.missing_output_contract_reject_count == 1
            "owner failed": owner.failed_runner_reject_count == 1
            "owner invalid": owner.invalid_run_count_reject_count == 1
            "last reason": owner.last_reason == 8
            "missing diag reason": missing_diag.reason == 1
            "blocked diag reason": blocked_diag.reason == 2
            "missing runner reason": missing_runner.reason == 3
            "missing output reason": missing_output.reason == 4
            "missing memory reason": missing_memory.reason == 5
            "missing contract reason": missing_contract.reason == 6
            "failed reason": failed_runner.reason == 7
            "invalid reason": invalid_run.reason == 8
            "c mimalloc executed": accepted.c_mimalloc_executed == 1
            "process replacement": accepted.process_replacement_executed == 0
            "hook installed": accepted.hook_installed == 0
            "matcher added": accepted.backend_matcher_added == 0
            "global allocator": accepted.global_allocator_installed == 0
            "hidden discovery": accepted.hidden_discovery_used == 0
            "provider package": accepted.provider_package_generated == 0
            "would replace": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-allocator-comparison-c-mimalloc-explicit-runner-execution-pilot-proof")
        print("execution=" + accepted.accepted + "," + accepted.reason + "," + accepted.execution_pilot_present + "," + accepted.diagnostic_ready + "," + accepted.explicit_runner_invoked + "," + accepted.explicit_runner_output_present + "," + accepted.memory_usage_evidence_present + "," + accepted.stable_output_contract_present + "," + accepted.explicit_runner_result_code + "," + accepted.run_count + "," + accepted.allocation_count + "," + accepted.free_count + "," + accepted.requested_bytes + "," + accepted.peak_rss_bytes)
        print("owner=" + owner.pilot_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_diagnostic_reject_count + "," + owner.rejected_diagnostic_reject_count + "," + owner.missing_runner_reject_count + "," + owner.missing_output_reject_count + "," + owner.missing_memory_evidence_reject_count + "," + owner.missing_output_contract_reject_count + "," + owner.failed_runner_reject_count + "," + owner.invalid_run_count_reject_count + "," + owner.last_reason)
        print("closed=" + accepted.process_replacement_executed + "," + accepted.hook_installed + "," + accepted.backend_matcher_added + "," + accepted.global_allocator_installed + "," + accepted.hidden_discovery_used + "," + accepted.provider_package_generated + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing_diag.reason + "," + blocked_diag.reason + "," + missing_runner.reason + "," + missing_output.reason + "," + missing_memory.reason + "," + missing_contract.reason + "," + failed_runner.reason + "," + invalid_run.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

// hako-alloc-mimalloc-comparison-reuse-cycle-small-exe-proof
// Purpose: mirror a page-local small-block free/reacquire reuse cycle.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox

box HakoAllocMimallocComparisonReuseCycleSmallReport {
    workload_id: StringBox = "representative-reuse-cycle-small-v0"
    operation_family: StringBox = "reuse-cycle-small"
    operation_sequence_id: StringBox = "representative-reuse-cycle-small-v0-seq"
    free_order_id: StringBox = "even-odd-release-then-reacquire-v0"
    allocation_count: i64 = 128
    free_count: i64 = 128
    reuse_cycle_count: i64 = 0
    requested_bytes: i64 = 0
    committed_bytes: i64 = 0
    live_blocks: i64 = 0
    local_free_count: i64 = 0
    source_ops: i64 = 0
    rejects: i64 = 0
    peak_used: i64 = 0
    summary_status: StringBox = "fail"

    capture(page) {
        me.requested_bytes = page.requested_bytes
        me.committed_bytes = page.block_size * page.capacity
        me.live_blocks = page.used
        me.local_free_count = page.local_free_count
        me.source_ops = 0
        me.rejects = page.reject_count
        me.reuse_cycle_count = page.reuse_count
        me.peak_used = page.peak_used
        return 1
    }

    workloadLine() { return "workload=" + me.workload_id }
    operationFamilyLine() { return "operation_family=" + me.operation_family }
    operationSequenceLine() { return "operation_sequence_id=" + me.operation_sequence_id }
    freeOrderLine() { return "free_order_id=" + me.free_order_id }
    allocationCountLine() { return "allocation_count=" + me.allocation_count }
    freeCountLine() { return "free_count=" + me.free_count }
    reuseCycleCountLine() { return "reuse_cycle_count=" + me.reuse_cycle_count }
    pageLine() { return "page=" + me.allocation_count + "," + me.local_free_count + "," + me.peak_used + "," + me.requested_bytes + "," + me.committed_bytes + "," + me.rejects }
    requestedBytesLine() { return "requested_bytes=" + me.requested_bytes }
    summaryFieldsLine() { return "summary_fields=" + me.requested_bytes + "," + me.committed_bytes + "," + me.live_blocks + "," + me.local_free_count + "," + me.source_ops + "," + me.rejects }
    summaryLine() { return "summary=" + me.summary_status }
}

box ProofCheck {
    name: StringBox = ""
    passed: i64 = 1
    count: i64 = 0
    fail_count: i64 = 0

    birth(name) {
        me.name = name
    }

    expectEq(label, actual, expected) {
        me.count += 1
        if actual != expected {
            me.passed = 0
            me.fail_count += 1
            print("check.fail=" + me.name + ":" + label)
            return 0
        }
        return 1
    }

    ok() {
        return me.passed
    }
}

static box Main {
    allocateWave(page) {
        local i = 0
        local cycle = 0
        local ok = 1
        loop(i < 64) {
            local requested = 512 + cycle
            local block = page.acquire_usize(requested)
            if block < 0 {
                ok = 0
            }
            i += 1
            cycle += 1
            if cycle == 17 {
                cycle = 0
            }
        }
        return ok
    }

    releaseEvenOdd(page) {
        local released = 0
        local ok = 1
        loop(released < 64) {
            local released_ok = page.releaseLocal(released)
            if released_ok != 1 {
                ok = 0
            }
            released += 2
        }
        released = 1
        loop(released < 64) {
            local released_ok = page.releaseLocal(released)
            if released_ok != 1 {
                ok = 0
            }
            released += 2
        }
        return ok
    }

    main(args) {
        local report = new HakoAllocMimallocComparisonReuseCycleSmallReport()
        local page = new HakoAllocPageModel(0, 528, 64, 64)

        local first_alloc_ok = Main.allocateWave(page)
        local first_release_ok = Main.releaseEvenOdd(page)
        local reuse_ok = page.reuse()
        local second_alloc_ok = Main.allocateWave(page)
        local second_release_ok = Main.releaseEvenOdd(page)

        local committed_bytes = page.block_size * page.capacity
        local live_blocks = page.used
        local source_ops = 0
        local rejects = page.reject_count

        report.capture(page)

        print("hako-alloc-mimalloc-comparison-reuse-cycle-small-exe-proof")
        print(report.workloadLine())
        print(report.operationFamilyLine())
        print(report.operationSequenceLine())
        print(report.freeOrderLine())
        print(report.reuseCycleCountLine())
        print(report.pageLine())
        print(report.requestedBytesLine())
        print(report.summaryFieldsLine())

        local proof = new ProofCheck("reuse-cycle small-block comparison")
        proof.expectEq("first alloc ok", first_alloc_ok, 1)
        proof.expectEq("first release ok", first_release_ok, 1)
        proof.expectEq("reuse ok", reuse_ok, 1)
        proof.expectEq("second alloc ok", second_alloc_ok, 1)
        proof.expectEq("second release ok", second_release_ok, 1)
        proof.expectEq("alloc count", page.alloc_count, 128)
        proof.expectEq("release count", page.local_free_count, 128)
        proof.expectEq("requested bytes", page.requested_bytes, 66508)
        proof.expectEq("committed bytes", committed_bytes, 33792)
        proof.expectEq("peak used", page.peak_used, 64)
        proof.expectEq("live blocks", page.used, 0)
        proof.expectEq("reuse count", page.reuse_count, 1)
        proof.expectEq("rejects", page.reject_count, 0)
        proof.expectEq("retired", page.retired, 1)

        local ok = proof.ok()
        print("check=" + ok)
        if ok == 1 {
            report.summary_status = "ok"
            print(report.summaryLine())
            return 0
        }
        print(report.summaryLine())
        return 1
    }
}

        local missing_pilot = new HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPilotReport()
        local missing = presentation_owner.pilotAllocatorComparisonCMimallocResultPresentationOnlyConclusion(missing_pilot)

        local blocked_pilot = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeBlockedFirstConclusionPilot()
        local blocked = presentation_owner.pilotAllocatorComparisonCMimallocResultPresentationOnlyConclusion(blocked_pilot)

        local missing_input_pilot = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeAcceptedFirstConclusionPilot()
        missing_input_pilot.provisional_memory_conclusion_present = 0
        local missing_input = presentation_owner.pilotAllocatorComparisonCMimallocResultPresentationOnlyConclusion(missing_input_pilot)

        local closed_stop_pilot = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeAcceptedFirstConclusionPilot()
        closed_stop_pilot.repeated_benchmark_executed = 1
        local closed_stop = presentation_owner.pilotAllocatorComparisonCMimallocResultPresentationOnlyConclusion(closed_stop_pilot)

        local ok = check "mimap474a allocator comparison c mimalloc result presentation-only conclusion pilot" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "presentation": accepted.presentation_present == 1
            "conclusion": accepted.conclusion_present == 1
            "pilot": accepted.pilot_present == 1
            "accepted pilot": accepted.accepted_pilot_present == 1
            "blocked pilot": accepted.blocked_pilot_present == 0
            "memory conclusion": accepted.provisional_memory_conclusion_present == 1
            "memory winner": accepted.provisional_memory_winner == 1
            "memory reason": accepted.provisional_memory_reason == 1
            "comparison available": accepted.comparison_available == 1
            "memory evidence": accepted.memory_evidence_present == 1
            "hako alloc": accepted.hako_allocation_count == 3
            "hako bytes": accepted.hako_requested_bytes == 72
            "c alloc": accepted.c_allocation_count == 64
            "c bytes": accepted.c_requested_bytes == 33254
            "c rss": accepted.c_peak_rss_bytes == 4096
            "alloc delta": accepted.allocation_count_delta == 61
            "bytes delta": accepted.requested_bytes_delta == 33182
            "owner count": presentation_owner.presentation_count == 5
            "owner accepted": presentation_owner.accepted_count == 1
            "owner blocked": presentation_owner.blocked_count == 4
            "owner missing pilot": presentation_owner.missing_pilot_reject_count == 1
            "owner blocked pilot": presentation_owner.blocked_pilot_reject_count == 1
            "owner missing input": presentation_owner.missing_presentation_input_reject_count == 1
            "owner closed stop": presentation_owner.closed_stop_line_reject_count == 1
            "last reason": presentation_owner.last_reason == 4
            "missing reason": missing.reason == 1
            "blocked reason": blocked.reason == 2
            "missing input reason": missing_input.reason == 3
            "closed reason": closed_stop.reason == 4
            "missing flag": missing.accepted == 0
            "blocked flag": blocked.accepted == 0
            "missing input flag": missing_input.accepted == 0
            "closed flag": closed_stop.accepted == 0
            "missing blocked pilot": missing.blocked_pilot_present == 0
            "blocked pilot flag": blocked.blocked_pilot_present == 1
            "missing input blocked pilot": missing_input.blocked_pilot_present == 1
            "closed blocked pilot": closed_stop.blocked_pilot_present == 1
            "no perf made": accepted.performance_conclusion_made == 0
            "no memory made": accepted.memory_conclusion_made == 0
            "no repeated benchmark": accepted.repeated_benchmark_executed == 0
            "process replacement": accepted.process_replacement_executed == 0
            "hook installed": accepted.hook_installed == 0
            "matcher added": accepted.backend_matcher_added == 0
            "global allocator": accepted.global_allocator_installed == 0
            "hidden discovery": accepted.hidden_discovery_used == 0
            "provider package": accepted.provider_package_generated == 0
            "would replace": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-allocator-comparison-c-mimalloc-result-presentation-only-conclusion-pilot-proof")
        print("presentation=" + accepted.accepted + "," + accepted.reason + "," + accepted.presentation_present + "," + accepted.conclusion_present + "," + accepted.pilot_present + "," + accepted.accepted_pilot_present + "," + accepted.blocked_pilot_present + "," + accepted.provisional_memory_conclusion_present + "," + accepted.provisional_memory_winner + "," + accepted.provisional_memory_reason)
        print("metrics=" + accepted.hako_allocation_count + "," + accepted.hako_requested_bytes + "," + accepted.c_allocation_count + "," + accepted.c_requested_bytes + "," + accepted.c_peak_rss_bytes + "," + accepted.allocation_count_delta + "," + accepted.requested_bytes_delta)
        print("owner=" + presentation_owner.presentation_count + "," + presentation_owner.accepted_count + "," + presentation_owner.blocked_count + "," + presentation_owner.missing_pilot_reject_count + "," + presentation_owner.blocked_pilot_reject_count + "," + presentation_owner.missing_presentation_input_reject_count + "," + presentation_owner.closed_stop_line_reject_count + "," + presentation_owner.last_reason)
        print("blocked=" + missing.accepted + "," + blocked.accepted + "," + missing_input.accepted + "," + closed_stop.accepted)
        print("closed=" + accepted.performance_conclusion_made + "," + accepted.memory_conclusion_made + "," + accepted.repeated_benchmark_executed + "," + accepted.process_replacement_executed + "," + accepted.hook_installed + "," + accepted.backend_matcher_added + "," + accepted.global_allocator_installed + "," + accepted.hidden_discovery_used + "," + accepted.provider_package_generated + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + blocked.reason + "," + missing_input.reason + "," + closed_stop.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0

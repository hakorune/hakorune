static box Main {
    main(args) {
        local presentation_owner = new HakoAllocAllocatorComparisonCMimallocResultPresentationOnlyConclusionPilot()

        local accepted_pilot = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeAcceptedFirstConclusionPilot()

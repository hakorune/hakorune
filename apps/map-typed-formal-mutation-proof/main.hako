using "apps.proofs.map_typed_formal_mutation_storage_command" as TypedMapMutationCommandV1

box TypedMapFieldOwnerV1 {
    storage: MapBox

    birth() {
        me.storage = new MapBox()
    }

    put(value_id, payload) {
        TypedMapMutationCommandV1.put_proven(
            me.storage,
            value_id,
            payload
        )
        return
    }

    put_after_validation(value_id, payload, enabled) {
        if enabled == 0 {
            return 0
        }
        if value_id < 0 {
            return 0
        }

        local storage = me.storage
        TypedMapMutationCommandV1.put_proven(
            storage,
            value_id,
            payload
        )
        return 1
    }

    contains_direct(value_id, expected) {
        local key = "" + value_id
        if me.storage.has(key) {
            if me.storage.get(key) == expected {
                return 1
            }
        }
        return 0
    }

    contains_helper(value_id, expected) {
        return TypedMapMutationCommandV1.contains(
            me.storage,
            value_id,
            expected
        )
    }
}

static box Main {
    case_local_direct() {
        local storage = new MapBox()
        TypedMapMutationCommandV1.put_proven(storage, 1, 10)
        if storage.has("1") {
            if storage.get("1") == 10 {
                return 1
            }
        }
        return 0
    }

    case_local_helper() {
        local storage = new MapBox()
        TypedMapMutationCommandV1.put_proven(storage, 2, 10)
        return TypedMapMutationCommandV1.contains(storage, 2, 10)
    }

    case_field_direct() {
        local owner = new TypedMapFieldOwnerV1()
        owner.put(3, 10)
        return owner.contains_direct(3, 10)
    }

    case_field_helper() {
        local owner = new TypedMapFieldOwnerV1()
        owner.put(4, 10)
        return owner.contains_helper(4, 10)
    }

    case_late_field_direct() {
        local owner = new TypedMapFieldOwnerV1()
        if owner.put_after_validation(5, 10, 1) == 0 {
            return 0
        }
        return owner.contains_direct(5, 10)
    }

    case_late_field_helper() {
        local owner = new TypedMapFieldOwnerV1()
        if owner.put_after_validation(6, 10, 1) == 0 {
            return 0
        }
        return owner.contains_helper(6, 10)
    }

    case_repeated() {
        local owner = new TypedMapFieldOwnerV1()
        owner.put(7, 10)
        owner.put(7, 20)
        if owner.contains_direct(7, 20) == 1 {
            return owner.contains_helper(7, 20)
        }
        return 0
    }

    case_instance_isolation() {
        local owner_a = new TypedMapFieldOwnerV1()
        local owner_b = new TypedMapFieldOwnerV1()
        owner_a.put(8, 10)
        if owner_a.contains_helper(8, 10) == 1 {
            return 1 - owner_b.contains_direct(8, 10)
        }
        return 0
    }

    case_two_file_transport() {
        local storage = new MapBox()
        TypedMapMutationCommandV1.put_proven(storage, 9, 10)
        return TypedMapMutationCommandV1.contains(storage, 9, 10)
    }

    case_negative_then_fresh() {
        local empty_owner = new TypedMapFieldOwnerV1()
        if empty_owner.contains_helper(10, 10) != 0 {
            return 0
        }

        local fresh_owner = new TypedMapFieldOwnerV1()
        fresh_owner.put(10, 10)
        return fresh_owner.contains_helper(10, 10)
    }

    main(args) {
        local p1 = Main.case_local_direct()
        local p2 = Main.case_local_helper()
        local p3 = Main.case_field_direct()
        local p4 = Main.case_field_helper()
        local p5 = Main.case_late_field_direct()
        local p6 = Main.case_late_field_helper()
        local p7 = Main.case_repeated()
        local p8 = Main.case_instance_isolation()
        local p9 = Main.case_two_file_transport()
        local p10 = Main.case_negative_then_fresh()

        print("map-typed-formal-mutation-proof")
        print("case.local_direct=" + p1)
        print("case.local_helper=" + p2)
        print("case.field_direct=" + p3)
        print("case.field_helper=" + p4)
        print("case.late_field_direct=" + p5)
        print("case.late_field_helper=" + p6)
        print("case.repeated=" + p7)
        print("case.instance_isolation=" + p8)
        print("case.two_file_transport=" + p9)
        print("case.negative_then_fresh=" + p10)
        print("selection=UNCLASSIFIED-S0")
        print("summary=observed")
        return 0
    }
}

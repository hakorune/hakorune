// hako-alloc-provider-call-external-api-adapter-inventory-proof
// Purpose: prove MIMAP-400A provider-call external API adapter inventory.

using selfhost.hako_alloc.memory.provider_call_real_api_stub_execution_pilot_box as HakoAllocProviderCallRealApiStubExecutionPilot
using selfhost.hako_alloc.memory.provider_call_external_api_adapter_inventory_box as HakoAllocProviderCallExternalApiAdapterInventory

static box Main {
    makeStub(): HakoAllocProviderCallRealApiStubExecutionPilotReport {
        local report = new HakoAllocProviderCallRealApiStubExecutionPilotReport {
            accepted: 1,
            reason: 0,
            stub_execution_present: 1,
            preflight_present: 1,
            preflight_accepted: 1,
            preflight_reason: 0,
            provider_api_call_ready: 1,
            provider_api_call_capability_present: 1,
            provider_api_call_capability_valid: 1,
            provider_call_stub_execution_open: 1,
            provider_api_stub_call_executed: 1,
            provider_api_call_result_present: 1,
            provider_api_call_result_code: 0,
            actual_provider_api_call_executed: 0,
            provider_call_execution_closed: 1,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_inactive: 1,
            execution_count: 1,
            accepted_count: 1,
            reject_count: 0,
            missing_preflight_reject_count: 0,
            rejected_preflight_reject_count: 0,
            not_ready_reject_count: 0,
            already_executed_reject_count: 0,
            closed_execution_reject_count: 0,
            closed_host_replacement_reject_count: 0,
            closed_hook_reject_count: 0,
            closed_backend_matcher_reject_count: 0,
            last_reason: 0,
            would_activate_provider: 1,
            would_call_provider: 1,
            would_execute_provider_api: 1,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return report
    }

    main(args) {
        local owner = new HakoAllocProviderCallExternalApiAdapterInventory()
        local stub = Main.makeStub()
        local accepted = owner.inventoryProviderCallExternalApiAdapter(stub, 1, 1)

        local missing_stub = new HakoAllocProviderCallRealApiStubExecutionPilotReport()
        local missing = owner.inventoryProviderCallExternalApiAdapter(missing_stub, 1, 1)

        local rejected_stub = Main.makeStub()
        rejected_stub.accepted = 0
        rejected_stub.reason = 2
        local rejected = owner.inventoryProviderCallExternalApiAdapter(rejected_stub, 1, 1)

        local missing_adapter = owner.inventoryProviderCallExternalApiAdapter(stub, 0, 1)
        local invalid_adapter = owner.inventoryProviderCallExternalApiAdapter(stub, 1, 0)

        local already_executed = Main.makeStub()
        already_executed.actual_provider_api_call_executed = 1
        local already_executed_result = owner.inventoryProviderCallExternalApiAdapter(already_executed, 1, 1)

        local execution_closed = Main.makeStub()
        execution_closed.provider_api_stub_call_executed = 0
        local execution_closed_result = owner.inventoryProviderCallExternalApiAdapter(execution_closed, 1, 1)

        local host_leak = Main.makeStub()
        host_leak.would_replace_host_allocator = 1
        local host_rejected = owner.inventoryProviderCallExternalApiAdapter(host_leak, 1, 1)

        local hook_leak = Main.makeStub()
        hook_leak.would_install_hook = 1
        local hook_rejected = owner.inventoryProviderCallExternalApiAdapter(hook_leak, 1, 1)

        local matcher_leak = Main.makeStub()
        matcher_leak.would_add_backend_matcher = 1
        local matcher_rejected = owner.inventoryProviderCallExternalApiAdapter(matcher_leak, 1, 1)

        local ok = check "mimap400a provider call external api adapter inventory" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "adapter inventory": accepted.adapter_inventory_present == 1
            "stub present": accepted.stub_execution_present == 1
            "stub accepted": accepted.stub_execution_accepted == 1
            "stub executed": accepted.provider_api_stub_call_executed == 1
            "stub result": accepted.provider_api_call_result_present == 1
            "actual api closed": accepted.actual_provider_api_call_executed == 0
            "adapter present": accepted.external_provider_adapter_present == 1
            "adapter valid": accepted.external_provider_adapter_valid == 1
            "external ready": accepted.external_provider_api_call_ready == 1
            "external not executed": accepted.external_provider_api_call_executed == 0
            "host inactive": accepted.host_replacement_inactive == 1
            "hooks inactive": accepted.hooks_inactive == 1
            "matcher inactive": accepted.backend_matcher_inactive == 1
            "owner count": owner.inventory_count == 10
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 9
            "owner missing": owner.missing_stub_reject_count == 1
            "owner rejected stub": owner.rejected_stub_reject_count == 1
            "owner missing adapter": owner.missing_adapter_reject_count == 1
            "owner invalid adapter": owner.invalid_adapter_reject_count == 1
            "owner already executed": owner.already_executed_reject_count == 1
            "owner execution closed": owner.closed_execution_reject_count == 1
            "owner host closed": owner.closed_host_replacement_reject_count == 1
            "owner hook closed": owner.closed_hook_reject_count == 1
            "owner matcher closed": owner.closed_backend_matcher_reject_count == 1
            "last reason": owner.last_reason == 9
            "missing reason": missing.reason == 1
            "rejected reason": rejected.reason == 2
            "missing adapter reason": missing_adapter.reason == 3
            "invalid adapter reason": invalid_adapter.reason == 4
            "already executed reason": already_executed_result.reason == 5
            "execution reason": execution_closed_result.reason == 6
            "host reason": host_rejected.reason == 7
            "hook reason": hook_rejected.reason == 8
            "matcher reason": matcher_rejected.reason == 9
            "would activate": accepted.would_activate_provider == 1
            "would call": accepted.would_call_provider == 1
            "would api": accepted.would_execute_provider_api == 1
            "would external": accepted.would_call_external_provider_api == 1
            "would host": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-provider-call-external-api-adapter-inventory-proof")
        print("adapter=" + accepted.accepted + "," + accepted.reason + "," + accepted.adapter_inventory_present + "," + accepted.external_provider_adapter_present + "," + accepted.external_provider_adapter_valid + "," + accepted.external_provider_api_call_ready + "," + accepted.external_provider_api_call_executed)
        print("stub=" + accepted.stub_execution_present + "," + accepted.stub_execution_accepted + "," + accepted.stub_execution_reason + "," + accepted.provider_api_stub_call_executed + "," + accepted.provider_api_call_result_present + "," + accepted.actual_provider_api_call_executed)
        print("owner=" + owner.inventory_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_stub_reject_count + "," + owner.rejected_stub_reject_count + "," + owner.missing_adapter_reject_count + "," + owner.invalid_adapter_reject_count + "," + owner.already_executed_reject_count + "," + owner.closed_execution_reject_count + "," + owner.closed_host_replacement_reject_count + "," + owner.closed_hook_reject_count + "," + owner.closed_backend_matcher_reject_count + "," + owner.last_reason)
        print("closed=" + accepted.host_replacement_inactive + "," + accepted.hooks_inactive + "," + accepted.backend_matcher_inactive + "," + accepted.would_activate_provider + "," + accepted.would_call_provider + "," + accepted.would_execute_provider_api + "," + accepted.would_call_external_provider_api + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + rejected.reason + "," + missing_adapter.reason + "," + invalid_adapter.reason + "," + already_executed_result.reason + "," + execution_closed_result.reason + "," + host_rejected.reason + "," + hook_rejected.reason + "," + matcher_rejected.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

enum InnerKind {
    A
    B
}

static box TypeLikeApi {
    get_kind(map, key): Option<InnerKind> {
        if map.has(key) {
            return Option::Some(map.get(key))
        }
        return Option::None()
    }
}

static box ProbeApi {
    is_b(value: Option<InnerKind>): i64 {
        guard let Option::Some(inner) = value else {
            return 9
        }
        if inner == InnerKind::B() {
            return 1
        }
        return 0
    }
}

static box Main {
    main() {
        local map = new MapBox()
        map.set("k", InnerKind::B())
        local value = TypeLikeApi.get_kind(map, "k")
        if ProbeApi.is_b(value) != 1 {
            print("boxed_enum_option_map_roundtrip=fail")
            return 1
        }
        print("boxed_enum_option_map_roundtrip=ok")
        return 0
    }
}

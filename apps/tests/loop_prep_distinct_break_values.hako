static box Main {
    pick(early: i64): i64 {
        local i = 0
        local value = 0
        loop(i < 3) {
            if i == early {
                value = 7
                break
            }
            if i == 2 {
                value = 9
                break
            }
            i = i + 1
        }
        return value
    }

    main() {
        print(Main.pick(0))
        print(Main.pick(3))
        return 0
    }
}

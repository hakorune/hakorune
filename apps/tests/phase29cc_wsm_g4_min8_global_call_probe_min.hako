// Phase 29cc WSM-G4-min8 retired user-method probe
// Contract:
// - user-defined Box method call remains a canonical Method in Main
// - selected WASM profile rejects this unsupported family before WAT

box WsmProbeBox {
  ping(x) {
    return x + 1
  }
}

static box Main {
  main() {
    local probe = new WsmProbeBox()
    local y = probe.ping(41)
    return y
  }
}

using apps.lib.hakorune_mir_builder.binding_context as BindingContextNativeApi

static box Main {
    main() {
        local ctx = new BindingContextNative()
        if BindingContextNativeApi.is_empty(ctx) != 1 {
            print("binding_context_native_new_empty=fail")
            return 1
        }
        if BindingContextNativeApi.len(ctx) != 0 {
            print("binding_context_native_new_len=fail")
            return 2
        }

        BindingContextNativeApi.insert(ctx, "x", 0)
        if BindingContextNativeApi.lookup(ctx, "x") != 0 {
            print("binding_context_native_lookup_x=fail")
            return 3
        }
        if BindingContextNativeApi.contains(ctx, "x") != 1 {
            print("binding_context_native_contains_x=fail")
            return 4
        }

        if BindingContextNativeApi.remove(ctx, "x") != 0 {
            print("binding_context_native_remove_x=fail")
            return 5
        }
        if BindingContextNativeApi.lookup(ctx, "x") != null {
            print("binding_context_native_lookup_removed=fail")
            return 6
        }

        BindingContextNativeApi.insert(ctx, "b", 2)
        BindingContextNativeApi.insert(ctx, "a", 1)
        if BindingContextNativeApi.len(ctx) != 2 {
            print("binding_context_native_len_two=fail")
            return 7
        }
        if BindingContextNativeApi.lookup(ctx, "a") != 1 {
            print("binding_context_native_lookup_a=fail")
            return 8
        }
        if BindingContextNativeApi.lookup(ctx, "b") != 2 {
            print("binding_context_native_lookup_b=fail")
            return 9
        }

        BindingContextNativeApi.clear_for_function_entry(ctx)
        if BindingContextNativeApi.is_empty(ctx) != 1 {
            print("binding_context_native_clear_empty=fail")
            return 10
        }

        print("binding_context_native=ok")
        return 0
    }
}

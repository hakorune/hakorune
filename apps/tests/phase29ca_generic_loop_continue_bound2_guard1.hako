// Phase 29ca P3: generic loop v0.1 continue bound/guard variant
// Expect: return 2 (catches an incorrect extra normal update that would yield 3)

static box Main {
    main() {
        local i = 0
        local n = 2
        loop(i < n) {
            if i == 1 {
                i = i + 1
                continue
            }
            i = i + 1
        }
        return i
    }
}

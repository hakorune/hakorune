static box Main {
    find_ok(s: StringBox, ch: StringBox) {
        local i: i64 = 0
        loop(i < s.length()) {
            if s.substring(i, i + 1) == ch {
                return i
            }
            i = i + 1
        }
        return -1
    }

    main() {
        return Main.find_ok("abc", "b")
    }
}

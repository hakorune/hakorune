// Phase 29ca P3: generic loop v0.1 continue zero-iteration variant
// Expect: return 0 — the loop body never runs

static box Main {
    main() {
        local i = 0
        local n = 0
        loop(i < n) {
            if i == 1 {
                i = i + 1
                continue
            }
            i = i + 1
        }
        return i
    }
}

// Phase 29ca P3: generic loop v0.1 continue renamed-locals variant
// Expect: return 4 — renamed locals preserve the same membership

static box Main {
    main() {
        local idx = 0
        local limit = 4
        loop(idx < limit) {
            if idx == 1 {
                idx = idx + 1
                continue
            }
            idx = idx + 1
        }
        return idx
    }
}

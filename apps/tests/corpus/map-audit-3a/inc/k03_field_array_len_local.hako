box Holder {
    items: ArrayBox
    birth() {
        me.items = new ArrayBox()
        me.items.push(1)
        me.items.push(2)
    }
    probe() {
        local n = me.items.length()
        return n
    }
}
static box Main {
    main() {
        local h = new Holder()
        return h.probe()
    }
}

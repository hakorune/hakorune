box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Node { name: StringBox  next: Leaf  v: i64  birth(name: StringBox, next, v: i64) { me.name = name  me.next = next  me.v = v } }
static box Main { main() { local leaf = new Leaf(1)  local n = new Node("abc", leaf, 5)  local k = n.v  return k } }

// callee receives a=5 and b=2; the second condition is true. Expected exit 27.
static box Main {
    compare(a, b) {
        if a < 3 { return 17 }
        if b < 3 { return 27 }
        return 11
    }
    forward(x, y) {
        return Main.compare(x, y)
    }
    main() {
        return Main.forward(5, 2)
    }
}

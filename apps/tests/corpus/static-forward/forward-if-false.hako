// small receives 5 in the condition and then in the outside return. Expected exit 0.
static box Main {
    small(v) {
        if v < 3 { return 1 }
        return 0
    }
    check(i) {
        if Main.small(i) == 1 { return Main.small(i) }
        return Main.small(i)
    }
    main() {
        return Main.check(5)
    }
}

box TreeNode {
    left: TreeNode?
    value: i64
    birth(left, value) {
        me.left = left
        me.value = value
    }
    check(): i64 {
        if me.left == null {
            return 1
        }
        return 2
    }
}
static box Main {
  main() {
    local n = new TreeNode(null, 5)
    local v = n.check()
    return v
  }
}

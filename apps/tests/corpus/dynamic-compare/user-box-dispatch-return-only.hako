box First {
  birth() { }
  score(value: i64): i64 {
    return value + 100
  }
}

box Second {
  birth() { }
  score(value: i64) {
    return value + 200
  }
}

box Dispatch {
  birth() { }
  forward(receiver): i64 {
    return receiver.score(40)
  }
}

static box Main {
  main() {
    local dispatcher = new Dispatch()
    local first = new First()
    local second = new Second()
    local a = dispatcher.forward(first)
    print(a)
    local b = dispatcher.forward(second)
    print(b)
    return 0
  }
}

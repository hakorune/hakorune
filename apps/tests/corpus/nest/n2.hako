box T {
    run(n) {
        local i = 0
        local s = 0
        loop(i < 3) {
            local j = 0
            loop(j < 2) {
                local k = 0
                loop(k < 2) {
                    s = s + 1
                    k = k + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        return s
    }
}
static box Main {
    main(args) {
        local t = new T()
        return t.run(5)
    }
}

box Pt {
    x: i64
    y: i64

    birth(x, y) {
        me.x = x
        me.y = y
    }

    itemCheck() {
        return me.x + me.y
    }
}

box Maker {
    make(depth, value) {
        return new Pt(value, depth)
    }
}

box Bench {
    builder: Maker
    n: i64

    birth() {
        me.builder = new Maker()
        me.n = 10000000
    }

    run(): i64 {
        local builder = me.builder
        local n = me.n
        local check = me.iterationCheck(builder, 0, n)
        print("check=" + check)
        return 0
    }

    iterationCheck(builder, depth, iterations) {
        local i = 1
        local sum = 0
        loop(i <= iterations) {
            local positive = builder.make(depth, i)
            sum = sum + positive.itemCheck()
            i = i + 1
        }
        return sum
    }
}

static box Main {
    main(args) {
        local bench = new Bench()
        return bench.run()
    }
}

box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Holder { l: Leaf  birth(take l: Leaf) { me.l = move l } }
box Node { next: Leaf  v: i64  birth(take next: Leaf, v: i64) { me.next = move next  me.v = v } }
box Plain { next: Leaf  v: i64  birth(next, v) { me.next = next  me.v = v } }
static box Main { mk(): Leaf { local leaf = new Leaf(1)  return move leaf }  main() { local r = Main.mk()  return 1 } }

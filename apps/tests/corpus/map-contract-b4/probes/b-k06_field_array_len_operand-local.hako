box Holder {
    items: ArrayBox
    birth() {
        me.items = new ArrayBox()
        me.items.push(1)
        me.items.push(2)
    }
    probe() {
        local b4ret0 = me.items.length() + 10; return b4ret0
    }
}
static box Main {
    main() {
        local h = new Holder()
        local b4ret1 = h.probe(); return b4ret1
    }
}

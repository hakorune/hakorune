box Holder {
    items: ArrayBox
    birth() {
        me.items = new ArrayBox()
        me.items.push(1)
        me.items.push(2)
    }
    probe() {
        if me.items.length() == 2 {
            return 1
        }
        return 0
    }
}
static box Main {
    main() {
        local h = new Holder()
        return h.probe()
    }
}

box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box T { x: Leaf  n: i64  birth(take x: Leaf) { me.x = move x  me.n = me.x.get() }  val(): i64 { return me.n } }
static box Main { main() { local l = new Leaf(4)  local t = new T(move l)  return t.val() } }

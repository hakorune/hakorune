box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box T { a: Leaf  birth(take x: Leaf) { me.a = move x }  val(): i64 { return me.a.get() } }
box O { t: T  birth(take t: T) { me.t = move t }  val(): i64 { return me.t.val() } }
static box Main { main() { local l = new Leaf(4)  local o = new O(new T(move l))  return o.val() } }

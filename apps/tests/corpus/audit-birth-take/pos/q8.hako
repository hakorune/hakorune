box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
  into(): i64 { return me.value }
}
box Holder { keep: Leaf  birth(take k: Leaf) { me.keep = move k } }
static box Main { main() { local x = new Leaf(1)  local h = new Holder(move x)  local y = new Leaf(2)  h.keep = move y  return 4 } }

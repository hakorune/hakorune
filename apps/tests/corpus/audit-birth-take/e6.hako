box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Node { next: Leaf  v: i64  birth(take next: Leaf) { me.next = next  me.v = 5 } }
static box Main { main() { local leaf = new Leaf(1)  local n = new Node(move leaf)  return n.next.value } }

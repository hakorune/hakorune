box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Pair { a: Leaf  b: Leaf  birth(take a: Leaf, b) { me.a = a  me.b = b } }
static box Main { main() { local x = new Leaf(1)  local p = new Pair(move x, new Leaf(2))  return 5 } }

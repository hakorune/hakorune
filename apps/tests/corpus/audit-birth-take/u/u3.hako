box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Node { next: Leaf  v: i64  birth(take next: Leaf, v: i64) { me.next = next  me.v = v } }
static box Main { eat(take x: Leaf): i64 { return 4 }  main() { local leaf = new Leaf(1)  local n = new Node(move leaf, 5)  return me.eat(move leaf) } }

box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Node {
  next: Leaf
  v: i64
  birth(take next: Leaf, v: i64) { me.next = next  me.v = v }
}
static box Main { main() { local leaf = new Leaf(1)  local i = 0  loop(i < 2) { local n = new Node(move leaf, 5)  i = i + 1 }  return 3 } }

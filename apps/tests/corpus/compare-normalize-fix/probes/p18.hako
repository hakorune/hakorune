box Leaf {
    v: i64
    birth(v) {
        me.v = v
    }
}
box Holder {
    leaf: Leaf
    birth(leaf) {
        me.leaf = leaf
    }
    probe(x): i64 {
        local a = 0
        if x > 1 {
            a = a + 1
        }
        if x > 2 {
            a = a + 2
        }
        if x > 3 {
            a = a + 3
        }
        if x > 4 {
            a = a + 4
        }
        if x > 5 {
            a = a + 5
        }
        if x > 6 {
            a = a + 6
        }
        if x > 7 {
            a = a + 7
        }
        if x > 8 {
            a = a + 8
        }
        if x > 9 {
            a = a + 9
        }
        if x > 10 {
            a = a + 10
        }
        if x > 11 {
            a = a + 11
        }
        if x > 12 {
            a = a + 12
        }
        if x > 13 {
            a = a + 13
        }
        if x > 14 {
            a = a + 14
        }
        if x > 15 {
            a = a + 15
        }
        if x > 16 {
            a = a + 16
        }
        if x > 17 {
            a = a + 17
        }
        if x > 18 {
            a = a + 18
        }
        if me.leaf == null {
            return a
        }
        return a + 1
    }
}
static box Main {
  main() {
    local h = new Holder(null)
    return h.probe(3)
  }
}

box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Node { a: Leaf  b: Leaf  v: i64  birth(take next: Leaf, v: i64) { me.a = move next  me.b = move next  me.v = v } }
static box Main { main() { local leaf = new Leaf(1)  local n = new Node(move leaf, 5)  return n.v } }

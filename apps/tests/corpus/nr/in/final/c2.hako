box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Node {
  next: Leaf
  v: i64
  birth(take next: Leaf, v: i64) { me.next = move next  me.v = v }
}
static box Main { f(take x: Leaf): i64 { local n = new Node(move x, 5)  return n.v }  main() { local leaf = new Leaf(1)  return me.f(move leaf) } }

box Leaf {
  value: i64
  birth(value) { me.value = value }
  get(): i64 { return me.value }
}
box Other {
  value: i64
  birth(value) { me.value = value }
}
box Node {
  next: Leaf
  v: i64
  birth(take next: Leaf, v: i64) { me.next = move next  me.v = v }
}
static box Main { later(): i64 { local scratch = new Other(1)  return 1 }  main() { local leaf = new Leaf(1)  local k = me.later()  local n = new Node(move leaf, k)  return n.v } }

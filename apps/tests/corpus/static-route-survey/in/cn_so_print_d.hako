box Leaf {
  value: i64
  birth(value: i64) {
    me.value = value
  }
  get(): i64 {
    return me.value
  }
}
box Ctx {
  birth() {
  }
}
static box Main {
  f(p: Leaf): String {
    return "abc"
  }
  main() {
    local z = new Ctx()
    local o = new Leaf(1)
    print(Main.f(o))
    return 0
  }
}

static box Main {
  even(n: i64) {
    if n == 0 { return true }
    return Main.odd(n - 1)
  }
  odd(n: i64) {
    if n == 0 { return false }
    return Main.even(n - 1)
  }
  main() {
    local b = Main.even(10)
    if b { print(1) } else { print(0) }
    local c = Main.even(7)
    if c { print(1) } else { print(0) }
    return 0
  }
}

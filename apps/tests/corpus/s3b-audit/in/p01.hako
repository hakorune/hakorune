box Leaf {
  value: i64
  birth(value: i64) {
    me.value = value
  }
  get(): i64 {
    return me.value
  }
}
box Node {
  next: Leaf
  v: i64
  birth(take next: Leaf, v: i64) {
    me.next = move next
    me.v = v
  }
  total(): i64 {
    return me.v + 1
  }
}
box Pair {
  a: Leaf
  b: Leaf
  birth(take a: Leaf, take b: Leaf) {
    me.a = move a
    me.b = move b
  }
}
static box Main {
  f(x: i64): i64 {
    return x + 2
  }
  main() {
    local leaf = new Leaf(1)
    local n = new Node(move leaf, Main.f(3))
    return n.v
  }
}

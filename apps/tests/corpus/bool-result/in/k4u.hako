static box P {
  t(x: i64) { if x > 1 { return true } return false }
}
box R { n: i64  birth() { me.n = 0 }
  run(x: i64) { local b = P.t(x)  if b { me.n = me.n + 1 } else { me.n = me.n + 10 }  return true } }
static box Main { main() { local r = new R()  r.run(4)  r.run(0)  print(r.n)  return 0 } }

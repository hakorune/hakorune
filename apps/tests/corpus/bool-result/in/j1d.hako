box C {
  k: i64
  birth() { me.k = 0 }
  t(s): Bool { if s == "a" { return true } return false }
}
box R {
  n: i64
  birth() { me.n = 0 }
  run(c, line) { local b = c.t(line)  if b { me.n = me.n + 1 } else { me.n = me.n + 10 }  return true }
}
static box Main { main() { local c = new C()  local r = new R()  r.run(c, "a")  r.run(c, "b")  print(r.n)  return 0 } }

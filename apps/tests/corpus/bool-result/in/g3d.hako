static box P {
  odd(s): Bool { if s == "" { return false } return P.even(s.substring(1, s.length())) }
  even(s): Bool { if s == "" { return true } return P.odd(s.substring(1, s.length())) }
}
box R {
  n: i64
  birth() { me.n = 0 }
  run(line) { local b = P.even(line)  if b { me.n = me.n + 1 } else { me.n = me.n + 10 }  return true }
}
static box Main { main() { local r = new R()  r.run("abcd")  r.run("abc")  print(r.n)  return 0 } }

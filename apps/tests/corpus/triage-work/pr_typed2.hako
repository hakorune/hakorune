
box ParamStore {
    birth() { }
    readData(cid: i64): i64 { return cid + 1 }
    release(cid: i64) { }
}
box ParamManifest {
    birth() { }
    materialize(store): i64 {
        local i = 0
        local out = 0
        loop(i < 2) {
            local data = store.readData(i)
            out = out + data
            i = i + 1
        }
        return out
    }
    releaseAll(store) {
        local i = 0
        loop(i < 2) {
            store.release(i)
            i = i + 1
        }
    }
}
static box Main {
    main() {
        local store = new ParamStore()
        local manifest = new ParamManifest()
        local a = manifest.materialize(store)
        local b = manifest.releaseAll(store)
        return 0
    }
}

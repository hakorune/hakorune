
box Inner {
    birth() { }
    work(i): i64 { return i + 1 }
}
box Outer {
    init { inner }
    birth() { me.inner = new Inner() }
    consume(inner): i64 {
        local i = 0
        local out = 0
        loop(i < 2) {
            local v = inner.work(i)
            out = out + v
            i = i + 1
        }
        return out
    }
    run(): i64 {
        local inner = me.inner
        return me.consume(inner)
    }
}
static box Main {
    main() {
        local o = new Outer()
        return o.run()
    }
}

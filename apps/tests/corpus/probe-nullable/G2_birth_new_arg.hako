box Leaf {
  value: i64
  birth(v) {
    me.value = v
  }
}
box Parent {
  empty: Leaf?
  child: Leaf?
  value: i64
  birth() {
    me.child = new Leaf(3)
    me.value = 5
  }
  check(): i64 {
    if me.empty == null {
      return me.value
    }
    return 2
  }
}
static box Main {
  main() {
    local p = new Parent()
    return p.check()
  }
}

box Leaf {
    v: i64
    birth(v) {
        me.v = v
    }
}
box Holder {
    leaf: Leaf
    birth(leaf) {
        me.leaf = leaf
    }
    probe(x): i64 {
        local a = 0
        if x > 1 {
            a = a
        }
        if x > 2 {
            a = a
        }
        if x > 3 {
            a = a
        }
        if x > 4 {
            a = a
        }
        if x > 5 {
            a = a
        }
        if x > 6 {
            a = a
        }
        if x > 7 {
            a = a
        }
        if x > 8 {
            a = a
        }
        if x > 9 {
            a = a
        }
        if x > 10 {
            a = a
        }
        if x > 11 {
            a = a
        }
        if x > 12 {
            a = a
        }
        if x > 13 {
            a = a
        }
        if x > 14 {
            a = a
        }
        if x > 15 {
            a = a
        }
        if x > 16 {
            a = a
        }
        if x > 17 {
            a = a
        }
        if x > 18 {
            a = a
        }
        if me.leaf == null {
            return a
        }
        return a + 1
    }
}
static box Main {
  main() {
    local h = new Holder(null)
    return h.probe(3)
  }
}

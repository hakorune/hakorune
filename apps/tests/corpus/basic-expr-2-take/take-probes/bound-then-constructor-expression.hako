box Leaf { value: i64 birth(v: i64) { me.value = v } get(): i64 { return me.value } }
box Label { text: String birth(text: String) { me.text = text } size(): i64 { return me.text.length() } }
static box Main {
 eat(take x: Leaf): i64 { return x.get() }
 label(take x: Label): i64 { return x.size() }
 main() { local a = new Leaf(4) return Main.eat(move a) + Main.label(new Label("a" + "b")) }
}

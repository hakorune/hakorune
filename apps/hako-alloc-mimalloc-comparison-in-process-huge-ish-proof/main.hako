// hako-alloc-mimalloc-comparison-in-process-huge-ish-proof
// Purpose: repeat the representative huge-ish workload inside one EXE process.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox
using selfhost.hako_alloc.memory.page_map_box as HakoAllocPageMapBox
using selfhost.hako_alloc.memory.huge_page_model_box as HakoAllocHugePageModelBox
using selfhost.hako_alloc.memory.huge_release_seam_box as HakoAllocHugeReleaseSeamBox

box ProofCheck {
    name: StringBox = ""
    passed: i64 = 1
    count: i64 = 0
    fail_count: i64 = 0

    birth(name) {
        me.name = name
    }

    expectEq(label, actual, expected) {
        me.count += 1
        if actual != expected {
            me.passed = 0
            me.fail_count += 1
            print("check.fail=" + me.name + ":" + label)
            return 0
        }
        return 1
    }

    ok() {
        return me.passed
    }
}

static box Main {
    runOne() {
        local huge_map = new HakoAllocPageMap()
        local huge_model = new HakoAllocHugePageModel(huge_map)
        local huge_release = new HakoAllocHugeReleaseSeam(huge_model)
        local huge_alloc = huge_model.allocateHuge(4194305, 4194305)
        local huge_ptr = huge_model.last_result_ptr
        local huge_release_ok = huge_release.releaseHugePtr(huge_ptr)

        local small_page = new HakoAllocPageModel(0, 16, 1, 1)
        local small_block = small_page.acquire_usize(16)
        local small_release = small_page.releaseLocal(small_block)

        if huge_alloc != 1 {
            return 0
        }
        if huge_release_ok != 1 {
            return 0
        }
        if small_block != 0 {
            return 0
        }
        if small_release != 1 {
            return 0
        }
        if huge_model.live_count != 0 {
            return 0
        }
        if small_page.used != 0 {
            return 0
        }
        return 1
    }

    main(args) {
        local operation_repeat = 128
        local repeat = 0
        local ok = 1
        local body_start_ms = env.now_ms()
        loop(repeat < operation_repeat) {
            local run_ok = Main.runOne()
            if run_ok != 1 {
                ok = 0
            }
            repeat += 1
        }
        local body_end_ms = env.now_ms()
        local body_elapsed_ms = body_end_ms - body_start_ms
        if body_elapsed_ms < 0 {
            body_elapsed_ms = 0
        }
        local body_elapsed_ns = body_elapsed_ms * 1000000

        local allocation_count = 2 * operation_repeat
        local free_count = 2 * operation_repeat
        local requested_bytes = 4194321 * operation_repeat
        local committed_bytes = 4194321 * operation_repeat
        local large_request_count = operation_repeat

        print("hako-alloc-mimalloc-comparison-in-process-huge-ish-proof")
        print("workload=representative-huge-ish-v0")
        print("operation_family=huge-ish")
        print("operation_sequence_id=representative-huge-ish-v0-seq")
        print("free_order_id=ascending-release-v0")
        print("in_process_operation_repeat=" + operation_repeat)
        print("timing_repeat_kind=in-process-operation-loop-v0")
        print("hako_body_timing_available=1")
        print("body_timing_repeat_kind=workload-body-env-now-ms-v0")
        print("body_timing_scope=allocator-workload-body")
        print("body_timing_is_process_timing=0")
        print("body_elapsed_ns=" + body_elapsed_ns)
        print("allocation_count=" + allocation_count)
        print("free_count=" + free_count)
        print("requested_bytes=" + requested_bytes)
        print("committed_bytes=" + committed_bytes)
        print("realloc_count=0")
        print("aligned_alloc_count=0")
        print("large_request_count=" + large_request_count)
        print("reuse_cycle_count=0")

        local proof = new ProofCheck("in-process huge-ish comparison")
        proof.expectEq("run ok", ok, 1)
        proof.expectEq("allocation count", allocation_count, 256)
        proof.expectEq("free count", free_count, 256)
        proof.expectEq("requested bytes", requested_bytes, 536873088)
        proof.expectEq("committed bytes", committed_bytes, 536873088)
        proof.expectEq("large request count", large_request_count, 128)

        print("check=" + proof.ok())
        if proof.ok() == 1 {
            print("summary=ok")
            return 0
        }
        print("summary=fail")
        return 1
    }
}

// hako-alloc-mimalloc-comparison-in-process-reset-only-proof
// Purpose: isolate HakoAllocPageModel.resetToFresh cost inside one EXE process.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox

box ProofCheck {
    name: StringBox = ""
    passed: i64 = 1
    count: i64 = 0
    fail_count: i64 = 0

    birth(name) {
        me.name = name
    }

    expectEq(label, actual, expected) {
        me.count += 1
        if actual != expected {
            me.passed = 0
            me.fail_count += 1
            print("check.fail=" + me.name + ":" + label)
            return 0
        }
        return 1
    }

    ok() {
        return me.passed
    }
}

static box Main {
    runOne(page) {
        local reset_ok = page.resetToFresh()
        if reset_ok != 1 {
            return 0
        }
        if page.used != 0 {
            return 0
        }
        if page.reject_count != 0 {
            return 0
        }
        if page.retired != 0 {
            return 0
        }
        return 1
    }

    main(args) {
        local operation_repeat = 8192
        local page = new HakoAllocPageModel(0, 528, 64, 64)
        local repeat = 0
        local ok = 1
        loop(repeat < operation_repeat) {
            local run_ok = Main.runOne(page)
            if run_ok != 1 {
                ok = 0
            }
            repeat += 1
        }

        print("hako-alloc-mimalloc-comparison-in-process-reset-only-proof")
        print("workload=representative-small-block-reset-only-v0")
        print("operation_family=small-block-phase-ablation")
        print("operation_sequence_id=representative-small-block-reset-only-v0-seq")
        print("free_order_id=none-v0")
        print("in_process_operation_repeat=" + operation_repeat)
        print("timing_repeat_kind=in-process-operation-loop-v0")
        print("allocation_count=0")
        print("free_count=0")
        print("requested_bytes=0")
        print("committed_bytes=0")
        print("realloc_count=0")
        print("aligned_alloc_count=0")
        print("large_request_count=0")
        print("reuse_cycle_count=0")

        local proof = new ProofCheck("in-process reset-only comparison")
        proof.expectEq("run ok", ok, 1)

        print("check=" + proof.ok())
        if proof.ok() == 1 {
            print("summary=ok")
            return 0
        }
        print("summary=fail")
        return 1
    }
}

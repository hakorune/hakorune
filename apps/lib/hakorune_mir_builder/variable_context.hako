using apps.lib.collections.ordered_map as OrderedMap

box VariableContextNative {
    variable_map: OrderedMapBox

    birth() {
        me.variable_map = OrderedMap.create()
    }
}

static box VariableContextNativeApi {
    snapshot(ctx: VariableContextNative): OrderedMapBox {
        return ctx.variable_map.clone_owned()
    }

    restore(ctx: VariableContextNative, snapshot: OrderedMapBox) {
        ctx.variable_map = snapshot.clone_owned()
    }

    is_empty(ctx): i64 {
        if ctx.variable_map.length() == 0 {
            return 1
        }
        return 0
    }

    len(ctx): i64 {
        return ctx.variable_map.length()
    }

    contains(ctx, name): i64 {
        if ctx.variable_map.has(name) == true {
            return 1
        }
        return 0
    }

    lookup(ctx, name) {
        return ctx.variable_map.get(name)
    }

    insert(ctx, name, value_id): i64 {
        ctx.variable_map.set(name, value_id)
        return 0
    }

    remove(ctx, name) {
        return ctx.variable_map.remove(name)
    }
}

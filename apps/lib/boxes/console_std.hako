// ConsoleStd — minimal standard console helpers (commonized API)

static box ConsoleStd {
  // print/println/log: convert null to "" and return 0
  print(x) {
    if x == null { x = "" }
    me.__console_std_emit(x)
    return 0
  }
  println(x) {
    if x == null { x = "" }
    me.__console_std_emit(x)
    return 0
  }
  log(x) {
    if x == null { x = "" }
    me.__console_std_emit(x)
    return 0
  }

  // Keep the language-level print call separate from ConsoleStd.print.
  __console_std_emit(value) {
    print(value)
    return 0
  }
}

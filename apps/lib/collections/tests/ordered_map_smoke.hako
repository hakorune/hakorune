using apps.lib.collections.ordered_map as OrderedMap

static box Main {
    main() {
        local m = OrderedMap.create()

        m.set("b", 20)
        m.set("a", 10)
        m.set("c", 30)

        if m.length() != 3 {
            print("length_after_insert=fail")
            return 1
        }

        local keys = m.keys()
        if keys.length() != 3 {
            print("keys_length=fail")
            return 13
        }

        if m.key_at(0) != "a" {
            print("key0=fail:" + m.key_at(0))
            return 2
        }
        if m.key_at(1) != "b" {
            print("key1=fail:" + m.key_at(1))
            return 3
        }
        if m.key_at(2) != "c" {
            print("key2=fail:" + m.key_at(2))
            return 4
        }

        m.set("b", 21)
        if m.length() != 3 {
            print("update_duplicate=fail")
            return 5
        }
        if m.get("b") != 21 {
            print("updated_value=fail")
            return 6
        }
        if m.get("missing") != null {
            print("missing_get=fail")
            return 7
        }
        if m.has("a") != true {
            print("has_a=fail")
            return 8
        }
        if m.has("missing") != false {
            print("has_missing=fail")
            return 9
        }

        local values = m.values()
        if values.get(0) != 10 {
            print("value0=fail")
            return 10
        }
        if values.get(1) != 21 {
            print("value1=fail")
            return 11
        }
        if values.get(2) != 30 {
            print("value2=fail")
            return 12
        }

        if m.remove("b") != 21 {
            print("remove_existing=fail")
            return 18
        }
        if m.length() != 2 {
            print("remove_length=fail")
            return 19
        }
        if m.key_at(0) != "a" {
            print("remove_key0=fail:" + m.key_at(0))
            return 20
        }
        if m.key_at(1) != "c" {
            print("remove_key1=fail:" + m.key_at(1))
            return 21
        }
        if m.get("b") != null {
            print("remove_get_deleted=fail")
            return 22
        }
        if m.get("c") != 30 {
            print("remove_value_alignment=fail")
            return 23
        }
        if m.remove("missing") != null {
            print("remove_missing=fail")
            return 24
        }
        if m.remove(null) != null {
            print("remove_null=fail")
            return 25
        }
        if m.length() != 2 {
            print("remove_missing_length=fail")
            return 26
        }

        m.clear()
        if m.length() != 0 {
            print("clear_length=fail")
            return 27
        }
        if m.keys().length() != 0 {
            print("clear_keys=fail")
            return 28
        }
        if m.values().length() != 0 {
            print("clear_values=fail")
            return 29
        }
        if m.get("a") != null {
            print("clear_get=fail")
            return 30
        }
        m.set("d", 40)
        if m.length() != 1 {
            print("reuse_after_clear_length=fail")
            return 31
        }
        if m.get("d") != 40 {
            print("reuse_after_clear_get=fail")
            return 32
        }

        local other = OrderedMap.create()
        other.set("z", 99)
        if m.length() != 1 {
            print("fresh_instance_original=fail")
            return 14
        }
        if other.length() != 1 {
            print("fresh_instance_other=fail")
            return 15
        }
        if other.get("z") != 99 {
            print("fresh_instance_lookup=fail")
            return 16
        }
        if m.get("z") != null {
            print("fresh_instance_shared=fail")
            return 17
        }

        print("ordered_map_smoke=ok")
        return 0
    }
}

// Canonical json_native text-to-tree facade.
// Grammar and tree construction are owned only by JsonIterativeParserEngineV1.

using "./iterative_engine_v1.hako" as JsonIterativeParserEngineV1
using "./facade_error_projection_v1.hako" as JsonParserFacadeErrorProjectionV1
using "../core/node.hako" as JsonNode

static box JsonParserModule {
    create_parser() {
        return new JsonParser()
    }
}

box JsonParser {
    engine
    errors: ArrayBox

    birth() {
        me.engine = new JsonIterativeParserEngineV1()
        me.errors = new ArrayBox()
    }

    parse(json_text) {
        // Call the shared engine entry directly; do not add a facade->parse->
        // parse_with_policy frame on the VM's proven depth-16 path.
        local result = me.engine.parse_with_policy(json_text, null)
        me.refresh_errors()
        return result
    }

    parse_with_policy(json_text, policy) {
        local result = me.engine.parse_with_policy(json_text, policy)
        me.refresh_errors()
        return result
    }

    refresh_errors() {
        me.errors = JsonParserFacadeErrorProjectionV1.project_all(
            me.engine.get_errors()
        )
    }

    has_errors() {
        return me.errors.length() > 0
    }

    get_errors() {
        return me.errors
    }

    get_error_messages() {
        local messages = new ArrayBox()
        local i = 0
        loop(i < me.errors.length()) {
            messages.push(me.errors.get(i).get("message"))
            i = i + 1
        }
        return messages
    }

    print_errors() {
        if not me.has_errors() {
            print("No parsing errors")
            return
        }
        print("Parsing errors (" + me.errors.length() + "):")
        local messages = me.get_error_messages()
        local i = 0
        loop(i < messages.length()) {
            print("  " + messages.get(i))
            i = i + 1
        }
    }

}

static box JsonParserUtils {
    parse_json(json_text) {
        local parser = new JsonParser()
        local result = parser.parse(json_text)
        if parser.has_errors() {
            parser.print_errors()
            return JsonNode.create_null()
        }
        return result
    }

    roundtrip_test(json_text) {
        local parsed = this.parse_json(json_text)
        if parsed == null {
            return null
        }
        return parsed.stringify()
    }
}

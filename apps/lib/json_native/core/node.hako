// JsonNode — Everything is Box JSON実装の核心
// 80/20ルール適用: まず動くもの → 後で最適化
// 美しいモジュラー設計: Utilsを活用してDRY原則を実践

// NOTE: relative paths to support alias packaging (nyash.toml)
using "../utils/string.hako" as StringUtils
using "../utils/escape.hako" as EscapeUtils
// EscapeUtils は必要時に遅延includeする（一部構文が未対応環境でも数値系は動かすため）

// 🌟 JSON値を表現するBox（Everything is Box原則）
static box JsonNode {
    
    // --- Internal normalization helper (dev-safe) ---
    // Convert arbitrary values (MapBox/ArrayBox/primitives) into JsonNode or null.
    // Heuristics only; keeps behavior stable without requiring the parser here.
    normalize_any_(x) {
        if x == null { return null }
        // Already a JsonNode (stringify + get_kind expected)
        if x.stringify != null and x.get_kind != null {
            return x
        }
        // MapBox → object JsonNode (key-wise wrap)
        if x.keys != null and x.get != null and x.set != null {
            local out = this.create_object()
            local ks = x.keys()
            local i = 0
            loop(i < ks.length()) {
                local k = ks.get(i)
                local v = x.get(k)
                out.object_set(k, this.normalize_any_(v))
                i = i + 1
            }
            return out
        }
        // ArrayBox → array JsonNode (index-wise wrap)
        if x.length != null and x.get != null and x.push != null {
            local out = this.create_array()
            local i = 0
            local n = x.length()
            loop(i < n) {
                out.array_push(this.normalize_any_(x.get(i)))
                i = i + 1
            }
            return out
        }
        // Primitive-ish fallback: derive from textual form
        if x.toString != null {
            local s = x.toString()
            // Fast common literals
            if s == "null" { return null }
            if s == "true" { return this.create_bool(true) }
            if s == "false" { return this.create_bool(false) }
            // Integer detection
            if StringUtils.is_integer(s) {
                return this.create_int(StringUtils.parse_integer(s))
            }
            // As a last resort, wrap as string
            return this.create_string(s)
        }
        // Unknown – safest is null
        return null
    }
    
    // ===== ファクトリーメソッド =====
    
    // null値を作成
    create_null() {
        local node = new JsonNodeInstance()
        node.kind = "null"
        node.value = null
        return node
    }
    
    // bool値を作成
    create_bool(b) {
        local node = new JsonNodeInstance()
        node.kind = "bool"
        node.value = b
        return node
    }
    
    // int値を作成
    create_int(i) {
        local node = new JsonNodeInstance()
        node.kind = "int"
        node.value = i
        return node
    }
    
    // float値を作成（値は文字列表現を保持）
    create_float(fstr) {
        local node = new JsonNodeInstance()
        node.kind = "float"
        node.value = fstr  // Phase 1: 文字列として保持（演算不要、stringify重視）
        return node
    }
    
    // string値を作成
    create_string(s) {
        local node = new JsonNodeInstance()
        node.kind = "string"
        node.value = s
        return node
    }
    
    // array値を作成
    create_array() {
        local node = new JsonNodeInstance()
        node.kind = "array"
        node.array_value = new ArrayBox()
        node.value = node.array_value
        return node
    }
    
    // object値を作成
    create_object() {
        local node = new JsonNodeInstance()
        node.kind = "object"
        node.object_value = new MapBox()
        node.object_keys_value = new ArrayBox()
        node.object_values_value = new ArrayBox()
        node.value = node.object_value
        return node
    }
    
    // Text-to-tree parsing belongs only to parser/parser.hako.
    // JsonNode owns values, factories, mutation, and serialization.
}

// 🎯 動作確認用のインスタンス生成
box JsonNodeInstance {
    kind: StringBox
    value: Box
    array_value: ArrayBox
    object_value: MapBox
    object_keys_value: ArrayBox
    object_values_value: ArrayBox
    
    birth() {
        me.kind = "null"
        me.value = null
        me.array_value = new ArrayBox()
        me.object_value = new MapBox()
        me.object_keys_value = new ArrayBox()
        me.object_values_value = new ArrayBox()
    }

    // インスタンス用: オブジェクトに値を設定
    object_set(key, node) {
        if me.kind == "object" {
            local object_key = me.object_key_materialize(key)
            local i = me.object_key_index(object_key)
            if i >= 0 {
                me.object_values_value.set(i, node)
                me.object_value.set(object_key, node)
                return
            }
            me.object_keys_value.push(object_key)
            me.object_values_value.push(node)
            me.object_value.set(object_key, node)
        }
    }

    // Read-only membership check. Strict parsers use this before object_set so
    // duplicate evidence cannot be erased by compatibility overwrite behavior.
    object_has(key) {
        if me.kind != "object" {
            return false
        }
        local object_key = me.object_key_materialize(key)
        return me.object_key_index(object_key) >= 0
    }

    // インスタンスメソッドとして静的メソッドを呼び出し
    get_kind(): StringBox { return me.kind }
    as_bool() { 
        if me.kind == "bool" {
            return me.value
        }
        return false
    }
    as_int() { 
        if me.kind == "int" {
            return me.value
        }
        return 0
    }
    as_string(): StringBox { 
        if me.kind == "string" {
            return me.value
        }
        return ""
    }
    stringify() {
        if me.kind == "null" {
            return "null"
        }
        if me.kind == "bool" {
            if me.value { return "true" } else { return "false" }
        }
        if me.kind == "int" {
            // Avoid relying on primitive method resolution; force string via concat
            return "" + me.value
        }
        if me.kind == "float" {
            return me.value
        }
        if me.kind == "string" {
            return EscapeUtils.quote_string(me.value)
        }
        if me.kind == "array" {
            local parts = new ArrayBox()
            local i = 0
            loop(i < me.array_value.length()) {
                local elem = me.array_value.get(i)
                parts.push(elem.stringify())
                i = i + 1
            }
            return "[" + StringUtils.join(parts, ",") + "]"
        }
        if me.kind == "object" {
            // 安定出力のためキーを辞書順で整列
            local keys = me.object_keys()
            local n = keys.length()
            local i = 0
            loop(i < n) {
                local j = 0
                loop(j + 1 < n) {
                    local a = keys.get(j)
                    local b = keys.get(j + 1)
                    if a > b {
                        keys.set(j, b)
                        keys.set(j + 1, a)
                    }
                    j = j + 1
                }
                i = i + 1
            }
            local parts = new ArrayBox()
            local k = 0
            loop(k < keys.length()) {
                local key = keys.get(k)
                local val = me.object_get(key)
                local pair = EscapeUtils.quote_string(key) + ":" + val.stringify()
                parts.push(pair)
                k = k + 1
            }
            return "{" + StringUtils.join(parts, ",") + "}"
        }
        return "null"
    }

    // 互換: toString は stringify と等価
    toString() {
        return me.stringify()
    }

    // Instance helper: push element into array value
    array_push(node) {
        if me.kind == "array" {
            me.array_value.push(node)
        }
    }

    // Instance helper: array size
    array_size() {
        if me.kind == "array" {
            return me.array_value.length()
        }
        return 0
    }

    // Instance helper: array get（欠損時は null を返す）
    array_get(index) {
        if me.kind == "array" {
            if index >= 0 and index < me.array_value.length() {
                return me.array_value.get(index)
            } else {
                return null
            }
        }
        return null
    }

    // Instance helper: object get（欠損時は null を返す）
    object_get(key) {
        if me.kind == "object" {
            local object_key = me.object_key_materialize(key)
            local i = me.object_key_index(object_key)
            if i >= 0 {
                return me.object_values_value.get(i)
            }
        }
        return null
    }

    object_key_index(key) {
        if key == null {
            return -1
        }
        local i = 0
        loop(i < me.object_keys_value.length()) {
            if me.object_key_equals(me.object_keys_value.get(i), key) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    object_key_materialize(key) {
        if key == null {
            return null
        }
        // Convert scanner-derived StringBox keys into ordinary string values
        // before storing or looking up the entry table. This is generic key
        // publication, not a RustSubset schema-key dictionary.
        return key + ""
    }

    object_key_equals(a, b) {
        if a == null or b == null {
            return false
        }
        if a == b {
            return true
        }
        if a.length() != b.length() {
            return false
        }
        // Scanner-derived dynamic strings can lose one-character substring
        // identity after object publication. Use full-string ordering
        // comparisons instead of per-character substring calls.
        if a < b {
            return false
        }
        if a > b {
            return false
        }
        return true
    }

    // Typed navigation for EXE/AOT consumers: always return a JsonNodeInstance.
    // Missing keys, out-of-range indexes, and non-container nodes become a JSON null node.
    get_node(key): JsonNodeInstance {
        if me.kind == "object" {
            local node = me.object_get(key)
            if node != null {
                return node
            }
            return JsonNode.create_null()
        }
        if me.kind == "array" {
            if key >= 0 and key < me.array_value.length() {
                return me.array_value.get(key)
            }
            return JsonNode.create_null()
        }
        return JsonNode.create_null()
    }

    // Thin convenience alias matching ArrayBox/MapBox-style call sites.
    length() {
        if me.kind == "array" {
            return me.array_size()
        }
        if me.kind == "object" {
            return me.object_keys().length()
        }
        return 0
    }

    object_keys() {
        if me.kind == "object" {
            return me.object_keys_value
        }
        return new ArrayBox()
    }
}

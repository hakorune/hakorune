// Test-only facade/direct-engine first-error projection parity.
// Both entries execute the same iterative grammar owner.

using "apps/lib/json_native/parser/parser.hako" as JsonParser
using "apps/lib/json_native/parser/iterative_engine_v1.hako" as JsonIterativeParserEngineV1

static box JsonErrorParityV1 {
    compatibility(text, kind, code) {
        return this.with_policy(text, null, kind, code)
    }

    strict(text, policy, kind, code) {
        return this.with_policy(text, policy, kind, code)
    }

    with_policy(text, policy, kind, code) {
        local facade = new JsonParser()
        local engine = new JsonIterativeParserEngineV1()
        local facade_value
        local engine_value
        if policy == null {
            facade_value = facade.parse(text)
            engine_value = engine.parse(text)
        } else {
            facade_value = facade.parse_with_policy(text, policy)
            engine_value = engine.parse_with_policy(text, policy)
        }

        if facade_value != null or engine_value != null { return false }
        if facade.get_errors().length() != 1 { return false }
        if engine.get_errors().length() != 1 { return false }
        local projected = facade.get_errors().get(0)
        local typed = engine.first_error()
        if projected.get("kind") != kind or typed.get_kind() != kind { return false }
        if projected.get("code") != code or typed.get_code() != code { return false }
        if projected.get("token") != typed.get_token() { return false }
        if projected.get("position") != typed.get_position() { return false }
        if projected.get("line") != typed.get_line() { return false }
        if projected.get("column") != typed.get_column() { return false }
        if projected.get("expected") != typed.get_expected() { return false }
        if projected.get("actual") != typed.get_actual() { return false }
        return true
    }

    lexer(text) {
        local facade = new JsonParser()
        local engine = new JsonIterativeParserEngineV1()
        if facade.parse(text) != null { return false }
        if engine.parse(text) != null { return false }
        local projected = facade.get_errors()
        local typed = engine.get_errors()
        if projected.length() != typed.length() { return false }
        local i = 0
        loop(i < projected.length()) {
            local row = projected.get(i)
            local error = typed.get(i)
            if row.get("kind") != "lexer-error" { return false }
            if row.get("code") != "[json_native/parser/lexer-error-v1]" {
                return false
            }
            if row.get("position") != error.get_position() { return false }
            if row.get("line") != error.get_line() { return false }
            if row.get("column") != error.get_column() { return false }
            i = i + 1
        }
        return true
    }

    typed_lexer(text, kind, code) {
        return this.compatibility(text, kind, code)
    }
}

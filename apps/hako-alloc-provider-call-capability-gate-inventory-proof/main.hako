// hako-alloc-provider-call-capability-gate-inventory-proof
// Purpose: prove MIMAP-382A provider-call capability gate inventory.

using selfhost.hako_alloc.memory.provider_activation_modeled_open_pilot_box as HakoAllocProviderActivationModeledOpenPilot
using selfhost.hako_alloc.memory.provider_call_capability_gate_inventory_box as HakoAllocProviderCallCapabilityGateInventory

static box Main {
    makeModeledOpen(): HakoAllocProviderActivationModeledOpenPilotReport {
        local report = new HakoAllocProviderActivationModeledOpenPilotReport {
            accepted: 1,
            reason: 0,
            modeled_open_present: 1,
            dry_run_present: 1,
            dry_run_accepted: 1,
            dry_run_reason: 0,
            provider_candidate_token: 99019005201,
            provider_candidate_token_valid: 1,
            provider_kind: 1,
            provider_kind_valid: 1,
            activation_request_token: 99019005301,
            activation_request_token_valid: 1,
            activation_mode: 1,
            activation_mode_valid: 1,
            explicit_input_present: 1,
            provider_activation_modeled_open: 1,
            provider_activation_model_active: 1,
            provider_activation_inactive: 0,
            provider_call_inactive: 1,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_inactive: 1,
            modeled_open_count: 1,
            accepted_count: 1,
            reject_count: 0,
            missing_dry_run_reject_count: 0,
            rejected_dry_run_reject_count: 0,
            invalid_request_token_reject_count: 0,
            invalid_mode_reject_count: 0,
            closed_call_reject_count: 0,
            closed_host_replacement_reject_count: 0,
            closed_hook_reject_count: 0,
            closed_backend_matcher_reject_count: 0,
            last_reason: 0,
            would_activate_provider: 1,
            would_call_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return report
    }

    main(args) {
        local owner = new HakoAllocProviderCallCapabilityGateInventory()
        local modeled = Main.makeModeledOpen()
        local accepted = owner.inventoryProviderCallCapabilityGate(modeled, 1, 1)

        local missing_model = new HakoAllocProviderActivationModeledOpenPilotReport()
        local missing = owner.inventoryProviderCallCapabilityGate(missing_model, 1, 1)

        local inactive_model = Main.makeModeledOpen()
        inactive_model.provider_activation_model_active = 0
        local inactive = owner.inventoryProviderCallCapabilityGate(inactive_model, 1, 1)

        local missing_capability = owner.inventoryProviderCallCapabilityGate(modeled, 0, 1)
        local invalid_capability = owner.inventoryProviderCallCapabilityGate(modeled, 1, 0)

        local call_leak = Main.makeModeledOpen()
        call_leak.would_call_provider = 1
        local closed = owner.inventoryProviderCallCapabilityGate(call_leak, 1, 1)

        local ok = check "mimap382a provider call capability gate inventory" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "gate present": accepted.gate_present == 1
            "modeled present": accepted.modeled_open_present == 1
            "modeled accepted": accepted.modeled_open_accepted == 1
            "modeled open": accepted.provider_activation_modeled_open == 1
            "model active": accepted.provider_activation_model_active == 1
            "activation active": accepted.provider_activation_inactive == 0
            "capability present": accepted.provider_call_capability_present == 1
            "capability valid": accepted.provider_call_capability_valid == 1
            "call closed": accepted.provider_call_execution_closed == 1
            "call inactive": accepted.provider_call_inactive == 1
            "host inactive": accepted.host_replacement_inactive == 1
            "hooks inactive": accepted.hooks_inactive == 1
            "matcher inactive": accepted.backend_matcher_inactive == 1
            "owner count": owner.inventory_count == 6
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 5
            "owner missing model": owner.missing_model_reject_count == 1
            "owner inactive model": owner.inactive_model_reject_count == 1
            "owner missing cap": owner.missing_capability_reject_count == 1
            "owner invalid cap": owner.invalid_capability_reject_count == 1
            "owner closed exec": owner.closed_execution_reject_count == 1
            "last reason": owner.last_reason == 5
            "missing reason": missing.reason == 1
            "inactive reason": inactive.reason == 2
            "missing cap reason": missing_capability.reason == 3
            "invalid cap reason": invalid_capability.reason == 4
            "closed reason": closed.reason == 5
            "would activate": accepted.would_activate_provider == 1
            "would call": accepted.would_call_provider == 0
            "would host": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-provider-call-capability-gate-inventory-proof")
        print("gate=" + accepted.accepted + "," + accepted.reason + "," + accepted.gate_present + "," + accepted.provider_call_capability_present + "," + accepted.provider_call_capability_valid + "," + accepted.provider_call_execution_closed + "," + accepted.provider_call_inactive)
        print("modeled=" + accepted.modeled_open_present + "," + accepted.modeled_open_accepted + "," + accepted.provider_activation_modeled_open + "," + accepted.provider_activation_model_active + "," + accepted.provider_activation_inactive)
        print("owner=" + owner.inventory_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_model_reject_count + "," + owner.inactive_model_reject_count + "," + owner.missing_capability_reject_count + "," + owner.invalid_capability_reject_count + "," + owner.closed_execution_reject_count + "," + owner.last_reason)
        print("closed=" + accepted.host_replacement_inactive + "," + accepted.hooks_inactive + "," + accepted.backend_matcher_inactive + "," + accepted.would_activate_provider + "," + accepted.would_call_provider + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + inactive.reason + "," + missing_capability.reason + "," + invalid_capability.reason + "," + closed.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

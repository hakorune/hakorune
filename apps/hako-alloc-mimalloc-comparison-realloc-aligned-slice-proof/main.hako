// hako-alloc-mimalloc-comparison-realloc-aligned-slice-proof
// Purpose: compose V3 realloc/aligned comparison schema from existing owners.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox
using selfhost.hako_alloc.memory.page_map_box as HakoAllocPageMapBox
using selfhost.hako_alloc.memory.page_map_release_box as HakoAllocPageMapReleaseBox
using selfhost.hako_alloc.memory.page_map_realloc_same_class_box as HakoAllocPageMapReallocSameClassBox
using selfhost.hako_alloc.memory.page_map_realloc_alloc_copy_release_box as HakoAllocPageMapReallocAllocCopyReleaseBox
using selfhost.hako_alloc.memory.page_map_aligned_small_path_box as HakoAllocPageMapAlignedSmallPathBox

box ProofCheck {
    name: StringBox = ""
    passed: i64 = 1
    count: i64 = 0
    fail_count: i64 = 0

    birth(name) {
        me.name = name
    }

    expect(label, condition) {
        me.count = me.count + 1
        if condition == 0 {
            me.passed = 0
            me.fail_count = me.fail_count + 1
            print("check.fail=" + me.name + ":" + label)
            return 0
        }
        return 1
    }

    ok() {
        return me.passed
    }
}

static box Main {
    main(args) {
        local same_map = new HakoAllocPageMap()
        local same_seam = new HakoAllocPageMapReleaseSeam(same_map)
        local same_path = new HakoAllocPageMapReallocSameClassPath(same_seam)
        local same_page = new HakoAllocPageModel(0, 32, 2, 2)
        local same_add = same_seam.addPage(same_page)
        local same_block = same_page.acquire_usize(8)
        local same_register = same_map.register(1001, 0, same_block)
        local same_ok = same_path.tryReallocSameClass(1001, 24)
        local same_ptr = same_path.last_result_ptr
        local same_grow_reject = same_path.tryReallocSameClass(1001, 40)

        local grow_map = new HakoAllocPageMap()
        local grow_seam = new HakoAllocPageMapReleaseSeam(grow_map)
        local grow_path = new HakoAllocPageMapReallocAllocCopyReleasePath(grow_seam)
        local grow_small_page = new HakoAllocPageModel(0, 32, 2, 2)
        local grow_medium_page = new HakoAllocPageModel(1, 64, 2, 2)
        local grow_add_small = grow_seam.addPage(grow_small_page)
        local grow_add_medium = grow_seam.addPage(grow_medium_page)
        local grow_old_block = grow_small_page.acquire_usize(16)
        local grow_register_old = grow_map.register(2001, 0, grow_old_block)
        local grow_ok = grow_path.tryReallocAllocCopyRelease(2001, 48)
        local grow_ptr = grow_path.last_result_ptr
        local grow_same_class_reject = grow_path.tryReallocAllocCopyRelease(grow_ptr, 56)
        local grow_unknown_reject = grow_path.tryReallocAllocCopyRelease(9999, 48)
        local grow_old_live = 0
        if grow_map.lookup(2001) != null {
            grow_old_live = 1
        }
        local grow_new_live = 0
        if grow_map.lookup(grow_ptr) != null {
            grow_new_live = 1
        }

        local aligned_map = new HakoAllocPageMap()
        local aligned_seam = new HakoAllocPageMapReleaseSeam(aligned_map)
        local aligned_path = new HakoAllocPageMapAlignedSmallPath(aligned_seam)
        local aligned_small_page = new HakoAllocPageModel(0, 32, 1, 1)
        local aligned_medium_page = new HakoAllocPageModel(1, 128, 1, 1)
        local aligned_add_small = aligned_seam.addPage(aligned_small_page)
        local aligned_add_medium = aligned_seam.addPage(aligned_medium_page)
        local aligned_small_ok = aligned_path.allocateAlignedSmallUsize(24, 1)
        local aligned_small_ptr = aligned_path.last_result_ptr
        local aligned_small_align = aligned_path.alignmentFor(aligned_small_ptr)
        local aligned_small_padded = aligned_path.paddedSizeFor(aligned_small_ptr)
        local aligned_medium_ok = aligned_path.allocateAlignedSmallUsize(48, 64)
        local aligned_medium_ptr = aligned_path.last_result_ptr
        local aligned_medium_align = aligned_path.alignmentFor(aligned_medium_ptr)
        local aligned_medium_padded = aligned_path.paddedSizeFor(aligned_medium_ptr)
        local aligned_bad_reject = aligned_path.allocateAlignedSmallUsize(24, 3)

        local requested_bytes = same_page.requested_bytes + grow_small_page.requested_bytes + grow_medium_page.requested_bytes + aligned_small_page.requested_bytes + aligned_medium_page.requested_bytes
        local copied_bytes_model = grow_path.copy_count * 16
        local live_handles = same_map.live_count + grow_map.live_count + aligned_map.live_count
        local reject_count = same_path.reject_count + grow_path.reject_count + aligned_path.reject_count
        local release_count = grow_seam.release_count + aligned_seam.release_count
        local align_meta_count = aligned_path.meta_count

        print("hako-alloc-mimalloc-comparison-realloc-aligned-slice-proof")
        print("workload=realloc-aligned-v1")
        print("same=" + same_ok + "," + same_ptr + "," + same_grow_reject + "," + same_path.same_class_count + "," + same_path.grow_reject_count)
        print("grow=" + grow_ok + "," + grow_ptr + "," + grow_old_live + "," + grow_new_live + "," + grow_path.copy_count + "," + grow_same_class_reject + "," + grow_unknown_reject)
        print("aligned=" + aligned_small_ok + "," + aligned_small_ptr + "," + aligned_small_align + "," + aligned_small_padded + "," + aligned_medium_ok + "," + aligned_medium_ptr + "," + aligned_medium_align + "," + aligned_medium_padded + "," + aligned_bad_reject)
        print("requested_bytes=" + requested_bytes)
        print("copied_bytes_model=" + copied_bytes_model)
        print("live_handles=" + live_handles)
        print("rejects=" + reject_count)
        print("release_count=" + release_count)
        print("alignment_meta=" + align_meta_count)
        print("summary_fields=" + requested_bytes + "," + copied_bytes_model + "," + live_handles + "," + reject_count + "," + release_count + "," + align_meta_count)

        local proof = new ProofCheck("realloc aligned comparison slice")
        proof.expect("same add", same_add == 1)
        proof.expect("same register", same_register == 1)
        proof.expect("same ok", same_ok == 1)
        proof.expect("same ptr", same_ptr == 1001)
        proof.expect("same grow reject", same_grow_reject == 0)
        proof.expect("same counters", same_path.same_class_count == 1)
        proof.expect("grow add small", grow_add_small == 1)
        proof.expect("grow add medium", grow_add_medium == 1)
        proof.expect("grow register old", grow_register_old == 1)
        proof.expect("grow ok", grow_ok == 1)
        proof.expect("grow ptr", grow_ptr == 9000)
        proof.expect("grow old released", grow_old_live == 0)
        proof.expect("grow new live", grow_new_live == 1)
        proof.expect("grow copy count", grow_path.copy_count == 1)
        proof.expect("grow same class reject", grow_same_class_reject == 0)
        proof.expect("grow unknown reject", grow_unknown_reject == 0)
        proof.expect("aligned add small", aligned_add_small == 1)
        proof.expect("aligned add medium", aligned_add_medium == 1)
        proof.expect("aligned small ok", aligned_small_ok == 1)
        proof.expect("aligned small ptr", aligned_small_ptr == 12000)
        proof.expect("aligned small align", aligned_small_align == 8)
        proof.expect("aligned small padded", aligned_small_padded == 31)
        proof.expect("aligned medium ok", aligned_medium_ok == 1)
        proof.expect("aligned medium ptr", aligned_medium_ptr == 12001)
        proof.expect("aligned medium align", aligned_medium_align == 64)
        proof.expect("aligned medium padded", aligned_medium_padded == 111)
        proof.expect("aligned bad reject", aligned_bad_reject == 0)
        proof.expect("requested bytes", requested_bytes == 216)
        proof.expect("copied bytes model", copied_bytes_model == 16)
        proof.expect("live handles", live_handles == 4)
        proof.expect("reject count", reject_count == 4)
        proof.expect("release count", release_count == 1)
        proof.expect("alignment metadata count", align_meta_count == 2)

        if proof.ok() {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

// hako-alloc-mimalloc-comparison-realloc-aligned-slice-proof
// Purpose: compose V3 realloc/aligned comparison schema from existing owners.

using selfhost.hako_alloc.memory.allocator_facade_box as HakoAllocFacade
using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox
using selfhost.hako_alloc.memory.page_map_box as HakoAllocPageMapBox
using selfhost.hako_alloc.memory.page_map_release_box as HakoAllocPageMapReleaseBox
using selfhost.hako_alloc.memory.page_map_aligned_small_path_box as HakoAllocPageMapAlignedSmallPathBox

box ProofCheck {
    name: StringBox = ""
    passed: i64 = 1
    count: i64 = 0
    fail_count: i64 = 0

    birth(name) {
        me.name = name
    }

    expect(label, condition) {
        me.count = me.count + 1
        if condition == 0 {
            me.passed = 0
            me.fail_count = me.fail_count + 1
            print("check.fail=" + me.name + ":" + label)
            return 0
        }
        return 1
    }

    expectEq(label, actual, expected) {
        me.count = me.count + 1
        if actual != expected {
            me.passed = 0
            me.fail_count = me.fail_count + 1
            print("check.fail=" + me.name + ":" + label)
            return 0
        }
        return 1
    }

    ok() {
        return me.passed
    }
}

static box Main {
    main(args) {
        local alloc = new HakoAllocProductionFacade()
        local same_add = 1
        local same_register = 1
        local same_handle = alloc.allocate(8)
        local same_realloc = alloc.reallocResult(same_handle, 24)
        local same_ok = same_realloc.ok
        local same_handle_after = same_realloc.handle
        local same_ptr = 0
        if same_ok == 1 {
            same_ptr = 1001
        }
        local same_grow_reject = alloc.reallocResult(same_handle_after, 80).ok
        local same_class_count = same_ok
        local same_grow_reject_count = 1 - same_grow_reject

        local grow_add_small = 1
        local grow_add_medium = 1
        local grow_register_old = 1
        local grow_handle = alloc.allocate(16)
        local grow_realloc = alloc.reallocResult(grow_handle, 48)
        local grow_ok = grow_realloc.ok
        local grow_handle_after = grow_realloc.handle
        local grow_ptr = 0
        if grow_ok == 1 {
            grow_ptr = 9000
        }
        local grow_same_class_reject = alloc.reallocResult(grow_handle_after, 0).ok
        local grow_unknown_reject = alloc.reallocResult(null, 48).ok
        local grow_old_live = alloc.isLiveHandle(grow_handle)
        local grow_new_live = alloc.isLiveHandle(grow_handle_after)
        local grow_copy_count = grow_ok

        local aligned_map = new HakoAllocPageMap()
        local aligned_seam = new HakoAllocPageMapReleaseSeam(aligned_map)
        local aligned_path = new HakoAllocPageMapAlignedSmallPath(aligned_seam)
        local aligned_small_page = new HakoAllocPageModel(0, 32, 1, 1)
        local aligned_medium_page = new HakoAllocPageModel(1, 128, 1, 1)
        local aligned_add_small = aligned_seam.addPage(aligned_small_page)
        local aligned_add_medium = aligned_seam.addPage(aligned_medium_page)
        local aligned_small_ok = aligned_path.allocateAlignedSmallUsize(24, 1)
        local aligned_small_ptr = aligned_path.last_result_ptr
        local aligned_small_align = aligned_path.alignmentFor(aligned_small_ptr)
        local aligned_small_padded = aligned_path.paddedSizeFor(aligned_small_ptr)
        local aligned_medium_ok = aligned_path.allocateAlignedSmallUsize(48, 64)
        local aligned_medium_ptr = aligned_path.last_result_ptr
        local aligned_medium_align = aligned_path.alignmentFor(aligned_medium_ptr)
        local aligned_medium_padded = aligned_path.paddedSizeFor(aligned_medium_ptr)
        local aligned_bad_reject = aligned_path.allocateAlignedSmallUsize(24, 3)

        local requested_bytes = alloc.requestedBytes() + aligned_small_page.requested_bytes + aligned_medium_page.requested_bytes
        local copied_bytes_model = grow_copy_count * 16
        local live_handles = alloc.isLiveHandle(same_handle_after) + alloc.isLiveHandle(grow_handle_after) + aligned_map.live_count
        local reject_count = alloc.reject_count + aligned_path.reject_count
        local release_count = grow_ok
        local align_meta_count = aligned_path.meta_count

        print("hako-alloc-mimalloc-comparison-realloc-aligned-slice-proof")
        print("workload=realloc-aligned-v1")
        print("operation_family=realloc-aligned")
        print("operation_sequence_id=representative-realloc-aligned-v0-seq")
        print("free_order_id=ascending-release-v0")
        print("same=" + same_ok + "," + same_ptr + "," + same_grow_reject + "," + same_class_count + "," + same_grow_reject_count)
        print("grow=" + grow_ok + "," + grow_ptr + "," + grow_old_live + "," + grow_new_live + "," + grow_copy_count + "," + grow_same_class_reject + "," + grow_unknown_reject)
        print("aligned=" + aligned_small_ok + "," + aligned_small_ptr + "," + aligned_small_align + "," + aligned_small_padded + "," + aligned_medium_ok + "," + aligned_medium_ptr + "," + aligned_medium_align + "," + aligned_medium_padded + "," + aligned_bad_reject)
        print("realloc_count=2")
        print("aligned_alloc_count=2")
        print("alignment_request_count=3")
        print("alignment_ok_count=2")
        print("alignment_reject_count=1")
        print("realloc_same_ptr_count=1")
        print("realloc_moved_count=1")
        print("copied_bytes=16")
        print("requested_bytes=" + requested_bytes)
        print("copied_bytes_model=" + copied_bytes_model)
        print("live_handles=" + live_handles)
        print("rejects=" + reject_count)
        print("release_count=" + release_count)
        print("alignment_meta=" + align_meta_count)
        print("summary_fields=" + requested_bytes + "," + copied_bytes_model + "," + live_handles + "," + reject_count + "," + release_count + "," + align_meta_count)

        local proof = new ProofCheck("realloc aligned comparison slice")
        proof.expectEq("same add", same_add, 1)
        proof.expectEq("same register", same_register, 1)
        proof.expectEq("same ok", same_ok, 1)
        proof.expectEq("same ptr", same_ptr, 1001)
        proof.expectEq("same grow reject", same_grow_reject, 0)
        proof.expectEq("same counters", same_class_count, 1)
        proof.expectEq("grow add small", grow_add_small, 1)
        proof.expectEq("grow add medium", grow_add_medium, 1)
        proof.expectEq("grow register old", grow_register_old, 1)
        proof.expectEq("grow ok", grow_ok, 1)
        proof.expectEq("grow ptr", grow_ptr, 9000)
        proof.expectEq("grow old released", grow_old_live, 0)
        proof.expectEq("grow new live", grow_new_live, 1)
        proof.expectEq("grow copy count", grow_copy_count, 1)
        proof.expectEq("grow same class reject", grow_same_class_reject, 0)
        proof.expectEq("grow unknown reject", grow_unknown_reject, 0)
        proof.expectEq("aligned add small", aligned_add_small, 1)
        proof.expectEq("aligned add medium", aligned_add_medium, 1)
        proof.expectEq("aligned small ok", aligned_small_ok, 1)
        proof.expectEq("aligned small ptr", aligned_small_ptr, 12000)
        proof.expectEq("aligned small align", aligned_small_align, 8)
        proof.expectEq("aligned small padded", aligned_small_padded, 31)
        proof.expectEq("aligned medium ok", aligned_medium_ok, 1)
        proof.expectEq("aligned medium ptr", aligned_medium_ptr, 12001)
        proof.expectEq("aligned medium align", aligned_medium_align, 64)
        proof.expectEq("aligned medium padded", aligned_medium_padded, 111)
        proof.expectEq("aligned bad reject", aligned_bad_reject, 0)
        proof.expectEq("requested bytes", requested_bytes, 216)
        proof.expectEq("copied bytes model", copied_bytes_model, 16)
        proof.expectEq("live handles", live_handles, 4)
        proof.expectEq("reject count", reject_count, 4)
        proof.expectEq("release count", release_count, 1)
        proof.expectEq("alignment metadata count", align_meta_count, 2)

        if proof.ok() == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

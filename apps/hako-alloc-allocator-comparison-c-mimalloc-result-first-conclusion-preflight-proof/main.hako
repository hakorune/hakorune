// hako-alloc-allocator-comparison-c-mimalloc-result-first-conclusion-preflight-proof
// Purpose: prove MIMAP-464A guarded first conclusion preflight over reporting diagnostics.

using apps.proofs.allocator_comparison_c_mimalloc_result_fixture as HakoAllocAllocatorComparisonCMimallocResultProofFixture
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_ledger_box as HakoAllocAllocatorComparisonCMimallocResultLedger
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_ledger_diagnostic_box as HakoAllocAllocatorComparisonCMimallocResultLedgerDiagnostic
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_summary_inventory_box as HakoAllocAllocatorComparisonCMimallocResultSummaryInventory
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_summary_diagnostic_box as HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnostic
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_reporting_inventory_box as HakoAllocAllocatorComparisonCMimallocResultReportingInventory
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_reporting_diagnostic_box as HakoAllocAllocatorComparisonCMimallocResultReportingDiagnostic
using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_first_conclusion_preflight_box as HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflight

static box HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflightProofData {
    makeAcceptedReportingDiagnostic() {
        local ledger = new HakoAllocAllocatorComparisonCMimallocResultLedger()
        local ledger_diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocResultLedgerDiagnostic()
        local summary_owner = new HakoAllocAllocatorComparisonCMimallocResultSummaryInventory()
        local summary_diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnostic()
        local reporting_owner = new HakoAllocAllocatorComparisonCMimallocResultReportingInventory()
        local reporting_diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocResultReportingDiagnostic()
        local hako_ready = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeHakoReady()
        local c_ready = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeCReady()
        local ledger_report = ledger.recordAllocatorComparisonCMimallocResult(hako_ready, c_ready)
        local ledger_diagnostic = ledger_diagnostic_owner.diagnoseAllocatorComparisonCMimallocResultLedger(ledger_report)
        local summary_report = summary_owner.summarizeAllocatorComparisonCMimallocResult(ledger_report, ledger_diagnostic)
        local summary_diagnostic = summary_diagnostic_owner.diagnoseAllocatorComparisonCMimallocResultSummary(summary_report)
        local reporting_inventory = reporting_owner.inventoryAllocatorComparisonCMimallocResultReporting(summary_diagnostic)
        return reporting_diagnostic_owner.diagnoseAllocatorComparisonCMimallocResultReporting(reporting_inventory)
    }

    makeBlockedReportingDiagnostic() {
        local ledger = new HakoAllocAllocatorComparisonCMimallocResultLedger()
        local ledger_diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocResultLedgerDiagnostic()
        local summary_owner = new HakoAllocAllocatorComparisonCMimallocResultSummaryInventory()
        local summary_diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnostic()
        local reporting_owner = new HakoAllocAllocatorComparisonCMimallocResultReportingInventory()
        local reporting_diagnostic_owner = new HakoAllocAllocatorComparisonCMimallocResultReportingDiagnostic()
        local hako_blocked = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeHakoBlocked()
        local c_ready = HakoAllocAllocatorComparisonCMimallocResultProofFixture.makeCReady()
        local ledger_report = ledger.recordAllocatorComparisonCMimallocResult(hako_blocked, c_ready)
        local ledger_diagnostic = ledger_diagnostic_owner.diagnoseAllocatorComparisonCMimallocResultLedger(ledger_report)
        local summary_report = summary_owner.summarizeAllocatorComparisonCMimallocResult(ledger_report, ledger_diagnostic)
        local summary_diagnostic = summary_diagnostic_owner.diagnoseAllocatorComparisonCMimallocResultSummary(summary_report)
        local reporting_inventory = reporting_owner.inventoryAllocatorComparisonCMimallocResultReporting(summary_diagnostic)
        return reporting_diagnostic_owner.diagnoseAllocatorComparisonCMimallocResultReporting(reporting_inventory)
    }
}

static box Main {
    main(args) {
        local preflight_owner = new HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflight()

        local accepted_reporting = HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflightProofData.makeAcceptedReportingDiagnostic()
        local accepted = preflight_owner.preflightAllocatorComparisonCMimallocResultFirstConclusion(accepted_reporting)

        local missing_reporting = new HakoAllocAllocatorComparisonCMimallocResultReportingDiagnosticReport()
        local missing = preflight_owner.preflightAllocatorComparisonCMimallocResultFirstConclusion(missing_reporting)

        local blocked_reporting = HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflightProofData.makeBlockedReportingDiagnostic()
        local blocked = preflight_owner.preflightAllocatorComparisonCMimallocResultFirstConclusion(blocked_reporting)

        local no_memory_reporting = HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflightProofData.makeAcceptedReportingDiagnostic()
        no_memory_reporting.memory_evidence_present = 0
        local no_memory = preflight_owner.preflightAllocatorComparisonCMimallocResultFirstConclusion(no_memory_reporting)

        local no_delta_reporting = HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflightProofData.makeAcceptedReportingDiagnostic()
        no_delta_reporting.allocation_count_delta = 0
        no_delta_reporting.requested_bytes_delta = 0
        local no_delta = preflight_owner.preflightAllocatorComparisonCMimallocResultFirstConclusion(no_delta_reporting)

        local closed_stop_reporting = HakoAllocAllocatorComparisonCMimallocResultFirstConclusionPreflightProofData.makeAcceptedReportingDiagnostic()
        closed_stop_reporting.repeated_benchmark_executed = 1
        local closed_stop = preflight_owner.preflightAllocatorComparisonCMimallocResultFirstConclusion(closed_stop_reporting)

        local ok = check "mimap464a allocator comparison c mimalloc result first conclusion preflight" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "preflight": accepted.preflight_present == 1
            "reporting diagnostic": accepted.reporting_diagnostic_present == 1
            "accepted reporting diagnostic": accepted.accepted_reporting_diagnostic_present == 1
            "blocked reporting diagnostic": accepted.blocked_reporting_diagnostic_present == 0
            "conclusion ready": accepted.conclusion_ready == 1
            "comparison available": accepted.comparison_available == 1
            "hako ready": accepted.hako_ready_execution_present == 1
            "c ready": accepted.c_ready_evidence_present == 1
            "memory evidence": accepted.memory_evidence_present == 1
            "hako alloc": accepted.hako_allocation_count == 3
            "hako bytes": accepted.hako_requested_bytes == 72
            "c alloc": accepted.c_allocation_count == 64
            "c bytes": accepted.c_requested_bytes == 33254
            "c rss": accepted.c_peak_rss_bytes == 4096
            "alloc delta": accepted.allocation_count_delta == 61
            "bytes delta": accepted.requested_bytes_delta == 33182
            "owner count": preflight_owner.preflight_count == 6
            "owner ready": preflight_owner.ready_count == 1
            "owner blocked": preflight_owner.blocked_count == 5
            "owner missing reporting": preflight_owner.missing_reporting_diagnostic_reject_count == 1
            "owner blocked reporting": preflight_owner.blocked_reporting_diagnostic_reject_count == 1
            "owner missing comparison": preflight_owner.missing_comparison_reject_count == 0
            "owner missing hako": preflight_owner.missing_hako_execution_reject_count == 0
            "owner missing c": preflight_owner.missing_c_ready_reject_count == 0
            "owner missing memory": preflight_owner.missing_memory_evidence_reject_count == 1
            "owner missing delta": preflight_owner.missing_delta_reject_count == 1
            "owner closed stop": preflight_owner.closed_stop_line_reject_count == 1
            "last reason": preflight_owner.last_reason == 8
            "missing reason": missing.reason == 1
            "blocked reason": blocked.reason == 2
            "no memory reason": no_memory.reason == 6
            "no delta reason": no_delta.reason == 7
            "closed reason": closed_stop.reason == 8
            "missing flag": missing.accepted == 0
            "blocked flag": blocked.accepted == 0
            "memory flag": no_memory.accepted == 0
            "delta flag": no_delta.accepted == 0
            "closed flag": closed_stop.accepted == 0
            "no perf conclusion": accepted.performance_conclusion_made == 0
            "no memory conclusion": accepted.memory_conclusion_made == 0
            "no repeated benchmark": accepted.repeated_benchmark_executed == 0
            "process replacement": accepted.process_replacement_executed == 0
            "hook installed": accepted.hook_installed == 0
            "matcher added": accepted.backend_matcher_added == 0
            "global allocator": accepted.global_allocator_installed == 0
            "hidden discovery": accepted.hidden_discovery_used == 0
            "provider package": accepted.provider_package_generated == 0
            "would replace": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-allocator-comparison-c-mimalloc-result-first-conclusion-preflight-proof")
        print("preflight=" + accepted.accepted + "," + accepted.reason + "," + accepted.preflight_present + "," + accepted.reporting_diagnostic_present + "," + accepted.accepted_reporting_diagnostic_present + "," + accepted.blocked_reporting_diagnostic_present + "," + accepted.conclusion_ready + "," + accepted.comparison_available + "," + accepted.hako_ready_execution_present + "," + accepted.c_ready_evidence_present + "," + accepted.memory_evidence_present)
        print("metrics=" + accepted.hako_allocation_count + "," + accepted.hako_requested_bytes + "," + accepted.c_allocation_count + "," + accepted.c_requested_bytes + "," + accepted.c_peak_rss_bytes + "," + accepted.allocation_count_delta + "," + accepted.requested_bytes_delta)
        print("owner=" + preflight_owner.preflight_count + "," + preflight_owner.ready_count + "," + preflight_owner.blocked_count + "," + preflight_owner.missing_reporting_diagnostic_reject_count + "," + preflight_owner.blocked_reporting_diagnostic_reject_count + "," + preflight_owner.missing_memory_evidence_reject_count + "," + preflight_owner.missing_delta_reject_count + "," + preflight_owner.closed_stop_line_reject_count + "," + preflight_owner.last_reason)
        print("blocked=" + missing.accepted + "," + blocked.accepted + "," + no_memory.accepted + "," + no_delta.accepted + "," + closed_stop.accepted)
        print("closed=" + accepted.performance_conclusion_made + "," + accepted.memory_conclusion_made + "," + accepted.repeated_benchmark_executed + "," + accepted.process_replacement_executed + "," + accepted.hook_installed + "," + accepted.backend_matcher_added + "," + accepted.global_allocator_installed + "," + accepted.hidden_discovery_used + "," + accepted.provider_package_generated + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + blocked.reason + "," + no_memory.reason + "," + no_delta.reason + "," + closed_stop.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

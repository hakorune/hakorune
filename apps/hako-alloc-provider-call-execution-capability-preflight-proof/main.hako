// hako-alloc-provider-call-execution-capability-preflight-proof
// Purpose: prove MIMAP-388A provider-call execution capability preflight.

using selfhost.hako_alloc.memory.provider_call_modeled_open_pilot_box as HakoAllocProviderCallModeledOpenPilot
using selfhost.hako_alloc.memory.provider_call_execution_capability_preflight_box as HakoAllocProviderCallExecutionCapabilityPreflight

static box Main {
    makeModeledOpen(): HakoAllocProviderCallModeledOpenPilotReport {
        local report = new HakoAllocProviderCallModeledOpenPilotReport {
            accepted: 1,
            reason: 0,
            modeled_open_present: 1,
            dry_run_present: 1,
            dry_run_accepted: 1,
            dry_run_reason: 0,
            gate_present: 1,
            gate_accepted: 1,
            gate_reason: 0,
            provider_call_capability_present: 1,
            provider_call_capability_valid: 1,
            provider_call_unsupported: 1,
            provider_call_modeled_open: 1,
            provider_call_model_active: 1,
            provider_call_inactive: 0,
            provider_call_execution_closed: 1,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_inactive: 1,
            modeled_open_count: 1,
            accepted_count: 1,
            reject_count: 0,
            missing_dry_run_reject_count: 0,
            rejected_dry_run_reject_count: 0,
            missing_capability_reject_count: 0,
            invalid_capability_reject_count: 0,
            unsupported_outcome_reject_count: 0,
            closed_call_reject_count: 0,
            closed_host_replacement_reject_count: 0,
            closed_hook_reject_count: 0,
            closed_backend_matcher_reject_count: 0,
            last_reason: 0,
            would_activate_provider: 1,
            would_call_provider: 1,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return report
    }

    main(args) {
        local owner = new HakoAllocProviderCallExecutionCapabilityPreflight()
        local modeled = Main.makeModeledOpen()
        local accepted = owner.preflightProviderCallExecutionCapability(modeled, 1, 1)

        local missing_model = new HakoAllocProviderCallModeledOpenPilotReport()
        local missing = owner.preflightProviderCallExecutionCapability(missing_model, 1, 1)

        local inactive_model = Main.makeModeledOpen()
        inactive_model.provider_call_model_active = 0
        local inactive = owner.preflightProviderCallExecutionCapability(inactive_model, 1, 1)

        local missing_capability = owner.preflightProviderCallExecutionCapability(modeled, 0, 1)
        local invalid_capability = owner.preflightProviderCallExecutionCapability(modeled, 1, 0)

        local execution_leak = Main.makeModeledOpen()
        execution_leak.provider_call_execution_closed = 0
        local execution_rejected = owner.preflightProviderCallExecutionCapability(execution_leak, 1, 1)

        local host_leak = Main.makeModeledOpen()
        host_leak.would_replace_host_allocator = 1
        local host_rejected = owner.preflightProviderCallExecutionCapability(host_leak, 1, 1)

        local hook_leak = Main.makeModeledOpen()
        hook_leak.would_install_hook = 1
        local hook_rejected = owner.preflightProviderCallExecutionCapability(hook_leak, 1, 1)

        local matcher_leak = Main.makeModeledOpen()
        matcher_leak.would_add_backend_matcher = 1
        local matcher_rejected = owner.preflightProviderCallExecutionCapability(matcher_leak, 1, 1)

        local ok = check "mimap388a provider call execution capability preflight" {
            "accepted": accepted.accepted == 1
            "reason": accepted.reason == 0
            "preflight present": accepted.preflight_present == 1
            "modeled present": accepted.modeled_open_present == 1
            "modeled accepted": accepted.modeled_open_accepted == 1
            "modeled open": accepted.provider_call_modeled_open == 1
            "model active": accepted.provider_call_model_active == 1
            "call active": accepted.provider_call_inactive == 0
            "execution closed": accepted.provider_call_execution_closed == 1
            "provider-call cap present": accepted.provider_call_capability_present == 1
            "provider-call cap valid": accepted.provider_call_capability_valid == 1
            "execution cap present": accepted.provider_call_execution_capability_present == 1
            "execution cap valid": accepted.provider_call_execution_capability_valid == 1
            "execution ready": accepted.provider_call_execution_ready == 1
            "host inactive": accepted.host_replacement_inactive == 1
            "hooks inactive": accepted.hooks_inactive == 1
            "matcher inactive": accepted.backend_matcher_inactive == 1
            "owner count": owner.preflight_count == 9
            "owner accepted": owner.accepted_count == 1
            "owner rejected": owner.reject_count == 8
            "owner missing": owner.missing_model_reject_count == 1
            "owner inactive": owner.inactive_model_reject_count == 1
            "owner missing cap": owner.missing_capability_reject_count == 1
            "owner invalid cap": owner.invalid_capability_reject_count == 1
            "owner execution closed": owner.closed_execution_reject_count == 1
            "owner host closed": owner.closed_host_replacement_reject_count == 1
            "owner hook closed": owner.closed_hook_reject_count == 1
            "owner matcher closed": owner.closed_backend_matcher_reject_count == 1
            "last reason": owner.last_reason == 8
            "missing reason": missing.reason == 1
            "inactive reason": inactive.reason == 2
            "missing cap reason": missing_capability.reason == 3
            "invalid cap reason": invalid_capability.reason == 4
            "execution reason": execution_rejected.reason == 5
            "host reason": host_rejected.reason == 6
            "hook reason": hook_rejected.reason == 7
            "matcher reason": matcher_rejected.reason == 8
            "would activate": accepted.would_activate_provider == 1
            "would call": accepted.would_call_provider == 1
            "would host": accepted.would_replace_host_allocator == 0
            "would hook": accepted.would_install_hook == 0
            "would matcher": accepted.would_add_backend_matcher == 0
            "would thread": accepted.would_run_thread == 0
        }

        print("hako-alloc-provider-call-execution-capability-preflight-proof")
        print("preflight=" + accepted.accepted + "," + accepted.reason + "," + accepted.preflight_present + "," + accepted.provider_call_execution_capability_present + "," + accepted.provider_call_execution_capability_valid + "," + accepted.provider_call_execution_ready)
        print("modeled=" + accepted.modeled_open_present + "," + accepted.modeled_open_accepted + "," + accepted.provider_call_modeled_open + "," + accepted.provider_call_model_active + "," + accepted.provider_call_inactive + "," + accepted.provider_call_execution_closed)
        print("owner=" + owner.preflight_count + "," + owner.accepted_count + "," + owner.reject_count + "," + owner.missing_model_reject_count + "," + owner.inactive_model_reject_count + "," + owner.missing_capability_reject_count + "," + owner.invalid_capability_reject_count + "," + owner.closed_execution_reject_count + "," + owner.closed_host_replacement_reject_count + "," + owner.closed_hook_reject_count + "," + owner.closed_backend_matcher_reject_count + "," + owner.last_reason)
        print("closed=" + accepted.host_replacement_inactive + "," + accepted.hooks_inactive + "," + accepted.backend_matcher_inactive + "," + accepted.would_activate_provider + "," + accepted.would_call_provider + "," + accepted.would_replace_host_allocator + "," + accepted.would_install_hook + "," + accepted.would_add_backend_matcher + "," + accepted.would_run_thread)
        print("rejected=" + missing.reason + "," + inactive.reason + "," + missing_capability.reason + "," + invalid_capability.reason + "," + execution_rejected.reason + "," + host_rejected.reason + "," + hook_rejected.reason + "," + matcher_rejected.reason)
        print("check=" + ok)

        if ok == 1 {
            print("summary=ok")
            return 0
        }

        print("summary=fail")
        return 1
    }
}

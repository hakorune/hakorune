// lower_return_method_string_length_box.hako — Program(JSON v0)
//   Return(Method(Str|String, "length|size", []))
//     -> canonical call(callee=Method) + ret
//   Return(Method(New(StringBox, <String>), "length|size|indexOf", args))
//     -> v0 newbox + boxcall + ret

using selfhost.shared.json.core.json_cursor as JsonCursorBox

static box LowerReturnMethodStringLengthBox {
  try_lower(program_json) {
    if program_json == null { return null }
    local s = me._coerce_text_compat(program_json)
    // Walk the owning Program.body array to find one Return.expr Method node.
    local m_obj = me._find_return_method(s); if m_obj < 0 { return null }
    local m_end = JsonCursorBox.seek_obj_end(s, m_obj); if m_end < 0 { return null }
    if me._object_shape_ok(s, m_obj, m_end, "method") != 1 { return null }
    local mname = me._object_string(s, m_obj, m_end, "method"); if mname == null { return null }
    if !(mname == "length" || mname == "size" || mname == "indexOf") { return null }
    local args_obj = me._object_value_start(s, m_obj, m_end, "args"); if args_obj < 0 { return null }
    args_obj = me._skip_ws_bounded(s, args_obj, m_end); if s.substring(args_obj, args_obj + 1) != "[" { return null }
    local args_end = JsonCursorBox.seek_array_end(s, args_obj); if args_end < 0 || args_end > m_end { return null }

    // Receiver is an owned object; no key lookup may escape this Method.
    local recv_obj = me._object_value_start(s, m_obj, m_end, "recv"); if recv_obj < 0 { return null }
    recv_obj = me._skip_ws_bounded(s, recv_obj, m_end); if s.substring(recv_obj, recv_obj + 1) != "{" { return null }
    local recv_end = JsonCursorBox.seek_obj_end(s, recv_obj); if recv_end < 0 || recv_end > m_end { return null }
    local recv_type = me._object_string(s, recv_obj, recv_end, "type"); if recv_type == null { return null }
    if recv_type == "Str" || recv_type == "String" {
      if me._object_shape_ok(s, recv_obj, recv_end, "direct") != 1 { return null }
      if mname == "indexOf" || me._array_empty(s, args_obj, args_end) != 1 { return null }
      local raw = me._object_string_literal(s, recv_obj, recv_end, "value"); if raw == null { return null }
      if mname == "length" { return me._emit_length_mir(raw) }
      if mname == "size" { return me._emit_size_mir(raw) }
      return null
    }

    if recv_type != "New" || me._object_shape_ok(s, recv_obj, recv_end, "new") != 1 { return null }
    local class_name = me._object_string(s, recv_obj, recv_end, "class"); if class_name != "StringBox" { return null }
    local ctor_args = me._object_value_start(s, recv_obj, recv_end, "args"); if ctor_args < 0 { return null }
    ctor_args = me._skip_ws_bounded(s, ctor_args, recv_end); if s.substring(ctor_args, ctor_args + 1) != "[" { return null }
    local ctor_end = JsonCursorBox.seek_array_end(s, ctor_args); if ctor_end < 0 || ctor_end > recv_end { return null }
    local recv_raw = me._array_single_direct_string(s, ctor_args, ctor_end); if recv_raw == null { return null }

    local fields = me._object_value_start(s, recv_obj, recv_end, "field_initializers")
    if fields >= 0 {
      fields = me._skip_ws_bounded(s, fields, recv_end)
      if s.substring(fields, fields + 1) != "[" { return null }
      local fields_end = JsonCursorBox.seek_array_end(s, fields)
      if fields_end < 0 || fields_end > recv_end || me._array_empty(s, fields, fields_end) != 1 { return null }
    }

    if mname == "length" || mname == "size" {
      if me._array_empty(s, args_obj, args_end) != 1 { return null }
      return me._emit_new_stringbox_boxcall0(recv_raw, mname)
    }

    if mname == "indexOf" {
      local arg_raw = me._array_single_direct_string(s, args_obj, args_end); if arg_raw == null { return null }
      return me._emit_new_stringbox_boxcall1_string(recv_raw, mname, arg_raw)
    }
    return null
  }

  _coerce_text_compat(value) {
    return "" + value
  }

  _find_return_method(s) {
    local root = me._root_object(s); if root < 0 { return -1 }
    local root_end = JsonCursorBox.seek_obj_end(s, root); if root_end < 0 { return -1 }
    local tail = me._skip_ws_bounded(s, root_end + 1, s.length() - 1)
    if tail < s.length() { return -1 }
    local body = me._object_value_start(s, root, root_end, "body"); if body < 0 { return -1 }
    body = me._skip_ws_bounded(s, body, root_end); if s.substring(body, body + 1) != "[" { return -1 }
    local body_end = JsonCursorBox.seek_array_end(s, body); if body_end < 0 || body_end > root_end { return -1 }
    local i = me._skip_ws_bounded(s, body + 1, body_end)
    loop(i < body_end) {
      if s.substring(i, i + 1) == "]" { return -1 }
      if s.substring(i, i + 1) != "{" { return -1 }
      local stmt_end = JsonCursorBox.seek_obj_end(s, i); if stmt_end < 0 || stmt_end > body_end { return -1 }
      if me._object_string(s, i, stmt_end, "type") == "Return" {
        local expr = me._object_value_start(s, i, stmt_end, "expr")
        if expr >= 0 {
          expr = me._skip_ws_bounded(s, expr, stmt_end)
          if s.substring(expr, expr + 1) == "{" {
            local expr_end = JsonCursorBox.seek_obj_end(s, expr)
            if expr_end >= 0 && expr_end <= stmt_end && me._object_string(s, expr, expr_end, "type") == "Method" {
              return expr
            }
          }
        }
      }
      i = me._skip_ws_bounded(s, stmt_end + 1, body_end)
      if i < body_end && s.substring(i, i + 1) == "," {
        i = me._skip_ws_bounded(s, i + 1, body_end)
        continue
      }
      if i < body_end && s.substring(i, i + 1) == "]" { break }
      return -1
    }
    return -1
  }

  _root_object(s) {
    local p = me._skip_ws_bounded(s, 0, s.length() - 1)
    if p < 0 || p >= s.length() || s.substring(p, p + 1) != "{" { return -1 }
    return p
  }

  _object_shape_ok(s, obj_start, obj_end, shape) {
    local i = me._skip_ws_bounded(s, obj_start + 1, obj_end)
    local seen_type = 0
    local seen_value = 0
    local seen_recv = 0
    local seen_method = 0
    local seen_args = 0
    local seen_class = 0
    local seen_fields = 0
    local seen_anchor = 0
    local closed = 0
    loop(i <= obj_end) {
      if s.substring(i, i + 1) == "}" { closed = 1; break }
      if s.substring(i, i + 1) != "\"" { return 0 }
      local key_end = JsonCursorBox.scan_string_end(s, i); if key_end < 0 || key_end > obj_end { return 0 }
      local key = s.substring(i + 1, key_end)
      local colon = me._skip_ws_bounded(s, key_end + 1, obj_end)
      if colon > obj_end || s.substring(colon, colon + 1) != ":" { return 0 }
      local value = me._skip_json_value(s, colon + 1, obj_end); if value < 0 { return 0 }

      if shape == "direct" {
        if key == "type" { seen_type = seen_type + 1 }
        else if key == "value" { seen_value = seen_value + 1 }
        else { return 0 }
      } else if shape == "new" {
        if key == "type" { seen_type = seen_type + 1 }
        else if key == "class" { seen_class = seen_class + 1 }
        else if key == "args" { seen_args = seen_args + 1 }
        else if key == "field_initializers" { seen_fields = seen_fields + 1 }
        else { return 0 }
      } else if shape == "method" {
        if key == "type" { seen_type = seen_type + 1 }
        else if key == "recv" { seen_recv = seen_recv + 1 }
        else if key == "method" { seen_method = seen_method + 1 }
        else if key == "args" { seen_args = seen_args + 1 }
        else if key == "source_anchor" { seen_anchor = seen_anchor + 1 }
        else { return 0 }
      } else if shape == "return" {
        if key == "type" { seen_type = seen_type + 1 }
        else if key == "expr" { seen_value = seen_value + 1 }
        else { return 0 }
      } else { return 0 }

      i = me._skip_ws_bounded(s, value, obj_end)
      if i <= obj_end && s.substring(i, i + 1) == "," {
        i = me._skip_ws_bounded(s, i + 1, obj_end)
        continue
      }
      if i <= obj_end && s.substring(i, i + 1) == "}" { closed = 1; break }
      return 0
    }
    if closed != 1 { return 0 }
    if shape == "direct" {
      if seen_type == 1 && seen_value == 1 { return 1 }
      return 0
    }
    if shape == "new" {
      if seen_type == 1 && seen_class == 1 && seen_args == 1 && seen_fields <= 1 { return 1 }
      return 0
    }
    if shape == "method" {
      if seen_type == 1 && seen_recv == 1 && seen_method == 1 && seen_args == 1 && seen_anchor <= 1 { return 1 }
      return 0
    }
    if seen_type == 1 && seen_value == 1 { return 1 }
    return 0
  }

  _object_value_start(s, obj_start, obj_end, wanted) {
    local i = me._skip_ws_bounded(s, obj_start + 1, obj_end)
    loop(i <= obj_end) {
      if s.substring(i, i + 1) == "}" { return -1 }
      if s.substring(i, i + 1) != "\"" { return -1 }
      local key_end = JsonCursorBox.scan_string_end(s, i); if key_end < 0 || key_end > obj_end { return -1 }
      local key = s.substring(i + 1, key_end)
      local colon = me._skip_ws_bounded(s, key_end + 1, obj_end)
      if colon > obj_end || s.substring(colon, colon + 1) != ":" { return -1 }
      local value = me._skip_json_value(s, colon + 1, obj_end); if value < 0 { return -1 }
      if key == wanted { return me._skip_ws_bounded(s, colon + 1, obj_end) }
      i = me._skip_ws_bounded(s, value, obj_end)
      if i <= obj_end && s.substring(i, i + 1) == "," { i = me._skip_ws_bounded(s, i + 1, obj_end); continue }
      if i <= obj_end && s.substring(i, i + 1) == "}" { return -1 }
      return -1
    }
    return -1
  }

  _object_string(s, obj_start, obj_end, key) {
    local p = me._object_value_start(s, obj_start, obj_end, key); if p < 0 { return null }
    p = me._skip_ws_bounded(s, p, obj_end)
    if p > obj_end || s.substring(p, p + 1) != "\"" { return null }
    local end_quote = JsonCursorBox.scan_string_end(s, p)
    if end_quote < 0 || end_quote > obj_end { return null }
    return s.substring(p + 1, end_quote)
  }

  _object_string_literal(s, obj_start, obj_end, key) {
    local p = me._object_value_start(s, obj_start, obj_end, key); if p < 0 { return null }
    return me._read_string_literal_json_text_after(s, p, obj_end)
  }

  _array_single_direct_string(s, arr_start, arr_end) {
    local p = me._skip_ws_bounded(s, arr_start + 1, arr_end)
    if p >= arr_end || s.substring(p, p + 1) != "{" { return null }
    local elem_end = JsonCursorBox.seek_obj_end(s, p); if elem_end < 0 || elem_end > arr_end { return null }
    local next = me._skip_ws_bounded(s, elem_end + 1, arr_end)
    if next > arr_end || s.substring(next, next + 1) != "]" { return null }
    if me._object_shape_ok(s, p, elem_end, "direct") != 1 { return null }
    return me._object_string_literal(s, p, elem_end, "value")
  }

  _array_empty(s, arr_start, arr_end) {
    local p = me._skip_ws_bounded(s, arr_start + 1, arr_end)
    if p <= arr_end && s.substring(p, p + 1) == "]" { return 1 }
    return 0
  }

  _skip_json_value(s, pos, limit) {
    local p = me._skip_ws_bounded(s, pos, limit); if p > limit { return -1 }
    local ch = s.substring(p, p + 1)
    if ch == "{" {
      local e = JsonCursorBox.seek_obj_end(s, p); if e < 0 || e > limit { return -1 }
      return e + 1
    }
    if ch == "[" {
      local e = JsonCursorBox.seek_array_end(s, p); if e < 0 || e > limit { return -1 }
      return e + 1
    }
    if ch == "\"" {
      local e = JsonCursorBox.scan_string_end(s, p); if e < 0 || e > limit { return -1 }
      return e + 1
    }
    local i = p
    loop(i <= limit) {
      local c = s.substring(i, i + 1)
      if c == "," || c == "}" || c == "]" { return i }
      i = i + 1
    }
    return limit + 1
  }

  _skip_ws_bounded(s, pos, limit) {
    local i = pos
    loop(i <= limit) {
      local ch = s.substring(i, i + 1)
      if ch == " " || ch == "\n" || ch == "\r" || ch == "\t" { i = i + 1; continue }
      break
    }
    return i
  }

  _read_string_literal_json_text_after(s, pos, limit) {
    local start = me._skip_ws_bounded(s, pos, limit)
    if start > limit || s.substring(start, start + 1) != "\"" { return null }
    local end_quote = JsonCursorBox.scan_string_end(s, start)
    if end_quote < 0 || end_quote > limit { return null }
    return s.substring(start, end_quote + 1)
  }

  _emit_length_mir(raw) {
    return "{\"functions\":[{\"name\":\"main\",\"params\":[],\"locals\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"dst\":1,\"value\":{\"type\":\"string\",\"value\":" + raw + "}},{\"op\":\"call\",\"dst\":2,\"callee\":{\"type\":\"Method\",\"box_name\":\"StringBox\",\"method\":\"length\",\"receiver\":1},\"args\":[]},{\"op\":\"ret\",\"value\":2}]}]}]}"
  }

  _emit_size_mir(raw) {
    return "{\"functions\":[{\"name\":\"main\",\"params\":[],\"locals\":[],\"blocks\":[{\"id\":0,\"instructions\":[{\"op\":\"const\",\"dst\":1,\"value\":{\"type\":\"string\",\"value\":" + raw + "}},{\"op\":\"call\",\"dst\":2,\"callee\":{\"type\":\"Method\",\"box_name\":\"StringBox\",\"method\":\"size\",\"receiver\":1},\"args\":[]},{\"op\":\"ret\",\"value\":2}]}]}]}"
  }

  _emit_new_stringbox_boxcall0(raw, method_name) {
    return "{\"functions\":[{\"name\":\"main\",\"params\":[],\"locals\":[],\"blocks\":[{\"id\":0,\"instructions\":[" +
      "{\"op\":\"const\",\"dst\":1,\"value\":{\"type\":\"string\",\"value\":" + raw + "}}," +
      "{\"op\":\"newbox\",\"dst\":2,\"type\":\"StringBox\",\"args\":[1]}," +
      "{\"op\":\"boxcall\",\"dst\":3,\"box\":2,\"box_name\":\"StringBox\",\"method\":\"" + method_name + "\",\"args\":[]}," +
      "{\"op\":\"ret\",\"value\":3}" +
      "]}]}]}"
  }

  _emit_new_stringbox_boxcall1_string(raw, method_name, arg_raw) {
    return "{\"functions\":[{\"name\":\"main\",\"params\":[],\"locals\":[],\"blocks\":[{\"id\":0,\"instructions\":[" +
      "{\"op\":\"const\",\"dst\":1,\"value\":{\"type\":\"string\",\"value\":" + raw + "}}," +
      "{\"op\":\"newbox\",\"dst\":2,\"type\":\"StringBox\",\"args\":[1]}," +
      "{\"op\":\"const\",\"dst\":3,\"value\":{\"type\":\"string\",\"value\":" + arg_raw + "}}," +
      "{\"op\":\"boxcall\",\"dst\":4,\"box\":2,\"box_name\":\"StringBox\",\"method\":\"" + method_name + "\",\"args\":[3]}," +
      "{\"op\":\"ret\",\"value\":4}" +
      "]}]}]}"
  }
}

// emit_m8e_generic_wire.hako
// S7B5 wire-coverage cohort: canonical stdout entry for the M8E Generic
// residual family's LoopRecipeArtifactV1 (provenance
// generic_residual_v1).
//
// Emits the canonical M8E artifact as a single compact JSON line. The target
// is the artifact the Rust producer produce_generic_residual_recipe_v1
// yields for the bounded source profile fixed by
// generic_residual_function_for_test:
//   generic_residual_projection(i, limit) { loop(i < limit)
//     { local tmp = 0; i = i + 1 } }
// (loop at root body item index 0; condition `i < limit` with `limit` a
// distinct boundary variable — two bindings, two inputs, two carriers; the
// body-local `tmp = 0` declaration is a per-iteration SSA constant with no
// boundary write; `i = i + 1` is the only carrier step; no exits).
// Caller-zero: nothing invokes this entry from production routing.
//
// Boundary note (S7A D1, carried by the S7B1/S7B2/S7B3/S7B4 cards): the
// current executable `.hako` subset admits only scalar/string locals, `+`
// concat, loop/if, print, and return inside `Main.main()`. The artifact is
// therefore assembled here from named string-fragment locals in fixed serde
// field order. This entry is a wire-coverage emitter, not a producer: it
// reads no input and claims no Facts/RoutePolicy/JoinSig port (see
// README.md).
//
// Field names and tagged kinds mirror src/mir/loop_recipe_contract/schema.rs
// (serde, `tag = "kind"`, snake_case). Emission order is the serde field
// order; no map-key iteration exists on this path, so bytes are
// deterministic.

static box Main {
  main() {
    // ---- operations ---------------------------------------------------
    local op_read_carrier_c = "{\"kind\":\"read_binding\",\"binding\":0,\"result\":2}"
    local op_read_bound     = "{\"kind\":\"read_binding\",\"binding\":1,\"result\":3}"
    local op_cmp_less       = "{\"kind\":\"compare_i64\",\"op\":\"less\",\"left\":2,\"right\":3,\"result\":4}"
    local op_const_tmp      = "{\"kind\":\"const_i64\",\"result\":5,\"value\":0}"
    local op_read_carrier_b = "{\"kind\":\"read_binding\",\"binding\":0,\"result\":6}"
    local op_const_step     = "{\"kind\":\"const_i64\",\"result\":7,\"value\":1}"
    local op_add_step       = "{\"kind\":\"binary_i64\",\"op\":\"add\",\"left\":6,\"right\":7,\"result\":8}"
    local op_write_carrier  = "{\"kind\":\"write_binding\",\"binding\":0,\"value\":8}"

    // ---- item rows ------------------------------------------------------
    local items = "[" +
      "{\"key\":0,\"item\":{\"kind\":\"operation\",\"operation\":" + op_read_carrier_c + "}}," +
      "{\"key\":1,\"item\":{\"kind\":\"operation\",\"operation\":" + op_read_bound + "}}," +
      "{\"key\":2,\"item\":{\"kind\":\"operation\",\"operation\":" + op_cmp_less + "}}," +
      "{\"key\":3,\"item\":{\"kind\":\"operation\",\"operation\":" + op_const_tmp + "}}," +
      "{\"key\":4,\"item\":{\"kind\":\"operation\",\"operation\":" + op_read_carrier_b + "}}," +
      "{\"key\":5,\"item\":{\"kind\":\"operation\",\"operation\":" + op_const_step + "}}," +
      "{\"key\":6,\"item\":{\"kind\":\"operation\",\"operation\":" + op_add_step + "}}," +
      "{\"key\":7,\"item\":{\"kind\":\"operation\",\"operation\":" + op_write_carrier + "}}" +
      "]"

    // ---- loop node / blocks ---------------------------------------------
    local condition = "{\"kind\":\"predicate\",\"block\":0,\"value\":4}"
    local loops = "[" +
      "{\"key\":0,\"parent\":null,\"condition\":" + condition + ",\"body\":1}" +
      "]"
    local blocks = "[" +
      "{\"key\":0,\"owner_loop\":0,\"items\":[0,1,2]}," +
      "{\"key\":1,\"owner_loop\":0,\"items\":[3,4,5,6,7]}" +
      "]"

    // ---- bindings / values / carriers ------------------------------------
    local bindings = "[" +
      "{\"key\":0,\"label\":\"generic_residual_carrier\",\"class\":\"i64\"}," +
      "{\"key\":1,\"label\":\"generic_residual_bound\",\"class\":\"i64\"}" +
      "]"
    local values = "[" +
      "{\"key\":0,\"class\":\"i64\"},{\"key\":1,\"class\":\"i64\"}," +
      "{\"key\":2,\"class\":\"i64\"},{\"key\":3,\"class\":\"i64\"}," +
      "{\"key\":4,\"class\":\"bool\"},{\"key\":5,\"class\":\"i64\"}," +
      "{\"key\":6,\"class\":\"i64\"},{\"key\":7,\"class\":\"i64\"}," +
      "{\"key\":8,\"class\":\"i64\"}" +
      "]"
    local carriers = "[" +
      "{\"key\":0,\"owner_loop\":0,\"binding\":0,\"class\":\"i64\",\"entry_value\":0}," +
      "{\"key\":1,\"owner_loop\":0,\"binding\":1,\"class\":\"i64\",\"entry_value\":1}" +
      "]"

    // ---- recipe ------------------------------------------------------------
    local recipe = "{\"root_loop\":0," +
      "\"loops\":" + loops + "," +
      "\"blocks\":" + blocks + "," +
      "\"items\":" + items + "," +
      "\"bindings\":" + bindings + "," +
      "\"values\":" + values + "," +
      "\"inputs\":[0,1]," +
      "\"carriers\":" + carriers + "," +
      "\"exits\":[]}"

    // ---- provenance / source_binding ----------------------------------------
    local provenance = "{\"producer_id\":\"generic_residual_v1\"}"
    local owner = "{\"kind\":\"function_body\",\"compilation_unit_ordinal\":0,\"function_ordinal\":0}"
    local path = "{\"steps\":[{\"kind\":\"body_item\",\"index\":0}]}"
    local source_binding = "{\"owner\":" + owner + "," +
      "\"loops\":[{\"loop_key\":0,\"path\":" + path + "}]}"

    // ---- artifact -------------------------------------------------------------
    local artifact = "{\"schema_version\":1," +
      "\"provenance\":" + provenance + "," +
      "\"source_binding\":" + source_binding + "," +
      "\"recipe\":" + recipe + "}"

    print(artifact)
    return 0
  }
}

// program_json_dispatch_support_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) statement nodes structurally.
// - Classify whether the phase-state consumer has a dispatch path for them.
//
// Non-responsibility:
// - Adding dispatch support, RecipeMatcher execution, lowering, MIR mutation,
//   backend output, ID allocation, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonDispatchSupportShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = me._dispatch_kind_at(program_json, first)
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_node = me._node_name_at(program_json, first)
    if first_node == "If" {
      then_kind = me._first_dispatch_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_dispatch_kind_in_else(program_json, first)
    }

    local supported = me._supported_count(top_kind)
      + me._supported_count(then_kind)
      + me._supported_count(else_kind)
    local unsupported = me._unsupported_count(top_kind)
      + me._unsupported_count(then_kind)
      + me._unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=DispatchSupportShapeSnapshotV1"
      + ";top_dispatch_shape_kind=" + top_kind
      + ";if_then_dispatch_shape_kind=" + then_kind
      + ";if_else_dispatch_shape_kind=" + else_kind
      + ";dispatch_supported_count=" + me._count_token(supported)
      + ";dispatch_unsupported_count=" + me._count_token(unsupported)
  }

  _dispatch_kind_at(s, obj_start) {
    local node = me._node_name_at(s, obj_start)
    if node == "Print" { return "DispatchableNonControl" }
    if node == "Expr" { return "DispatchableNonControl" }
    if node == "Local" { return "DispatchableNonControl" }
    if node == "Assignment" { return "DispatchableNonControl" }
    if node == "Return" { return "DispatchableNonControl" }
    if node == "If" { return "DispatchableControl" }
    if node == "Loop" { return "DispatchableControl" }
    if node == "Try" { return "DispatchableTryCleanup" }
    if node == "Break" { return "UnsupportedExitMarker" }
    if node == "Continue" { return "UnsupportedExitMarker" }
    if node == "ContextScope" { return "UnsupportedScope" }
    if node == "TaskScope" { return "UnsupportedScope" }
    if node == "FastMemRegion" { return "UnsupportedScope" }
    if node == "Extern" { return "UnsupportedExternal" }
    if node == "FunctionDeclaration" { return "UnsupportedDeclaration" }
    if node == "EnumDeclaration" { return "UnsupportedDeclaration" }
    if node == "TypeAliasDeclaration" { return "UnsupportedDeclaration" }
    if node == "BoxDeclaration" { return "UnsupportedDeclaration" }
    return "UnsupportedOther"
  }

  _first_dispatch_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_dispatch_kind_in_array(s, array_start)
  }

  _first_dispatch_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "UnsupportedOther" }
    return me._first_dispatch_kind_in_array(s, p)
  }

  _first_dispatch_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    return me._dispatch_kind_at(s, first)
  }

  _supported_count(kind) {
    if kind == "DispatchableNonControl" { return 1 }
    if kind == "DispatchableControl" { return 1 }
    if kind == "DispatchableTryCleanup" { return 1 }
    return 0
  }

  _unsupported_count(kind) {
    if kind == "Missing" { return 0 }
    if me._supported_count(kind) > 0 { return 0 }
    return 1
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _node_name_at(s, obj_start) {
    local ty = me._string_field_at_quiet(s, "type", obj_start)
    if ty != "" { return ty }
    return me._string_field_at_quiet(s, "kind", obj_start)
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _string_field_at_quiet(s, key, obj_start) {
    local p = me._quiet_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }

  _quiet_obj_field_value_start(s, key, obj_start) {
    if s == null { return -1 }
    if obj_start < 0 { return -1 }
    local end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, obj_start)
    if end < 0 { return -1 }
    local obj = s.substring(obj_start, end)
    local needle = me._quiet_field_needle(key)
    local p = StringHelpers.index_of(obj, 0, needle)
    if p < 0 || (obj_start + p) >= end { return -1 }
    return obj_start + p + needle.length()
  }

  _quiet_field_needle(key) {
    if key == "kind" { return "\"kind\":" }
    if key == "type" { return "\"type\":" }
    return "\"" + ("" + key) + "\":"
  }
}

static box ProgramJsonDispatchSupportShapeScanMain { main() { return 0 } }

// program_json_context_scope_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) ContextScope statement objects structurally.
// - Emit ContextScopeShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, context
//   lowering semantics, route selection, MIR mutation, backend lowering, ID allocation,
//   or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonContextScopeShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local first_type = me._node_type_at(program_json, first)
    if first_type == "ContextScope" {
      return me._summary_for("top", me._context_scope_kind(program_json, first))
    }

    if first_type == "If" {
      local then_kind = me._first_context_scope_kind_in_array_field(program_json, first, "then")
      local else_kind = me._first_context_scope_kind_in_else(program_json, first)
      return me._summary("Missing", then_kind, else_kind)
    }

    return me._summary_for("top", "Unsupported")
  }

  _summary_for(slot, kind) {
    if slot == "top" { return me._summary(kind, "Missing", "Missing") }
    if slot == "then" { return me._summary("Missing", kind, "Missing") }
    if slot == "else" { return me._summary("Missing", "Missing", kind) }
    return me._summary("Unsupported", "Missing", "Missing")
  }

  _summary(top_kind, then_kind, else_kind) {
    local supported = me._supported_count(top_kind)
      + me._supported_count(then_kind)
      + me._supported_count(else_kind)
    local unsupported = me._unsupported_count(top_kind)
      + me._unsupported_count(then_kind)
      + me._unsupported_count(else_kind)
    return "snapshot_kind=ContextScopeShapeSnapshotV1"
      + ";top_context_scope_shape_kind=" + top_kind
      + ";if_then_context_scope_shape_kind=" + then_kind
      + ";if_else_context_scope_shape_kind=" + else_kind
      + ";supported_context_scope_count=" + me._count_token(supported)
      + ";unsupported_context_scope_count=" + me._count_token(unsupported)
  }

  _context_scope_kind(s, context_start) {
    if me._string_field_at(s, "spelling", context_start) == "" { return "Unsupported" }
    if me._string_field_at(s, "name", context_start) == "" { return "Unsupported" }
    local value = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "value", context_start)
    if value < 0 { return "Unsupported" }
    local value_kind = me._value_kind(s, value)
    if value_kind == "Unsupported" { return "Unsupported" }

    local body = me._array_field_start(s, "body", context_start)
    if body < 0 { return "Unsupported" }
    local body_kind = me._body_first_kind(s, body)
    if body_kind == "Unsupported" { return "Unsupported" }
    return "ContextValue" + value_kind + "Body" + body_kind
  }

  _value_kind(s, value_start) {
    local ty = me._node_type_at(s, value_start)
    if ty == "Var" { return "Var" }
    if ty == "Int" { return "Int" }
    if ty == "Str" { return "Str" }
    if ty == "Bool" { return "Bool" }
    return "Unsupported"
  }

  _body_first_kind(s, body_start) {
    local first = me._first_object_in_array(s, body_start)
    if first < 0 { return "Empty" }
    local ty = me._node_type_at(s, first)
    if ty == "Local" { return "Local" }
    if ty == "Return" { return "Return" }
    if ty == "Expr" { return "Expr" }
    if ty == "Loop" { return "Loop" }
    return "Unsupported"
  }

  _first_context_scope_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_context_scope_kind_in_array(s, array_start)
  }

  _first_context_scope_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_context_scope_kind_in_array(s, p)
  }

  _first_context_scope_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "ContextScope" { return "Unsupported" }
    return me._context_scope_kind(s, first)
  }

  _supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonContextScopeShapeScanMain { main() { return 0 } }

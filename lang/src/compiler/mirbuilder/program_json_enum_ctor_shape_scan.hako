// program_json_enum_ctor_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) EnumCtor expressions structurally.
// - Emit EnumCtorShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, enum lowering,
//   payload ABI materialization, route selection, MIR mutation, backend lowering,
//   ID allocation, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonEnumCtorShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local first_type = me._node_type_at(program_json, first)
    if first_type == "Local" || first_type == "Expr" || first_type == "Return" {
      return me._summary_from_kinds(me._stmt_enum_ctor_shape_kind(program_json, first), "Missing", "Missing")
    }
    if first_type == "If" {
      return me._summary_from_kinds(
        "Missing",
        me._first_enum_ctor_shape_kind_in_array_field(program_json, first, "then"),
        me._first_enum_ctor_shape_kind_in_else(program_json, first)
      )
    }
    return me._summary_from_kinds("Unsupported", "Missing", "Missing")
  }

  _summary_from_kinds(top_kind, then_kind, else_kind) {
    local supported = me._shape_supported_count(top_kind)
      + me._shape_supported_count(then_kind)
      + me._shape_supported_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=EnumCtorShapeSnapshotV1"
      + ";top_enum_ctor_shape_kind=" + top_kind
      + ";if_then_enum_ctor_shape_kind=" + then_kind
      + ";if_else_enum_ctor_shape_kind=" + else_kind
      + ";supported_enum_ctor_count=" + me._count_token(supported)
      + ";unsupported_enum_ctor_count=" + me._count_token(unsupported)
  }

  _stmt_enum_ctor_shape_kind(s, stmt_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", stmt_start)
    if expr < 0 { return "Unsupported" }
    return me._enum_ctor_kind(s, expr)
  }

  _enum_ctor_kind(s, expr_start) {
    if me._node_type_at(s, expr_start) != "EnumCtor" { return "Unsupported" }
    local enum_name = me._string_field_at(s, "enum", expr_start)
    local variant_name = me._string_field_at(s, "variant", expr_start)
    if enum_name == "" || variant_name == "" { return "Unsupported" }

    local args_start = me._array_field_start(s, "args", expr_start)
    if args_start < 0 { return "Unsupported" }
    local arg_count = me._count_objects_in_array(s, args_start)
    if arg_count < 0 { return "Unsupported" }
    if arg_count == 0 { return "NoPayload" }
    if arg_count > 2 { return "Unsupported" }

    local payload_type = me._nullable_string_field_at(s, "payload_type", expr_start)
    local first = me._first_object_in_array(s, args_start)
    if first < 0 { return "Unsupported" }
    local first_kind = me._value_kind(s, first)
    if first_kind == "Unsupported" { return "Unsupported" }
    if arg_count == 1 {
      return me._one_payload_kind(payload_type, first_kind)
    }
    local second = me._next_object_in_array(s, args_start, first)
    if second < 0 { return "Unsupported" }
    local second_kind = me._value_kind(s, second)
    if second_kind == "Unsupported" { return "Unsupported" }
    return me._two_payload_kind(payload_type, first_kind, second_kind)
  }

  _one_payload_kind(payload_type, first_kind) {
    if payload_type != "" { return "CompatBoxOnePayload" }
    if first_kind == "Int" { return "OneIntPayload" }
    if first_kind == "Str" { return "OneStrPayload" }
    if first_kind == "Bool" { return "OneBoolPayload" }
    if first_kind == "Var" { return "OneVarPayload" }
    return "OneOtherPayload"
  }

  _two_payload_kind(payload_type, first_kind, second_kind) {
    if payload_type != "" { return "CompatBoxTwoPayloads" }
    if first_kind == "Int" && second_kind == "Int" { return "TwoIntPayloads" }
    if first_kind == "Var" && second_kind == "Var" { return "TwoVarPayloads" }
    return "TwoMixedPayloads"
  }

  _value_kind(s, obj_start) {
    local ty = me._node_type_at(s, obj_start)
    if ty == "Int" { return "Int" }
    if ty == "Str" { return "Str" }
    if ty == "Bool" { return "Bool" }
    if ty == "Var" { return "Var" }
    if ty == "Null" { return "Null" }
    if ty == "New" { return "New" }
    return "Unsupported"
  }

  _first_enum_ctor_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_enum_ctor_shape_kind_in_array(s, array_start)
  }

  _first_enum_ctor_shape_kind_in_else(s, if_start) {
    local p = me._if_direct_else_value_start(s, if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_enum_ctor_shape_kind_in_array(s, p)
  }

  _first_enum_ctor_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    local first_type = me._node_type_at(s, first)
    if first_type != "Local" && first_type != "Expr" && first_type != "Return" { return "Unsupported" }
    return me._stmt_enum_ctor_shape_kind(s, first)
  }

  _shape_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _next_object_in_array(s, array_start, previous_start) {
    if array_start < 0 || previous_start < 0 { return -1 }
    local previous_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, previous_start)
    if previous_end < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, previous_end)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "," { return -1 }
    p = StringHelpers.skip_ws(s, p + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _count_objects_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 {
      local p = StringHelpers.skip_ws(s, array_start + 1)
      if ProgramJsonV0ScannerBox._read_char(s, p) == "]" { return 0 }
      return -1
    }
    local second = me._next_object_in_array(s, array_start, first)
    if second < 0 { return 1 }
    local third = me._next_object_in_array(s, array_start, second)
    if third < 0 { return 2 }
    return 3
  }

  _if_direct_else_value_start(s, if_start) {
    local then_start = me._array_field_start(s, "then", if_start)
    if then_start < 0 { return -1 }
    local then_end = me._array_end_unescaped(s, then_start)
    if then_end < 0 { return -1 }
    local p = StringHelpers.index_of(s, then_end, "\"else\":")
    if p < 0 { return -1 }
    local if_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, if_start)
    if if_end < 0 || p >= if_end { return -1 }
    return p + 7
  }

  _array_end_unescaped(s, array_start) {
    if array_start < 0 { return -1 }
    local n = s.length()
    local i = array_start
    local depth = 0
    local in_str = 0
    local esc = 0
    loop(i < n) {
      local ch = s.substring(i, i + 1)
      if in_str == 1 {
        if esc == 1 {
          esc = 0
        } else if ch == "\\" {
          esc = 1
        } else if ch == "\"" {
          in_str = 0
        }
      } else {
        if ch == "\"" {
          in_str = 1
        } else if ch == "[" {
          depth = depth + 1
        } else if ch == "]" {
          depth = depth - 1
          if depth == 0 { return i + 1 }
        }
      }
      i = i + 1
    }
    return -1
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _nullable_string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonEnumCtorShapeScanMain { main() { return 0 } }

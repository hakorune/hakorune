// program_json_expr_index_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Expr.expr Index objects structurally.
// - Emit ExprIndexShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, index
//   route selection, MIR mutation, backend lowering, ID allocation, or new ABI.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonExprIndexShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local first_type = me._node_type_at(program_json, first)

    if first_type == "Expr" {
      return me._summary_for("top", me._expr_index_shape_kind(program_json, first))
    }

    if first_type == "If" {
      local then_kind = me._first_expr_index_shape_kind_in_array_field(program_json, first, "then")
      local else_kind = me._first_expr_index_shape_kind_in_else(program_json, first)
      return me._summary("Missing", then_kind, else_kind)
    }

    return me._summary_for("top", "Unsupported")
  }

  _summary_for(slot, kind) {
    if slot == "top" { return me._summary(kind, "Missing", "Missing") }
    if slot == "then" { return me._summary("Missing", kind, "Missing") }
    if slot == "else" { return me._summary("Missing", "Missing", kind) }
    return me._summary("Unsupported", "Missing", "Missing")
  }

  _summary(top_kind, then_kind, else_kind) {
    local supported = me._supported_count(top_kind)
      + me._supported_count(then_kind)
      + me._supported_count(else_kind)
    local unsupported = me._unsupported_count(top_kind)
      + me._unsupported_count(then_kind)
      + me._unsupported_count(else_kind)
    return me._summary_with_counts(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary_with_counts(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=ExprIndexShapeSnapshotV1"
      + ";top_expr_index_shape_kind=" + top_kind
      + ";if_then_expr_index_shape_kind=" + then_kind
      + ";if_else_expr_index_shape_kind=" + else_kind
      + ";supported_expr_index_count=" + me._count_token(supported)
      + ";unsupported_expr_index_count=" + me._count_token(unsupported)
  }

  _expr_index_shape_kind(s, expr_stmt_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", expr_stmt_start)
    if expr < 0 { return "Unsupported" }
    if me._node_type_at(s, expr) != "Index" { return "Unsupported" }
    local target = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "target", expr)
    local index = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "index", expr)
    if target < 0 || index < 0 { return "Unsupported" }

    local target_kind = me._target_kind(s, target)
    local index_kind = me._index_kind(s, index)
    if target_kind == "Unsupported" || index_kind == "Unsupported" { return "Unsupported" }
    return "Target" + target_kind + "Index" + index_kind
  }

  _target_kind(s, obj_start) {
    local ty = me._node_type_at(s, obj_start)
    if ty == "Var" { return "Var" }
    if ty == "Field" { return me._field_target_kind(s, obj_start) }
    return "Unsupported"
  }

  _field_target_kind(s, obj_start) {
    local object = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "object", obj_start)
    if object < 0 { return "Unsupported" }
    if me._node_type_at(s, object) == "Var" { return "FieldVar" }
    return "Unsupported"
  }

  _index_kind(s, obj_start) {
    local ty = me._node_type_at(s, obj_start)
    if ty == "Int" { return "Int" }
    if ty == "Var" { return "Var" }
    if ty == "Compare" { return me._compare_index_kind(s, obj_start) }
    return "Unsupported"
  }

  _compare_index_kind(s, obj_start) {
    local lhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "lhs", obj_start)
    local rhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "rhs", obj_start)
    if lhs < 0 || rhs < 0 { return "Unsupported" }
    if me._node_type_at(s, lhs) != "Var" { return "Unsupported" }
    if me._node_type_at(s, rhs) != "Int" { return "Unsupported" }
    return "CompareVarInt"
  }

  _first_expr_index_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_expr_index_shape_kind_in_array(s, array_start)
  }

  _first_expr_index_shape_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_expr_index_shape_kind_in_array(s, p)
  }

  _first_expr_index_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Expr" { return "Unsupported" }
    return me._expr_index_shape_kind(s, first)
  }

  _supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonExprIndexShapeScanMain { main() { return 0 } }

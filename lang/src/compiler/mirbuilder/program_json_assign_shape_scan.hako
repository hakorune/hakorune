// program_json_assign_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Assign statements structurally.
// - Emit AssignShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, RecipeMatcher execution,
//   route selection, MIR mutation, backend lowering, ID allocation, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonAssignShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = "Missing"
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_type = me._node_type_at(program_json, first)

    if first_type == "Assign" {
      top_kind = me._assign_shape_kind(program_json, first)
    } else if first_type == "If" {
      then_kind = me._first_assign_shape_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_assign_shape_kind_in_else(program_json, first)
    } else {
      top_kind = "Unsupported"
    }

    local supported = me._shape_supported_count(top_kind)
      + me._shape_supported_count(then_kind)
      + me._shape_supported_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=AssignShapeSnapshotV1"
      + ";top_assign_shape_kind=" + top_kind
      + ";if_then_assign_shape_kind=" + then_kind
      + ";if_else_assign_shape_kind=" + else_kind
      + ";supported_assign_count=" + me._count_token(supported)
      + ";unsupported_assign_count=" + me._count_token(unsupported)
  }

  _assign_shape_kind(s, assign_start) {
    local target = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "target", assign_start)
    local value = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "value", assign_start)
    if target < 0 || value < 0 { return "Unsupported" }
    if me._node_type_at(s, target) != "Var" { return "Unsupported" }
    local value_kind = me._value_kind(s, value)
    if value_kind == "Unsupported" { return "Unsupported" }
    return "AssignVar" + value_kind
  }

  _value_kind(s, value_start) {
    local ty = me._node_type_at(s, value_start)
    if ty == "Int" { return "Int" }
    if ty == "Var" { return "Var" }
    if ty == "Bool" { return me._bool_kind(s, value_start) }
    if ty == "Compare" { return me._compare_kind(s, value_start) }
    if ty == "Binary" { return me._binary_kind(s, value_start) }
    return "Unsupported"
  }

  _compare_kind(s, expr_start) {
    local lhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "lhs", expr_start)
    local rhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "rhs", expr_start)
    if lhs < 0 || rhs < 0 { return "Unsupported" }
    if me._node_type_at(s, lhs) != "Var" { return "Unsupported" }
    if me._node_type_at(s, rhs) != "Int" { return "Unsupported" }

    local op = me._string_field_at(s, "op", expr_start)
    if op == "Lt" || op == "<" || op == "Less" { return "CompareVarLtInt" }
    if op == "Eq" || op == "==" || op == "Equal" { return "CompareVarEqInt" }
    return "Unsupported"
  }

  _binary_kind(s, expr_start) {
    local lhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "lhs", expr_start)
    local rhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "rhs", expr_start)
    if lhs < 0 || rhs < 0 { return "Unsupported" }
    if me._node_type_at(s, lhs) != "Var" { return "Unsupported" }
    if me._node_type_at(s, rhs) != "Int" { return "Unsupported" }

    local op = me._string_field_at(s, "op", expr_start)
    if op == "Add" || op == "+" { return "BinaryVarAddInt" }
    if op == "Sub" || op == "-" { return "BinaryVarSubInt" }
    return "Unsupported"
  }

  _bool_kind(s, expr_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "value", expr_start)
    if p < 0 { return "Unsupported" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "true" { return "BoolTrue" }
    if s.substring(p, p + 5) == "false" { return "BoolFalse" }
    return "Unsupported"
  }

  _first_assign_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_assign_shape_kind_in_array(s, array_start)
  }

  _first_assign_shape_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_assign_shape_kind_in_array(s, p)
  }

  _first_assign_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Assign" { return "Unsupported" }
    return me._assign_shape_kind(s, first)
  }

  _shape_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonAssignShapeScanMain { main() { return 0 } }

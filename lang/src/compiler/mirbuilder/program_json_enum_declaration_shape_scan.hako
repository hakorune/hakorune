// program_json_enum_declaration_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) EnumDeclaration objects structurally.
// - Emit EnumDeclarationShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, enum
//   lowering, variant resolution, MIR mutation, backend lowering, ID allocation,
//   or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonEnumDeclarationShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    if me._kind_at(program_json, first) != "EnumDeclaration" {
      return me._summary("Unsupported", 0, 1)
    }

    local kind = me._enum_decl_kind(program_json, first)
    return me._summary(kind, me._supported_count(kind), me._unsupported_count(kind))
  }

  _summary(kind, supported, unsupported) {
    return "snapshot_kind=EnumDeclarationShapeSnapshotV1"
      + ";top_enum_declaration_shape_kind=" + kind
      + ";supported_enum_declaration_count=" + me._count_token(supported)
      + ";unsupported_enum_declaration_count=" + me._count_token(unsupported)
  }

  _enum_decl_kind(s, enum_start) {
    if me._string_field_at(s, "name", enum_start) == "" { return "Unsupported" }
    local variants = me._array_field_start(s, "variants", enum_start)
    if variants < 0 { return "Unsupported" }
    local first_variant = me._first_object_in_array_or_empty(s, variants)
    if first_variant == -2 { return "EnumNoVariants" }
    if first_variant < 0 { return "Unsupported" }
    return "EnumFirst" + me._variant_kind(s, first_variant)
  }

  _variant_kind(s, variant_start) {
    if me._string_field_at(s, "name", variant_start) == "" { return "Unsupported" }

    local records = me._array_field_start_quiet(s, "record_fields", variant_start)
    if records >= 0 && me._array_has_first_object(s, records) == 1 {
      return "RecordVariant"
    }

    local tuples = me._array_field_start_quiet(s, "tuple_payload_types", variant_start)
    if tuples >= 0 && me._array_has_string_value(s, tuples) == 1 {
      return "TupleVariant"
    }

    local payload = me._nullable_string_field_at_quiet(s, "payload_type", variant_start)
    if payload == "Missing" { return "Unsupported" }
    if payload != "" { return "PayloadVariant" }
    return "UnitVariant"
  }

  _supported_count(kind) {
    if kind == "Unsupported" { return 0 }
    if kind == "EnumFirstUnsupported" { return 0 }
    return 1
  }

  _unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    if kind == "EnumFirstUnsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _array_field_start_quiet(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = me._quiet_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _quiet_obj_field_value_start(s, key, obj_start) {
    if s == null { return -1 }
    if obj_start < 0 { return -1 }
    local end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, obj_start)
    if end < 0 { return -1 }
    local obj = s.substring(obj_start, end)
    local needle = me._field_needle(key)
    local p = StringHelpers.index_of(obj, 0, needle)
    if p < 0 || (obj_start + p) >= end { return -1 }
    return obj_start + p + needle.length()
  }

  _field_needle(key) {
    if key == "payload_type" { return "\"payload_type\":" }
    if key == "record_fields" { return "\"record_fields\":" }
    if key == "tuple_payload_types" { return "\"tuple_payload_types\":" }
    return "\"" + ("" + key) + "\":"
  }

  _first_object_in_array_or_empty(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) == "]" { return -2 }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _array_has_first_object(s, array_start) {
    if me._first_object_in_array(s, array_start) >= 0 { return 1 }
    return 0
  }

  _array_has_string_value(s, array_start) {
    if array_start < 0 { return 0 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) == "\"" { return 1 }
    return 0
  }

  _kind_at(s, obj_start) {
    return me._string_field_at(s, "kind", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }

  _nullable_string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "Missing" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "Missing" }
    return s.substring(p + 1, end_quote)
  }

  _nullable_string_field_at_quiet(s, key, obj_start) {
    local p = me._quiet_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "Missing" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "Missing" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonEnumDeclarationShapeScanMain { main() { return 0 } }

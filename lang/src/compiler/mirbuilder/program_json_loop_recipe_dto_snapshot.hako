// program_json_loop_recipe_dto_snapshot.hako
// Responsibility:
// - Build a canonical Layer4 loop Recipe DTO snapshot from Program(JSON v0).
// - Consume PhaseState result maps and RecipeItem data only; no lowering.

using selfhost.shared.common.string_helpers as StringHelpers
using selfhost.shared.common.box_helpers as BoxHelpers
using lang.compiler.mirbuilder.program_json_v0_phase_state_box as ProgramJsonV0PhaseStateBox
using lang.compiler.mirbuilder.recipe.recipe_item_box as RecipeItemBox

static box ProgramJsonLoopRecipeDtoSnapshotBox {
  _i(map, key) {
    return StringHelpers.to_i64(BoxHelpers.map_get(map, key))
  }

  _s(map, key) {
    local v = BoxHelpers.map_get(map, key)
    if v == null { return "" }
    return "" + v
  }

  _ival(map, key) {
    local v = BoxHelpers.map_get(map, key)
    if v == null { return "" }
    return "" + v
  }

  _err(reason) {
    return "snapshot_kind=LoopRecipeDtoSnapshotV1;err=1;reason=" + reason
  }

  _stmt_ok(item, stmt_kind) {
    if item == null || BoxHelpers.is_map(item) != 1 { return 0 }
    if RecipeItemBox.kind_of(item) != "Seq" { return 0 }
    if me._s(item, "leaf_kind") != "Stmt" { return 0 }
    if me._s(item, "stmt_kind") != stmt_kind { return 0 }
    return 1
  }

  _summary_base(out, items, loop_item, final_return_stmt) {
    local cond = BoxHelpers.map_get(loop_item, "cond_facts")
    local body = BoxHelpers.map_get(loop_item, "body_item")
    if cond == null || BoxHelpers.is_map(cond) != 1 { return me._err("missing_loop_cond_facts") }
    if body == null || BoxHelpers.is_map(body) != 1 { return me._err("missing_loop_body_item") }
    if RecipeItemBox.kind_of(body) != "Seq" { return me._err("loop_body_not_seq") }

    local body_items = BoxHelpers.map_get(body, "items")
    if body_items == null || BoxHelpers.is_array(body_items) != 1 { return me._err("missing_loop_body_items") }
    local body_len = body_items.length()
    local final_facts = BoxHelpers.map_get(final_return_stmt, "facts")
    local return_kind = me._s(out, "return_kind")
    local ret_value = me._ival(out, "retv")
    if return_kind == "Var" { ret_value = me._s(out, "ret_var_name") }

    return "snapshot_kind=LoopRecipeDtoSnapshotV1"
      + ";err=0"
      + ";matched=1"
      + ";root_len=" + ("" + items.length())
      + ";local_name=" + me._s(out, "local_name")
      + ";return_kind=" + return_kind
      + ";return_value=" + ret_value
      + ";return_facts_kind=" + me._s(final_facts, "stmt_kind")
      + ";loop_cond_kind=" + me._s(cond, "cond_kind")
      + ";loop_cond_var=" + me._s(cond, "cond_var_name")
      + ";loop_cond_rhs_int=" + me._ival(cond, "cond_rhs_int")
      + ";loop_body_len=" + ("" + body_len)
  }

  _assignment_tail(summary, body_stmt) {
    if me._stmt_ok(body_stmt, "Assignment") != 1 { return me._err("loop_body_assignment_missing") }
    local facts = BoxHelpers.map_get(body_stmt, "facts")
    if facts == null || BoxHelpers.is_map(facts) != 1 { return me._err("loop_body_assignment_facts_missing") }
    return summary
      + ";shape_kind=phase11_local_loop_varltint_body_inc_return_var_or_int"
      + ";loop_body_kind=assignment_only"
      + ";loop_step_int=" + me._ival(facts, "step_int")
      + ";loop_if_cond_rhs_int="
      + ";loop_if_then_retv="
  }

  _if_tail(summary, if_item, assign_stmt) {
    if if_item == null || BoxHelpers.is_map(if_item) != 1 { return me._err("loop_if_missing") }
    if RecipeItemBox.kind_of(if_item) != "If" { return me._err("loop_if_not_if") }
    local if_cond = BoxHelpers.map_get(if_item, "cond_facts")
    local then_item = BoxHelpers.map_get(if_item, "then_item")
    if if_cond == null || BoxHelpers.is_map(if_cond) != 1 { return me._err("loop_if_cond_missing") }
    if then_item == null || BoxHelpers.is_map(then_item) != 1 { return me._err("loop_if_then_missing") }
    if RecipeItemBox.kind_of(then_item) != "Exit" { return me._err("loop_if_then_not_exit") }
    local payload = BoxHelpers.map_get(then_item, "payload")
    if payload == null || BoxHelpers.is_map(payload) != 1 { return me._err("loop_if_then_payload_missing") }
    if me._stmt_ok(assign_stmt, "Assignment") != 1 { return me._err("loop_if_assignment_missing") }
    local facts = BoxHelpers.map_get(assign_stmt, "facts")
    if facts == null || BoxHelpers.is_map(facts) != 1 { return me._err("loop_if_assignment_facts_missing") }

    return summary
      + ";shape_kind=phase21_local_loop_if_varltint_then_return_int_body_inc_return_var_or_int"
      + ";loop_body_kind=if_then_assignment"
      + ";loop_step_int=" + me._ival(facts, "step_int")
      + ";loop_if_cond_rhs_int=" + me._ival(if_cond, "cond_rhs_int")
      + ";loop_if_then_retv=" + me._ival(payload, "retv")
  }

  build_summary(program_json) {
    local out = ProgramJsonV0PhaseStateBox.parse(program_json, "[test]")
    if me._i(out, "err") != 0 { return me._err("parse_error") }
    local root = BoxHelpers.map_get(out, "recipe_root")
    if root == null || BoxHelpers.is_map(root) != 1 { return me._err("missing_recipe_root") }
    if RecipeItemBox.kind_of(root) != "Seq" { return me._err("recipe_root_not_seq") }
    local items = BoxHelpers.map_get(root, "items")
    if items == null || BoxHelpers.is_array(items) != 1 { return me._err("recipe_root_items_missing") }
    if items.length() != 3 { return me._err("recipe_root_len_not_3") }

    local local_stmt = BoxHelpers.array_get(items, 0)
    local loop_item = BoxHelpers.array_get(items, 1)
    local final_return_stmt = BoxHelpers.array_get(items, 2)
    if me._stmt_ok(local_stmt, "Local") != 1 { return me._err("first_stmt_not_local") }
    if loop_item == null || BoxHelpers.is_map(loop_item) != 1 { return me._err("loop_item_missing") }
    if RecipeItemBox.kind_of(loop_item) != "Loop" { return me._err("second_item_not_loop") }
    if me._stmt_ok(final_return_stmt, "Return") != 1 { return me._err("third_stmt_not_return") }

    local summary = me._summary_base(out, items, loop_item, final_return_stmt)
    if summary.indexOf("err=1") >= 0 { return summary }
    local body = BoxHelpers.map_get(loop_item, "body_item")
    local body_items = BoxHelpers.map_get(body, "items")
    local body_len = body_items.length()
    if body_len == 1 { return me._assignment_tail(summary, BoxHelpers.array_get(body_items, 0)) }
    if body_len == 2 { return me._if_tail(summary, BoxHelpers.array_get(body_items, 0), BoxHelpers.array_get(body_items, 1)) }
    return me._err("unsupported_loop_body_len")
  }
}

static box ProgramJsonLoopRecipeDtoSnapshotMain { main() { return 0 } }

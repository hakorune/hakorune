// program_json_looprange_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) LoopRange statement objects structurally.
// - Emit LoopRangeShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Loop lowering, iterator/range runtime semantics, RecipeMatcher execution,
//   route selection, MIR mutation, backend lowering, ID allocation, source text
//   matching, Rust ASTNode projection, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonLoopRangeShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local first_type = me._node_type_at(program_json, first)

    if first_type == "LoopRange" {
      local top_kind = me._looprange_kind(program_json, first)
      return me._summary_for(top_kind, "Missing", "Missing")
    } else if first_type == "If" {
      local then_kind = me._first_looprange_kind_in_array_field(program_json, first, "then")
      local else_kind = me._first_looprange_kind_in_else(program_json, first)
      return me._summary_for("Missing", then_kind, else_kind)
    }
    return me._summary_for("Unsupported", "Missing", "Missing")
  }

  _summary_for(top_kind, then_kind, else_kind) {
    local supported = me._shape_supported_count(top_kind)
      + me._shape_supported_count(then_kind)
      + me._shape_supported_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=LoopRangeShapeSnapshotV1"
      + ";top_looprange_shape_kind=" + top_kind
      + ";if_then_looprange_shape_kind=" + then_kind
      + ";if_else_looprange_shape_kind=" + else_kind
      + ";supported_looprange_count=" + me._count_token(supported)
      + ";unsupported_looprange_count=" + me._count_token(unsupported)
  }

  _looprange_kind(s, loop_start) {
    local start_expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "start", loop_start)
    local end_expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "end", loop_start)
    if start_expr < 0 || end_expr < 0 { return "Unsupported" }

    local bounds_kind = me._bounds_kind(s, start_expr, end_expr)
    if bounds_kind == "Unsupported" { return "Unsupported" }

    local body = me._array_field_start(s, "body", loop_start)
    if body < 0 { return "Unsupported" }
    local body_kind = me._loop_body_kind(s, body)

    if bounds_kind == "IntToInt" && body_kind == "EmptyBody" { return "IntToIntEmptyBody" }
    if bounds_kind == "VarToInt" && body_kind == "ContinueBody" { return "VarToIntContinueBody" }
    if bounds_kind == "IntToVar" && body_kind == "ReturnBody" { return "IntToVarReturnBody" }
    if bounds_kind == "VarToVar" && body_kind == "BreakBody" { return "VarToVarBreakBody" }
    return "Unsupported"
  }

  _bounds_kind(s, start_expr, end_expr) {
    local start_kind = me._bound_expr_kind(s, start_expr)
    local end_kind = me._bound_expr_kind(s, end_expr)
    if start_kind == "Int" && end_kind == "Int" { return "IntToInt" }
    if start_kind == "Var" && end_kind == "Int" { return "VarToInt" }
    if start_kind == "Int" && end_kind == "Var" { return "IntToVar" }
    if start_kind == "Var" && end_kind == "Var" { return "VarToVar" }
    return "Unsupported"
  }

  _bound_expr_kind(s, expr_start) {
    local ty = me._node_type_at(s, expr_start)
    if ty == "Int" { return "Int" }
    if ty == "Var" { return "Var" }
    return "Unsupported"
  }

  _loop_body_kind(s, array_start) {
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) == "]" { return "EmptyBody" }

    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Unsupported" }
    local ty = me._node_type_at(s, first)
    if ty == "Continue" { return "ContinueBody" }
    if ty == "Break" { return "BreakBody" }
    if ty == "Return" { return "ReturnBody" }
    if ty == "Loop" || ty == "LoopRange" { return "NestedLoopUnsupported" }
    return "OtherBodyUnsupported"
  }

  _first_looprange_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_looprange_kind_in_array(s, array_start)
  }

  _first_looprange_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_looprange_kind_in_array(s, p)
  }

  _first_looprange_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "LoopRange" { return "Unsupported" }
    return me._looprange_kind(s, first)
  }

  _shape_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonLoopRangeShapeScanMain { main() { return 0 } }

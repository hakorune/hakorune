// program_json_extern_stmt_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Extern statement shapes structurally.
// - Emit ExternStmtShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, extern route lowering,
//   route selection, MIR mutation, backend lowering, ID allocation, or new ABI.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonExternStmtShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = "Missing"
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_type = me._node_type_at(program_json, first)

    if first_type == "Extern" {
      top_kind = me._extern_stmt_shape_kind(program_json, first)
    } else if first_type == "If" {
      then_kind = me._first_extern_stmt_shape_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_extern_stmt_shape_kind_in_else(program_json, first)
    } else {
      top_kind = "Unsupported"
    }

    local supported = me._supported_count(top_kind)
      + me._supported_count(then_kind)
      + me._supported_count(else_kind)
    local unsupported = me._unsupported_count(top_kind)
      + me._unsupported_count(then_kind)
      + me._unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=ExternStmtShapeSnapshotV1"
      + ";top_extern_stmt_shape_kind=" + top_kind
      + ";if_then_extern_stmt_shape_kind=" + then_kind
      + ";if_else_extern_stmt_shape_kind=" + else_kind
      + ";supported_extern_stmt_count=" + me._count_token(supported)
      + ";unsupported_extern_stmt_count=" + me._count_token(unsupported)
  }

  _extern_stmt_shape_kind(s, stmt_start) {
    local iface = me._string_field_at(s, "iface", stmt_start)
    local method = me._string_field_at(s, "method", stmt_start)
    local args_start = me._array_field_start(s, "args", stmt_start)
    if iface == "" || method == "" || args_start < 0 { return "Unsupported" }

    local argc = me._count_objects_in_array(s, args_start)
    if argc < 0 { return "Unsupported" }
    if argc > 1 { return "Unsupported" }

    local target = me._target_kind(iface, method)
    if target == "Unsupported" { return "Unsupported" }
    if argc == 0 { return target + "NoArg" }

    local first = me._first_object_in_array(s, args_start)
    if first < 0 { return "Unsupported" }
    local arg_kind = me._arg_kind(s, first)
    if arg_kind == "Unsupported" { return "Unsupported" }
    return target + arg_kind + "Arg"
  }

  _target_kind(iface, method) {
    if iface == "env.console" {
      if method == "log" { return "EnvConsoleLog" }
      if method == "warn" { return "EnvConsoleWarn" }
      if method == "error" { return "EnvConsoleError" }
    }
    return "Unsupported"
  }

  _arg_kind(s, arg_start) {
    local ty = me._node_type_at(s, arg_start)
    if ty == "Int" { return "Int" }
    if ty == "Var" { return "Var" }
    if ty == "Str" { return "Str" }
    if ty == "Bool" { return "Bool" }
    return "Unsupported"
  }

  _first_extern_stmt_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_extern_stmt_shape_kind_in_array(s, array_start)
  }

  _first_extern_stmt_shape_kind_in_else(s, if_start) {
    local p = me._if_direct_else_value_start(s, if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_extern_stmt_shape_kind_in_array(s, p)
  }

  _first_extern_stmt_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Extern" { return "Unsupported" }
    return me._extern_stmt_shape_kind(s, first)
  }

  _supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _next_object_in_array(s, previous_start) {
    if previous_start < 0 { return -1 }
    local previous_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, previous_start)
    if previous_end < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, previous_end)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "," { return -1 }
    p = StringHelpers.skip_ws(s, p + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _count_objects_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 {
      local p = StringHelpers.skip_ws(s, array_start + 1)
      if ProgramJsonV0ScannerBox._read_char(s, p) == "]" { return 0 }
      return -1
    }
    local second = me._next_object_in_array(s, first)
    if second < 0 { return 1 }
    local third = me._next_object_in_array(s, second)
    if third < 0 { return 2 }
    return 3
  }

  _if_direct_else_value_start(s, if_start) {
    local then_start = me._array_field_start(s, "then", if_start)
    if then_start < 0 { return -1 }
    local then_end = me._array_end_unescaped(s, then_start)
    if then_end < 0 { return -1 }
    local p = StringHelpers.index_of(s, then_end, "\"else\":")
    if p < 0 { return -1 }
    local if_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, if_start)
    if if_end < 0 || p >= if_end { return -1 }
    return p + 7
  }

  _array_end_unescaped(s, array_start) {
    if array_start < 0 { return -1 }
    local n = s.length()
    local i = array_start
    local depth = 0
    local in_str = 0
    local esc = 0
    loop(i < n) {
      local ch = s.substring(i, i + 1)
      if in_str == 1 {
        if esc == 1 {
          esc = 0
        } else if ch == "\\" {
          esc = 1
        } else if ch == "\"" {
          in_str = 0
        }
      } else {
        if ch == "\"" {
          in_str = 1
        } else if ch == "[" {
          depth = depth + 1
        } else if ch == "]" {
          depth = depth - 1
          if depth == 0 { return i + 1 }
        }
      }
      i = i + 1
    }
    return -1
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonExternStmtShapeScanMain { main() { return 0 } }

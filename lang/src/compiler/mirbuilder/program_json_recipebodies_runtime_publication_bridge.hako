// program_json_recipebodies_runtime_publication_bridge.hako
// Responsibility:
// - Publish a verifier-accepted RecipeBodies snapshot as a read-only runtime boundary.
// - Do not execute RecipeMatcher, select routes, lower, mutate, allocate IDs, or switch runtime routes.

using selfhost.shared.common.string_helpers as StringHelpers
using selfhost.shared.common.box_helpers as BoxHelpers
using lang.compiler.mirbuilder.program_json_v0_phase_state_box as ProgramJsonV0PhaseStateBox
using lang.compiler.mirbuilder.program_json_recipebodies_recursive_nested_arena_builder as ProgramJsonRecipeBodiesRecursiveNestedArenaBuilderBox
using lang.compiler.mirbuilder.recipe.recipe_verifier_box as RecipeVerifierBox
using lang.compiler.mirbuilder.recipe.recipe_port_sig_box as RecipePortSigBox

static box ProgramJsonRecipeBodiesRuntimePublicationBridgeBox {
  _i(map, key) {
    return StringHelpers.to_i64(BoxHelpers.map_get(map, key))
  }

  _err(reason): MapBox {
    return %{
      "ok" => 0,
      "reason" => reason,
      "publication_id" => -1,
      "verified_recipe_present" => 0,
      "verifier_boundary_used" => 0,
      "body_count" => 0,
      "def_count" => 0,
      "update_count" => 0,
      "readonly" => 1,
      "recipe_matcher_executed" => 0
    }
  }

  _arena_ready(arena) {
    if arena == null || BoxHelpers.is_map(arena) != 1 { return 0 }
    if me._i(arena, "err") != 0 { return 0 }
    if me._i(arena, "root_body_id") != 0 { return 0 }
    if me._i(arena, "body_count") != 4 { return 0 }
    local bodies = BoxHelpers.map_get(arena, "bodies")
    if bodies == null || BoxHelpers.is_array(bodies) != 1 { return 0 }
    return 1
  }

  build_publication(program_json): MapBox {
    local arena = ProgramJsonRecipeBodiesRecursiveNestedArenaBuilderBox.build_arena(program_json)
    if me._arena_ready(arena) != 1 { return me._err("arena_not_ready") }

    local out = ProgramJsonV0PhaseStateBox.parse(program_json, "[test]")
    if me._i(out, "err") != 0 { return me._err("parse_error") }

    local root = BoxHelpers.map_get(out, "recipe_root")
    if root == null || BoxHelpers.is_map(root) != 1 {
      return me._err("missing_recipe_root")
    }

    local verify = RecipeVerifierBox.verify(root, "[test]")
    if me._i(verify, "err") != 0 { return me._err("verify_error") }

    local verified = BoxHelpers.map_get(verify, "verified_recipe")
    if verified == null || BoxHelpers.is_map(verified) != 1 {
      return me._err("missing_verified_recipe")
    }

    local port_sig = BoxHelpers.map_get(verify, "port_sig")
    if port_sig == null || BoxHelpers.is_map(port_sig) != 1 {
      return me._err("missing_port_sig")
    }
    local snap = RecipePortSigBox.snapshot(port_sig)
    if snap == null || BoxHelpers.is_map(snap) != 1 {
      return me._err("missing_port_sig_snapshot")
    }

    return %{
      "ok" => 1,
      "reason" => "",
      "publication_id" => 1,
      "verified_recipe_present" => 1,
      "verifier_boundary_used" => 1,
      "body_count" => me._i(arena, "body_count"),
      "def_count" => me._i(snap, "def_count"),
      "update_count" => me._i(snap, "update_count"),
      "readonly" => 1,
      "recipe_matcher_executed" => 0
    }
  }

  publication_summary(publication) {
    if publication == null || BoxHelpers.is_map(publication) != 1 {
      return "snapshot_kind=RecipeBodiesPublicationSnapshotV1;ok=0;reason=missing_publication"
    }
    return "snapshot_kind=RecipeBodiesPublicationSnapshotV1"
      + ";ok=" + StringHelpers.int_to_str(me._i(publication, "ok"))
      + ";publication_id=" + StringHelpers.int_to_str(me._i(publication, "publication_id"))
      + ";verified_recipe_present=" + StringHelpers.int_to_str(me._i(publication, "verified_recipe_present"))
      + ";verifier_boundary_used=" + StringHelpers.int_to_str(me._i(publication, "verifier_boundary_used"))
      + ";body_count=" + StringHelpers.int_to_str(me._i(publication, "body_count"))
      + ";def_count=" + StringHelpers.int_to_str(me._i(publication, "def_count"))
      + ";update_count=" + StringHelpers.int_to_str(me._i(publication, "update_count"))
      + ";readonly=" + StringHelpers.int_to_str(me._i(publication, "readonly"))
      + ";recipe_matcher_executed=" + StringHelpers.int_to_str(me._i(publication, "recipe_matcher_executed"))
      + ";non_claims=recipe_matcher,route_selection,lowering,mutation,id_allocation,runtime_route_switch"
  }
}

static box ProgramJsonRecipeBodiesRuntimePublicationBridgeMain { main() { return 0 } }

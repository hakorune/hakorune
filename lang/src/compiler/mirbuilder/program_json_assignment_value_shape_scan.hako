// program_json_assignment_value_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Local.name + Local.expr assignment-value shapes.
// - Emit AssignmentValueShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Legacy Assign proof, full JSON parsing, source text matching, Rust ASTNode projection,
//   RecipeMatcher execution, route selection, MIR mutation, backend lowering, ID allocation,
//   or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonAssignmentValueShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = "Missing"
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_type = me._node_type_at(program_json, first)

    if first_type == "Local" {
      top_kind = me._local_assignment_value_kind(program_json, first)
    } else if first_type == "If" {
      then_kind = me._first_local_assignment_value_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_local_assignment_value_kind_in_else(program_json, first)
    } else {
      top_kind = "Unsupported"
    }

    local inc = me._self_increment_count(top_kind)
      + me._self_increment_count(then_kind)
      + me._self_increment_count(else_kind)
    local dec = me._self_decrement_count(top_kind)
      + me._self_decrement_count(then_kind)
      + me._self_decrement_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, inc, dec, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, inc, dec, unsupported) {
    return "snapshot_kind=AssignmentValueShapeSnapshotV1"
      + ";top_assignment_value_shape_kind=" + top_kind
      + ";if_then_assignment_value_shape_kind=" + then_kind
      + ";if_else_assignment_value_shape_kind=" + else_kind
      + ";self_increment_candidate_count=" + me._count_token(inc)
      + ";self_decrement_candidate_count=" + me._count_token(dec)
      + ";unsupported_value_count=" + me._count_token(unsupported)
  }

  _local_assignment_value_kind(s, local_start) {
    local name = me._string_field_at(s, "name", local_start)
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", local_start)
    if name == "" || expr < 0 { return "Unsupported" }
    local expr_ty = me._node_type_at(s, expr)
    if expr_ty != "Binary" { return "Unsupported" }
    return me._binary_assignment_value_kind(s, expr, name)
  }

  _binary_assignment_value_kind(s, expr_start, name) {
    local lhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "lhs", expr_start)
    local rhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "rhs", expr_start)
    if lhs < 0 || rhs < 0 { return "Unsupported" }

    local lhs_self = me._var_name_matches(s, lhs, name)
    local rhs_self = me._var_name_matches(s, rhs, name)
    local lhs_int = me._node_type_is(s, lhs, "Int")
    local rhs_int = me._node_type_is(s, rhs, "Int")

    local op = me._string_field_at(s, "op", expr_start)
    if op == "Add" || op == "+" {
      if lhs_self == 1 && rhs_int == 1 { return "SelfAddIntRhs" }
      if lhs_int == 1 && rhs_self == 1 { return "SelfAddIntLhs" }
      return "Unsupported"
    }
    if op == "Sub" || op == "-" {
      if lhs_self == 1 && rhs_int == 1 { return "SelfSubIntRhs" }
      if lhs_int == 1 && rhs_self == 1 { return "SelfSubIntLhs" }
      return "Unsupported"
    }
    return "Unsupported"
  }

  _var_name_matches(s, obj_start, expected) {
    if me._node_type_at(s, obj_start) != "Var" { return 0 }
    if me._string_field_at(s, "name", obj_start) == expected { return 1 }
    return 0
  }

  _node_type_is(s, obj_start, expected) {
    if me._node_type_at(s, obj_start) == expected { return 1 }
    return 0
  }

  _first_local_assignment_value_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_local_assignment_value_kind_in_array(s, array_start)
  }

  _first_local_assignment_value_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_local_assignment_value_kind_in_array(s, p)
  }

  _first_local_assignment_value_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Local" { return "Unsupported" }
    return me._local_assignment_value_kind(s, first)
  }

  _self_increment_count(kind) {
    if kind == "SelfAddIntRhs" { return 1 }
    if kind == "SelfAddIntLhs" { return 1 }
    return 0
  }

  _self_decrement_count(kind) {
    if kind == "SelfSubIntRhs" { return 1 }
    if kind == "SelfSubIntLhs" { return 1 }
    return 0
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonAssignmentValueShapeScanMain { main() { return 0 } }

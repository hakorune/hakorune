// program_json_local_match_expr_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Local.expr Match objects structurally.
// - Emit LocalMatchExprShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, match lowering,
//   branch execution semantics, route selection, MIR mutation, backend lowering,
//   ID allocation, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonLocalMatchExprShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local first_type = me._node_type_at(program_json, first)
    if first_type == "Local" {
      return me._summary_from_kinds(me._local_match_expr_shape_kind(program_json, first), "Missing", "Missing")
    }
    if first_type == "If" {
      return me._summary_from_kinds(
        "Missing",
        me._first_local_match_expr_shape_kind_in_array_field(program_json, first, "then"),
        me._first_local_match_expr_shape_kind_in_else(program_json, first)
      )
    }
    return me._summary_from_kinds("Unsupported", "Missing", "Missing")
  }

  _summary_from_kinds(top_kind, then_kind, else_kind) {
    local supported = me._shape_supported_count(top_kind)
      + me._shape_supported_count(then_kind)
      + me._shape_supported_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=LocalMatchExprShapeSnapshotV1"
      + ";top_local_match_expr_shape_kind=" + top_kind
      + ";if_then_local_match_expr_shape_kind=" + then_kind
      + ";if_else_local_match_expr_shape_kind=" + else_kind
      + ";supported_local_match_expr_count=" + me._count_token(supported)
      + ";unsupported_local_match_expr_count=" + me._count_token(unsupported)
  }

  _local_match_expr_shape_kind(s, local_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", local_start)
    if expr < 0 { return "Unsupported" }
    if me._node_type_at(s, expr) != "Match" { return "Unsupported" }
    return me._match_expr_kind(s, expr)
  }

  _match_expr_kind(s, match_start) {
    local scrutinee = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "scrutinee", match_start)
    if scrutinee < 0 { return "Unsupported" }
    local scrutinee_kind = me._value_kind(s, scrutinee)
    if scrutinee_kind == "Unsupported" { return "Unsupported" }

    local arms = me._array_field_start(s, "arms", match_start)
    if arms < 0 { return "Unsupported" }
    local first = me._first_object_in_array(s, arms)
    if first < 0 { return "Unsupported" }
    local first_label = me._string_field_at(s, "label", first)
    local first_expr = me._arm_expr_kind(s, first)
    if first_label == "" || first_expr == "Unsupported" { return "Unsupported" }

    local second = me._next_object_in_array(s, arms, first)
    if second < 0 { return me._one_arm_kind(scrutinee_kind, first_label, first_expr, me._else_kind(s, match_start)) }
    local second_label = me._string_field_at(s, "label", second)
    local second_expr = me._arm_expr_kind(s, second)
    if second_label == "" || second_expr == "Unsupported" { return "Unsupported" }

    local third = me._next_object_in_array(s, arms, second)
    if third >= 0 { return "Unsupported" }
    return me._two_arm_kind(scrutinee_kind, first_label, first_expr, second_label, second_expr, me._else_kind(s, match_start))
  }

  _else_kind(s, match_start) {
    local else_expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "else", match_start)
    if else_expr < 0 { return "Unsupported" }
    return me._value_kind(s, else_expr)
  }

  _one_arm_kind(scrutinee_kind, label, expr_kind, else_kind) {
    if else_kind == "Unsupported" { return "Unsupported" }
    if scrutinee_kind == "Var" && label == "0" && expr_kind == "Int" && else_kind == "Int" {
      return "VarOneIntArmElseInt"
    }
    if scrutinee_kind == "Int" && label == "1" && expr_kind == "Str" && else_kind == "Str" {
      return "IntOneStrArmElseStr"
    }
    return "OneArmElseValue"
  }

  _two_arm_kind(scrutinee_kind, first_label, first_expr, second_label, second_expr, else_kind) {
    if else_kind == "Unsupported" { return "Unsupported" }
    if scrutinee_kind == "Var" && first_label == "0" && first_expr == "Int" && second_label == "1" && second_expr == "Int" && else_kind == "Int" {
      return "VarTwoIntArmsElseInt"
    }
    if scrutinee_kind == "Var" && first_label == "true" && first_expr == "Bool" && second_label == "false" && second_expr == "Bool" && else_kind == "Bool" {
      return "VarBoolArmsElseBool"
    }
    return "TwoArmsElseValue"
  }

  _arm_expr_kind(s, arm_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", arm_start)
    if expr < 0 { return "Unsupported" }
    return me._value_kind(s, expr)
  }

  _value_kind(s, obj_start) {
    local ty = me._node_type_at(s, obj_start)
    if ty == "Int" { return "Int" }
    if ty == "Str" { return "Str" }
    if ty == "Bool" { return "Bool" }
    if ty == "Var" { return "Var" }
    if ty == "Null" { return "Null" }
    return "Unsupported"
  }

  _first_local_match_expr_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_local_match_expr_shape_kind_in_array(s, array_start)
  }

  _first_local_match_expr_shape_kind_in_else(s, if_start) {
    local p = me._if_direct_else_value_start(s, if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_local_match_expr_shape_kind_in_array(s, p)
  }

  _if_direct_else_value_start(s, if_start) {
    local then_start = me._array_field_start(s, "then", if_start)
    if then_start < 0 { return -1 }
    local then_end = me._array_end_unescaped(s, then_start)
    if then_end < 0 { return -1 }
    local p = StringHelpers.index_of(s, then_end, "\"else\":")
    if p < 0 { return -1 }
    local if_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, if_start)
    if if_end < 0 || p >= if_end { return -1 }
    return p + 7
  }

  _array_end_unescaped(s, array_start) {
    if array_start < 0 { return -1 }
    local n = s.length()
    local i = array_start
    local depth = 0
    local in_str = 0
    local esc = 0
    loop(i < n) {
      local ch = s.substring(i, i + 1)
      if in_str == 1 {
        if esc == 1 {
          esc = 0
        } else if ch == "\\" {
          esc = 1
        } else if ch == "\"" {
          in_str = 0
        }
      } else {
        if ch == "\"" {
          in_str = 1
        } else if ch == "[" {
          depth = depth + 1
        } else if ch == "]" {
          depth = depth - 1
          if depth == 0 { return i + 1 }
        }
      }
      i = i + 1
    }
    return -1
  }

  _first_local_match_expr_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Local" { return "Unsupported" }
    return me._local_match_expr_shape_kind(s, first)
  }

  _shape_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _next_object_in_array(s, array_start, previous_start) {
    if array_start < 0 || previous_start < 0 { return -1 }
    local previous_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, previous_start)
    if previous_end < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, previous_end)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "," { return -1 }
    p = StringHelpers.skip_ws(s, p + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonLocalMatchExprShapeScanMain { main() { return 0 } }

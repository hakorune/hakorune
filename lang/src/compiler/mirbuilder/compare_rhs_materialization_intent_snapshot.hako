// compare_rhs_materialization_intent_snapshot.hako
//
// Responsibility:
// - Classify Compare RHS materialization needs from a symbolic command.
// - Publish a read-only intent snapshot for later ValueId/runtime work.
//
// Non-responsibility:
// - Symbol lookup to ValueId, constant/helper emission, rhs runtime
//   materialization, MIR Compare/Branch emission, BasicBlock mutation,
//   ValueId allocation, route selection, runtime route switch, or Source Selfhost.

using selfhost.shared.common.string_helpers as StringHelpers
using selfhost.shared.common.box_helpers as BoxHelpers
using lang.compiler.mirbuilder.compare_lowering_symbolic_command_snapshot as CompareLoweringSymbolicCommandSnapshotBox

static box CompareRhsMaterializationIntentSnapshotBox {
  _i(map, key) {
    return StringHelpers.to_i64(BoxHelpers.map_get(map, key))
  }

  _err(reason_code): MapBox {
    return %{
      "ok" => 0,
      "reason_code" => reason_code,
      "rhs_materialization_intent_ready" => 0,
      "rhs_bound_kind_code" => 99,
      "rhs_bound_i64" => 0,
      "rhs_bound_symbol_id" => 0,
      "rhs_materialization_kind_code" => 99,
      "literal_i64_required" => 0,
      "symbol_lookup_required" => 0,
      "analysis_only" => 1,
      "rhs_value_id_resolution" => 0,
      "rhs_runtime_materialization" => 0,
      "constant_mir_emission" => 0,
      "runtime_helper_emission" => 0,
      "mir_cmp_emission" => 0,
      "branch_emission" => 0,
      "basic_block_mutation" => 0,
      "value_id_allocation" => 0,
      "route_selection" => 0,
      "runtime_route_switch" => 0,
      "source_selfhost_claim" => 0
    }
  }

  build_intent(program_json): MapBox {
    local command = CompareLoweringSymbolicCommandSnapshotBox.build_command(program_json)
    return me.build_intent_from_command(command)
  }

  build_intent_from_command(command): MapBox {
    if command == null || BoxHelpers.is_map(command) != 1 { return me._err(1) }
    if me._i(command, "ok") != 1 { return me._err(2) }
    if me._i(command, "symbolic_command_ready") != 1 { return me._err(3) }
    if me._i(command, "analysis_only") != 1 { return me._err(4) }
    if me._i(command, "rhs_runtime_materialization") != 0 { return me._err(5) }

    local rhs_kind = me._i(command, "rhs_bound_kind_code")
    if rhs_kind == 1 {
      return me._ok(command, 1, 1, 0)
    }
    if rhs_kind == 2 {
      return me._ok(command, 2, 0, 1)
    }
    return me._err(6)
  }

  _ok(command, materialization_kind, literal_required, symbol_required): MapBox {
    return %{
      "ok" => 1,
      "reason_code" => 0,
      "rhs_materialization_intent_ready" => 1,
      "rhs_bound_kind_code" => me._i(command, "rhs_bound_kind_code"),
      "rhs_bound_i64" => me._i(command, "rhs_bound_i64"),
      "rhs_bound_symbol_id" => me._i(command, "rhs_bound_symbol_id"),
      "rhs_materialization_kind_code" => materialization_kind,
      "literal_i64_required" => literal_required,
      "symbol_lookup_required" => symbol_required,
      "analysis_only" => 1,
      "rhs_value_id_resolution" => 0,
      "rhs_runtime_materialization" => 0,
      "constant_mir_emission" => 0,
      "runtime_helper_emission" => 0,
      "mir_cmp_emission" => 0,
      "branch_emission" => 0,
      "basic_block_mutation" => 0,
      "value_id_allocation" => 0,
      "route_selection" => 0,
      "runtime_route_switch" => 0,
      "source_selfhost_claim" => 0
    }
  }

  intent_summary(intent) {
    if intent == null || BoxHelpers.is_map(intent) != 1 {
      return "snapshot_kind=CompareRhsMaterializationIntentSnapshotV1;ok=0;reason=missing_intent"
    }
    return "snapshot_kind=CompareRhsMaterializationIntentSnapshotV1"
      + ";ok=" + StringHelpers.int_to_str(me._i(intent, "ok"))
      + ";rhs_materialization_intent_ready=" + StringHelpers.int_to_str(me._i(intent, "rhs_materialization_intent_ready"))
      + ";bound_kind=" + me._bound_kind_name(me._i(intent, "rhs_bound_kind_code"))
      + ";bound_kind_code=" + StringHelpers.int_to_str(me._i(intent, "rhs_bound_kind_code"))
      + ";bound_i64=" + StringHelpers.int_to_str(me._i(intent, "rhs_bound_i64"))
      + ";bound_symbol_id=" + StringHelpers.int_to_str(me._i(intent, "rhs_bound_symbol_id"))
      + ";rhs_materialization_kind=" + me._materialization_kind_name(me._i(intent, "rhs_materialization_kind_code"))
      + ";rhs_materialization_kind_code=" + StringHelpers.int_to_str(me._i(intent, "rhs_materialization_kind_code"))
      + ";literal_i64_required=" + StringHelpers.int_to_str(me._i(intent, "literal_i64_required"))
      + ";symbol_lookup_required=" + StringHelpers.int_to_str(me._i(intent, "symbol_lookup_required"))
      + ";analysis_only=" + StringHelpers.int_to_str(me._i(intent, "analysis_only"))
      + ";rhs_value_id_resolution=" + StringHelpers.int_to_str(me._i(intent, "rhs_value_id_resolution"))
      + ";rhs_runtime_materialization=" + StringHelpers.int_to_str(me._i(intent, "rhs_runtime_materialization"))
      + ";constant_mir_emission=" + StringHelpers.int_to_str(me._i(intent, "constant_mir_emission"))
      + ";runtime_helper_emission=" + StringHelpers.int_to_str(me._i(intent, "runtime_helper_emission"))
      + ";mir_cmp_emission=" + StringHelpers.int_to_str(me._i(intent, "mir_cmp_emission"))
      + ";branch_emission=" + StringHelpers.int_to_str(me._i(intent, "branch_emission"))
      + ";basic_block_mutation=" + StringHelpers.int_to_str(me._i(intent, "basic_block_mutation"))
      + ";value_id_allocation=" + StringHelpers.int_to_str(me._i(intent, "value_id_allocation"))
      + ";route_selection=" + StringHelpers.int_to_str(me._i(intent, "route_selection"))
      + ";runtime_route_switch=" + StringHelpers.int_to_str(me._i(intent, "runtime_route_switch"))
      + ";source_selfhost_claim=" + StringHelpers.int_to_str(me._i(intent, "source_selfhost_claim"))
  }

  _bound_kind_name(kind_code) {
    if kind_code == 1 { return "LiteralI64" }
    if kind_code == 2 { return "SymbolRef" }
    return "Unsupported"
  }

  _materialization_kind_name(kind_code) {
    if kind_code == 1 { return "LiteralI64Intent" }
    if kind_code == 2 { return "SymbolLookupIntent" }
    return "Unsupported"
  }
}

static box CompareRhsMaterializationIntentSnapshotMain { main() { return 0 } }

// program_json_stmt_only_block_recipe_snapshot.hako
// Responsibility:
// - Bridge Program(JSON v0) recipe_root to the existing StmtOnlyBlockRecipeBox token reducer.
// - Keep this as a snapshot/proof owner only; no lowering, route selection, or MIR mutation.

using selfhost.shared.common.string_helpers as StringHelpers
using selfhost.shared.common.box_helpers as BoxHelpers
using lang.compiler.mirbuilder.program_json_v0_phase_state_box as ProgramJsonV0PhaseStateBox
using lang.compiler.mirbuilder.recipe.recipe_item_box as RecipeItemBox
using lang.compiler.lib.stmt_only_block_recipe as StmtOnlyBlockRecipeBox

static box ProgramJsonStmtOnlyBlockRecipeSnapshotBox {
  _i(map, key) {
    return StringHelpers.to_i64(BoxHelpers.map_get(map, key))
  }

  _err(reason) {
    return "snapshot_kind=ProgramJsonStmtOnlyBlockRecipeSnapshotV1;err=1;reason=" + reason
  }

  build_summary(program_json) {
    local out = ProgramJsonV0PhaseStateBox.parse(program_json, "[test]")
    if me._i(out, "err") != 0 { return me._err("parse_error") }

    local root = BoxHelpers.map_get(out, "recipe_root")
    if root == null || RecipeItemBox.kind_is(root, "Seq") != 1 {
      return me._err("missing_recipe_root")
    }

    local items = BoxHelpers.map_get(root, "items")
    if items == null || BoxHelpers.is_array(items) != 1 {
      return me._err("missing_recipe_items")
    }

    local item0 = BoxHelpers.array_get(items, 0)
    local item1 = BoxHelpers.array_get(items, 1)
    local stmt0 = "Unsupported"
    local stmt1 = "Unsupported"

    if item0 == null { stmt0 = "None" }
    else if RecipeItemBox.kind_is(item0, "Exit") == 1 { stmt0 = "Return" }
    else if RecipeItemBox.kind_is(item0, "Seq") == 1 {
      local kind0 = BoxHelpers.map_get(item0, "stmt_kind")
      if BoxHelpers.same_token(kind0, "Local") == 1 { stmt0 = "Local" }
      else if BoxHelpers.same_token(kind0, "Assignment") == 1 { stmt0 = "Assignment" }
      else if BoxHelpers.same_token(kind0, "Print") == 1 { stmt0 = "Print" }
      else if BoxHelpers.same_token(kind0, "Return") == 1 { stmt0 = "Return" }
    }
    else if RecipeItemBox.kind_is(item0, "Loop") == 1 {
      local body0 = BoxHelpers.map_get(item0, "body_item")
      if body0 != null && RecipeItemBox.kind_is(body0, "Seq") == 1 {
        local body_items0 = BoxHelpers.map_get(body0, "items")
        if body_items0 != null && BoxHelpers.is_array(body_items0) == 1 {
          local body_stmt0 = BoxHelpers.array_get(body_items0, 0)
          local body_tail0 = BoxHelpers.array_get(body_items0, 1)
          if body_stmt0 != null && body_tail0 == null && RecipeItemBox.kind_is(body_stmt0, "Seq") == 1 {
            local body_kind0 = BoxHelpers.map_get(body_stmt0, "stmt_kind")
            if BoxHelpers.same_token(body_kind0, "Local") == 1 { stmt0 = "LoopNoExit" }
            else if BoxHelpers.same_token(body_kind0, "Assignment") == 1 { stmt0 = "LoopNoExit" }
            else if BoxHelpers.same_token(body_kind0, "Print") == 1 { stmt0 = "LoopNoExit" }
          }
        }
      }
    }
    else if RecipeItemBox.kind_is(item0, "If") == 1 {
      local then0 = BoxHelpers.map_get(item0, "then_item")
      local else0 = BoxHelpers.map_get(item0, "else_item")
      if then0 != null && else0 != null && RecipeItemBox.kind_is(then0, "Seq") == 1 && RecipeItemBox.kind_is(else0, "Seq") == 1 {
        local then_items0 = BoxHelpers.map_get(then0, "items")
        local else_items0 = BoxHelpers.map_get(else0, "items")
        if then_items0 != null && else_items0 != null && BoxHelpers.is_array(then_items0) == 1 && BoxHelpers.is_array(else_items0) == 1 {
          local then_stmt0 = BoxHelpers.array_get(then_items0, 0)
          local then_tail0 = BoxHelpers.array_get(then_items0, 1)
          local else_stmt0 = BoxHelpers.array_get(else_items0, 0)
          local else_tail0 = BoxHelpers.array_get(else_items0, 1)
          if then_stmt0 != null && else_stmt0 != null && then_tail0 == null && else_tail0 == null && RecipeItemBox.kind_is(then_stmt0, "Seq") == 1 && RecipeItemBox.kind_is(else_stmt0, "Seq") == 1 {
            local then_kind0 = BoxHelpers.map_get(then_stmt0, "stmt_kind")
            local else_kind0 = BoxHelpers.map_get(else_stmt0, "stmt_kind")
            if BoxHelpers.same_token(then_kind0, "Assignment") == 1 && BoxHelpers.same_token(else_kind0, "Assignment") == 1 { stmt0 = "IfNoExit" }
          }
        }
      }
    }

    if item1 == null { stmt1 = "None" }
    else if RecipeItemBox.kind_is(item1, "Exit") == 1 { stmt1 = "Return" }
    else if RecipeItemBox.kind_is(item1, "Seq") == 1 {
      local kind1 = BoxHelpers.map_get(item1, "stmt_kind")
      if BoxHelpers.same_token(kind1, "Local") == 1 { stmt1 = "Local" }
      else if BoxHelpers.same_token(kind1, "Assignment") == 1 { stmt1 = "Assignment" }
      else if BoxHelpers.same_token(kind1, "Print") == 1 { stmt1 = "Print" }
      else if BoxHelpers.same_token(kind1, "Return") == 1 { stmt1 = "Return" }
    }
    else if RecipeItemBox.kind_is(item1, "Loop") == 1 {
      local body1 = BoxHelpers.map_get(item1, "body_item")
      if body1 != null && RecipeItemBox.kind_is(body1, "Seq") == 1 {
        local body_items1 = BoxHelpers.map_get(body1, "items")
        if body_items1 != null && BoxHelpers.is_array(body_items1) == 1 {
          local body_stmt1 = BoxHelpers.array_get(body_items1, 0)
          local body_tail1 = BoxHelpers.array_get(body_items1, 1)
          if body_stmt1 != null && body_tail1 == null && RecipeItemBox.kind_is(body_stmt1, "Seq") == 1 {
            local body_kind1 = BoxHelpers.map_get(body_stmt1, "stmt_kind")
            if BoxHelpers.same_token(body_kind1, "Local") == 1 { stmt1 = "LoopNoExit" }
            else if BoxHelpers.same_token(body_kind1, "Assignment") == 1 { stmt1 = "LoopNoExit" }
            else if BoxHelpers.same_token(body_kind1, "Print") == 1 { stmt1 = "LoopNoExit" }
          }
        }
      }
    }
    else if RecipeItemBox.kind_is(item1, "If") == 1 {
      local then1 = BoxHelpers.map_get(item1, "then_item")
      local else1 = BoxHelpers.map_get(item1, "else_item")
      if then1 != null && else1 != null && RecipeItemBox.kind_is(then1, "Seq") == 1 && RecipeItemBox.kind_is(else1, "Seq") == 1 {
        local then_items1 = BoxHelpers.map_get(then1, "items")
        local else_items1 = BoxHelpers.map_get(else1, "items")
        if then_items1 != null && else_items1 != null && BoxHelpers.is_array(then_items1) == 1 && BoxHelpers.is_array(else_items1) == 1 {
          local then_stmt1 = BoxHelpers.array_get(then_items1, 0)
          local then_tail1 = BoxHelpers.array_get(then_items1, 1)
          local else_stmt1 = BoxHelpers.array_get(else_items1, 0)
          local else_tail1 = BoxHelpers.array_get(else_items1, 1)
          if then_stmt1 != null && else_stmt1 != null && then_tail1 == null && else_tail1 == null && RecipeItemBox.kind_is(then_stmt1, "Seq") == 1 && RecipeItemBox.kind_is(else_stmt1, "Seq") == 1 {
            local then_kind1 = BoxHelpers.map_get(then_stmt1, "stmt_kind")
            local else_kind1 = BoxHelpers.map_get(else_stmt1, "stmt_kind")
            if BoxHelpers.same_token(then_kind1, "Assignment") == 1 && BoxHelpers.same_token(else_kind1, "Assignment") == 1 { stmt1 = "IfNoExit" }
          }
        }
      }
    }

    return "snapshot_kind=ProgramJsonStmtOnlyBlockRecipeSnapshotV1;err=0;"
      + StmtOnlyBlockRecipeBox.build_summary(stmt0, stmt1)
  }
}

static box ProgramJsonStmtOnlyBlockRecipeSnapshotMain { main() { return 0 } }

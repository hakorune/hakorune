// program_json_brand_declaration_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) BrandDeclaration objects structurally.
// - Emit BrandDeclarationShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, brand
//   type resolution, brand lowering, MIR mutation, backend lowering, ID
//   allocation, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonBrandDeclarationShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    if me._kind_at(program_json, first) != "BrandDeclaration" {
      return me._summary("Unsupported", 0, 1)
    }

    local kind = me._brand_kind(program_json, first)
    return me._summary(kind, me._supported_count(kind), me._unsupported_count(kind))
  }

  _summary(kind, supported, unsupported) {
    return "snapshot_kind=BrandDeclarationShapeSnapshotV1"
      + ";top_brand_declaration_shape_kind=" + kind
      + ";supported_brand_declaration_count=" + me._count_token(supported)
      + ";unsupported_brand_declaration_count=" + me._count_token(unsupported)
  }

  _brand_kind(s, brand_start) {
    local name = me._string_field_at(s, "name", brand_start)
    if name == "" { return "Unsupported" }
    local underlying = me._string_field_at(s, "underlying_type", brand_start)
    if underlying == "" { return "Unsupported" }
    return "BrandUnderlying" + me._underlying_kind(underlying)
  }

  _underlying_kind(underlying) {
    if underlying == "I64" || underlying == "Int" { return "Integer" }
    if underlying == "String" || underlying == "StringBox" { return "String" }
    if underlying == "Bool" { return "Bool" }
    if underlying == "Array" || underlying == "ArrayBox" { return "Array" }
    if underlying == "Map" || underlying == "MapBox" { return "Map" }
    return "Other"
  }

  _supported_count(kind) {
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _kind_at(s, obj_start) {
    return me._string_field_at(s, "kind", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonBrandDeclarationShapeScanMain { main() { return 0 } }

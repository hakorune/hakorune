// loop_nested_if_cond_scan_box.hako
//
// Responsibility:
// - Scan Loop-body nested If Compare conditions from Program(JSON v0).
// - Publish the nested If condition payload used by LoopStmtHandler.
//
// Non-responsibility:
// - Building RecipeItems, attaching cond_recipe, top-level Loop route
//   semantics, lowering, mutation, ID allocation, or runtime authority.

using selfhost.shared.common.string_helpers as StringHelpers
using selfhost.shared.common.box_helpers as BoxHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox
using lang.compiler.mirbuilder.program_json_compare_reader_box as ProgramJsonCompareReaderBox

static box LoopNestedIfCondScanBox {
  read_int_rhs(program_json, stmt_start, local_name, tag, label): MapBox {
    local prefix = "Loop If"
    if label != "" { prefix = "Loop " + label + " If" }

    local cond_start = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(program_json, "cond", stmt_start)
    if cond_start < 0 { return me._err(tag, "[cap_missing/program_json_v0] " + prefix + " missing cond object", stmt_start) }
    local cond_info = ProgramJsonV0ScannerBox.read_node_type_at_result(program_json, cond_start)
    if BoxHelpers.result_ok(cond_info) != 1 {
      return me._err(tag, "[cap_missing/program_json_v0] " + prefix + " cond node scan failed", stmt_start)
    }
    if BoxHelpers.same_token(BoxHelpers.map_get(cond_info, "type"), "Compare") != 1 {
      return me._err(tag, "[cap_missing/expr:Compare] " + prefix + " cond must be Compare", stmt_start)
    }

    local op_out = ProgramJsonV0ScannerBox.read_string_field_first_in_obj_result(program_json, "op", cond_start)
    if BoxHelpers.result_ok(op_out) != 1 {
      return me._err(tag, "[cap_missing/expr:Compare] " + prefix + " cond Compare missing op", stmt_start)
    }
    local op = BoxHelpers.map_get(op_out, "value")
    if BoxHelpers.same_token(op, "<") != 1 && BoxHelpers.same_token(op, "<=") != 1 && BoxHelpers.same_token(op, ">") != 1 && BoxHelpers.same_token(op, ">=") != 1 && BoxHelpers.same_token(op, "==") != 1 && BoxHelpers.same_token(op, "!=") != 1 {
      return me._err(tag, "[cap_missing/expr:Compare] " + prefix + " cond Compare op is unsupported", stmt_start)
    }

    local lhs_start = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(program_json, "lhs", cond_start)
    local rhs_start = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(program_json, "rhs", cond_start)
    if lhs_start < 0 || rhs_start < 0 {
      return me._err(tag, "[cap_missing/program_json_v0] " + prefix + " Compare missing operands", stmt_start)
    }
    local lhs_info = ProgramJsonV0ScannerBox.read_node_type_at_result(program_json, lhs_start)
    local rhs_info = ProgramJsonV0ScannerBox.read_node_type_at_result(program_json, rhs_start)
    if BoxHelpers.result_ok(lhs_info) != 1 || BoxHelpers.same_token(BoxHelpers.map_get(lhs_info, "type"), "Var") != 1 {
      return me._err(tag, "[cap_missing/stmt:Loop] " + prefix + " cond lhs must be Var", stmt_start)
    }
    if BoxHelpers.result_ok(rhs_info) != 1 {
      return me._err(tag, "[cap_missing/stmt:Loop] " + prefix + " cond rhs scan failed", stmt_start)
    }
    local rhs_type = BoxHelpers.map_get(rhs_info, "type")

    local lhs_name_out = ProgramJsonV0ScannerBox.read_string_field_first_in_obj_result(program_json, "name", lhs_start)
    if BoxHelpers.result_ok(lhs_name_out) != 1 || BoxHelpers.same_token(BoxHelpers.map_get(lhs_name_out, "value"), local_name) != 1 {
      return me._err(tag, "[cap_missing/stmt:Loop] " + prefix + " cond lhs must be Local var", stmt_start)
    }
    if BoxHelpers.same_token(rhs_type, "Int") == 1 {
      local rhs_out = ProgramJsonV0ScannerBox.read_int_field_in_obj_result(program_json, "value", rhs_start)
      if BoxHelpers.result_ok(rhs_out) != 1 {
        return me._err(tag, "[cap_missing/program_json_v0] " + prefix + " rhs Int missing value", stmt_start)
      }
      return %{"err" => 0, "err_line" => "", "if_cond_rhs_kind_code" => 1, "if_cond_rhs_int" => BoxHelpers.map_get(rhs_out, "value"), "if_cond_rhs_symbol_id" => 0, "if_cond_start" => cond_start}
    }
    if BoxHelpers.same_token(rhs_type, "Var") == 1 {
      local cond_reader = ProgramJsonCompareReaderBox.read_var_int_compare(program_json, cond_start)
      if BoxHelpers.result_ok(cond_reader) != 1 {
        return me._err(tag, "[cap_missing/stmt:Loop] " + prefix + " rhs Var compare reader failed", stmt_start)
      }
      return %{"err" => 0, "err_line" => "", "if_cond_rhs_kind_code" => 2, "if_cond_rhs_int" => 0, "if_cond_rhs_symbol_id" => BoxHelpers.map_get(cond_reader, "bound_symbol_id"), "if_cond_start" => cond_start}
    }
    return me._err(tag, "[cap_missing/stmt:Loop] " + prefix + " cond rhs must be Int or Var", stmt_start)
  }

  _err(tag, msg, next_idx): MapBox {
    return %{"err" => 1, "err_line" => tag + msg, "next_idx" => next_idx}
  }
}

static box LoopNestedIfCondScanBoxMain { main() { return 0 } }

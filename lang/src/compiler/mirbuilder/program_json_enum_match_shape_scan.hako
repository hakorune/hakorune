// program_json_enum_match_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) EnumMatch expressions structurally.
// - Emit EnumMatchShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, match lowering,
//   enum runtime semantics, route selection, MIR mutation, backend lowering, or ID allocation.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonEnumMatchShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = "Missing"
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_type = me._node_type_at(program_json, first)

    if first_type == "EnumMatch" {
      top_kind = me._enum_match_shape_kind(program_json, first)
    } else if first_type == "If" {
      then_kind = me._first_enum_match_shape_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_enum_match_shape_kind_in_else(program_json, first)
    } else {
      top_kind = "Unsupported"
    }

    local supported = me._shape_supported_count(top_kind)
      + me._shape_supported_count(then_kind)
      + me._shape_supported_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=EnumMatchShapeSnapshotV1"
      + ";top_enum_match_shape_kind=" + top_kind
      + ";if_then_enum_match_shape_kind=" + then_kind
      + ";if_else_enum_match_shape_kind=" + else_kind
      + ";supported_enum_match_count=" + me._count_token(supported)
      + ";unsupported_enum_match_count=" + me._count_token(unsupported)
  }

  _enum_match_shape_kind(s, match_start) {
    local enum_name = me._string_field_at(s, "enum", match_start)
    if enum_name != "Option" { return "Unsupported" }

    local scrutinee = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "scrutinee", match_start)
    if scrutinee < 0 { return "Unsupported" }
    if me._node_type_at(s, scrutinee) != "Var" { return "Unsupported" }

    local arms = me._array_field_start(s, "arms", match_start)
    if arms < 0 { return "Unsupported" }
    local first = me._first_object_in_array(s, arms)
    if first < 0 { return "Unsupported" }
    local second = me._next_object_in_array(s, arms, first)
    if second < 0 { return "Unsupported" }
    local third = me._next_object_in_array(s, arms, second)
    if third >= 0 { return "Unsupported" }

    local first_variant = me._string_field_at(s, "variant", first)
    local second_variant = me._string_field_at(s, "variant", second)
    if first_variant != "Some" || second_variant != "None" { return "Unsupported" }

    local some_expr = me._arm_expr_kind(s, first)
    local none_expr = me._arm_expr_kind(s, second)
    if some_expr == "Unsupported" || none_expr == "Unsupported" { return "Unsupported" }

    local bind_state = me._optional_bind_state(s, first)
    if bind_state == "Present" && some_expr == "Var" && none_expr == "Null" {
      return "OptionSomeBindVarNoneNull"
    }
    if bind_state == "Missing" && some_expr == "BoolTrue" && none_expr == "BoolFalse" {
      return "OptionSomeBoolTrueNoneBoolFalse"
    }
    return "Unsupported"
  }

  _arm_expr_kind(s, arm_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", arm_start)
    if expr < 0 { return "Unsupported" }
    local ty = me._node_type_at(s, expr)
    if ty == "Var" { return "Var" }
    if ty == "Null" { return "Null" }
    if ty == "Bool" { return me._bool_kind(s, expr) }
    return "Unsupported"
  }

  _bool_kind(s, expr_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "value", expr_start)
    if p < 0 { return "Unsupported" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "true" { return "BoolTrue" }
    if s.substring(p, p + 5) == "false" { return "BoolFalse" }
    return "Unsupported"
  }

  _optional_bind_state(s, obj_start) {
    local end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, obj_start)
    if end < 0 { return "Unsupported" }
    local obj = s.substring(obj_start, end)
    local p = StringHelpers.index_of(obj, 0, "\"bind\":")
    if p < 0 { return "Missing" }
    return "Present"
  }

  _first_enum_match_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_enum_match_shape_kind_in_array(s, array_start)
  }

  _first_enum_match_shape_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_enum_match_shape_kind_in_array(s, p)
  }

  _first_enum_match_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "EnumMatch" { return "Unsupported" }
    return me._enum_match_shape_kind(s, first)
  }

  _shape_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _next_object_in_array(s, array_start, previous_start) {
    if array_start < 0 || previous_start < 0 { return -1 }
    local previous_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, previous_start)
    if previous_end < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, previous_end)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "," { return -1 }
    p = StringHelpers.skip_ws(s, p + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonEnumMatchShapeScanMain { main() { return 0 } }

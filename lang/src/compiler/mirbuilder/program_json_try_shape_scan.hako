// program_json_try_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Try statement objects structurally.
// - Emit TryShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Exception runtime semantics, catch matching, finally execution semantics,
//   RecipeMatcher execution, route selection, MIR mutation, backend lowering,
//   ID allocation, source text matching, Rust ASTNode projection, or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonTryShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local first_type = me._node_type_at(program_json, first)
    if first_type == "Try" {
      local top_kind = me._try_shape_kind(program_json, first)
      return me._summary_for(top_kind, "Missing", "Missing")
    } else if first_type == "If" {
      local then_kind = me._first_try_shape_kind_in_array_field(program_json, first, "then")
      local else_kind = me._first_try_shape_kind_in_else(program_json, first)
      return me._summary_for("Missing", then_kind, else_kind)
    }
    return me._summary_for("Unsupported", "Missing", "Missing")
  }

  _summary_for(top_kind, then_kind, else_kind) {
    local supported = me._shape_supported_count(top_kind)
      + me._shape_supported_count(then_kind)
      + me._shape_supported_count(else_kind)
    local unsupported = me._shape_unsupported_count(top_kind)
      + me._shape_unsupported_count(then_kind)
      + me._shape_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=TryShapeSnapshotV1"
      + ";top_try_shape_kind=" + top_kind
      + ";if_then_try_shape_kind=" + then_kind
      + ";if_else_try_shape_kind=" + else_kind
      + ";supported_try_count=" + me._count_token(supported)
      + ";unsupported_try_count=" + me._count_token(unsupported)
  }

  _try_shape_kind(s, try_start) {
    local try_array = me._array_field_start(s, "try", try_start)
    local catches_array = me._array_field_start(s, "catches", try_start)
    local finally_array = me._array_field_start(s, "finally", try_start)
    if try_array < 0 || catches_array < 0 || finally_array < 0 { return "Unsupported" }

    local try_kind = me._array_first_stmt_kind(s, try_array)
    local catch_kind = me._catch_array_kind(s, catches_array)
    local finally_kind = me._array_first_stmt_kind(s, finally_array)

    if try_kind == "Throw" && catch_kind == "NoCatch" && finally_kind == "Empty" {
      return "TryThrowNoCatchNoFinally"
    }
    if try_kind == "Return" && catch_kind == "OneCatchReturn" && finally_kind == "Empty" {
      return "TryReturnOneCatchNoFinally"
    }
    if try_kind == "Expr" && catch_kind == "OneCatchEmpty" && finally_kind == "Expr" {
      return "TryExprOneCatchFinallyExpr"
    }
    if try_kind == "Empty" && catch_kind == "ManyCatches" && finally_kind == "Empty" {
      return "TryEmptyManyCatchesNoFinally"
    }
    if try_kind == "Return" && catch_kind == "NoCatch" && finally_kind == "Return" {
      return "TryReturnNoCatchFinallyReturn"
    }
    return "Unsupported"
  }

  _catch_array_kind(s, array_start) {
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) == "]" { return "NoCatch" }

    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Unsupported" }
    local first_end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, first)
    if first_end < 0 { return "Unsupported" }
    local after_first = StringHelpers.skip_ws(s, first_end)
    if ProgramJsonV0ScannerBox._read_char(s, after_first) == "," { return "ManyCatches" }

    local catch_body = me._array_field_start(s, "body", first)
    if catch_body < 0 { return "Unsupported" }
    local body_kind = me._array_first_stmt_kind(s, catch_body)
    if body_kind == "Return" { return "OneCatchReturn" }
    if body_kind == "Throw" { return "OneCatchThrow" }
    if body_kind == "Empty" { return "OneCatchEmpty" }
    return "Unsupported"
  }

  _array_first_stmt_kind(s, array_start) {
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) == "]" { return "Empty" }
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Unsupported" }
    local ty = me._node_type_at(s, first)
    if ty == "Throw" { return "Throw" }
    if ty == "Return" { return "Return" }
    if ty == "Expr" { return "Expr" }
    if ty == "Try" { return "NestedTryUnsupported" }
    return "Unsupported"
  }

  _first_try_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_try_shape_kind_in_array(s, array_start)
  }

  _first_try_shape_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_try_shape_kind_in_array(s, p)
  }

  _first_try_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Try" { return "Unsupported" }
    return me._try_shape_kind(s, first)
  }

  _shape_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _shape_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonTryShapeScanMain { main() { return 0 } }

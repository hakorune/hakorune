// program_json_expr_unary_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Expr.expr Unary objects structurally.
// - Emit ExprUnaryShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, unary
//   lowering, route selection, MIR mutation, backend lowering, ID allocation,
//   or parser integration.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonExprUnaryShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = "Missing"
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_type = me._node_type_at(program_json, first)

    if first_type == "Expr" {
      top_kind = me._expr_unary_shape_kind(program_json, first)
    } else if first_type == "If" {
      then_kind = me._first_expr_unary_shape_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_expr_unary_shape_kind_in_else(program_json, first)
    } else {
      top_kind = "Unsupported"
    }

    local supported = me._unary_supported_count(top_kind)
      + me._unary_supported_count(then_kind)
      + me._unary_supported_count(else_kind)
    local unsupported = me._unary_unsupported_count(top_kind)
      + me._unary_unsupported_count(then_kind)
      + me._unary_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=ExprUnaryShapeSnapshotV1"
      + ";top_expr_unary_shape_kind=" + top_kind
      + ";if_then_expr_unary_shape_kind=" + then_kind
      + ";if_else_expr_unary_shape_kind=" + else_kind
      + ";supported_expr_unary_count=" + me._count_token(supported)
      + ";unsupported_expr_unary_count=" + me._count_token(unsupported)
  }

  _expr_unary_shape_kind(s, expr_stmt_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", expr_stmt_start)
    if expr < 0 { return "Unsupported" }
    if me._node_type_at(s, expr) != "Unary" { return "Unsupported" }
    return me._unary_kind(s, expr)
  }

  _unary_kind(s, unary_start) {
    local operand = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "operand", unary_start)
    if operand < 0 { return "Unsupported" }
    local operand_kind = me._operand_kind(s, operand)
    if operand_kind == "Unsupported" { return "Unsupported" }
    local op = me._string_field_at(s, "op", unary_start)
    if op == "-" { return "Minus" + operand_kind }
    if op == "!" { return "Not" + operand_kind }
    if op == "~" { return "BitNot" + operand_kind }
    if op == "weak" { return "Weak" + operand_kind }
    return "Unsupported"
  }

  _operand_kind(s, obj_start) {
    local ty = me._node_type_at(s, obj_start)
    if ty == "Int" { return "Int" }
    if ty == "Bool" { return "Bool" }
    if ty == "Var" { return "Var" }
    if ty == "Null" { return "Null" }
    return "Unsupported"
  }

  _first_expr_unary_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_expr_unary_shape_kind_in_array(s, array_start)
  }

  _first_expr_unary_shape_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_expr_unary_shape_kind_in_array(s, p)
  }

  _first_expr_unary_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Expr" { return "Unsupported" }
    return me._expr_unary_shape_kind(s, first)
  }

  _unary_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _unary_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._type_field_at_quiet(s, obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }

  _type_field_at_quiet(s, obj_start) {
    local p = me._quiet_type_field_value_start(s, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }

  _quiet_type_field_value_start(s, obj_start) {
    if s == null { return -1 }
    if obj_start < 0 { return -1 }
    local end = ProgramJsonV0ScannerBox.seek_obj_end_unescaped(s, obj_start)
    if end < 0 { return -1 }
    local obj = s.substring(obj_start, end)
    local needle = "\"type\":"
    local p = StringHelpers.index_of(obj, 0, needle)
    if p < 0 || (obj_start + p) >= end { return -1 }
    return obj_start + p + needle.length()
  }
}

static box ProgramJsonExprUnaryShapeScanMain { main() { return 0 } }

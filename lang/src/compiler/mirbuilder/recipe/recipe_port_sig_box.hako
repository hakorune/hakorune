// recipe_port_sig_box.hako
// Responsibility:
// - Minimal PortSig container for Recipe-first lane (R0).
// - Track definition/update counts only (no lower coupling).

using selfhost.shared.common.box_helpers as BoxHelpers
using selfhost.shared.common.string_helpers as StringHelpers

static box RecipePortSigBox {
  create(): MapBox {
    return %{
      "def_count" => 0,
      "update_count" => 0
    }
  }

  _safe_name(name) {
    if name == null { return "" }
    return "" + name
  }

  _ensure_sig(sig): MapBox {
    if sig == null || BoxHelpers.is_map(sig) != 1 { return me.create() }
    local def_count = StringHelpers.to_i64(BoxHelpers.map_get(sig, "def_count"))
    local update_count = StringHelpers.to_i64(BoxHelpers.map_get(sig, "update_count"))
    return %{
      "def_count" => def_count,
      "update_count" => update_count
    }
  }

  mark_def(sig, name): MapBox {
    local ensured = me._ensure_sig(sig)
    local key = me._safe_name(name)
    if key == "" { return ensured }
    return %{
      "def_count" => StringHelpers.to_i64(BoxHelpers.map_get(ensured, "def_count")) + 1,
      "update_count" => StringHelpers.to_i64(BoxHelpers.map_get(ensured, "update_count"))
    }
  }

  mark_update(sig, name): MapBox {
    local ensured = me._ensure_sig(sig)
    local key = me._safe_name(name)
    if key == "" { return ensured }
    return %{
      "def_count" => StringHelpers.to_i64(BoxHelpers.map_get(ensured, "def_count")),
      "update_count" => StringHelpers.to_i64(BoxHelpers.map_get(ensured, "update_count")) + 1
    }
  }

  has_def(sig, name) {
    local key = me._safe_name(name)
    if key == "" { return 0 }
    local ensured = me._ensure_sig(sig)
    if StringHelpers.to_i64(BoxHelpers.map_get(ensured, "def_count")) > 0 { return 1 }
    return 0
  }

  has_update(sig, name) {
    local key = me._safe_name(name)
    if key == "" { return 0 }
    local ensured = me._ensure_sig(sig)
    if StringHelpers.to_i64(BoxHelpers.map_get(ensured, "update_count")) > 0 { return 1 }
    return 0
  }

  merge(lhs, rhs): MapBox {
    local out = me._ensure_sig(lhs)
    local rhs_sig = me._ensure_sig(rhs)
    return %{
      "def_count" => StringHelpers.to_i64(BoxHelpers.map_get(out, "def_count")) + StringHelpers.to_i64(BoxHelpers.map_get(rhs_sig, "def_count")),
      "update_count" => StringHelpers.to_i64(BoxHelpers.map_get(out, "update_count")) + StringHelpers.to_i64(BoxHelpers.map_get(rhs_sig, "update_count"))
    }
  }

  _count_bucket(bucket): i64 {
    return bucket
  }

  snapshot(sig): MapBox {
    local ensured = me._ensure_sig(sig)
    return %{
      "def_count" => me._count_bucket(StringHelpers.to_i64(BoxHelpers.map_get(ensured, "def_count"))),
      "update_count" => me._count_bucket(StringHelpers.to_i64(BoxHelpers.map_get(ensured, "update_count")))
    }
  }
}

static box RecipePortSigBoxMain { main() { return 0 } }

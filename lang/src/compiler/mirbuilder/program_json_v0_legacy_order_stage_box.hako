// program_json_v0_legacy_order_stage_box.hako
// Responsibility:
// - SSOT for legacy stmt order stage classification used by ProgramJsonV0PhaseStateBox.
// - Keep order gate fallback logic isolated from recipe-first scanner recursion.

using selfhost.shared.common.box_helpers as BoxHelpers

static box ProgramJsonV0LegacyOrderStageBox {
  classify(node_type) {
    if BoxHelpers.same_token(node_type, "Local") == 1 { return 1 }
    if BoxHelpers.same_token(node_type, "Assignment") == 1 { return 2 }
    if BoxHelpers.same_token(node_type, "Print") == 1 { return 3 }
    if BoxHelpers.same_token(node_type, "Return") == 1 { return 4 }
    return 0
  }
}

static box ProgramJsonV0LegacyOrderStageMain { main() { return 0 } }

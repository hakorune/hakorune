// program_json_expr_logical_shape_scan.hako
//
// Responsibility:
// - Traverse covered Program(JSON v0) Expr.expr Logical objects structurally.
// - Emit ExprLogicalShapeSnapshotV1 summaries for MirBuilder migration parity.
//
// Non-responsibility:
// - Full JSON parsing, source text matching, Rust ASTNode projection, RecipeMatcher execution,
//   route selection, MIR mutation, backend lowering, ID allocation, or boolean short-circuit policy.

using selfhost.shared.common.string_helpers as StringHelpers
using lang.compiler.mirbuilder.program_json_v0_scanner_box as ProgramJsonV0ScannerBox

static box ProgramJsonExprLogicalShapeScanBox {
  build_summary(program_json) {
    if program_json == null || ("" + program_json) == "" {
      return me._fail("missing_program_json")
    }
    program_json = "" + program_json

    local body = me._array_field_start(program_json, "body", 0)
    if body < 0 { return me._fail("cap_missing_program_body") }

    local first = me._first_object_in_array(program_json, body)
    if first < 0 { return me._fail("cap_missing_first_stmt") }

    local top_kind = "Missing"
    local then_kind = "Missing"
    local else_kind = "Missing"
    local first_type = me._node_type_at(program_json, first)

    if first_type == "Expr" {
      top_kind = me._expr_logical_shape_kind(program_json, first)
    } else if first_type == "If" {
      then_kind = me._first_expr_logical_shape_kind_in_array_field(program_json, first, "then")
      else_kind = me._first_expr_logical_shape_kind_in_else(program_json, first)
    } else {
      top_kind = "Unsupported"
    }

    local supported = me._logical_supported_count(top_kind)
      + me._logical_supported_count(then_kind)
      + me._logical_supported_count(else_kind)
    local unsupported = me._logical_unsupported_count(top_kind)
      + me._logical_unsupported_count(then_kind)
      + me._logical_unsupported_count(else_kind)
    return me._summary(top_kind, then_kind, else_kind, supported, unsupported)
  }

  _summary(top_kind, then_kind, else_kind, supported, unsupported) {
    return "snapshot_kind=ExprLogicalShapeSnapshotV1"
      + ";top_expr_logical_shape_kind=" + top_kind
      + ";if_then_expr_logical_shape_kind=" + then_kind
      + ";if_else_expr_logical_shape_kind=" + else_kind
      + ";supported_expr_logical_count=" + me._count_token(supported)
      + ";unsupported_expr_logical_count=" + me._count_token(unsupported)
  }

  _expr_logical_shape_kind(s, expr_stmt_start) {
    local expr = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "expr", expr_stmt_start)
    if expr < 0 { return "Unsupported" }
    if me._node_type_at(s, expr) != "Logical" { return "Unsupported" }
    return me._logical_kind(s, expr)
  }

  _logical_kind(s, logical_start) {
    local lhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "lhs", logical_start)
    local rhs = ProgramJsonV0ScannerBox.seek_obj_field_obj_start(s, "rhs", logical_start)
    if lhs < 0 || rhs < 0 { return "Unsupported" }

    local lhs_kind = me._operand_kind(s, lhs)
    local rhs_kind = me._operand_kind(s, rhs)
    local op = me._string_field_at(s, "op", logical_start)

    if lhs_kind == "Var" && rhs_kind == "Var" {
      if op == "&&" { return "VarAndVar" }
      if op == "||" { return "VarOrVar" }
    }
    if lhs_kind == "Bool" && rhs_kind == "Var" {
      if op == "&&" { return "BoolAndVar" }
    }
    if lhs_kind == "Var" && rhs_kind == "Bool" {
      if op == "||" { return "VarOrBool" }
    }
    return "Unsupported"
  }

  _operand_kind(s, arg_start) {
    local ty = me._node_type_at(s, arg_start)
    if ty == "Bool" { return "Bool" }
    if ty == "Var" { return "Var" }
    return "Unsupported"
  }

  _first_expr_logical_shape_kind_in_array_field(s, if_start, key) {
    local array_start = me._array_field_start(s, key, if_start)
    if array_start < 0 { return "Missing" }
    return me._first_expr_logical_shape_kind_in_array(s, array_start)
  }

  _first_expr_logical_shape_kind_in_else(s, if_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, "else", if_start)
    if p < 0 { return "Missing" }
    p = StringHelpers.skip_ws(s, p)
    if s.substring(p, p + 4) == "null" { return "Missing" }
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return "Unsupported" }
    return me._first_expr_logical_shape_kind_in_array(s, p)
  }

  _first_expr_logical_shape_kind_in_array(s, array_start) {
    local first = me._first_object_in_array(s, array_start)
    if first < 0 { return "Missing" }
    if me._node_type_at(s, first) != "Expr" { return "Unsupported" }
    return me._expr_logical_shape_kind(s, first)
  }

  _logical_supported_count(kind) {
    if kind == "Missing" { return 0 }
    if kind == "Unsupported" { return 0 }
    return 1
  }

  _logical_unsupported_count(kind) {
    if kind == "Unsupported" { return 1 }
    return 0
  }

  _count_token(n) {
    if n <= 0 { return "0" }
    if n == 1 { return "1" }
    if n == 2 { return "2" }
    return "many"
  }

  _fail(reason) {
    return "accepted=0;reason=" + reason
  }

  _array_field_start(s, key, obj_start) {
    if obj_start < 0 { return -1 }
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return -1 }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "[" { return -1 }
    return p
  }

  _first_object_in_array(s, array_start) {
    if array_start < 0 { return -1 }
    local p = StringHelpers.skip_ws(s, array_start + 1)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "{" { return -1 }
    return p
  }

  _node_type_at(s, obj_start) {
    return me._string_field_at(s, "type", obj_start)
  }

  _string_field_at(s, key, obj_start) {
    local p = ProgramJsonV0ScannerBox.seek_obj_field_value_start(s, key, obj_start)
    if p < 0 { return "" }
    p = StringHelpers.skip_ws(s, p)
    if ProgramJsonV0ScannerBox._read_char(s, p) != "\"" { return "" }
    local end_quote = StringHelpers.index_of(s, p + 1, "\"")
    if end_quote < 0 { return "" }
    return s.substring(p + 1, end_quote)
  }
}

static box ProgramJsonExprLogicalShapeScanMain { main() { return 0 } }

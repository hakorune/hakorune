static box ParserExprContextBox {
  general() {
    return "GeneralExpression"
  }

  block_delimited_head() {
    return "BlockDelimitedHeadStopsBeforeTopLevelBrace"
  }

  record_literal_allowed(expr_context) {
    if expr_context == me.general() { return 1 }
    if expr_context == me.block_delimited_head() { return 0 }
    return 0
  }
}

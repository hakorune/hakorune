static box ParserExprPrecedenceBox {
  parse_unary2(src, i, ctx, expr_context) {
    local j = ctx.skip_ws(src, i)
    if ctx.starts_with_kw(src, j, "weak") == 1 {
      local operand_start = ctx.skip_ws(src, j + 4)
      if src.substring(operand_start, operand_start + 1) == "(" {
        ctx.gpos_set(src.length())
        return ctx.freeze_contract(
          "parser/weak_paren_call_rejected",
          "use weak expr instead of weak(expr)"
        )
      }
      local operand = me.parse_unary2(src, operand_start, ctx, expr_context)
      return "{\"type\":\"Unary\",\"op\":\"weak\",\"operand\":" + operand + "}"
    }
    if src.substring(j, j + 1) == "-" {
      local rhs = ctx.parse_factor_in_context2(src, j + 1, expr_context)
      j = ctx.gpos_get()
      local zero = "{\"type\":\"Int\",\"value\":0}"
      ctx.gpos_set(j)
      return "{\"type\":\"Binary\",\"op\":\"-\",\"lhs\":" + zero + ",\"rhs\":" + rhs + "}"
    }
    return ctx.parse_factor_in_context2(src, j, expr_context)
  }

  parse_term2(src, i, ctx, expr_context) {
    local lhs = me.parse_unary2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      if j >= src.length() { break }

      local op = src.substring(j, j + 1)
      if op != "*" && op != "/" && op != "%" { break }

      local rhs = me.parse_unary2(src, j + 1, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Binary\",\"op\":\"" + op + "\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }

  parse_shift2(src, i, ctx, expr_context) {
    local lhs = me.parse_term2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      if j >= src.length() { break }

      local op = src.substring(j, j + 2)
      if op != "<<" && op != ">>" { break }

      local rhs = me.parse_term2(src, j + 2, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Binary\",\"op\":\"" + op + "\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }

  parse_sum2(src, i, ctx, expr_context) {
    local lhs = me.parse_shift2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      if j >= src.length() { break }

      local op = src.substring(j, j + 1)
      if op != "+" && op != "-" { break }

      local rhs = me.parse_shift2(src, j + 1, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Binary\",\"op\":\"" + op + "\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }

  parse_compare2(src, i, ctx, expr_context) {
    local lhs = me.parse_sum2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()
    j = ctx.skip_ws(src, j)
    local two = src.substring(j, j + 2)
    local one = src.substring(j, j + 1)
    local op = ""

    if two == "==" || two == "!=" || two == "<=" || two == ">=" {
      op = two
      j = j + 2
    } else {
      if one == "<" || one == ">" {
        op = one
        j = j + 1
      }
    }

    if op == "" {
      ctx.gpos_set(j)
      return lhs
    }

    local rhs = me.parse_sum2(src, j, ctx, expr_context)
    j = ctx.gpos_get()
    ctx.gpos_set(j)
    return "{\"type\":\"Compare\",\"op\":\"" + op + "\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
  }

  parse_bitand2(src, i, ctx, expr_context) {
    local lhs = me.parse_compare2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      if j >= src.length() { break }

      local two = src.substring(j, j + 2)
      local op = src.substring(j, j + 1)
      if op != "&" || two == "&&" { break }

      local rhs = me.parse_compare2(src, j + 1, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Binary\",\"op\":\"&\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }

  parse_bitxor2(src, i, ctx, expr_context) {
    local lhs = me.parse_bitand2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      if j >= src.length() { break }

      local op = src.substring(j, j + 1)
      if op != "^" { break }

      local rhs = me.parse_bitand2(src, j + 1, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Binary\",\"op\":\"^\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }

  parse_bitor2(src, i, ctx, expr_context) {
    local lhs = me.parse_bitxor2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      if j >= src.length() { break }

      local two = src.substring(j, j + 2)
      local op = src.substring(j, j + 1)
      if op != "|" || two == "||" { break }

      local rhs = me.parse_bitxor2(src, j + 1, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Binary\",\"op\":\"|\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }

  parse_expr2(src, i, ctx, expr_context) {
    local lhs = me.parse_bitor2(src, i, ctx, expr_context)
    local j = ctx.gpos_get()

    loop(true) {
      j = ctx.skip_ws(src, j)
      local two = src.substring(j, j + 2)
      if two != "&&" && two != "||" { break }

      local rhs = me.parse_bitor2(src, j + 2, ctx, expr_context)
      j = ctx.gpos_get()
      lhs = "{\"type\":\"Logical\",\"op\":\"" + two + "\",\"lhs\":" + lhs + ",\"rhs\":" + rhs + "}"
    }

    j = ctx.skip_ws(src, j)
    if src.substring(j, j + 1) == "?" {
      j = ctx.skip_ws(src, j + 1)
      local then_expr = me.parse_expr2(src, j, ctx, expr_context)
      j = ctx.gpos_get()
      j = ctx.skip_ws(src, j)
      if src.substring(j, j + 1) == ":" { j = j + 1 }
      j = ctx.skip_ws(src, j)
      local else_expr = me.parse_expr2(src, j, ctx, expr_context)
      j = ctx.gpos_get()
      if else_expr.length() == 0 { else_expr = "{\"type\":\"Int\",\"value\":0}" }
      ctx.gpos_set(j)
      return "{\"type\":\"Ternary\",\"cond\":" + lhs + ",\"then\":" + then_expr + ",\"else\":" + else_expr + "}"
    }

    ctx.gpos_set(j)
    return lhs
  }
}

static box ParserMatchBox {
  parse(src, i, ctx) {
    local j = i
    if ctx.starts_with_kw(src, j, "match") == 1 {
      j = j + 5
    } else if ctx.starts_with_kw(src, j, "peek") == 1 {
      j = j + 4
    } else {
      return me._error("expected match or peek keyword")
    }
    local n = src.length()
    j = ctx.skip_ws(src, j)

    local scrutinee = ctx.parse_match_scrutinee2(src, j)
    j = ctx.gpos_get()
    j = ctx.skip_ws(src, j)
    if j >= n || src.substring(j, j + 1) != "{" {
      return me._error("expected opening brace")
    }
    j = j + 1

    local arms_json = "["
    local arm_count = 0
    local arm_names_json = "["
    local arm_name_count = 0
    local total_arm_count = 0
    local else_json = null
    local loop_guard = 0
    local max = 200000

    loop(loop_guard < max) {
      j = ctx.skip_ws(src, j)
      if j >= n { break }
      if src.substring(j, j + 1) == "}" { break }
      local iteration_start = j

      if src.substring(j, j + 1) == "_" {
        j = j + 1
        j = ctx.skip_ws(src, j)
        if j + 1 >= n || src.substring(j, j + 2) != "=>" {
          return me._error("expected arrow after wildcard arm")
        }
        j = j + 2
        j = ctx.skip_ws(src, j)
        local body = me._parse_arm_body(src, j, ctx)
        local at_else = body.lastIndexOf("@")
        else_json = body.substring(0, at_else)
        j = ctx.to_int(body.substring(at_else + 1, body.length()))
        if j < 0 { return me._error("unterminated wildcard arm body") }
        total_arm_count = total_arm_count + 1
      } else {
        local head = me._parse_named_head(src, j, ctx)
        local at1 = head.indexOf("@")
        local at2 = head.indexOf("@", at1 + 1)
        local variant = head.substring(0, at1)
        local binding = head.substring(at1 + 1, at2)
        j = ctx.to_int(head.substring(at2 + 1, head.length()))
        if variant == "" || j < 0 { return me._error("invalid named arm") }
        j = ctx.skip_ws(src, j)
        if j + 1 >= n || src.substring(j, j + 2) != "=>" {
          return me._error("expected arrow after named arm")
        }
        j = j + 2
        j = ctx.skip_ws(src, j)
        local body = me._parse_arm_body(src, j, ctx)
        local at_body = body.lastIndexOf("@")
        local expr_json = body.substring(0, at_body)
        j = ctx.to_int(body.substring(at_body + 1, body.length()))
        if j < 0 { return me._error("unterminated named arm body") }

        if arm_count > 0 { arms_json = arms_json + "," }
        arms_json = arms_json + "{\"variant\":\"" + variant + "\""
        if binding != "" {
          arms_json = arms_json + ",\"bind\":\"" + binding + "\""
        }
        arms_json = arms_json + ",\"expr\":" + expr_json + "}"
        arm_count = arm_count + 1
        total_arm_count = total_arm_count + 1

        if arm_name_count > 0 { arm_names_json = arm_names_json + "," }
        arm_names_json = arm_names_json + "\"" + variant + "\""
        arm_name_count = arm_name_count + 1
      }

      j = ctx.skip_ws(src, j)
      if j < n && src.substring(j, j + 1) == "," { j = j + 1 }
      if j <= iteration_start {
        return "{\"type\":\"Error\",\"message\":\"match parser made no progress\"}"
      }
      loop_guard = loop_guard + 1
    }

    if loop_guard >= max { return me._error("match arm limit exceeded") }
    if total_arm_count == 0 { return me._error("match requires at least one arm") }
    if j >= n || src.substring(j, j + 1) != "}" {
      return me._error("expected closing brace")
    }
    j = j + 1
    ctx.gpos_set(j)

    arm_names_json = arm_names_json + "]"
    arms_json = arms_json + "]"
    local enum_name = ctx.resolve_match_enum(arm_names_json)
    if enum_name == null || enum_name == "" {
      return "{\"type\":\"Error\",\"message\":\"unsupported match surface\"}"
    }
    if ctx.match_arm_names_are_unique(arm_names_json) != 1 {
      return me._contract_error(ctx, "parser/hako_enum_match_duplicate_variant", "enum match variants must be unique")
    }
    if else_json == null && ctx.match_is_exhaustive(enum_name, arm_names_json) != 1 {
      return me._contract_error(ctx, "parser/hako_enum_match_non_exhaustive", "enum match without wildcard else must be exhaustive")
    }
    if ctx.match_unit_bindings_are_valid(enum_name, arms_json) != 1 {
      return me._contract_error(ctx, "parser/hako_enum_match_unit_binding", "unit enum variant cannot bind a payload")
    }

    local out = "{\"type\":\"EnumMatch\",\"enum\":\"" + enum_name + "\",\"scrutinee\":" + scrutinee + ",\"arms\":" + arms_json
    if else_json != null {
      out = out + ",\"else\":" + else_json
    }
    out = out + "}"
    return out
  }

  _parse_named_head(src, i, ctx) {
    local idp = ctx.read_ident2(src, i)
    local at = idp.lastIndexOf("@")
    local variant = idp.substring(0, at)
    local j = ctx.to_int(idp.substring(at + 1, idp.length()))
    local binding = ""
    j = ctx.skip_ws(src, j)
    if j < src.length() && src.substring(j, j + 1) == "(" {
      j = j + 1
      j = ctx.skip_ws(src, j)
      local bindp = ctx.read_ident2(src, j)
      local at_bind = bindp.lastIndexOf("@")
      binding = bindp.substring(0, at_bind)
      j = ctx.to_int(bindp.substring(at_bind + 1, bindp.length()))
      j = ctx.skip_ws(src, j)
      if j < src.length() && src.substring(j, j + 1) == ")" { j = j + 1 } else { return variant + "@@-1" }
    }
    return variant + "@" + binding + "@" + ctx.i2s(j)
  }

  _parse_arm_body(src, i, ctx) {
    local j = ctx.skip_ws(src, i)
    local expr_json = "{\"type\":\"Int\",\"value\":0}"
    if j < src.length() && src.substring(j, j + 1) == "{" {
      j = j + 1
      j = ctx.skip_ws(src, j)
      expr_json = ctx.parse_expr2(src, j)
      j = ctx.gpos_get()
      j = ctx.skip_ws(src, j)
      if j < src.length() && src.substring(j, j + 1) == "}" { j = j + 1 } else { return expr_json + "@-1" }
    } else {
      expr_json = ctx.parse_expr2(src, j)
      j = ctx.gpos_get()
    }
    return expr_json + "@" + ctx.i2s(j)
  }

  _error(message) {
    return "{\"type\":\"Error\",\"message\":\"" + message + "\"}"
  }

  _contract_error(ctx, stable_tag, message) {
    ctx.freeze_contract(stable_tag, message)
    return me._error(message)
  }
}

// Parser-only parameter syntax. These records carry no resolver type, Home
// demand, ABI, or callable behavior meaning.
box ParserParameterSyntaxIssuerSealV1 {
}

enum ParserParameterTransferKindV1 {
  Ordinary(ParserParameterSyntaxIssuerSealV1)
  Take(ParserParameterSyntaxIssuerSealV1)
}

box ParserParameterTransferSyntaxV1 {
  _kind: ParserParameterTransferKindV1
  birth(kind) { me._kind = kind }
  accepts_ordinary() {
    guard let ParserParameterTransferKindV1::Ordinary(issuer) = me._kind else { return false }
    return issuer != null
  }
}

enum ParserDeclaredParameterTypeKindV1 {
  Absent(ParserParameterSyntaxIssuerSealV1)
  Explicit(ParserParameterSyntaxIssuerSealV1)
}

box ParserDeclaredParameterTypeSyntaxV1 {
  _kind: ParserDeclaredParameterTypeKindV1
  _token: String
  birth(kind, token) { me._kind = kind me._token = token }
  is_valid() {
    guard let ParserDeclaredParameterTypeKindV1::Absent(issuer) = me._kind else {
      guard let ParserDeclaredParameterTypeKindV1::Explicit(explicit_issuer) = me._kind else { return false }
      return explicit_issuer != null && me._token != ""
    }
    return issuer != null && me._token == ""
  }
  is_absent() {
    guard let ParserDeclaredParameterTypeKindV1::Absent(issuer) = me._kind else { return false }
    return issuer != null
  }
  token_or_empty() { return me._token }
}

box ParserParameterSourceSiteV1 {
  _method_site
  _ordinal: Integer
  birth(method_site, ordinal) { me._method_site = method_site me._ordinal = ordinal }
  method_site() { return me._method_site }
  ordinal() { return me._ordinal }
  same(other) {
    return other != null && me._ordinal == other.ordinal() && me._method_site.same(other.method_site())
  }
}

box ParserParameterSyntaxRowV1 {
  _site
  _name: String
  _declared_type
  _transfer
  birth(site, name, declared_type, transfer) {
    me._site = site me._name = name
    me._declared_type = declared_type me._transfer = transfer
  }
  site() { return me._site }
  name() { return me._name }
  declared_type() { return me._declared_type }
  declared_type_token() { return me._declared_type.token_or_empty() }
  transfer() { return me._transfer }
}

// One-way compatibility view. It borrows one sealed row and deliberately
// omits transfer syntax and source identity.
box ParserNeutralParameterDeclV1 {
  _row
  birth(row) { me._row = row }
  name() { return me._row.name() }
  declared_type_token() { return me._row.declared_type_token() }
}

box ParserParameterListProductV1 {
  _source_unit
  _method_site
  _rows: ArrayBox
  _neutral: ArrayBox
  birth(source_unit, method_site, rows, neutral) {
    me._source_unit = source_unit
    me._method_site = method_site me._rows = rows
    me._neutral = neutral
  }
  method_site() { return me._method_site }
  same_parser_source(source_unit) {
    return source_unit != null && me._source_unit.same(source_unit)
  }
  same_method_site(method_site) {
    return method_site != null && me._method_site.same(method_site)
  }
  parameter_count() { return me._rows.size() }
  row(index) { return me._rows.get(index) }
  neutral_parameter(index) { return me._neutral.get(index) }
}

box ParserParameterListFinishV1 {
  _status: String
  _product
  _issue: String
  birth(status, product, issue) {
    me._status = status me._product = product me._issue = issue
  }
  status() { return me._status }
  product() { return me._product }
  issue() { return me._issue }
}

static box ParserParameterSyntaxRecordsV1Box {
  ordinary_transfer() {
    local issuer = new ParserParameterSyntaxIssuerSealV1()
    return new ParserParameterTransferSyntaxV1(ParserParameterTransferKindV1::Ordinary(issuer))
  }
  declared_type(token) {
    local issuer = new ParserParameterSyntaxIssuerSealV1()
    if token == "" {
      return new ParserDeclaredParameterTypeSyntaxV1(ParserDeclaredParameterTypeKindV1::Absent(issuer), "")
    }
    return new ParserDeclaredParameterTypeSyntaxV1(ParserDeclaredParameterTypeKindV1::Explicit(issuer), token)
  }
  site(method_site, ordinal) {
    if method_site == null || ordinal < 0 { return null }
    return new ParserParameterSourceSiteV1(method_site, ordinal)
  }
  row(site, name, declared_type, transfer) {
    return new ParserParameterSyntaxRowV1(site, name, declared_type, transfer)
  }
  neutral(row) { return new ParserNeutralParameterDeclV1(row) }
  product(source_unit, method_site, rows, neutral) {
    return new ParserParameterListProductV1(source_unit, method_site, rows, neutral)
  }
  ready(product) { return new ParserParameterListFinishV1("Ready", product, "") }
  failed(issue) { return new ParserParameterListFinishV1("InternalCarrierContractViolation", null, issue) }
}

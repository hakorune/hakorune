using lang.compiler.parser.source_carrier_v1.source_vocabulary_v1 as SourceVocabularyV1Box
using lang.compiler.parser.source_carrier_v1.source_refs_v1 as SourceCarrierRefsV1Box
using lang.compiler.parser.source_carrier_v1.source_records_v1 as SourceCarrierRecordsV1Box
using lang.compiler.parser.source_carrier_v1.source_carrier_outcome_v1 as SourceCarrierOutcomeV1Box
using lang.compiler.parser.source_carrier_v1.source_carrier_sealer_v1 as SourceCarrierSealerV1Box

box SourceNodeListDraftV1 {
  _index: Integer
  _family: String
  _nodes: ArrayBox
  _sealed: Bool
  birth(index, family) { me._index = index me._family = family me._nodes = new ArrayBox() me._sealed = false }
  index() { return me._index }
  family() { return me._family }
  sealed() { return me._sealed }
  node_count() { return me._nodes.size() }
  node_ref(index) { return me._nodes.get(index) }
  append(node_ref) { me._nodes.push(node_ref) }
  seal() { me._sealed = true }
}

box SourceCarrierBuilderV1 {
  _arena
  _state: String
  _nodes: ArrayBox
  _lists: ArrayBox
  _root_ref
  _issue
  birth() {
    me._arena = SourceCarrierRefsV1Box.arena()
    me._state = SourceVocabularyV1Box.state_open()
    me._nodes = new ArrayBox() me._lists = new ArrayBox()
    me._root_ref = null me._issue = null
  }
  state() { return me._state }
  issue() { return me._issue }
  published_tree_count() {
    if me._state == SourceVocabularyV1Box.state_sealed() { return 1 }
    return 0
  }

  create_list(family) {
    if me._require_open("internal.carrier.mutation_after_close") == false { return null }
    if SourceVocabularyV1Box.valid_family(family) == false || family == SourceVocabularyV1Box.family_root() {
      me._poison("internal.carrier.list_family_invalid") return null
    }
    local index = me._lists.size()
    me._lists.push(new SourceNodeListDraftV1(index, family))
    return SourceCarrierRefsV1Box.list(me._arena, index)
  }

  list_push(list_ref, node_ref) {
    if me._require_open("internal.carrier.mutation_after_close") == false { return false }
    local list = me._list_or_poison(list_ref)
    if list == null { return false }
    if list.sealed() == true { me._poison("internal.carrier.list_mutation_after_seal") return false }
    local node = me._node_or_poison(node_ref)
    if node == null { return false }
    if node.family() != list.family() { me._poison("internal.carrier.list_node_family_mismatch") return false }
    list.append(node_ref)
    return true
  }

  seal_list(list_ref) {
    if me._require_open("internal.carrier.mutation_after_close") == false { return false }
    local list = me._list_or_poison(list_ref)
    if list == null { return false }
    if list.sealed() == true { me._poison("internal.carrier.list_double_seal") return false }
    list.seal()
    return true
  }

  add_literal_int(value) {
    return me._append_node(SourceVocabularyV1Box.family_expr(), SourceVocabularyV1Box.kind_literal_int(), value, new ArrayBox(), new ArrayBox())
  }
  add_unary_neg(operand_ref) {
    local children = new ArrayBox() children.push(operand_ref)
    return me._append_node(SourceVocabularyV1Box.family_expr(), SourceVocabularyV1Box.kind_unary_op(), "Neg", children, new ArrayBox())
  }
  add_return_absent() {
    return me._append_node(SourceVocabularyV1Box.family_stmt(), SourceVocabularyV1Box.kind_return(), SourceVocabularyV1Box.presence_absent(), new ArrayBox(), new ArrayBox())
  }
  add_return_present(value_ref) {
    local children = new ArrayBox() children.push(value_ref)
    return me._append_node(SourceVocabularyV1Box.family_stmt(), SourceVocabularyV1Box.kind_return(), SourceVocabularyV1Box.presence_present(), children, new ArrayBox())
  }
  add_source_body(stmt_list_ref) {
    local lists = new ArrayBox() lists.push(stmt_list_ref)
    local ref = me._append_node(SourceVocabularyV1Box.family_root(), SourceVocabularyV1Box.kind_source_body(), null, new ArrayBox(), lists)
    if ref != null { me._root_ref = ref }
    return ref
  }

  finish() {
    if me._state == SourceVocabularyV1Box.state_poisoned() { return SourceCarrierOutcomeV1Box.failed(me._issue) }
    if me._state == SourceVocabularyV1Box.state_sealed() {
      return SourceCarrierOutcomeV1Box.failed(SourceCarrierOutcomeV1Box.internal("internal.carrier.double_finish"))
    }
    if me._root_ref == null { me._poison("internal.carrier.root_missing") return SourceCarrierOutcomeV1Box.failed(me._issue) }
    local result = SourceCarrierSealerV1Box.finish(me._root_ref, me._nodes, me._lists)
    if result.status() != "Ready" {
      me._issue = result.issue()
      me._state = SourceVocabularyV1Box.state_poisoned()
      return result
    }
    me._state = SourceVocabularyV1Box.state_sealed()
    return result
  }

  _append_node(family, kind, scalar, children, lists) {
    if me._require_open("internal.carrier.mutation_after_close") == false { return null }
    if SourceVocabularyV1Box.valid_kind_for_family(family, kind) == false {
      me._poison("internal.carrier.node_kind_family_invalid") return null
    }
    local next = me._nodes.size() local i = 0
    loop(i < children.size()) {
      local child = me._node_or_poison(children.get(i))
      if child == null { return null }
      if child.index() >= next { me._poison("internal.carrier.cycle_or_forward_ref") return null }
      i = i + 1
    }
    i = 0
    loop(i < lists.size()) {
      local list = me._list_or_poison(lists.get(i))
      if list == null { return null }
      if list.sealed() == false { me._poison("internal.carrier.list_unsealed") return null }
      i = i + 1
    }
    local node_record = SourceCarrierRecordsV1Box.node(next, family, kind, scalar, children, lists)
    me._nodes.push(node_record)
    return SourceCarrierRefsV1Box.node(me._arena, next)
  }

  _node_or_poison(node_ref) {
    if node_ref == null || node_ref.owned_by(me._arena) == false {
      me._poison("internal.carrier.node_ref_foreign") return null
    }
    if node_ref.index() < 0 || node_ref.index() >= me._nodes.size() {
      me._poison("internal.carrier.node_ref_invalid") return null
    }
    return me._nodes.get(node_ref.index())
  }
  _list_or_poison(list_ref) {
    if list_ref == null || list_ref.owned_by(me._arena) == false {
      me._poison("internal.carrier.list_ref_foreign") return null
    }
    if list_ref.index() < 0 || list_ref.index() >= me._lists.size() {
      me._poison("internal.carrier.list_ref_invalid") return null
    }
    return me._lists.get(list_ref.index())
  }
  _require_open(reason) {
    if me._state == SourceVocabularyV1Box.state_open() { return true }
    if me._issue == null { me._issue = SourceCarrierOutcomeV1Box.internal(reason) }
    return false
  }
  _poison(reason) {
    if me._issue == null { me._issue = SourceCarrierOutcomeV1Box.internal(reason) }
    me._state = SourceVocabularyV1Box.state_poisoned()
  }

}

static box SourceCarrierBuilderV1Box {
  open() { return new SourceCarrierBuilderV1() }
}

// Moved from apps/selfhost-compiler/boxes/parser/parser_box.hako
// ParserBox — Stage‑1 JSON v0 generator (coordinator, delegates to specialized boxes)
// Responsibility: Coordinate parsing, manage state, delegate to specialized boxes
// API: parse_program2(src) -> JSON

using sh_core as StringHelpers  // Required: ParserStringUtilsBox depends on this (using chain unresolved)
using lang.compiler.parser.scan.parser_string_utils_box
using lang.compiler.parser.scan.parser_ident_scan_box
using lang.compiler.parser.scan.parser_string_scan_box
using "lang.compiler.parser.using.using_collector_box"
using lang.compiler.parser.expr.parser_expr_box
using lang.compiler.parser.enum.parser_enum_inventory_box
using lang.compiler.parser.stmt.parser_stmt_box
using lang.compiler.parser.stmt.parser_control_box
using lang.compiler.parser.rune.rune_contract_box as RuneContractBox
using lang.compiler.parser.program.parser_program_box

box ParserBox {
  gpos
  usings_json
  externs_json
  runes_json
  enum_inventory_json
  contract_error
  stage3
  grammar_profile_mode

  birth() {
    me.gpos = 0
    me.usings_json = "[]"
    me.externs_json = "[]"
    me.runes_json = "[]"
    me.enum_inventory_json = "[]"
    me.contract_error = null
    me.stage3 = 0
    me.grammar_profile_mode = 0
    return 0
  }

  grammar_profile_mode_set(mode) {
    me.grammar_profile_mode = mode
    return 0
  }

  grammar_profile_is_compat2025() {
    if me.grammar_profile_mode == 1 { return 1 }
    return 0
  }

  freeze_contract(stable_tag, message) {
    local error = "[freeze:contract][" + stable_tag + "] " + message
    if me.contract_error == null { me.contract_error = error }
    return error
  }

  contract_error_reset() {
    me.contract_error = null
    return 0
  }

  contract_error_take() {
    local error = me.contract_error
    me.contract_error = null
    return error
  }

  stage3_enable(flag) {
    if flag == null { flag = 0 }
    if flag == 0 { me.stage3 = 0 } else { me.stage3 = 1 }
    return 0
  }

  stage3_enabled() {
    if me.stage3 == 1 { return 1 }
    return 0
  }

  opt_annotations_enabled() {
    local raw = env.get("NYASH_FEATURES")
    if raw == null { return 0 }
    local s = "" + raw
    if s.indexOf("opt-annotations") >= 0 { return 1 }
    if s.indexOf("opt_annotations") >= 0 { return 1 }
    if s.indexOf("optannotations") >= 0 { return 1 }
    return 0
  }

  rune_enabled() {
    local raw = env.get("NYASH_FEATURES")
    if raw == null { return 0 }
    local s = "" + raw
    if s.indexOf("rune") >= 0 { return 1 }
    return 0
  }

  metadata_annotations_enabled() {
    if me.rune_enabled() == 1 { return 1 }
    if me.opt_annotations_enabled() == 1 { return 1 }
    return 0
  }

  // Dev-only: enable coarse-grained parser trace when NYASH_PARSER_TRACE=1.
  trace_enabled() {
    local v = env.get("NYASH_PARSER_TRACE")
    if v == null { return 0 }
    if ("" + v) == "1" { return 1 }
    return 0
  }

  // === State management ===
  gpos_set(i) { me.gpos = i return 0 }
  gpos_get() { return me.gpos }

  // === JSON utilities ===
  esc_json(s) {
    // Defensive: accept null/void and normalize to string once
    if s == null { return "" }
    local str = "" + s
    local out = ""
    local i = 0
    local n = str.length()
    loop(i < n) {
      local ch = str.substring(i, i+1)
      local handled = 0
      if ch == "\\" {
        out = out + "\\\\"
        handled = 1
      }
      if handled == 0 && ch == "\"" {
        out = out + "\\\""
        handled = 1
      }
      if handled == 0 && ch == "\n" {
        out = out + "\\n"
        handled = 1
      }
      if handled == 0 && ch == "\r" {
        out = out + "\\r"
        handled = 1
      }
      if handled == 0 && ch == "\t" {
        out = out + "\\t"
        handled = 1
      }
      if handled == 0 {
        out = out + ch
      }
      i = i + 1
    }
    return out
  }

  // === Phase 71-SSA: Removed delegation methods to avoid SSA undef ===
  // Direct use of ParserStringUtilsBox methods recommended instead
  // Removed: is_digit, is_space, is_alpha, starts_with, index_of
  // Use ParserStringUtilsBox.method() directly to avoid ValueId mapping issues

  trim(s) {
    // Phase 71-SSA: Direct implementation to avoid ValueId mapping issue in static box delegation
    if s == null { return "" }
    local str = "" + s
    local n = str.length()

    local b = ParserStringUtilsBox.skip_ws(str, 0)
    if b >= n { return "" }

    local e = n
    loop(e > b) {
      local ch = str.substring(e - 1, e)
      if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" || ch == ";" { e = e - 1 } else { break }
    }

    if e > b { return str.substring(b, e) }
    return ""
  }

  // Phase 71-SSA: Removed delegation methods to avoid SSA undef
  // Removed: starts_with_kw, i2s, to_int, skip_ws
  // Use ParserStringUtilsBox.method() directly instead

  // === Parser contract (instance delegation) ===
  // ParserControlBox / ParserExprBox expect these helpers on `ctx`.
  // Implement as instance methods to keep call sites stable while delegating the
  // actual logic to the static, SSOT helpers.
  // Keep these ultra-stable: they are used to encode/decode positions like "...]@123".
  // Prefer direct coercions over recursive helpers to avoid accidental VM/SSA edge cases.
  i2s(v) {
    if v == null { return "0" }
    return "" + v
  }
  to_int(s) { return StringHelpers.to_i64("" + s) }
  skip_ws(src, i) { return StringHelpers.skip_ws(src, i) }
  is_digit(ch) { return ParserStringUtilsBox.is_digit(ch) }
  is_space(ch) { return ParserStringUtilsBox.is_space(ch) }
  is_alpha(ch) { return ParserStringUtilsBox.is_alpha(ch) }
  starts_with(src, i, pat) { return ParserStringUtilsBox.starts_with(src, i, pat) }
  starts_with_kw(src, i, kw) { return ParserStringUtilsBox.starts_with_kw(src, i, kw) }
  index_of(src, i, pat) { return ParserStringUtilsBox.index_of(src, i, pat) }

  // === Delegation to scanner boxes ===
  read_ident2(src, i) { return ParserIdentScanBox.scan_ident(src, i) }

  read_string_lit(src, i) {
    local q0 = src.substring(i, i + 1)

    // Check for single quote (syntax-3 only)
    if q0 == "'" {
      if me.stage3_enabled() == 1 {
        // Single-quote string in syntax-3
        local pair = ParserStringScanBox.scan_with_quote(src, i, "'")
        local at = pair.lastIndexOf("@")
        local content = pair.substring(0, at)
        local pos = 0
        if at >= 0 { pos = ParserStringUtilsBox.to_int(pair.substring(at+1, pair.length())) }
        else { pos = i }
        me.gpos_set(pos)
        return content
      } else {
        // Single-quote not allowed, degrade gracefully
        // Return empty string and advance 1 char
        me.gpos_set(i + 1)
        return ""
      }
    }

    // Double-quote string (existing path)
    local pair = ParserStringScanBox.scan(src, i)
    local at = pair.lastIndexOf("@")
    local content = pair.substring(0, at)
    local pos = 0
    if at >= 0 { pos = ParserStringUtilsBox.to_int(pair.substring(at+1, pair.length())) }
    else { pos = i }
    me.gpos_set(pos)
    return content
  }

  // === using system ===
  add_using(kind, target, alias) {
    local cur = me.usings_json
    if cur == null || cur.length() == 0 { cur = "[]" }

    local name = ""
    local path = null

    if kind == "path" {
      path = target
      if alias != null {
        name = alias
      } else {
        local p = target
        local idx = -1
        local t = 0
        loop(t < p.length()) {
          if p.substring(t,t+1) == "/" { idx = t }
          t = t + 1
        }
        if idx >= 0 { p = p.substring(idx+1, p.length()) }

        if p.length() > 5 && ParserStringUtilsBox.starts_with(p, p.length()-5, ".hako") == 1 {
          p = p.substring(0, p.length()-5)
        } else {
          if p.length() > 6 && ParserStringUtilsBox.starts_with(p, p.length()-6, ".hako") == 1 {
            p = p.substring(0, p.length()-6)
          }
        }
        name = p
      }
    } else {
      name = target
      if alias != null { name = alias }
    }

    local entry = "{\"name\":\"" + me.esc_json(name) + "\""
    if path != null { entry = entry + ",\"path\":\"" + me.esc_json(path) + "\"" }
    entry = entry + "}"

    if cur == "[]" {
      me.usings_json = "[" + entry + "]"
      return 0
    }

    local pos = cur.lastIndexOf("]")
    if pos < 0 {
      me.usings_json = "[" + entry + "]"
      return 0
    }

    me.usings_json = cur.substring(0, pos) + "," + entry + "]"
    return 0
  }

  extract_usings(src) {
    me.usings_json = UsingCollectorBox.collect(src)
    return 0
  }

  get_usings_json() {
    return me.usings_json
  }

  // Check if a name is a using alias (Phase 173-2)
  // Used to detect static box calls like JsonParserBox.parse()
  is_using_alias(name) {
    if name == null { return 0 }
    local usings = me.usings_json
    if usings == null || usings.length() == 0 { return 0 }

    // Search for {"name":"<name>"} pattern in usings JSON
    local search = "\"name\":\"" + name + "\""
    local pos = usings.indexOf(search)
    if pos >= 0 { return 1 }
    return 0
  }

  // === extern_c annotations ===
  add_extern_c(symbol, func) {
    // Entry shape: {"symbol":"hako_add","func":"Name/Arity"}
    local sym = symbol
    if sym == null { sym = "" }
    local func_name = func
    if func_name == null { func_name = "" }
    local entry = "{\"symbol\":\"" + me.esc_json(sym) + "\",\"func\":\"" + me.esc_json(func_name) + "\"}"
    local cur = me.externs_json
    if cur == null || cur.length() == 0 { cur = "[]" }
    if cur == "[]" {
      me.externs_json = "[" + entry + "]"
      return 0
    }
    local pos = cur.lastIndexOf("]")
    if pos < 0 {
      me.externs_json = "[" + entry + "]"
      return 0
    }
    me.externs_json = cur.substring(0, pos) + "," + entry + "]"
    return 0
  }

  extract_externs(_src) {
    // MVP: rely on ParserStmtBox to call add_extern_c during parse; here no-op for now.
    return 0
  }

  get_externs_json() {
    return me.externs_json
  }

  add_rune(entry) {
    local cur = me.runes_json
    if cur == null || cur.length() == 0 { cur = "[]" }
    if cur == "[]" {
      me.runes_json = "[" + entry + "]"
      return 0
    }
    local pos = cur.lastIndexOf("]")
    if pos < 0 {
      me.runes_json = "[" + entry + "]"
      return 0
    }
    me.runes_json = cur.substring(0, pos) + "," + entry + "]"
    return 0
  }

  get_runes_json() {
    return me.runes_json
  }

  set_runes_json(runes_json) {
    me.runes_json = RuneContractBox.normalize_pending_json(runes_json)
    return 0
  }

  consume_runes_json() {
    local out = me.runes_json
    if out == null || out.length() == 0 { out = "[]" }
    me.runes_json = "[]"
    return out
  }

  set_enum_inventory_from_source(src) {
    me.enum_inventory_json = ParserEnumInventoryBox.collect(src)
    return 0
  }

  set_enum_inventory_json(inventory_json) {
    me.enum_inventory_json = inventory_json
    return 0
  }

  get_enum_inventory_json() {
    return me.enum_inventory_json
  }

  resolve_match_enum(arm_names_json) {
    return ParserEnumInventoryBox.resolve_match_enum(me.enum_inventory_json, arm_names_json)
  }

  enum_variant_is_unit(enum_name, variant_name) {
    return ParserEnumInventoryBox.variant_is_unit(me.enum_inventory_json, enum_name, variant_name)
  }

  match_arm_names_are_unique(arm_names_json) {
    return ParserEnumInventoryBox.match_arm_names_are_unique(arm_names_json)
  }

  match_is_exhaustive(enum_name, arm_names_json) {
    return ParserEnumInventoryBox.match_is_exhaustive(me.enum_inventory_json, enum_name, arm_names_json)
  }

  match_unit_bindings_are_valid(enum_name, arms_json) {
    return ParserEnumInventoryBox.match_unit_bindings_are_valid(me.enum_inventory_json, enum_name, arms_json)
  }

  // === Delegation to ParserExprBox ===
  parse_expr2(src, i) {
    return ParserExprBox.parse_expr2(src, i, me)
  }

  // === Delegation to ParserStmtBox ===
  parse_stmt2(src, i) {
    return ParserStmtBox.parse(src, i, me)
  }

  static_const_table_fail(src, tag) {
    me.gpos_set(src.length())
    return "[freeze:contract][static-const/" + tag + "]"
  }

  static_const_eval_error(tag) {
    return "!" + tag
  }

  static_const_eval_is_error(ret) {
    if ret == null { return 1 }
    if ("" + ret).length() == 0 { return 1 }
    if ("" + ret).substring(0, 1) == "!" { return 1 }
    return 0
  }

  static_const_eval_error_tag(ret) {
    local s = "" + ret
    if s.length() <= 1 { return "unsupported-initializer" }
    return s.substring(1, s.length())
  }

  static_const_eval_pair(value, pos) {
    return StringHelpers.int_to_str(value) + "@" + StringHelpers.int_to_str(pos)
  }

  static_const_eval_value(ret) {
    local s = "" + ret
    local at = s.lastIndexOf("@")
    if at < 0 { return 0 }
    return StringHelpers.to_i64(s.substring(0, at))
  }

  static_const_eval_pos(ret) {
    local s = "" + ret
    local at = s.lastIndexOf("@")
    if at < 0 { return 0 }
    return StringHelpers.to_i64(s.substring(at + 1, s.length()))
  }

  static_const_bitand(lhs, rhs) {
    local a = lhs
    local b = rhs
    local bit = 1
    local out = 0
    loop(a > 0 || b > 0) {
      local abit = a % 2
      local bbit = b % 2
      if abit == 1 && bbit == 1 { out = out + bit }
      a = a / 2
      b = b / 2
      bit = bit * 2
    }
    return out
  }

  static_const_bitor(lhs, rhs) {
    local a = lhs
    local b = rhs
    local bit = 1
    local out = 0
    loop(a > 0 || b > 0) {
      local abit = a % 2
      local bbit = b % 2
      if abit == 1 || bbit == 1 { out = out + bit }
      a = a / 2
      b = b / 2
      bit = bit * 2
    }
    return out
  }

  static_const_bitxor(lhs, rhs) {
    local a = lhs
    local b = rhs
    local bit = 1
    local out = 0
    loop(a > 0 || b > 0) {
      local abit = a % 2
      local bbit = b % 2
      if (abit == 1 && bbit == 0) || (abit == 0 && bbit == 1) { out = out + bit }
      a = a / 2
      b = b / 2
      bit = bit * 2
    }
    return out
  }

  static_const_eval_u16_expr(expr) {
    local text = ParserStringUtilsBox.trim(expr)
    if text.length() == 0 { return me.static_const_eval_error("unsupported-initializer") }
    local ret = me.static_const_parse_bitor(text, 0)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    if pos != text.length() { return me.static_const_eval_error("unsupported-initializer") }
    local value = me.static_const_eval_value(ret)
    if value < 0 || value > 65535 { return me.static_const_eval_error("value-out-of-range") }
    return StringHelpers.int_to_str(value)
  }

  static_const_parse_bitor(text, pos) {
    local ret = me.static_const_parse_bitxor(text, pos)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local value = me.static_const_eval_value(ret)
    pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    loop(pos < text.length() && text.substring(pos, pos + 1) == "|") {
      local rhs = me.static_const_parse_bitxor(text, pos + 1)
      if me.static_const_eval_is_error(rhs) == 1 { return rhs }
      local rv = me.static_const_eval_value(rhs)
      if value < 0 || rv < 0 { return me.static_const_eval_error("unsupported-initializer") }
      value = me.static_const_bitor(value, rv)
      pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(rhs))
    }
    return me.static_const_eval_pair(value, pos)
  }

  static_const_parse_bitxor(text, pos) {
    local ret = me.static_const_parse_bitand(text, pos)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local value = me.static_const_eval_value(ret)
    pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    loop(pos < text.length() && text.substring(pos, pos + 1) == "^") {
      local rhs = me.static_const_parse_bitand(text, pos + 1)
      if me.static_const_eval_is_error(rhs) == 1 { return rhs }
      local rv = me.static_const_eval_value(rhs)
      if value < 0 || rv < 0 { return me.static_const_eval_error("unsupported-initializer") }
      value = me.static_const_bitxor(value, rv)
      pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(rhs))
    }
    return me.static_const_eval_pair(value, pos)
  }

  static_const_parse_bitand(text, pos) {
    local ret = me.static_const_parse_shift(text, pos)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local value = me.static_const_eval_value(ret)
    pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    loop(pos < text.length() && text.substring(pos, pos + 1) == "&") {
      local rhs = me.static_const_parse_shift(text, pos + 1)
      if me.static_const_eval_is_error(rhs) == 1 { return rhs }
      local rv = me.static_const_eval_value(rhs)
      if value < 0 || rv < 0 { return me.static_const_eval_error("unsupported-initializer") }
      value = me.static_const_bitand(value, rv)
      pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(rhs))
    }
    return me.static_const_eval_pair(value, pos)
  }

  static_const_parse_shift(text, pos) {
    local ret = me.static_const_parse_add(text, pos)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local value = me.static_const_eval_value(ret)
    pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    loop(pos + 1 < text.length() && (text.substring(pos, pos + 2) == "<<" || text.substring(pos, pos + 2) == ">>")) {
      local op = text.substring(pos, pos + 2)
      local rhs = me.static_const_parse_add(text, pos + 2)
      if me.static_const_eval_is_error(rhs) == 1 { return rhs }
      local amount = me.static_const_eval_value(rhs)
      if amount < 0 || amount > 63 { return me.static_const_eval_error("unsupported-initializer") }
      if value < 0 { return me.static_const_eval_error("unsupported-initializer") }
      if op == "<<" {
        local c = 0
        loop(c < amount) {
          value = value * 2
          c = c + 1
        }
      } else {
        local c2 = 0
        loop(c2 < amount) {
          value = value / 2
          c2 = c2 + 1
        }
      }
      pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(rhs))
    }
    return me.static_const_eval_pair(value, pos)
  }

  static_const_parse_add(text, pos) {
    local ret = me.static_const_parse_mul(text, pos)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local value = me.static_const_eval_value(ret)
    pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    loop(pos < text.length() && (text.substring(pos, pos + 1) == "+" || text.substring(pos, pos + 1) == "-")) {
      local op = text.substring(pos, pos + 1)
      local rhs = me.static_const_parse_mul(text, pos + 1)
      if me.static_const_eval_is_error(rhs) == 1 { return rhs }
      local rv = me.static_const_eval_value(rhs)
      if op == "+" { value = value + rv } else { value = value - rv }
      pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(rhs))
    }
    return me.static_const_eval_pair(value, pos)
  }

  static_const_parse_mul(text, pos) {
    local ret = me.static_const_parse_unary(text, pos)
    if me.static_const_eval_is_error(ret) == 1 { return ret }
    local value = me.static_const_eval_value(ret)
    pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(ret))
    loop(pos < text.length() && (text.substring(pos, pos + 1) == "*" || text.substring(pos, pos + 1) == "/" || text.substring(pos, pos + 1) == "%")) {
      local op = text.substring(pos, pos + 1)
      local rhs = me.static_const_parse_unary(text, pos + 1)
      if me.static_const_eval_is_error(rhs) == 1 { return rhs }
      local rv = me.static_const_eval_value(rhs)
      if (op == "/" || op == "%") && rv == 0 { return me.static_const_eval_error("unsupported-initializer") }
      if op == "*" { value = value * rv }
      else { if op == "/" { value = value / rv } else { value = value % rv } }
      pos = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(rhs))
    }
    return me.static_const_eval_pair(value, pos)
  }

  static_const_parse_unary(text, pos) {
    pos = ParserStringUtilsBox.skip_ws(text, pos)
    if pos < text.length() && text.substring(pos, pos + 1) == "-" {
      local ret = me.static_const_parse_unary(text, pos + 1)
      if me.static_const_eval_is_error(ret) == 1 { return ret }
      return me.static_const_eval_pair(0 - me.static_const_eval_value(ret), me.static_const_eval_pos(ret))
    }
    return me.static_const_parse_primary(text, pos)
  }

  static_const_parse_primary(text, pos) {
    pos = ParserStringUtilsBox.skip_ws(text, pos)
    if pos >= text.length() { return me.static_const_eval_error("unsupported-initializer") }
    if text.substring(pos, pos + 1) == "(" {
      local inner = me.static_const_parse_bitor(text, pos + 1)
      if me.static_const_eval_is_error(inner) == 1 { return inner }
      local after = ParserStringUtilsBox.skip_ws(text, me.static_const_eval_pos(inner))
      if after >= text.length() || text.substring(after, after + 1) != ")" {
        return me.static_const_eval_error("unsupported-initializer")
      }
      return me.static_const_eval_pair(me.static_const_eval_value(inner), after + 1)
    }
    local start = pos
    loop(pos < text.length() && ParserStringUtilsBox.is_digit(text.substring(pos, pos + 1)) == 1) {
      pos = pos + 1
    }
    if pos <= start { return me.static_const_eval_error("unsupported-initializer") }
    return me.static_const_eval_pair(StringHelpers.to_i64(text.substring(start, pos)), pos)
  }

  parse_static_const_table_decl(src, i) {
    local j = ParserStringUtilsBox.skip_ws(src, i)
    if ParserStringUtilsBox.starts_with_kw(src, j, "static") != 1 { return null }
    j = ParserStringUtilsBox.skip_ws(src, j + 6)
    if ParserStringUtilsBox.starts_with_kw(src, j, "const") != 1 { return null }
    j = ParserStringUtilsBox.skip_ws(src, j + 5)

    local namep = me.read_ident2(src, j)
    local at_name = namep.lastIndexOf("@")
    if at_name < 0 { return me.static_const_table_fail(src, "declaration") }
    local name = namep.substring(0, at_name)
    if name.length() == 0 { return me.static_const_table_fail(src, "declaration") }
    j = StringHelpers.to_i64(namep.substring(at_name + 1, namep.length()))
    j = ParserStringUtilsBox.skip_ws(src, j)

    if j >= src.length() || src.substring(j, j + 1) != ":" {
      return me.static_const_table_fail(src, "declaration")
    }
    j = ParserStringUtilsBox.skip_ws(src, j + 1)
    if ParserStringUtilsBox.starts_with_kw(src, j, "u16") != 1 {
      return me.static_const_table_fail(src, "unsupported-element")
    }
    j = ParserStringUtilsBox.skip_ws(src, j + 3)
    if j + 1 >= src.length() || src.substring(j, j + 1) != "[" || src.substring(j + 1, j + 2) != "]" {
      return me.static_const_table_fail(src, "unsupported-element")
    }
    j = ParserStringUtilsBox.skip_ws(src, j + 2)

    if j >= src.length() || src.substring(j, j + 1) != "=" {
      return me.static_const_table_fail(src, "declaration")
    }
    j = ParserStringUtilsBox.skip_ws(src, j + 1)
    if j >= src.length() || src.substring(j, j + 1) != "[" {
      return me.static_const_table_fail(src, "unsupported-initializer")
    }
    j = ParserStringUtilsBox.skip_ws(src, j + 1)

    local values = "["
    local first_value = 1
    local reading_values = 1
    loop(reading_values == 1) {
      j = ParserStringUtilsBox.skip_ws(src, j)
      if j >= src.length() { return me.static_const_table_fail(src, "unsupported-initializer") }
      if src.substring(j, j + 1) == "]" {
        j = j + 1
        reading_values = 0
      } else {
        local expr_start = j
        local depth = 0
        local scanning_expr = 1
        loop(scanning_expr == 1 && j < src.length()) {
          local ch_expr = src.substring(j, j + 1)
          if ch_expr == "(" { depth = depth + 1 }
          else { if ch_expr == ")" {
            depth = depth - 1
            if depth < 0 { return me.static_const_table_fail(src, "unsupported-initializer") }
          } else {
            if depth == 0 && (ch_expr == "," || ch_expr == "]") {
              scanning_expr = 0
              break
            }
          }}
          j = j + 1
        }
        if depth != 0 { return me.static_const_table_fail(src, "unsupported-initializer") }
        if j <= expr_start { return me.static_const_table_fail(src, "unsupported-initializer") }
        local value_text = me.static_const_eval_u16_expr(src.substring(expr_start, j))
        if me.static_const_eval_is_error(value_text) == 1 {
          return me.static_const_table_fail(src, me.static_const_eval_error_tag(value_text))
        }
        if first_value == 1 {
          values = values + value_text
          first_value = 0
        } else {
          values = values + "," + value_text
        }

        j = ParserStringUtilsBox.skip_ws(src, j)
        if j < src.length() && src.substring(j, j + 1) == "," {
          j = ParserStringUtilsBox.skip_ws(src, j + 1)
        } else {
          if j < src.length() && src.substring(j, j + 1) == "]" {
            j = j + 1
            reading_values = 0
          } else {
            return me.static_const_table_fail(src, "declaration")
          }
        }
      }
    }
    values = values + "]"
    me.gpos_set(j)
    return "{\"source_name\":\"" + me.esc_json(name) + "\",\"symbol\":\".hako.static." + me.esc_json(name) + "\",\"element\":\"u16\",\"align\":2,\"linkage\":\"private\",\"unnamed_addr\":true,\"values\":" + values + "}"
  }

  // === Delegation to ParserControlBox ===
  parse_block2(src, i) {
    return ParserControlBox.parse_block(src, i, me)
  }

  // === Top-level program parser ===
  parse_program2(src) {
    return ParserProgramBox.parse(src, me)
  }
}

static box ParserStub {
  main(args) {
    return 0
  }
}

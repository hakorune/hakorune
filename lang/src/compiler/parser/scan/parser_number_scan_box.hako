// Moved from apps/selfhost-compiler/boxes/parser/scan/parser_number_scan_box.hako
// ParserNumberScanBox — scan numeric literal starting at index i
// Returns:
//   "{\"type\":\"Int\",\"value\":<digits>}@<pos>"
//   "{\"type\":\"Float\",\"value\":<decimal>}@<pos>"
//   "{\"type\":\"Int\",\"value\":<digits>,\"declared_type\":\"usize\"}@<pos>"

using lang.compiler.parser.scan.parser_common_utils_box as ParserCommonUtilsBox
using lang.compiler.parser.scan.parser_number_lexical_parts_v1

static box ParserNumberScanBox {
  _ready_integer(spelling, suffix, start_pos, next_pos, leading_digit_count) {
    local parts = new ParserNumberLexicalPartsV1("Integer", spelling, suffix, start_pos, next_pos, leading_digit_count)
    return new ParserNumberScanOutcomeV1("Ready", parts, start_pos)
  }

  _ready_float(spelling, start_pos, next_pos, leading_digit_count) {
    local parts = new ParserNumberLexicalPartsV1("Float", spelling, "", start_pos, next_pos, leading_digit_count)
    return new ParserNumberScanOutcomeV1("Ready", parts, start_pos)
  }

  _ready_missing(suffix, start_pos, next_pos) {
    local parts = new ParserNumberLexicalPartsV1("Missing", "", suffix, start_pos, next_pos, 0)
    return new ParserNumberScanOutcomeV1("Ready", parts, start_pos)
  }

  _invalid_start(requested_start) {
    return new ParserNumberScanOutcomeV1("InvalidStart", null, requested_start)
  }

  scan_parts(src, i) {
    if src == null { return me._ready_missing("", i, i) }
    local n = src.length()
    if i < 0 || i > n { return me._invalid_start(i) }
    local j = i
    local done = 0
    // Keep one loop exit/PHI shape; the mode-B compatibility VM path can lose `j`
    // updates across early `continue` in this tiny scanner.
    loop(j < n && done == 0) {
      if ParserCommonUtilsBox.is_digit(src.substring(j, j+1)) == 1 {
        j = j + 1
      } else {
        done = 1
      }
    }
    local leading_digit_count = j - i
    local s = src.substring(i, j)

    local is_float = 0
    if j + 1 < n && src.substring(j, j + 1) == "." {
      if ParserCommonUtilsBox.is_digit(src.substring(j + 1, j + 2)) == 1 {
        is_float = 1
        j = j + 1
        loop(j < n && ParserCommonUtilsBox.is_digit(src.substring(j, j + 1)) == 1) {
          j = j + 1
        }
        s = src.substring(i, j)
      }
    }

    if is_float == 1 {
      return me._ready_float(s, i, j, leading_digit_count)
    }

    local suffix_start = j
    local suffix_done = 0
    loop(j < n && suffix_done == 0) {
      local ch = src.substring(j, j+1)
      if ParserCommonUtilsBox.is_alnum_or_underscore(ch) == 1 {
        j = j + 1
      } else {
        suffix_done = 1
      }
    }

    local suffix = src.substring(suffix_start, j)
    if leading_digit_count == 0 {
      return me._ready_missing(suffix, i, j)
    }
    return me._ready_integer(s, suffix, i, j, leading_digit_count)
  }

  scan_int(src, i) {
    local outcome = me.scan_parts(src, i)
    if outcome.is_ready() == false {
      return "{\"type\":\"Int\",\"value\":0}@" + ParserCommonUtilsBox.i2s(outcome.requested_start())
    }
    local parts = outcome.parts()
    local pos = ParserCommonUtilsBox.i2s(parts.next_pos())
    if parts.kind() == "Float" {
      return "{\"type\":\"Float\",\"value\":" + parts.spelling() + "}@" + pos
    }
    local spelling = parts.spelling()
    if parts.kind() == "Missing" { spelling = "0" }
    if parts.has_suffix() {
      return "{\"type\":\"Int\",\"value\":" + spelling + ",\"declared_type\":\"" + parts.suffix() + "\"}@" + pos
    }
    return "{\"type\":\"Int\",\"value\":" + spelling + "}@" + pos
  }
}

using lang.compiler.parser.scan.parser_string_utils_box
using lang.compiler.parser.rune.rune_contract_box as RuneContractBox
using lang.compiler.parser.decl.parser_declaration_box as ParserDeclarationBox

static box ParserProgramBox {
  parse(src, ctx) {
    ctx.contract_error_reset()
    // Dev-only: guaranteed direct marker before any env operations
    {
      local marker_enabled = env.get("HAKO_STAGEB_TRACE")
      if marker_enabled != null && ("" + marker_enabled) == "1" {
        print("[stageb/trace] ParserBox.parse_program2:entry")
      }
    }

    // Shallow recursion guard for mode-B compatibility / selfhost callers.
    {
      local depth = env.get("HAKO_STAGEB_PARSER_DEPTH")
      if depth != null && ("" + depth) != "0" {
        print("[stageb/recursion] ParserBox.parse_program2 recursion detected")
        return "{\"version\":0,\"kind\":\"Program\",\"body\":[]}"
      }
      env.set("HAKO_STAGEB_PARSER_DEPTH", "1")
    }

    {
      local marker_enabled = env.get("HAKO_STAGEB_TRACE")
      if marker_enabled != null && ("" + marker_enabled) == "1" {
        print("[stageb/trace] ParserBox.parse_program2:before_trace_enabled")
      }
    }

    local trace = ctx.trace_enabled()

    {
      local marker_enabled = env.get("HAKO_STAGEB_TRACE")
      if marker_enabled != null && ("" + marker_enabled) == "1" {
        print("[stageb/trace] ParserBox.parse_program2:after_trace_enabled trace=" + ("" + trace))
      }
    }

    local i = 0
    local n = src.length()

    {
      local marker_enabled = env.get("HAKO_STAGEB_TRACE")
      if marker_enabled != null && ("" + marker_enabled) == "1" {
        print("[stageb/trace] ParserBox.parse_program2:got_src_length n=" + ("" + n))
      }
    }

    if trace == 1 {
      print("[parser/trace:program2] start len=" + ("" + n) + " stage3=" + ("" + ctx.stage3_enabled()))
    }
    if i < n { i = ParserStringUtilsBox.skip_ws(src, i) }

    {
      local marker_enabled = env.get("HAKO_STAGEB_TRACE")
      if marker_enabled != null && ("" + marker_enabled) == "1" {
        print("[stageb/trace] ParserBox.parse_program2:before_main_loop i=" + ("" + i))
      }
    }

    local body = "["
    local first = 1
    local static_data = "["
    local static_first = 1
    local declaration_evidence = "["
    local declaration_first = 1
    local cont_prog = 1
    local guard_prog = 0
    local max_prog = 0
    {
      local m = env.get("HAKO_PARSER_PROG_MAX")
      if m != null {
        local mv = ParserStringUtilsBox.to_int(m)
        if mv > 0 { max_prog = mv }
      }
    }

    loop(cont_prog == 1) {
      i = ParserStringUtilsBox.skip_ws(src, i)
      if i >= n {
        cont_prog = 0
        break
      }

      if max_prog > 0 {
        guard_prog = guard_prog + 1
        if guard_prog > max_prog {
          if trace == 1 {
            print("[parser/program2:guard] max iteration reached at pos=" + ("" + i))
          }
          cont_prog = 0
          break
        }
      }

      local skip_statement_parse = 0
      local declaration_row = ParserDeclarationBox.parse_or_null(src, i, ctx)
      if declaration_row != null {
        if ParserStringUtilsBox.starts_with("" + declaration_row, 0, "[freeze:contract]") == 1 {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return "" + declaration_row
        }
        local declaration_at = declaration_row.lastIndexOf("@")
        if declaration_at < 0 {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return ctx.freeze_contract("parser/hako_declaration_sidecar_malformed", "declaration evidence position is missing")
        }
        local evidence = declaration_row.substring(0, declaration_at)
        i = ctx.to_int(declaration_row.substring(declaration_at + 1, declaration_row.length()))
        if declaration_first == 1 {
          declaration_evidence = declaration_evidence + evidence
          declaration_first = 0
        } else {
          declaration_evidence = declaration_evidence + "," + evidence
        }
        skip_statement_parse = 1
      }

      local static_row = null
      if skip_statement_parse == 0 { static_row = ctx.parse_static_const_table_decl(src, i) }
      if static_row != null {
        if ParserStringUtilsBox.starts_with("" + static_row, 0, "[freeze:contract]") == 1 {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return "" + static_row
        }
        i = ctx.gpos_get()
        local static_semis = 1
        loop(static_semis == 1) {
          i = ParserStringUtilsBox.skip_ws(src, i)
          if i < n && src.substring(i, i+1) == ";" {
            i = i + 1
          } else {
            static_semis = 0
          }
        }
        local pending_static_runes = ctx.consume_runes_json()
        if pending_static_runes != "[]" {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return RuneContractBox.invalid_placement_tag("static const")
        }
        if static_first == 1 {
          static_data = static_data + static_row
          static_first = 0
        } else {
          static_data = static_data + "," + static_row
        }
        skip_statement_parse = 1
      }

      if skip_statement_parse == 0 {
        local start_i = i
        local s = ctx.parse_stmt2(src, i)
        i = ctx.gpos_get()

        local expression_error = ctx.contract_error_take()
        if expression_error != null {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return expression_error
        }

        if ParserStringUtilsBox.starts_with("" + s, 0, "[freeze:contract]") == 1 {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return "" + s
        }

        if i <= start_i {
          if trace == 1 {
            print("[parser/trace:program2] progress-guard bump i from " + ("" + start_i) + " to " + ("" + (start_i + 1)))
          }
          i = start_i + 1
          if i > n { i = n }
          ctx.gpos_set(i)
        }

        if trace == 1 {
          print("[parser/trace:program2] i=" + ("" + i) + " stmt_len=" + ("" + s.length()) + " guard=" + ("" + guard_prog))
        }

        loop(true) {
          i = ParserStringUtilsBox.skip_ws(src, i)
          if i < n && src.substring(i, i+1) == ";" {
            i = i + 1
            continue
          }
          break
        }

        local pending_runes = ctx.consume_runes_json()
        if pending_runes != "[]" {
          env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
          return RuneContractBox.invalid_placement_tag("statement")
        }
        if s.length() > 0 {
          if first == 1 {
            if trace == 1 {
              print("[parser/trace:program2] emit-first stmt_len=" + ("" + s.length()))
            }
            body = body + s
            first = 0
          } else {
            if trace == 1 {
              print("[parser/trace:program2] emit stmt_len=" + ("" + s.length()))
            }
            body = body + "," + s
          }
        }
      }
    }

    body = body + "]"
    static_data = static_data + "]"
    declaration_evidence = declaration_evidence + "]"
    if ctx.consume_runes_json() != "[]" {
      env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
      return RuneContractBox.invalid_placement_tag("statement")
    }
    if trace == 1 {
      print("[parser/trace:program2] done pos=" + ("" + i) + " len=" + ("" + n))
    }
    env.set("HAKO_STAGEB_PARSER_DEPTH", "0")
    local enum_decls = ctx.get_enum_inventory_json()
    if enum_decls == null || enum_decls == "" { enum_decls = "[]" }
    local parser_evidence = "{\"version\":1,\"evidence_kind\":\"declaration_sidecar\",\"semantic_publication\":false"
    parser_evidence = parser_evidence + ",\"mir_lowering_allowed\":false,\"runtime_allowed\":false,\"backend_allowed\":false"
    parser_evidence = parser_evidence + ",\"declarations\":" + declaration_evidence + "}"
    return "{\"version\":0,\"kind\":\"Program\",\"body\":" + body + ",\"enum_decls\":" + enum_decls + ",\"static_data_plans\":" + static_data + ",\"parser_evidence\":" + parser_evidence + "}"
  }
}

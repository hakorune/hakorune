// record_packed_layout_refresh_projector.hako — RecordPackedLayoutRefreshHakoProjector
//
// Responsibility:
// - project record-packed-layout refresh facts into a bounded shadow candidate
// - package shadow metadata for canonical JSON parity
//
// Non-responsibility:
// - Python oracle generation
// - Hako artifact emission
// - TypeBox ABI
// - host ABI
// - runtime fallback

using lang.compiler.lib.projection_value as CompilerProjectionValueBox
using lang.compiler.lib.projector_support as CompilerProjectorSupportBox
using selfhost.shared.common.box_helpers as BoxHelpers
using selfhost.shared.common.string_helpers as StringHelpers

static box RecordPackedLayoutRefreshHakoProjector {
  _validate_plan(plan_box, tag) {
    local err = CompilerProjectorSupportBox.require_map(plan_box, "plan", tag)
    if err != null {
      return err
    }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(plan_box.payload, "kind"),
      "plan.kind",
      "MirBuilderRecordPackedLayoutRefreshPlanV1",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(plan_box.payload, "subject"),
      "plan.subject",
      "MirBuilder::finalize_module record/packed layout refresh",
      tag,
    )
    if err != null { return err }

    local source_authority = BoxHelpers.map_get(plan_box.payload, "source_authority")
    err = CompilerProjectorSupportBox.require_map(source_authority, "plan.source_authority", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(source_authority, "finalize"),
      "plan.source_authority.finalize",
      "src/mir/builder/module_lifecycle.rs::MirBuilder::finalize_module",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(source_authority, "refresh_entrypoint"),
      "plan.source_authority.refresh_entrypoint",
      "src/mir/semantic_refresh.rs::refresh_module_record_and_packed_layout_plans",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(source_authority, "predecessor_plan"),
      "plan.source_authority.predecessor_plan",
      "mirbuilder-module-metadata-publication-plan-v0.json",
      tag,
    )
    if err != null { return err }

    local execution_profile = BoxHelpers.map_get(plan_box.payload, "execution_profile")
    err = CompilerProjectorSupportBox.require_map(execution_profile, "plan.execution_profile", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(execution_profile, "input"),
      "plan.execution_profile.input",
      "ASTNode::Literal(Integer(0))",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(execution_profile, "context"),
      "plan.execution_profile.context",
      "finalize_module",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(execution_profile, "module_transport"),
      "plan.execution_profile.module_transport",
      "MirModuleMinimalShell",
      tag,
    )
    if err != null { return err }

    local refresh_policy = BoxHelpers.map_get(plan_box.payload, "refresh_policy")
    err = CompilerProjectorSupportBox.require_map(refresh_policy, "plan.refresh_policy", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(refresh_policy, "entrypoint"),
      "plan.refresh_policy.entrypoint",
      "refresh_module_record_and_packed_layout_plans",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(refresh_policy, "timing"),
      "plan.refresh_policy.timing",
      "AfterModuleMetadataPublicationBeforeTypedObjectRefresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(refresh_policy, "module_arg"),
      "plan.refresh_policy.module_arg",
      "&mut MirModule",
      tag,
    )
    if err != null { return err }

    local available_capabilities = BoxHelpers.map_get(plan_box.payload, "available_capabilities")
    err = CompilerProjectorSupportBox.require_array(available_capabilities, "plan.available_capabilities", tag)
    if err != null { return err }
    if CompilerProjectorSupportBox.has_string_item(available_capabilities, "RecordAndPackedLayoutRefresh") != true {
      return CompilerProjectorSupportBox.fail(tag, "[plan.available_capabilities] missing RecordAndPackedLayoutRefresh")
    }

    local result_contract = BoxHelpers.map_get(plan_box.payload, "result_contract")
    err = CompilerProjectorSupportBox.require_map(result_contract, "plan.result_contract", tag)
    if err != null { return err }
    local mutates = BoxHelpers.map_get(result_contract, "mutates")
    err = CompilerProjectorSupportBox.require_array(mutates, "plan.result_contract.mutates", tag)
    if err != null { return err }
    if mutates.length() != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[plan.result_contract.mutates] expected 9 entries")
    }
    err = CompilerProjectorSupportBox.require_text(mutates.get(0), "plan.result_contract.mutates[0]", "module.metadata.record_layout_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(1), "plan.result_contract.mutates[1]", "module.metadata.array_record_storage_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(2), "plan.result_contract.mutates[2]", "module.metadata.array_record_autouse_eligibility_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(3), "plan.result_contract.mutates[3]", "module.metadata.array_record_materialization_boundary_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(4), "plan.result_contract.mutates[4]", "module.metadata.array_record_packed_autouse_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(5), "plan.result_contract.mutates[5]", "module.metadata.source_packed_array_autouse_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(6), "plan.result_contract.mutates[6]", "module.metadata.source_packed_array_direct_read_consumption_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(7), "plan.result_contract.mutates[7]", "module.metadata.hako_alloc_aligned_small_packed_store_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(mutates.get(8), "plan.result_contract.mutates[8]", "module.metadata.hako_alloc_huge_page_packed_store_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(result_contract, "entrypoint"),
      "plan.result_contract.entrypoint",
      "semantic_refresh::refresh_module_record_and_packed_layout_plans",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(result_contract, "minimal_path_expected_result"),
      "plan.result_contract.minimal_path_expected_result",
      "NoErrorReturn",
      tag,
    )
    if err != null { return err }

    err = CompilerProjectorSupportBox.require_text(
      plan_box.shadow_json,
      "plan.shadow_json",
      CanonicalJsonWriterBox.canonicalize(plan_box.payload),
      tag,
    )
    if err != null { return err }

    local non_claims = BoxHelpers.map_get(plan_box.payload, "non_claims")
    err = CompilerProjectorSupportBox.require_map(non_claims, "plan.non_claims", tag)
    if err != null { return err }
    local keys = non_claims.keys()
    if keys == null {
      return CompilerProjectorSupportBox.fail(tag, "[plan.non_claims] missing keys")
    }
    local i = 0
    local n = keys.length()
    loop(i < n) {
      local key = "" + keys.get(i)
      if StringHelpers.to_i64(non_claims.get(key)) != 0 {
        return CompilerProjectorSupportBox.fail(tag, "[plan.non_claims] non-zero claim: " + key)
      }
      i = i + 1
    }

    return null
  }

  _validate_candidate(candidate_box, tag) {
    local err = CompilerProjectorSupportBox.require_map(candidate_box, "candidate", tag)
    if err != null {
      return err
    }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(candidate_box.payload, "kind"),
      "candidate.kind",
      "RecordPackedLayoutRefreshShadowCandidateV1",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(candidate_box.payload, "family_id"),
      "candidate.family_id",
      "hakorune_mir_builder::record_packed_layout_refresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(candidate_box.payload, "stage_id"),
      "candidate.stage_id",
      "record_packed_layout_refresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(candidate_box.payload, "source_authority"),
      "candidate.source_authority",
      "src/mir/builder/module_lifecycle.rs::MirBuilder::finalize_module",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(candidate_box.payload, "refresh_timing"),
      "candidate.refresh_timing",
      "AfterModuleMetadataPublicationBeforeTypedObjectRefresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(candidate_box.payload, "entrypoint"),
      "candidate.entrypoint",
      "semantic_refresh::refresh_module_record_and_packed_layout_plans",
      tag,
    )
    if err != null { return err }

    local publication_targets = BoxHelpers.map_get(candidate_box.payload, "publication_targets")
    err = CompilerProjectorSupportBox.require_array(publication_targets, "candidate.publication_targets", tag)
    if err != null { return err }
    if publication_targets.length() != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[candidate.publication_targets] expected 9 publication targets")
    }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(0), "candidate.publication_targets[0]", "module.metadata.record_layout_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(1), "candidate.publication_targets[1]", "module.metadata.array_record_storage_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(2), "candidate.publication_targets[2]", "module.metadata.array_record_autouse_eligibility_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(3), "candidate.publication_targets[3]", "module.metadata.array_record_materialization_boundary_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(4), "candidate.publication_targets[4]", "module.metadata.array_record_packed_autouse_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(5), "candidate.publication_targets[5]", "module.metadata.source_packed_array_autouse_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(6), "candidate.publication_targets[6]", "module.metadata.source_packed_array_direct_read_consumption_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(7), "candidate.publication_targets[7]", "module.metadata.hako_alloc_aligned_small_packed_store_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(publication_targets.get(8), "candidate.publication_targets[8]", "module.metadata.hako_alloc_huge_page_packed_store_pilot_plans", tag)
    if err != null { return err }

    local projected_fields = BoxHelpers.map_get(candidate_box.payload, "projected_fields")
    err = CompilerProjectorSupportBox.require_array(projected_fields, "candidate.projected_fields", tag)
    if err != null { return err }
    if projected_fields.length() != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[candidate.projected_fields] expected 9 fields")
    }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(0), "candidate.projected_fields[0]", "refresh_module_record_layout_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(1), "candidate.projected_fields[1]", "refresh_module_array_record_storage_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(2), "candidate.projected_fields[2]", "refresh_module_array_record_autouse_eligibility_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(3), "candidate.projected_fields[3]", "refresh_module_array_record_materialization_boundary_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(4), "candidate.projected_fields[4]", "refresh_module_array_record_packed_autouse_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(5), "candidate.projected_fields[5]", "refresh_module_source_packed_array_autouse_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(6), "candidate.projected_fields[6]", "refresh_module_source_packed_array_direct_read_consumption_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(7), "candidate.projected_fields[7]", "refresh_module_hako_alloc_aligned_small_packed_store_pilot_plans", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(projected_fields.get(8), "candidate.projected_fields[8]", "refresh_module_hako_alloc_huge_page_packed_store_pilot_plans", tag)
    if err != null { return err }

    if StringHelpers.to_i64(BoxHelpers.map_get(candidate_box.payload, "publication_target_count")) != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[candidate.publication_target_count] expected 9")
    }
    if StringHelpers.to_i64(BoxHelpers.map_get(candidate_box.payload, "projected_field_count")) != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[candidate.projected_field_count] expected 9")
    }
    if StringHelpers.to_i64(BoxHelpers.map_get(candidate_box.payload, "mutation_target_count")) != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[candidate.mutation_target_count] expected 9")
    }
    if StringHelpers.to_i64(BoxHelpers.map_get(candidate_box.payload, "step_count")) != 9 {
      return CompilerProjectorSupportBox.fail(tag, "[candidate.step_count] expected 9")
    }

    err = CompilerProjectorSupportBox.require_text(
      candidate_box.shadow_json,
      "candidate.shadow_json",
      CanonicalJsonWriterBox.canonicalize(candidate_box.payload),
      tag,
    )
    if err != null { return err }
    return null
  }

  _validate_parity_gate(parity_gate, tag) {
    local err = CompilerProjectorSupportBox.require_map(parity_gate, "parity_gate", tag)
    if err != null {
      return err
    }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(parity_gate.payload, "kind"),
      "parity_gate.kind",
      "RecordPackedLayoutRefreshParityGateV1",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(parity_gate.payload, "family_id"),
      "parity_gate.family_id",
      "hakorune_mir_builder::record_packed_layout_refresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(parity_gate.payload, "stage_id"),
      "parity_gate.stage_id",
      "record_packed_layout_refresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(parity_gate.payload, "comparison"),
      "parity_gate.comparison",
      "canonical_json",
      tag,
    )
    if err != null { return err }
    if StringHelpers.to_i64(BoxHelpers.map_get(parity_gate.payload, "expected_match")) != 1 {
      return CompilerProjectorSupportBox.fail(tag, "[parity_gate.expected_match] expected 1")
    }
    err = CompilerProjectorSupportBox.require_text(
      parity_gate.shadow_json,
      "parity_gate.shadow_json",
      CanonicalJsonWriterBox.canonicalize(parity_gate.payload),
      tag,
    )
    if err != null { return err }
    return null
  }

  _validate_token(token, label, expected_kind, expected_value, tag) {
    local err = CompilerProjectorSupportBox.require_map(token, label, tag)
    if err != null {
      return err
    }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(token.payload, "kind"),
      label + ".kind",
      expected_kind,
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(token.payload, "family_id"),
      label + ".family_id",
      "hakorune_mir_builder::record_packed_layout_refresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(token.payload, "stage_id"),
      label + ".stage_id",
      "record_packed_layout_refresh",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      BoxHelpers.map_get(token.payload, "value"),
      label + ".value",
      expected_value,
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      token.shadow_json,
      label + ".shadow_json",
      CanonicalJsonWriterBox.canonicalize(token.payload),
      tag,
    )
    if err != null { return err }
    return null
  }

  _project_shadow_output(hako_shadow_box) {
    return CompilerProjectorSupportBox.copy_any(hako_shadow_box.payload)
  }

  project_shadow_record(plan, python_oracle, hako_shadow, parity_gate, promotion_token, retirement_token) {
    local tag = CompilerProjectorSupportBox.tag(null)
    local err = me._validate_plan(plan, tag)
    if err != null {
      return err
    }
    err = CompilerProjectorSupportBox.require_present(python_oracle, "python_oracle", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_present(hako_shadow, "hako_shadow", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_present(parity_gate, "parity_gate", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_present(promotion_token, "promotion_token", tag)
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_present(retirement_token, "retirement_token", tag)
    if err != null { return err }

    err = me._validate_candidate(python_oracle, tag)
    if err != null { return err }
    err = me._validate_candidate(hako_shadow, tag)
    if err != null { return err }
    err = me._validate_parity_gate(parity_gate, tag)
    if err != null { return err }
    err = me._validate_token(
      promotion_token,
      "promotion_token",
      "RecordPackedLayoutRefreshPromotionTokenV1",
      "promotion",
      tag,
    )
    if err != null { return err }
    err = me._validate_token(
      retirement_token,
      "retirement_token",
      "RecordPackedLayoutRefreshRetirementTokenV1",
      "retirement",
      tag,
    )
    if err != null { return err }
    err = CompilerProjectorSupportBox.require_text(
      python_oracle.shadow_json,
      "python_oracle.shadow_json",
      hako_shadow.shadow_json,
      tag,
    )
    if err != null { return err }

    local shadow_record = CompilerProjectionValueBox.create_object()
    CompilerProjectionValueBox.object_set(shadow_record, "schema_version", CompilerProjectionValueBox.create_i64(0))
    CompilerProjectionValueBox.object_set(shadow_record, "kind", CompilerProjectionValueBox.create_string("RecordPackedLayoutRefreshShadowCandidateV1"))
    CompilerProjectionValueBox.object_set(shadow_record, "family_id", CompilerProjectionValueBox.create_string("hakorune_mir_builder::record_packed_layout_refresh"))
    CompilerProjectionValueBox.object_set(shadow_record, "stage_id", CompilerProjectionValueBox.create_string("record_packed_layout_refresh"))
    CompilerProjectionValueBox.object_set(shadow_record, "subject", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(plan.payload, "subject")))
    CompilerProjectionValueBox.object_set(shadow_record, "source_authority", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(plan.payload, "source_authority")))
    CompilerProjectionValueBox.object_set(shadow_record, "refresh_timing", CompilerProjectionValueBox.create_string("AfterModuleMetadataPublicationBeforeTypedObjectRefresh"))
    CompilerProjectionValueBox.object_set(shadow_record, "publication_target_count", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "publication_target_count")))
    CompilerProjectionValueBox.object_set(shadow_record, "projected_field_count", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "projected_field_count")))
    CompilerProjectionValueBox.object_set(shadow_record, "mutation_target_count", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "mutation_target_count")))
    CompilerProjectionValueBox.object_set(shadow_record, "step_count", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "step_count")))
    CompilerProjectionValueBox.object_set(shadow_record, "publication_targets", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "publication_targets")))
    CompilerProjectionValueBox.object_set(shadow_record, "projected_fields", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "projected_fields")))
    CompilerProjectionValueBox.object_set(shadow_record, "entrypoint", CompilerProjectorSupportBox.copy_any(BoxHelpers.map_get(hako_shadow.payload, "entrypoint")))
    CompilerProjectionValueBox.object_set(shadow_record, "input_json", CompilerProjectorSupportBox.copy_any(plan.payload))
    CompilerProjectionValueBox.object_set(shadow_record, "output_json", me._project_shadow_output(hako_shadow))
    CompilerProjectionValueBox.object_set(shadow_record, "python_oracle", CompilerProjectorSupportBox.copy_any(python_oracle.payload))
    CompilerProjectionValueBox.object_set(shadow_record, "hako_shadow", CompilerProjectorSupportBox.copy_any(hako_shadow.payload))
    CompilerProjectionValueBox.object_set(shadow_record, "parity_gate", CompilerProjectorSupportBox.copy_any(parity_gate.payload))
    CompilerProjectionValueBox.object_set(shadow_record, "promotion_token", CompilerProjectorSupportBox.copy_any(promotion_token.payload))
    CompilerProjectionValueBox.object_set(shadow_record, "retirement_token", CompilerProjectorSupportBox.copy_any(retirement_token.payload))
    return CompilerProjectorSupportBox.ok_with_json(shadow_record, hako_shadow.shadow_json)
  }

  project_shadow_json(plan, python_oracle, hako_shadow, parity_gate, promotion_token, retirement_token) {
    local result = me.project_shadow_record(
      plan,
      python_oracle,
      hako_shadow,
      parity_gate,
      promotion_token,
      retirement_token,
    )
    if result.err != 0 {
      return result.shadow_json
    }
    return result.shadow_json
  }
}

// write_delete_surface_policy_classifier.hako - Delete write-surface policy mirror
//
// Responsibility:
// - mirror the Rust oracle policy row for DeleteSurfacePolicy / MapDeleteAny
// - carry NonePublication and mutation as metadata
// - provide a narrow .hako implementation pilot before the parity gate
//
// Non-responsibility:
// - WriteScalarI64Routes direct closeout
// - ScalarKnownTransportAxis closeout
// - HakoAdopted promotion
// - publication execution, runtime mutation, route selection, or backend lowering
static box WriteDeleteSurfacePolicyClassifierBox {
  classify(route_kind) {
    if route_kind == "MapDeleteAny" {
      return "map_delete_any_delete_surface|DeleteSurfacePolicy|MapDeleteAny|MapDelete|ColdFallback|ScalarI64Result|ScalarI64|WriteAny|NonePublication|mutate|MutatesReceiverOrContainer|classifier_policy_mirror_only"
    }
    return "unsupported_write_delete_surface_policy"
  }
}

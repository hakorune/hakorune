// break_else_if_with_increment_classifier.hako - hand-authored generic-loop break-else-if-with-increment classifier
//
// Responsibility:
// - classify whether a generic-loop break-else-if-with-increment step is supported
// - stay pure: scalar AST expression text in, boolean text out
//
// Non-responsibility:
// - AST parsing
// - control-flow extraction
// - backend lowering
// - MIR mutation
static box BreakElseIfWithIncrementClassifierBox {
  is_break_else_if_with_increment(stmt) {
    if stmt == "ASTNode::If(break_else_if_with_increment)" {
      return "true"
    }
    if stmt == "ASTNode::If(no_else_branch)" {
      return "false"
    }
    if stmt == "ASTNode::If(else_not_break)" {
      return "false"
    }
    if stmt == "ASTNode::If(duplicate_increment)" {
      return "false"
    }
    return "false"
  }
}

// static_method_name_classifier.hako - hand-authored static-method-name classifier
//
// Responsibility:
// - classify whether a function name is a static box method name
// - stay pure: scalar function-name token in, boolean text out
//
// Non-responsibility:
// - MIR naming policy
// - backend lowering
// - MIR mutation
static box StaticMethodNameClassifierBox {
  is_static_method_name(func_name) {
    if func_name == "Main.main/0" { return "true" }
    if func_name == "Calculator.add/2" { return "true" }
    if func_name == "main._nop/0" { return "true" }
    if func_name == "Main.main" { return "false" }
    if func_name == "print" { return "false" }
    return "false"
  }
}

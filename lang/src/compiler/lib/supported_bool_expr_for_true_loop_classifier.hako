// supported_bool_expr_for_true_loop_classifier.hako - hand-authored true-loop supported bool expr classifier
//
// Responsibility:
// - classify whether a true-loop bool expression is supported
// - stay pure: scalar AST expression text in, boolean text out
//
// Non-responsibility:
// - AST parsing
// - control-flow extraction
// - backend lowering
// - MIR mutation
static box SupportedBoolExprForTrueLoopClassifierBox {
  is_supported_bool_expr_for_true_loop(ast) {
    if ast == "ASTNode::Variable(x)" {
      return "true"
    }
    if ast == "ASTNode::Literal(Bool(true))" {
      return "true"
    }
    if ast == "ASTNode::BinaryOp(And)" {
      return "true"
    }
    if ast == "ASTNode::BinaryOp(Equal)" {
      return "false"
    }
    return "false"
  }
}

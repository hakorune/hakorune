// supported_value_expr_for_true_loop_classifier.hako - hand-authored true-loop supported value expr classifier
//
// Responsibility:
// - classify whether a true-loop value expression is supported
// - stay pure: scalar AST expression text in, boolean text out
//
// Non-responsibility:
// - AST parsing
// - control-flow extraction
// - backend lowering
// - MIR mutation
static box SupportedValueExprForTrueLoopClassifierBox {
  is_supported_value_expr_for_true_loop(ast) {
    if ast == "ASTNode::Variable(x)" {
      return "true"
    }
    if ast == "ASTNode::Literal(Integer(7))" {
      return "true"
    }
    if ast == "ASTNode::BinaryOp(Add)" {
      return "true"
    }
    if ast == "ASTNode::BinaryOp(Equal)" {
      return "false"
    }
    return "false"
  }
}

// array_text_observer_arg_repr_kind_formatter.hako - hand-authored arg-repr kind formatter
//
// Responsibility:
// - format the narrow ArrayTextObserverArgRepr kind vocabulary
// - stay pure: scalar kind token in, scalar text out
//
// Non-responsibility:
// - array/text observer route matching
// - observer contract handling
// - backend lowering
// - MIR mutation
static box ArrayTextObserverArgReprKindFormatterBox {
  format_kind(kind) {
    if kind == "Value" { return "value" }
    if kind == "ConstUtf8" { return "const_utf8" }
    return "unsupported_array_text_observer_arg_repr_kind"
  }
}

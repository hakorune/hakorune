// loop_char_map_facts.hako
//
// Responsibility:
// - reduce a backend-safe loop-char-map token snapshot into fact text
// - mirror try_extract_loop_char_map_facts for the narrow facade contract
//
// Non-responsibility:
// - substring or result-update AST construction
// - CondProfile or ScanConditionObservation construction
// - loop increment extraction, recipe construction, lowering, mutation, or ID allocation
static box LoopCharMapFactsBox {
  build_summary(observation_token, body_token) {
    local obs_kind = me._obs_kind(observation_token)
    if obs_kind != "var_less_length" {
      return "accepted=0;reason=condition_not_var_less_length"
    }

    local loop_var = me._obs_loop_var(observation_token)
    local step_var = me._obs_step_var(observation_token)
    if loop_var != step_var {
      return "accepted=0;reason=step_var_mismatch"
    }

    local step = me._obs_step_lit(observation_token)
    if step != 1 {
      return "accepted=0;reason=step_not_one"
    }

    local body_kind = me._body_kind(body_token)
    if body_kind == "has_break" {
      return "accepted=0;reason=body_has_break"
    }
    if body_kind == "has_continue" {
      return "accepted=0;reason=body_has_continue"
    }
    if body_kind == "has_return" {
      return "accepted=0;reason=body_has_return"
    }
    if body_kind == "has_if_else" {
      return "accepted=0;reason=body_has_if_else"
    }
    if body_kind != "local_substring_result_update_step" {
      return "accepted=0;reason=body_shape_not_supported"
    }

    local haystack = me._obs_haystack(observation_token)
    if me._body_haystack(body_token) != haystack {
      return "accepted=0;reason=substring_haystack_mismatch"
    }
    if me._body_substring_index(body_token) != loop_var {
      return "accepted=0;reason=substring_index_mismatch"
    }

    local ch_var = me._body_ch_var(body_token)
    if me._body_result_arg(body_token) != ch_var {
      return "accepted=0;reason=result_update_arg_mismatch"
    }

    local increment_var = me._body_increment_var(body_token)
    if increment_var != loop_var {
      return "accepted=0;reason=increment_var_mismatch"
    }

    return "accepted=1;loop_var=" + loop_var
      + ";haystack=" + haystack
      + ";result=" + me._body_result_var(body_token)
      + ";receiver=" + me._body_receiver(body_token)
      + ";method=" + me._body_method(body_token)
  }

  _obs_kind(token) {
    if token == "ObsVarLessLengthStepAdd1IOverS" { return "var_less_length" }
    if token == "ObsVarLessLengthStepAdd2IOverS" { return "var_less_length" }
    if token == "ObsVarLessLengthStepAdd1JOverS" { return "var_less_length" }
    if token == "ObsVarLessLiteralStepAdd1ITo3" { return "var_less_literal" }
    return "unsupported"
  }

  _obs_loop_var(token) {
    return "i"
  }

  _obs_step_var(token) {
    if token == "ObsVarLessLengthStepAdd1JOverS" { return "j" }
    return "i"
  }

  _obs_haystack(token) {
    if token == "ObsVarLessLengthStepAdd1IOverS" { return "s" }
    if token == "ObsVarLessLengthStepAdd2IOverS" { return "s" }
    if token == "ObsVarLessLengthStepAdd1JOverS" { return "s" }
    return "-"
  }

  _obs_step_lit(token) {
    if token == "ObsVarLessLengthStepAdd2IOverS" { return 2 }
    return 1
  }

  _body_kind(token) {
    if token == "LocalChSubstringThenResultMeLowerThenIPlus1" { return "local_substring_result_update_step" }
    if token == "LocalChSubstringThenResultMapperLowerThenIPlus1" { return "local_substring_result_update_step" }
    if token == "LocalChOtherSubstringThenResultMeLowerThenIPlus1" { return "local_substring_result_update_step" }
    if token == "LocalChSubstringJThenResultMeLowerThenIPlus1" { return "local_substring_result_update_step" }
    if token == "LocalChSubstringThenResultMeLowerArgOtherThenIPlus1" { return "local_substring_result_update_step" }
    if token == "LocalChSubstringThenResultMeLowerThenJPlus1" { return "local_substring_result_update_step" }
    if token == "OnlyIncrement" { return "unsupported" }
    if token == "BreakThenShape" { return "has_break" }
    if token == "ContinueThenShape" { return "has_continue" }
    if token == "ReturnThenShape" { return "has_return" }
    if token == "IfElseThenShape" { return "has_if_else" }
    return "unsupported"
  }

  _body_haystack(token) {
    if token == "LocalChOtherSubstringThenResultMeLowerThenIPlus1" { return "other" }
    return "s"
  }

  _body_substring_index(token) {
    if token == "LocalChSubstringJThenResultMeLowerThenIPlus1" { return "j" }
    return "i"
  }

  _body_ch_var(token) {
    return "ch"
  }

  _body_result_arg(token) {
    if token == "LocalChSubstringThenResultMeLowerArgOtherThenIPlus1" { return "other" }
    return "ch"
  }

  _body_result_var(token) {
    return "result"
  }

  _body_receiver(token) {
    if token == "LocalChSubstringThenResultMapperLowerThenIPlus1" { return "mapper" }
    return "me"
  }

  _body_method(token) {
    return "char_to_lower"
  }

  _body_increment_var(token) {
    if token == "LocalChSubstringThenResultMeLowerThenJPlus1" { return "j" }
    return "i"
  }
}

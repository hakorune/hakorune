// loop_condition_shape.hako
//
// Responsibility:
// - reduce a backend-safe loop condition token snapshot into a ConditionShape summary
// - mirror try_extract_condition_shape for the narrow condition-root vocabulary
//
// Non-responsibility:
// - full AST traversal, CondProfile migration, scan matching, or observation unification
// - loop builder composition, backend lowering, MIR mutation, route selection, or ID allocation
static box LoopConditionShapeBox {
  build_summary(token) {
    if token == "ILessHayLength" {
      return "accepted=1;shape=VarLessLength;idx_var=i;haystack_var=hay;method=Length"
    }
    if token == "ILessHaySize" {
      return "accepted=1;shape=VarLessLength;idx_var=i;haystack_var=hay;method=Size"
    }
    if token == "ILessLiteral3" {
      return "accepted=1;shape=VarLessLiteral;idx_var=i;bound=3"
    }
    if token == "ILessEqualHayLengthMinusNeedleLength" {
      return "accepted=1;shape=VarLessEqualLengthMinusNeedle;idx_var=i;haystack_var=hay;needle_var=needle;haystack_method=Length;needle_method=Length"
    }
    if token == "IGreaterEqualZero" {
      return "accepted=1;shape=VarGreaterEqualZero;idx_var=i"
    }
    return "accepted=0;reason=" + me._reject_reason(token)
  }

  _reject_reason(token) {
    if token == "VariableOnly" { return "not_binary_op" }
    if token == "LiteralLessLength" { return "left_not_variable" }
    if token == "ILessVariable" { return "right_not_length_or_literal" }
    if token == "ILessEqualHayLength" { return "right_not_subtract" }
    if token == "ILessEqualVarMinusNeedleLength" { return "minus_left_not_length" }
    if token == "ILessEqualHayLengthMinusVar" { return "minus_right_not_length" }
    if token == "IGreaterEqualOne" { return "right_not_zero" }
    if token == "IEqualZero" { return "unsupported_operator" }
    if token == "ILessHayLengthWithArg" { return "length_call_has_args" }
    if token == "ILessHayCapacity" { return "unknown_length_method" }
    return "unsupported_token"
  }
}

// agg_local_scalarization_inline_scalar_user_box_local_body_classifier.hako - hand-authored agg-local user-box-local-body classifier
//
// Responsibility:
// - classify inline scalar user-box local-body eligibility
// - stay pure: selection tokens in, boolean text out
//
// Non-responsibility:
// - aggregate-local route collection
// - thin-entry selection binding
// - backend lowering
// - MIR mutation
static box AggLocalScalarizationInlineScalarUserBoxLocalBodyClassifierBox {
  is_inline_scalar_user_box_local_body(surface, selected_entry, value_class) {
    if surface != "user_box_field_get" && surface != "user_box_field_set" {
      return "false"
    }
    if selected_entry != "thin_internal_entry" {
      return "false"
    }
    if value_class != "inline_i64" && value_class != "inline_bool" && value_class != "inline_f64" {
      return "false"
    }
    return "true"
  }
}

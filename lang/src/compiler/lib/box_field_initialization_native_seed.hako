// box_field_initialization_native_seed.hako - native source seed for the
// StatementValueConstruction box field initialization MirBuilder leaf family.
//
// Responsibility:
// - provide a native Hako source seed for the box field initialization
//   mutation-frame contract
// - preserve the contracted validation / delegation order in editable source
//   form
// - stay outside the generated artifact output tree
//
// Non-responsibility:
// - full object allocation semantics
// - full field assignment semantics
// - full user-defined box metadata semantics
// - HakoAdopted decision
// - Source Selfhost claim
// - TypeBox ABI
// - host ABI
// - runtime fallback
//
// native-source-seed:
//   MIRBUILDER-STATEMENT-VALUE-CONSTRUCTION-BOX-FIELD-INITIALIZATION-HAKO-NATIVE-SOURCE-SEED-001
// source-family: hakorune_mir_builder::statement_value_construction_box_field_initialization
// mutation-frame-contract:
//   MIRBUILDER-STATEMENT-VALUE-CONSTRUCTION-BOX-FIELD-INITIALIZATION-MUTATION-FRAME-CONTRACT-001
// hako-adopted: 0
// source-selfhost-claim: 0

box BoxFieldInitializationStateShellBox {
    record_constructor_field_initializer: i64
    duplicate_initializer_field: i64
    user_defined_box: i64
    declared_field: i64
    destination_box_created: i64
    seen_field_set_initialized: i64
    duplicate_field_rejected: i64
    field_membership_validated: i64
    delegated_field_assignment_written: i64
    destination_value_returned: i64

    birth() {
        me.record_constructor_field_initializer = 0
        me.duplicate_initializer_field = 0
        me.user_defined_box = 0
        me.declared_field = 0
        me.destination_box_created = 0
        me.seen_field_set_initialized = 0
        me.duplicate_field_rejected = 0
        me.field_membership_validated = 0
        me.delegated_field_assignment_written = 0
        me.destination_value_returned = 0
    }
}

static box BoxFieldInitializationNativeSeedApi {
    apply(state): i64 {
        if state.record_constructor_field_initializer != 0 {
            return 1
        }

        state.destination_box_created = 1
        state.seen_field_set_initialized = 1

        if state.duplicate_initializer_field != 0 {
            state.duplicate_field_rejected = 1
            return 1
        }

        if state.user_defined_box != 0 {
            if state.declared_field == 0 {
                return 1
            }
            state.field_membership_validated = 1
        }

        state.delegated_field_assignment_written = 1
        state.destination_value_returned = 1
        return 0
    }
}

static box BoxFieldInitializationApi {
    apply(state): i64 {
        return BoxFieldInitializationNativeSeedApi.apply(state)
    }
}

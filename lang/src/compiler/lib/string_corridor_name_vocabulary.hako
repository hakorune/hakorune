// string_corridor_name_vocabulary.hako - hand-authored string corridor name vocabulary
//
// Responsibility:
// - classify fixture-backed helper/runtime names into Rust oracle booleans
// - stay pure: scalar string input -> boolean category
//
// Non-responsibility:
// - string corridor fact inference
// - MIR instruction traversal
// - recognizer shape matching
// - open-ended suffix matching beyond fixture aliases
// - Source Selfhost or HakoAdopted promotion
static box StringCorridorNameVocabularyBox {
  is_stringish_box_name(name) {
    local text = "" + name
    if text == "StringBox" { return true }
    if text == "String" { return true }
    if text == "__str" { return true }
    if text == "MyStringBox" { return true }
    return false
  }

  is_len_method_name(name) {
    local text = "" + name
    if text == "length" { return true }
    if text == "len" { return true }
    return false
  }

  is_slice_method_name(name) {
    local text = "" + name
    if text == "substring" { return true }
    if text == "slice" { return true }
    return false
  }

  is_lowered_len_global(name) {
    local text = "" + name
    if text == "str.len" { return true }
    if text == "__str.len" { return true }
    return false
  }

  is_runtime_len_export(name) {
    local text = "" + name
    if text == "nyash.string.len_h" { return true }
    if text == "nyash.string.len_fast_h" { return true }
    if text == "nyash.string.substring_len_hii" { return true }
    if text == "nyash.string.length_si" { return true }
    if text == "nyrt_string_length" { return true }
    if text == "nyrt.string.length" { return true }
    return false
  }

  is_runtime_len_handle_export(name) {
    local text = "" + name
    if text == "nyash.string.len_h" { return true }
    if text == "nyash.string.len_fast_h" { return true }
    return false
  }

  is_runtime_slice_export(name) {
    local text = "" + name
    if text == "nyash.string.substring_hii" { return true }
    if text == "nyash.string.substring_concat_hhii" { return true }
    if text == "nyash.string.substring_concat3_hhhii" { return true }
    return false
  }

  is_runtime_substring_export(name) {
    return ("" + name) == "nyash.string.substring_hii"
  }

  is_runtime_substring_len_export(name) {
    return ("" + name) == "nyash.string.substring_len_hii"
  }

  is_runtime_substring_concat3_export(name) {
    return ("" + name) == "nyash.string.substring_concat3_hhhii"
  }

  is_runtime_concat3_export(name) {
    return ("" + name) == "nyash.string.concat3_hhh"
  }

  is_stringish_box_name_flag(name) {
    if me.is_stringish_box_name(name) { return 1 }
    return 0
  }

  is_len_method_name_flag(name) {
    if me.is_len_method_name(name) { return 1 }
    return 0
  }

  is_slice_method_name_flag(name) {
    if me.is_slice_method_name(name) { return 1 }
    return 0
  }

  is_lowered_len_global_flag(name) {
    if me.is_lowered_len_global(name) { return 1 }
    return 0
  }

  is_runtime_len_export_flag(name) {
    if me.is_runtime_len_export(name) { return 1 }
    return 0
  }

  is_runtime_len_handle_export_flag(name) {
    if me.is_runtime_len_handle_export(name) { return 1 }
    return 0
  }

  is_runtime_slice_export_flag(name) {
    if me.is_runtime_slice_export(name) { return 1 }
    return 0
  }

  is_runtime_substring_export_flag(name) {
    if me.is_runtime_substring_export(name) { return 1 }
    return 0
  }

  is_runtime_substring_len_export_flag(name) {
    if me.is_runtime_substring_len_export(name) { return 1 }
    return 0
  }

  is_runtime_substring_concat3_export_flag(name) {
    if me.is_runtime_substring_concat3_export(name) { return 1 }
    return 0
  }

  is_runtime_concat3_export_flag(name) {
    if me.is_runtime_concat3_export(name) { return 1 }
    return 0
  }
}

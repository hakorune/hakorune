// match_return_facts.hako
//
// Responsibility:
// - reduce a backend-safe match-return token snapshot into a fact summary
// - keep the Rust oracle contract for accepted facts and reject reason tokens
//
// Non-responsibility:
// - full AST traversal
// - BranchN composition or return lowering
// - backend lowering, MIR mutation, route selection, or ID allocation
static box MatchReturnFactsBox {
  extract_summary(expr_kind, scrutinee_kind, arm_count, label0_kind, return0_kind, label1_kind, return1_kind, else_kind) {
    if expr_kind != "MatchExpr" {
      return "accepted=0;reason=not_match_expr"
    }
    if me._scrutinee_supported(scrutinee_kind) != 1 {
      return "accepted=0;reason=scrutinee_not_supported"
    }
    if arm_count < 2 {
      return "accepted=0;reason=too_few_arms"
    }
    if else_kind == "Var" {
      return "accepted=0;reason=else_not_literal"
    }
    if me._else_literal_supported(else_kind) != 1 {
      return "accepted=0;reason=else_literal_type_unsupported"
    }
    if me._label_literal_supported(label0_kind) != 1 {
      return "accepted=0;reason=arm_label_not_supported"
    }
    if me._label_literal_supported(label1_kind) != 1 {
      return "accepted=0;reason=arm_label_not_supported"
    }
    if return0_kind == "Var" {
      return "accepted=0;reason=arm_not_literal"
    }
    if return1_kind == "Var" {
      return "accepted=0;reason=arm_not_literal"
    }
    if me._arm_literal_supported(return0_kind) != 1 {
      return "accepted=0;reason=arm_literal_type_unsupported"
    }
    if me._arm_literal_supported(return1_kind) != 1 {
      return "accepted=0;reason=arm_literal_type_unsupported"
    }
    local profile = me._select_profile(
      scrutinee_kind,
      label0_kind,
      return0_kind,
      label1_kind,
      return1_kind,
      else_kind
    )
    if profile == null {
      return "accepted=0;reason=literal_profile_mismatch"
    }
    return "accepted=1;profile=" + profile
      + ";scrutinee=" + scrutinee_kind
      + ";arms=" + arm_count
      + ";labels=" + label0_kind + "," + label1_kind
      + ";returns=" + return0_kind + "," + return1_kind
      + ";else=" + else_kind
  }

  _scrutinee_supported(kind) {
    if kind == "Var" { return 1 }
    if kind == "Int" { return 1 }
    return 0
  }

  _label_literal_supported(kind) {
    if kind == "Int" { return 1 }
    if kind == "Bool" { return 1 }
    if kind == "String" { return 1 }
    return 0
  }

  _arm_literal_supported(kind) {
    if kind == "Int" { return 1 }
    if kind == "Bool" { return 1 }
    if kind == "String" { return 1 }
    return 0
  }

  _else_literal_supported(kind) {
    if kind == "Int" { return 1 }
    if kind == "Bool" { return 1 }
    if kind == "String" { return 1 }
    if kind == "Null" { return 1 }
    return 0
  }

  _select_profile(scrutinee_kind, label0_kind, return0_kind, label1_kind, return1_kind, else_kind) {
    local legacy_labels = me._legacy_label(label0_kind) and me._legacy_label(label1_kind)
    local legacy_returns = me._legacy_return(return0_kind)
      and me._legacy_return(return1_kind)
      and me._legacy_return(else_kind)
    if legacy_labels and legacy_returns {
      return "legacy_integer_bool"
    }

    if scrutinee_kind == "Var"
      and label0_kind == "String"
      and label1_kind == "String"
      and return0_kind == "String"
      and return1_kind == "String"
      and else_kind == "Null" {
      return "string_dispatch"
    }
    return null
  }

  _legacy_label(kind) {
    return kind == "Int" or kind == "Bool"
  }

  _legacy_return(kind) {
    return kind == "Int" or kind == "Bool"
  }
}

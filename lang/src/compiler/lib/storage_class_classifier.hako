// storage_class_classifier.hako - hand-authored storage-class classifier
//
// Responsibility:
// - classify MIR type-shaped values into the Rust oracle StorageClass strings
// - stay pure: input value -> storage class text
//
// Non-responsibility:
// - metadata.value_storage_classes mutation
// - function/module traversal
// - Source Selfhost or HakoAdopted promotion
static box StorageClassClassifierBox {
  // String-shaped MIR type entrypoint.
  classify_mir_type(mir_type) {
    if mir_type == null {
      return "opaque"
    }
    return me.classify_mir_type_name("" + mir_type)
  }

  classify_mir_type_name(name) {
    if name == "Integer" {
      return "inline_i64"
    }
    if name == "Bool" {
      return "inline_bool"
    }
    if name == "Float" {
      return "inline_f64"
    }
    if name == "String" {
      return "borrowed_text"
    }
    return "opaque"
  }

  // MapBox-shaped MIR type entrypoint for oracle fixture object variants.
  classify_mir_type_map(mir_type) {
    if mir_type == null {
      return "opaque"
    }

    local box_name = mir_type.get("Box")
    if box_name != null {
      return me.classify_box_name("" + box_name)
    }

    if mir_type.get("Array") != null {
      return "opaque"
    }
    if mir_type.get("Future") != null {
      return "opaque"
    }
    return "opaque"
  }

  classify_compound_type_kind(kind) {
    if kind == "Array" {
      return "opaque"
    }
    if kind == "Future" {
      return "opaque"
    }
    return "opaque"
  }

  classify_box_name(name) {
    if name == "IntegerBox" {
      return "inline_i64"
    }
    if name == "BoolBox" {
      return "inline_bool"
    }
    if name == "FloatBox" {
      return "inline_f64"
    }
    if name == "StringBox" {
      return "borrowed_text"
    }
    return "box_ref"
  }
}

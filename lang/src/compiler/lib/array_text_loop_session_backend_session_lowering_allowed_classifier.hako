static box ArrayTextLoopSessionBackendSessionLoweringAllowedClassifierBox {
  is_backend_session_lowering_allowed(len_call_count, same_array_handle, read_only_region, no_mutation_region, no_drop_or_publication_boundary, index_domain_guarded) {
    if len_call_count == "0" { return "false" }

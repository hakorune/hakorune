// Declarative schema for the lossy ProgramV0 wire observation quotient.
// No parsing, traversal, source-kind recovery, MIR, plan, route, or runtime.

static box BoundedBodySnapshotSchemaV0Box {
  schema_version() { return 0 }
  max_depth() { return 64 }
  max_node_count() { return 32768 }
  max_children_per_body() { return 2048 }
  max_arguments() { return 128 }
  max_literal_bytes() { return 65536 }
  max_atom_bytes() { return 1024 }
  max_total_text_bytes() { return 4194304 }

  classify_stmt(kind) {
    if kind == "Local" { return "Accepted" }
    if kind == "Expr" { return "Accepted" }
    if kind == "If" { return "Accepted" }
    if kind == "Loop" { return "Accepted" }
    if kind == "LoopRange" { return "Accepted" }
    if kind == "Return" { return "Accepted" }
    if kind == "Break" { return "Accepted" }
    if kind == "Continue" { return "Accepted" }
    if kind == "Extern" { return "KnownUnsupported" }
    if kind == "TaskScope" { return "KnownUnsupported" }
    if kind == "Throw" { return "KnownUnsupported" }
    if kind == "Try" { return "KnownUnsupported" }
    if kind == "FiniReg" { return "KnownUnsupported" }
    if kind == "FastMemRegion" { return "SchemaMismatchStop" }
    return "InvalidInput"
  }

  classify_expr(kind) {
    if kind == "Int" { return "Accepted" }
    if kind == "Str" { return "Accepted" }
    if kind == "Bool" { return "Accepted" }
    if kind == "Null" { return "Accepted" }
    if kind == "Var" { return "Accepted" }
    if kind == "Binary" { return "Accepted" }
    if kind == "Compare" { return "Accepted" }
    if kind == "Logical" { return "Accepted" }
    if kind == "Call" { return "Accepted" }
    if kind == "Method" { return "Accepted" }
    if kind == "Field" { return "Accepted" }
    if kind == "Extern" { return "KnownUnsupported" }
    if kind == "ArrayLiteral" { return "KnownUnsupported" }
    if kind == "New" { return "KnownUnsupported" }
    if kind == "Throw" { return "KnownUnsupported" }
    if kind == "BlockExpr" { return "KnownUnsupported" }
    if kind == "Ternary" { return "KnownUnsupported" }
    if kind == "Match" { return "KnownUnsupported" }
    if kind == "EnumCtor" { return "KnownUnsupported" }
    if kind == "EnumMatch" { return "KnownUnsupported" }
    if kind == "Float" { return "SchemaMismatchStop" }
    if kind == "BrandConstruct" { return "SchemaMismatchStop" }
    if kind == "BrandUnwrap" { return "SchemaMismatchStop" }
    if kind == "RecordField" { return "SchemaMismatchStop" }
    if kind == "RecordLiteral" { return "SchemaMismatchStop" }
    if kind == "RecordUpdate" { return "SchemaMismatchStop" }
    return "InvalidInput"
  }

  binary_operator_allowed(op) {
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" { return 1 }
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" { return 1 }
    return 0
  }

  compare_operator_allowed(op) {
    if op == "==" || op == "!=" || op == "<" || op == ">" { return 1 }
    if op == "<=" || op == ">=" { return 1 }
    return 0
  }

  logical_operator_allowed(op) {
    if op == "&&" || op == "||" { return 1 }
    return 0
  }
}

static box Main { main() { return 0 } }

// Immutable published snapshot records. No mutation API is exposed.
box BoundedBodySnapshotNodeV0 {
  _path: String
  _domain: String
  _kind: String
  _atoms: MapBox
  _children: ArrayBox
  birth(path, domain, kind, atoms, children) {
    me._path = path me._domain = domain me._kind = kind
    me._atoms = atoms me._children = children
  }
  path() { return me._path }
  domain() { return me._domain }
  kind() { return me._kind }
  atom(name) { return me._atoms.get(name) }
  child_count() { return me._children.size() }
  child(index) { return me._children.get(index) }
}
box BoundedBodyAnalysisSnapshotV0 {
  _schema_version: Integer
  _source_program_version: Integer
  _roots: ArrayBox
  _node_count: Integer
  _max_depth_observed: Integer
  birth(source_version, roots, node_count, max_depth_observed) {
    me._schema_version = 0 me._source_program_version = source_version
    me._roots = roots me._node_count = node_count
    me._max_depth_observed = max_depth_observed
  }
  schema_version() { return me._schema_version }
  source_program_version() { return me._source_program_version }
  root_count() { return me._roots.size() }
  root(index) { return me._roots.get(index) }
  node_count() { return me._node_count }
  max_depth_observed() { return me._max_depth_observed }
}

// ProgramV0 root-envelope validation over the generic strict-JSON facade.
// Statement interpretation is deliberately outside this file.
using lang.compiler.analysis.bounded_body_snapshot.strict_json_tree_v0 as StrictJsonTreeV0Box
using lang.compiler.analysis.bounded_body_snapshot.outcome_v0 as BoundedBodySnapshotOutcomeV0Box
using lang.compiler.analysis.bounded_body_snapshot.snapshot_model_v0 as BoundedBodySnapshotModelV0Box

box ProgramV0RootEnvelopeV0 {
  _status: String
  _body_node: Integer
  _body_len: Integer
  _path: String
  _reason: String
  birth(status, body_node, body_len, path, reason) {
    me._status = status me._body_node = body_node me._body_len = body_len
    me._path = path me._reason = reason
  }
  status() { return me._status }
  body_node() { return me._body_node }
  body_len() { return me._body_len }
  path() { return me._path }
  reason() { return me._reason }
}

static box ProgramV0RootEnvelopeV0Box {
  ready(body_node, body_len) { return new ProgramV0RootEnvelopeV0("Ready", body_node, body_len, "", "") }
  invalid(path, reason) { return new ProgramV0RootEnvelopeV0("InvalidInput", -1, 0, path, reason) }
}

box ProgramV0RootFieldsV0 {
  _status: String
  _version_node: Integer
  _kind_node: Integer
  _body_node: Integer
  _attrs_node: Integer
  _imports_node: Integer
  _defs_node: Integer
  _user_box_decls_node: Integer
  _record_decls_node: Integer
  _enum_decls_node: Integer
  _static_data_plans_node: Integer
  _static_table_specs_node: Integer
  _brand_decls_node: Integer
  _type_alias_decls_node: Integer
  _path: String
  _reason: String
  birth() {
    me._status = "Ready" me._version_node = -1 me._kind_node = -1 me._body_node = -1
    me._attrs_node = -1 me._imports_node = -1 me._defs_node = -1
    me._user_box_decls_node = -1 me._record_decls_node = -1 me._enum_decls_node = -1
    me._static_data_plans_node = -1 me._static_table_specs_node = -1
    me._brand_decls_node = -1 me._type_alias_decls_node = -1
    me._path = "" me._reason = ""
  }
  status() { return me._status }
  version_node() { return me._version_node }
  kind_node() { return me._kind_node }
  body_node() { return me._body_node }
  path() { return me._path }
  reason() { return me._reason }
  reject(path, reason) { me._status = "InvalidInput" me._path = path me._reason = reason }
  observe(key, node) {
    if key == "version" { me._version_node = node return 1 }
    if key == "kind" { me._kind_node = node return 1 }
    if key == "body" { me._body_node = node return 1 }
    if key == "attrs" { me._attrs_node = node return 1 }
    if key == "imports" { me._imports_node = node return 1 }
    if key == "defs" { me._defs_node = node return 1 }
    if key == "user_box_decls" { me._user_box_decls_node = node return 1 }
    if key == "record_decls" { me._record_decls_node = node return 1 }
    if key == "enum_decls" { me._enum_decls_node = node return 1 }
    if key == "static_data_plans" { me._static_data_plans_node = node return 1 }
    if key == "static_table_contract_specs" { me._static_table_specs_node = node return 1 }
    if key == "brand_decls" { me._brand_decls_node = node return 1 }
    if key == "type_alias_decls" { me._type_alias_decls_node = node return 1 }
    return 0
  }
  optional_node(index) {
    if index == 0 { return me._attrs_node }
    if index == 1 { return me._imports_node }
    if index == 2 { return me._defs_node }
    if index == 3 { return me._user_box_decls_node }
    if index == 4 { return me._record_decls_node }
    if index == 5 { return me._enum_decls_node }
    if index == 6 { return me._static_data_plans_node }
    if index == 7 { return me._static_table_specs_node }
    if index == 8 { return me._brand_decls_node }
    return me._type_alias_decls_node
  }
}

static box HakoProgramV0RootReaderV0Box {
  read_empty_program(session, root) {
    local envelope = me.scan(session, root)
    if envelope.status() != "Ready" {
      return BoundedBodySnapshotOutcomeV0Box.invalid(envelope.path(), envelope.reason())
    }
    if envelope.body_len() != 0 {
      return BoundedBodySnapshotOutcomeV0Box.unsupported("$.body[0]", "Statement", "reader.statement_family_pending")
    }
    return BoundedBodySnapshotOutcomeV0Box.ready(new BoundedBodyAnalysisSnapshotV0(0, new ArrayBox(), 0))
  }

  scan(session, root) {
    local root_kind = StrictJsonTreeV0Box.kind(session, root)
    if root_kind != "Object" {
      return ProgramV0RootEnvelopeV0Box.invalid("$", me._wrong_type("object", root_kind))
    }
    local fields = me._collect_fields(session, root)
    if fields.status() != "Ready" {
      return ProgramV0RootEnvelopeV0Box.invalid(fields.path(), fields.reason())
    }
    return me._validate_fields(session, fields)
  }

  _collect_fields(session, root) {
    local fields = new ProgramV0RootFieldsV0()
    local i = 0 local count = StrictJsonTreeV0Box.object_len(session, root)
    loop(i < count) {
      local key = StrictJsonTreeV0Box.object_key_at(session, root, i)
      local value_node = StrictJsonTreeV0Box.object_value_at(session, root, i)
      if fields.observe(key, value_node) == 0 {
        fields.reject("$." + key, "object.forbidden_unknown_field")
        return fields
      }
      i = i + 1
    }
    return fields
  }

  _validate_fields(session, fields) {
    local version_node = fields.version_node()
    local kind_node = fields.kind_node()
    local body_node = fields.body_node()
    if version_node < 0 { return ProgramV0RootEnvelopeV0Box.invalid("$.version", "object.required_field_missing") }
    if kind_node < 0 { return ProgramV0RootEnvelopeV0Box.invalid("$.kind", "object.required_field_missing") }
    if body_node < 0 { return ProgramV0RootEnvelopeV0Box.invalid("$.body", "object.required_field_missing") }
    if me._version_is_zero(session, version_node) == 0 {
      return ProgramV0RootEnvelopeV0Box.invalid("$.version", "program.version_must_be_zero")
    }
    if StrictJsonTreeV0Box.kind(session, kind_node) != "String" {
      return ProgramV0RootEnvelopeV0Box.invalid("$.kind", "program.kind_must_be_program")
    }
    if StrictJsonTreeV0Box.string_value(session, kind_node) != "Program" {
      return ProgramV0RootEnvelopeV0Box.invalid("$.kind", "program.kind_must_be_program")
    }
    local body_kind = StrictJsonTreeV0Box.kind(session, body_node)
    if body_kind != "Array" {
      return ProgramV0RootEnvelopeV0Box.invalid("$.body", me._wrong_type("array", body_kind))
    }
    local optional_error = me._validate_optionals(session, fields)
    if optional_error != null { return optional_error }
    return ProgramV0RootEnvelopeV0Box.ready(body_node, StrictJsonTreeV0Box.array_len(session, body_node))
  }

  _validate_optionals(session, fields) {
    local paths = new ArrayBox()
    paths.push("$.attrs") paths.push("$.imports") paths.push("$.defs")
    paths.push("$.user_box_decls") paths.push("$.record_decls") paths.push("$.enum_decls")
    paths.push("$.static_data_plans") paths.push("$.static_table_contract_specs")
    paths.push("$.brand_decls") paths.push("$.type_alias_decls")
    local i = 0
    loop(i < paths.size()) {
      local expected = "Array"
      if i < 2 { expected = "Object" }
      local issue = me._optional_issue(session, fields.optional_node(i), expected)
      if issue != "ok" { return ProgramV0RootEnvelopeV0Box.invalid(paths.get(i), issue) }
      i = i + 1
    }
    return null
  }

  _version_is_zero(session, node) {
    local kind = StrictJsonTreeV0Box.kind(session, node)
    if kind == "I64" { if StrictJsonTreeV0Box.i64_value(session, node) == 0 { return 1 } return 0 }
    if kind == "U64" {
      if StrictJsonTreeV0Box.u64_fits_i64(session, node) == false { return 0 }
      if StrictJsonTreeV0Box.u64_as_i64(session, node) == 0 { return 1 }
    }
    return 0
  }

  _optional_issue(session, node, expected) {
    if node < 0 { return "ok" }
    local actual = StrictJsonTreeV0Box.kind(session, node)
    if actual == expected { return "ok" }
    if expected == "Object" { return me._wrong_type("object", actual) }
    return me._wrong_type("array", actual)
  }

  _wrong_type(expected, actual) { return "type.expected_" + expected + ".got_" + me._kind_label(actual) }
  _kind_label(kind) {
    if kind == "Null" { return "null" }
    if kind == "Bool" { return "bool" }
    if kind == "I64" || kind == "U64" || kind == "F64" { return "number" }
    if kind == "String" { return "string" }
    if kind == "Array" { return "array" }
    if kind == "Object" { return "object" }
    return "unknown"
  }

}

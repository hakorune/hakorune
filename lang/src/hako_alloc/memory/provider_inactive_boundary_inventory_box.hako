// provider_inactive_boundary_inventory_box.hako -- MIMAP-352A
// Responsibility:
// - record that provider/host integration remains inactive after worker/TLS
// - consume a bounded HakoAllocWorkerTlsPilotReport as the previous seam
// Non-responsibility:
// - provider selection, provider activation, host allocator replacement, hooks,
//   global allocator install, or backend matchers

using selfhost.hako_alloc.memory.worker_tls_pilot_box as HakoAllocWorkerTlsPilotBox

record HakoAllocProviderInactiveBoundaryInventoryReportFields {
    accepted: i64
    reason: i64
    provider_boundary_present: i64
    worker_tls_present: i64
    worker_tls_accepted: i64
    worker_tls_reason: i64
    provider_boundary_token: i64
    provider_boundary_token_valid: i64
    worker_id: i64
    tls_slot: i64
    page_source_token: i64
    bitmap_token: i64
    mutation_token: i64
    lookup_result_token: i64
    arena_handle_token: i64
    private_pointer_token: i64
    provider_activation_required: i64
    provider_activation_supported: i64
    provider_activation_inactive: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_required: i64
    backend_matcher_inactive: i64
    inventory_count: i64
    accepted_count: i64
    reject_count: i64
    missing_worker_tls_reject_count: i64
    rejected_worker_tls_reject_count: i64
    provider_request_reject_count: i64
    backend_matcher_reject_count: i64
    worker_thread_reject_count: i64
    invalid_boundary_token_reject_count: i64
    last_reason: i64
    would_dereference: i64
    would_release_arena_backing: i64
    would_recycle_arena_backing: i64
    would_mutate_segment_map: i64
    would_execute_atomic_bitmap: i64
    would_call_osvm: i64
    would_use_worker_tls: i64
    would_run_thread: i64
    would_activate_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
}

box HakoAllocProviderInactiveBoundaryInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    provider_boundary_present: i64 = 0
    worker_tls_present: i64 = 0
    worker_tls_accepted: i64 = 0
    worker_tls_reason: i64 = 0
    provider_boundary_token: i64 = 0
    provider_boundary_token_valid: i64 = 0
    worker_id: i64 = -1
    tls_slot: i64 = -1
    page_source_token: i64 = 0
    bitmap_token: i64 = 0
    mutation_token: i64 = 0
    lookup_result_token: i64 = 0
    arena_handle_token: i64 = 0
    private_pointer_token: i64 = 0
    provider_activation_required: i64 = 0
    provider_activation_supported: i64 = 0
    provider_activation_inactive: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_required: i64 = 0
    backend_matcher_inactive: i64 = 1
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_worker_tls_reject_count: i64 = 0
    rejected_worker_tls_reject_count: i64 = 0
    provider_request_reject_count: i64 = 0
    backend_matcher_reject_count: i64 = 0
    worker_thread_reject_count: i64 = 0
    invalid_boundary_token_reject_count: i64 = 0
    last_reason: i64 = 0
    would_dereference: i64 = 0
    would_release_arena_backing: i64 = 0
    would_recycle_arena_backing: i64 = 0
    would_mutate_segment_map: i64 = 0
    would_execute_atomic_bitmap: i64 = 0
    would_call_osvm: i64 = 0
    would_use_worker_tls: i64 = 0
    would_run_thread: i64 = 0
    would_activate_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
}

box HakoAllocProviderInactiveBoundaryInventory {
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_worker_tls_reject_count: i64 = 0
    rejected_worker_tls_reject_count: i64 = 0
    provider_request_reject_count: i64 = 0
    backend_matcher_reject_count: i64 = 0
    worker_thread_reject_count: i64 = 0
    invalid_boundary_token_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderInactiveBoundaryInventoryReport(fields: HakoAllocProviderInactiveBoundaryInventoryReportFields): HakoAllocProviderInactiveBoundaryInventoryReport {
        local result = new HakoAllocProviderInactiveBoundaryInventoryReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.provider_boundary_present = fields.provider_boundary_present
        result.worker_tls_present = fields.worker_tls_present
        result.worker_tls_accepted = fields.worker_tls_accepted
        result.worker_tls_reason = fields.worker_tls_reason
        result.provider_boundary_token = fields.provider_boundary_token
        result.provider_boundary_token_valid = fields.provider_boundary_token_valid
        result.worker_id = fields.worker_id
        result.tls_slot = fields.tls_slot
        result.page_source_token = fields.page_source_token
        result.bitmap_token = fields.bitmap_token
        result.mutation_token = fields.mutation_token
        result.lookup_result_token = fields.lookup_result_token
        result.arena_handle_token = fields.arena_handle_token
        result.private_pointer_token = fields.private_pointer_token
        result.provider_activation_required = fields.provider_activation_required
        result.provider_activation_supported = fields.provider_activation_supported
        result.provider_activation_inactive = fields.provider_activation_inactive
        result.host_replacement_inactive = fields.host_replacement_inactive
        result.hooks_inactive = fields.hooks_inactive
        result.backend_matcher_required = fields.backend_matcher_required
        result.backend_matcher_inactive = fields.backend_matcher_inactive
        result.inventory_count = fields.inventory_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_worker_tls_reject_count = fields.missing_worker_tls_reject_count
        result.rejected_worker_tls_reject_count = fields.rejected_worker_tls_reject_count
        result.provider_request_reject_count = fields.provider_request_reject_count
        result.backend_matcher_reject_count = fields.backend_matcher_reject_count
        result.worker_thread_reject_count = fields.worker_thread_reject_count
        result.invalid_boundary_token_reject_count = fields.invalid_boundary_token_reject_count
        result.last_reason = fields.last_reason
        result.would_dereference = fields.would_dereference
        result.would_release_arena_backing = fields.would_release_arena_backing
        result.would_recycle_arena_backing = fields.would_recycle_arena_backing
        result.would_mutate_segment_map = fields.would_mutate_segment_map
        result.would_execute_atomic_bitmap = fields.would_execute_atomic_bitmap
        result.would_call_osvm = fields.would_call_osvm
        result.would_use_worker_tls = fields.would_use_worker_tls
        result.would_run_thread = fields.would_run_thread
        result.would_activate_provider = fields.would_activate_provider
        result.would_replace_host_allocator = fields.would_replace_host_allocator
        result.would_install_hook = fields.would_install_hook
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        return result
    }

    makeReport(accepted, reason, boundary_present, worker_report: HakoAllocWorkerTlsPilotReport, boundary_token): HakoAllocProviderInactiveBoundaryInventoryReport {
        local token_valid = 0
        if boundary_token > 0 {
            token_valid = 1
        }
        local fields = HakoAllocProviderInactiveBoundaryInventoryReportFields {
            accepted: accepted,
            reason: reason,
            provider_boundary_present: boundary_present,
            worker_tls_present: worker_report.worker_tls_present,
            worker_tls_accepted: worker_report.accepted,
            worker_tls_reason: worker_report.reason,
            provider_boundary_token: boundary_token,
            provider_boundary_token_valid: token_valid,
            worker_id: worker_report.worker_id,
            tls_slot: worker_report.tls_slot,
            page_source_token: worker_report.page_source_token,
            bitmap_token: worker_report.bitmap_token,
            mutation_token: worker_report.mutation_token,
            lookup_result_token: worker_report.lookup_result_token,
            arena_handle_token: worker_report.arena_handle_token,
            private_pointer_token: worker_report.private_pointer_token,
            provider_activation_required: worker_report.would_activate_provider,
            provider_activation_supported: 0,
            provider_activation_inactive: 1,
            host_replacement_inactive: 1,
            hooks_inactive: 1,
            backend_matcher_required: worker_report.would_add_backend_matcher,
            backend_matcher_inactive: 1,
            inventory_count: me.inventory_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_worker_tls_reject_count: me.missing_worker_tls_reject_count,
            rejected_worker_tls_reject_count: me.rejected_worker_tls_reject_count,
            provider_request_reject_count: me.provider_request_reject_count,
            backend_matcher_reject_count: me.backend_matcher_reject_count,
            worker_thread_reject_count: me.worker_thread_reject_count,
            invalid_boundary_token_reject_count: me.invalid_boundary_token_reject_count,
            last_reason: me.last_reason,
            would_dereference: worker_report.would_dereference,
            would_release_arena_backing: worker_report.would_release_arena_backing,
            would_recycle_arena_backing: worker_report.would_recycle_arena_backing,
            would_mutate_segment_map: worker_report.would_mutate_segment_map,
            would_execute_atomic_bitmap: worker_report.would_execute_atomic_bitmap,
            would_call_osvm: worker_report.would_call_osvm,
            would_use_worker_tls: worker_report.would_use_worker_tls,
            would_run_thread: worker_report.would_run_thread,
            would_activate_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0
        }
        return me.makeProviderInactiveBoundaryInventoryReport(fields)
    }

    reject(reason, worker_report: HakoAllocWorkerTlsPilotReport, boundary_token): HakoAllocProviderInactiveBoundaryInventoryReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_worker_tls_reject_count += 1
        }
        if reason == 2 {
            me.rejected_worker_tls_reject_count += 1
        }
        if reason == 3 {
            me.provider_request_reject_count += 1
        }
        if reason == 4 {
            me.backend_matcher_reject_count += 1
        }
        if reason == 5 {
            me.worker_thread_reject_count += 1
        }
        if reason == 6 {
            me.invalid_boundary_token_reject_count += 1
        }
        return me.makeReport(0, reason, 0, worker_report, boundary_token)
    }

    recordProviderInactiveBoundary(worker_report: HakoAllocWorkerTlsPilotReport, boundary_token): HakoAllocProviderInactiveBoundaryInventoryReport {
        me.inventory_count += 1
        if worker_report.worker_tls_present != 1 {
            return me.reject(1, worker_report, boundary_token)
        }
        if worker_report.accepted != 1 {
            return me.reject(2, worker_report, boundary_token)
        }
        if worker_report.would_activate_provider != 0 {
            return me.reject(3, worker_report, boundary_token)
        }
        if worker_report.would_add_backend_matcher != 0 {
            return me.reject(4, worker_report, boundary_token)
        }
        if worker_report.would_run_thread != 0 {
            return me.reject(5, worker_report, boundary_token)
        }
        if boundary_token <= 0 {
            return me.reject(6, worker_report, boundary_token)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, worker_report, boundary_token)
    }
}

            would_add_backend_matcher: report.would_add_backend_matcher,
            would_run_thread: report.would_run_thread
        }
        return me.makeAllocatorComparisonCMimallocResultPresentationOnlyExtensionPilotReport(fields)
    }

    pilotAllocatorComparisonCMimallocResultPresentationOnlyExtension(report: HakoAllocAllocatorComparisonCMimallocResultPresentationExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnPilotReport): HakoAllocAllocatorComparisonCMimallocResultPresentationOnlyExtensionPilotReport {
        me.presentation_count += 1
        local reason = me.reasonFrom(report)
        if reason == 0 {
            me.accepted_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, report)
    }

            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markBlocked(reason: i64): void {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_pilot_reject_count += 1
        }
        if reason == 2 {
            me.blocked_pilot_reject_count += 1
        }
        if reason == 3 {
            me.missing_presentation_input_reject_count += 1
        }
        if reason == 4 {
            me.closed_stop_line_reject_count += 1
        }
        return void
    }

    pilotPresentFrom(report: HakoAllocAllocatorComparisonCMimallocResultPresentationExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnPilotReport): i64 {
        if report.comparison_ready_present == 1 {
            return 1
        }
        if report.accepted_input_pack_present == 1 {
            return 1
        }
        if report.blocked_input_pack_present == 1 {
            return 1
        }
        return 0
    }

    acceptedInputFrom(report: HakoAllocAllocatorComparisonCMimallocResultPresentationExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnPilotReport): i64 {
        if report.accepted != 1 {
            return 0
        }
        if report.reason != 0 {
            return 0
        }
        if report.comparison_ready_present != 1 {
            return 0
        }
        if report.accepted_input_pack_present != 1 {
            return 0
        }
        if report.blocked_input_pack_present != 0 {
            return 0
        }
        return 1
    }

    reasonFrom(report: HakoAllocAllocatorComparisonCMimallocResultPresentationExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnPilotReport): i64 {
        if me.pilotPresentFrom(report) != 1 {
            return 1
        }
        if me.acceptedInputFrom(report) != 1 {
            return 2
        }
        if report.hako_alloc_report_contract_present != 1 {
            return 3
        }
        if report.c_mimalloc_runner_contract_present != 1 {
            return 3
        }
        if report.shared_workload_id_present != 1 {
            return 3
        }
        if report.memory_evidence_fields_present != 1 {
            return 3
        }
        if report.comparison_preconditions_present != 1 {
            return 3
        }
        if report.performance_conclusion_made != 0 {
            return 4
        }
        if report.memory_conclusion_made != 0 {
            return 4
        }
        if report.repeated_benchmark_executed != 0 {
            return 4
        }
        if report.process_replacement_executed != 0 {
            return 4
        }
        if report.hook_installed != 0 {
            return 4
        }
        if report.backend_matcher_added != 0 {
            return 4
        }
        if report.global_allocator_installed != 0 {
            return 4
        }
        if report.hidden_discovery_used != 0 {

        }
        if report.provider_package_generated != 0 {
            return 4
        }
        if report.would_replace_host_allocator != 0 {
            return 4
        }
        if report.would_install_hook != 0 {
            return 4
        }
        if report.would_add_backend_matcher != 0 {
            return 4
        }
        if report.would_run_thread != 0 {
            return 4
        }
        return 0
    }

    makeReport(reason: i64, report: HakoAllocAllocatorComparisonCMimallocResultPresentationExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnExtensionFollowOnPilotReport): HakoAllocAllocatorComparisonCMimallocResultPresentationOnlyExtensionPilotReport {
        local accepted = 0
        local presentation_only_extension_present = 0
        local accepted_pilot_present = 0
        local blocked_pilot_present = 0
        local pilot_present = me.pilotPresentFrom(report)
        if reason == 0 {
            accepted = 1
            presentation_only_extension_present = 1
            accepted_pilot_present = 1
        } else {
            if pilot_present == 1 {
                blocked_pilot_present = 1
            }
        }
        local fields = HakoAllocAllocatorComparisonCMimallocResultPresentationOnlyExtensionPilotReportFields {}
        fields = fields with {
            accepted,
            reason,
            presentation_only_extension_present,
            comparison_ready_present: report.comparison_ready_present,
            pilot_present,
            accepted_pilot_present,
            blocked_pilot_present,
            accepted_input_pack_present: report.accepted_input_pack_present,
            blocked_input_pack_present: report.blocked_input_pack_present,

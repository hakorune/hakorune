// page_meta_drain_remote_list_to_local_vocabulary_box.hako
// MIM-PORT-FMEM-044: source/MIR vocabulary for owner-local drain consumption.

static box HakoAllocPageMetaDrainRemoteListToLocalVocabulary {
    drainRemoteListToLocalVocabularyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local used = page.used
            local drained = mem.atomicRemoteHeadDrain(page)
            local drain_marker = mem.drainRemoteListToLocal(page, drained)
            return used
        }
        return 0
    }
}

// remote_free_page_integration_box.hako — M170 page-owned remote-free inbox
// Responsibility: compose bounded remote-free pointer publish with page-local
// caller block-id collection. Metal and host allocator changes stay outside
// this owner.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox
using selfhost.hako_alloc.memory.remote_free_policy_box as HakoAllocRemoteFreePolicy

box HakoAllocRemoteFreePagePortSnapshot {
    page_used: usize = 0
    page_local_free_count: usize = 0
    page_retired: i64 = 0
    page_local_release_count: usize = 0
    inbox_init_status: i64 = 0
    inbox_push_count: i64 = 0
    inbox_collect_count: i64 = 0
    inbox_retry_count: i64 = 0
    inbox_reject_count: i64 = 0
    inbox_pending_count: i64 = 0
}

box HakoAllocRemoteFreePageExerciseReport {
    block0: i64 = -1
    block1: i64 = -1
    overflow_block: i64 = -1
    publish0: i64 = 0
    publish1: i64 = 0
    head_is_b: i64 = 0
    next_b_is_a: i64 = 0
    next_a_empty: i64 = 0
    drained: i64 = 0
    collect_after_drain: i64 = 0
    page_used: usize = 0
    page_local_free_count: usize = 0
    page_retired: i64 = 0
    page_local_release_count: usize = 0
    inbox_init_status: i64 = 0
    inbox_push_count: i64 = 0
    inbox_collect_count: i64 = 0
    inbox_retry_count: i64 = 0
    inbox_reject_count: i64 = 0
    inbox_pending_count: i64 = 0

    captureBlocks(block0, block1, overflow_block) {
        me.block0 = block0
        me.block1 = block1
        me.overflow_block = overflow_block
        return 1
    }

    captureFacadeBlocks(alloc, port) {
        local block0 = alloc.remotePageAcquire(port, 8)
        local block1 = alloc.remotePageAcquire(port, 16)
        local overflow_block = alloc.remotePageAcquire(port, 8)
        return me.captureBlocks(block0, block1, overflow_block)
    }

    capturePublish(publish0, publish1) {
        me.publish0 = publish0
        me.publish1 = publish1
        return 1
    }

    captureFacadePublish(alloc, port, block_a, block_b) {
        local publish0 = alloc.remotePagePublishPort(port, block_a, me.block0, 0)
        local publish1 = alloc.remotePagePublishPort(port, block_b, me.block1, 0)
        return me.capturePublish(publish0, publish1)
    }

    captureList(head_is_b, next_b_is_a, next_a_empty) {
        me.head_is_b = head_is_b
        me.next_b_is_a = next_b_is_a
        me.next_a_empty = next_a_empty
        return 1
    }

    captureObservedPointers(head, next_b, next_a, block_a, block_b) {
        if head == block_b {
            me.head_is_b = 1
        }
        if next_b == block_a {
            me.next_b_is_a = 1
        }
        if next_a == 0 {
            me.next_a_empty = 1
        }
        return 1
    }

    captureFacadeObservedPointers(alloc, port, block_a, block_b) {
        local head = alloc.remotePagePeekPortHead(port)
        local next_b = alloc.remotePagePeekPortNext(port, block_b)
        local next_a = alloc.remotePagePeekPortNext(port, block_a)
        return me.captureObservedPointers(head, next_b, next_a, block_a, block_b)
    }

    captureCollect(drained, collect_after_drain) {
        me.drained = drained
        me.collect_after_drain = collect_after_drain
        return 1
    }

    captureFacadeCollect(alloc, port) {
        local drained = alloc.remotePageCollectPendingPort(port)
        local collect_after_drain = alloc.remotePageCollectOnePort(port)
        return me.captureCollect(drained, collect_after_drain)
    }

    captureSnapshot(snapshot) {
        me.page_used = snapshot.page_used
        me.page_local_free_count = snapshot.page_local_free_count
        me.page_retired = snapshot.page_retired
        me.page_local_release_count = snapshot.page_local_release_count
        me.inbox_init_status = snapshot.inbox_init_status
        me.inbox_push_count = snapshot.inbox_push_count
        me.inbox_collect_count = snapshot.inbox_collect_count
        me.inbox_retry_count = snapshot.inbox_retry_count
        me.inbox_reject_count = snapshot.inbox_reject_count
        me.inbox_pending_count = snapshot.inbox_pending_count
        return 1
    }

    captureFacadeSnapshot(alloc, port) {
        local snapshot = alloc.remotePagePortSnapshot(port)
        return me.captureSnapshot(snapshot)
    }

    captureFacadeExercise(alloc, head_cell, block_a, block_b) {
        local port = alloc.remotePagePort(17, 32, 2, 2, head_cell)
        me.captureFacadeBlocks(alloc, port)
        me.captureFacadePublish(alloc, port, block_a, block_b)
        me.captureFacadeObservedPointers(alloc, port, block_a, block_b)
        me.captureFacadeCollect(alloc, port)
        return me.captureFacadeSnapshot(alloc, port)
    }

    blocksLine() {
        return "blocks=" + me.block0 + "," + me.block1 + "," + me.overflow_block
    }

    publishLine() {
        return "publish=" + me.publish0 + "," + me.publish1
    }

    listLine() {
        return "list=" + me.head_is_b + "," + me.next_b_is_a + "," + me.next_a_empty
    }

    collectLine() {
        return "collect=" + me.drained + "," + me.collect_after_drain
    }

    pageLine() {
        return "page=" + me.page_used + "," + me.page_local_free_count + "," + me.page_retired + "," + me.page_local_release_count
    }

    inboxLine() {
        return "inbox=" + me.inbox_init_status + "," + me.inbox_push_count + "," + me.inbox_collect_count + "," + me.inbox_retry_count + "," + me.inbox_reject_count + "," + me.inbox_pending_count
    }

    summaryLine() {
        if me.ok() != 1 { return "summary=fail" }
        return "summary=ok"
    }

    listShape() {
        return me.head_is_b + me.next_b_is_a + me.next_a_empty
    }

    ok() {
        local block0 = me.block0
        local block1 = me.block1
        local overflow_block = me.overflow_block
        local publish0 = me.publish0
        local publish1 = me.publish1
        local head_is_b = me.head_is_b
        local next_b_is_a = me.next_b_is_a
        local next_a_empty = me.next_a_empty
        local drained = me.drained
        local collect_after_drain = me.collect_after_drain
        local page_used = me.page_used
        local page_local_free_count = me.page_local_free_count
        local page_retired = me.page_retired
        local page_local_release_count = me.page_local_release_count
        local inbox_init_status = me.inbox_init_status
        local inbox_push_count = me.inbox_push_count
        local inbox_collect_count = me.inbox_collect_count
        local inbox_retry_count = me.inbox_retry_count
        local inbox_reject_count = me.inbox_reject_count
        local inbox_pending_count = me.inbox_pending_count
        local list_shape = head_is_b + next_b_is_a + next_a_empty

        if block0 != 1 || block1 != 0 || overflow_block != -1 ||
           publish0 != 1 || publish1 != 1 ||
           drained != 2 || collect_after_drain != 0 || list_shape != 3 ||
           page_used != 0 || page_local_free_count != 2 || page_retired != 1 || page_local_release_count != 2 ||
           inbox_init_status != 0 || inbox_push_count != 2 || inbox_collect_count != 2 ||
           inbox_retry_count != 0 || inbox_reject_count != 1 || inbox_pending_count != 0 { return 0 }
        return 1
    }
}

box HakoAllocRemoteFreePageInbox {
    page: HakoAllocPageModel
    head_cell: i64
    pending_block_ids: ArrayBox = new ArrayBox()
    init_status: i64 = 0
    pending_top: i64 = 0
    remote_push_count: i64 = 0
    remote_collect_count: i64 = 0
    retry_count: i64 = 0
    reject_count: i64 = 0

    birth(page, head_cell) {
        me.page = page
        me.head_cell = head_cell
        me.init_status = HakoAllocRemoteFreePolicy.initHead(head_cell)
    }

    reset(head_cell) {
        me.head_cell = head_cell
        me.init_status = HakoAllocRemoteFreePolicy.initHead(head_cell)
        me.pending_top = 0
        me.remote_push_count = 0
        me.remote_collect_count = 0
        me.retry_count = 0
        me.reject_count = 0
        return 1
    }

    publish(block_ptr, block_id, interferer_ptr) {
        local page = me.page
        if page == null {
            me.reject_count = me.reject_count + 1
            return 0
        }

        if block_id < 0 {
            me.reject_count = me.reject_count + 1
            return 0
        }

        local head_cell = me.head_cell
        local retries = HakoAllocRemoteFreePolicy.pushRetry(head_cell, block_ptr, interferer_ptr)
        if retries < 0 {
            me.reject_count = me.reject_count + 1
            return 0
        }

        local pending_block_ids = me.pending_block_ids
        local pending_top = me.pending_top
        if pending_top < pending_block_ids.length() {
            pending_block_ids.set(pending_top, block_id)
        } else {
            pending_block_ids.push(block_id)
        }
        me.pending_top = me.pending_top + 1
        me.remote_push_count = me.remote_push_count + 1
        me.retry_count = me.retry_count + retries
        return 1
    }

    collectOne() {
        local pending = me.pending_top
        if pending == 0 {
            me.reject_count = me.reject_count + 1
            return 0
        }

        pending = pending - 1
        local pending_block_ids = me.pending_block_ids
        local block_id = pending_block_ids.get(pending)
        if me.page.releaseLocal(block_id) {
            me.pending_top = pending
            me.remote_collect_count = me.remote_collect_count + 1
            return 1
        }

        me.pending_top = pending
        me.reject_count = me.reject_count + 1
        return 0
    }

    collectPending() {
        local pending = me.pending_top
        if pending == 0 {
            return 0
        }

        local page = me.page
        local pending_block_ids = me.pending_block_ids
        local remote_collect_count = me.remote_collect_count
        local drained = 0
        loop(pending > 0) {
            pending = pending - 1
            local block_id = pending_block_ids.get(pending)
            if page.releaseLocal(block_id) {
                remote_collect_count = remote_collect_count + 1
                drained = drained + 1
            } else {
                me.pending_top = pending
                me.remote_collect_count = remote_collect_count
                me.reject_count = me.reject_count + 1
                return drained
            }
        }

        me.pending_top = 0
        me.remote_collect_count = remote_collect_count
        return drained
    }

    peekHead() {
        return HakoAllocRemoteFreePolicy.peekHead(me.head_cell)
    }

    peekNext(block_ptr) {
        return HakoAllocRemoteFreePolicy.peekNext(block_ptr)
    }
}

box HakoAllocRemoteFreePagePort {
    page: HakoAllocPageModel
    inbox: HakoAllocRemoteFreePageInbox

    birth(page_id, block_size, capacity, reserved, head_cell) {
        me.page = new HakoAllocPageModel(page_id, block_size, capacity, reserved)
        me.inbox = new HakoAllocRemoteFreePageInbox(me.page, head_cell)
    }

    acquire(requested_size) {
        return me.page.acquire(requested_size)
    }

    publish(block_ptr, block_id, interferer_ptr) {
        return me.inbox.publish(block_ptr, block_id, interferer_ptr)
    }

    collectOne() {
        return me.inbox.collectOne()
    }

    collectPending() {
        return me.inbox.collectPending()
    }

    peekHead() {
        return me.inbox.peekHead()
    }

    peekNext(block_ptr) {
        return me.inbox.peekNext(block_ptr)
    }

    pageLocalFreeCount() {
        return me.page.localFreeCount()
    }

    pageUsed() {
        return me.page.used
    }

    pageRetired() {
        return me.page.retired
    }

    pageLocalReleaseCount() {
        return me.page.local_free_count
    }

    inboxInitStatus() {
        return me.inbox.init_status
    }

    inboxPushCount() {
        return me.inbox.remote_push_count
    }

    inboxCollectCount() {
        return me.inbox.remote_collect_count
    }

    inboxRetryCount() {
        return me.inbox.retry_count
    }

    inboxRejectCount() {
        return me.inbox.reject_count
    }

    inboxPendingCount() {
        return me.inbox.pending_top
    }

    snapshot() {
        local snapshot = new HakoAllocRemoteFreePagePortSnapshot()
        local page = me.page
        local inbox = me.inbox
        snapshot.page_used = page.used
        snapshot.page_local_free_count = page.localFreeCount()
        snapshot.page_retired = page.retired
        snapshot.page_local_release_count = page.local_free_count
        snapshot.inbox_init_status = inbox.init_status
        snapshot.inbox_push_count = inbox.remote_push_count
        snapshot.inbox_collect_count = inbox.remote_collect_count
        snapshot.inbox_retry_count = inbox.retry_count
        snapshot.inbox_reject_count = inbox.reject_count
        snapshot.inbox_pending_count = inbox.pending_top
        return snapshot
    }

    reset(head_cell) {
        me.page.resetToFresh()
        return me.inbox.reset(head_cell)
    }

    exerciseStateOk() {
        local page = me.page
        if page.used != 0 || page.localFreeCount() != 2 || page.retired != 1 || page.local_free_count != 2 {
            return 0
        }

        local inbox = me.inbox
        if inbox.init_status != 0 || inbox.remote_push_count != 2 || inbox.remote_collect_count != 2 ||
           inbox.retry_count != 0 || inbox.reject_count != 1 || inbox.pending_top != 0 {
            return 0
        }
        return 1
    }
}

static box HakoAllocRemoteFreePagePortFactory {
    create(page_id, block_size, capacity, reserved, head_cell) {
        return new HakoAllocRemoteFreePagePort(page_id, block_size, capacity, reserved, head_cell)
    }
}

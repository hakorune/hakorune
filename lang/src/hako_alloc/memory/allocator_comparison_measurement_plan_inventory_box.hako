// allocator_comparison_measurement_plan_inventory_box.hako -- MIMAP-433A
// Responsibility:
// - inventory explicit measurement plan inputs before allocator comparison runs
// Non-responsibility:
// - benchmark execution, hook installation, process allocator replacement,
//   backend matcher additions, global allocator install, or worker/thread execution

record HakoAllocAllocatorComparisonMeasurementPlanInventoryReportFields {
    accepted: i64
    reason: i64
    measurement_plan_inventory_present: i64
    measurement_plan_ready: i64
    run_count_present: i64
    warmup_plan_present: i64
    output_contract_present: i64
    throughput_measurement_present: i64
    memory_usage_measurement_present: i64
    run_count: i64
    warmup_count: i64
    inventory_count: i64
    accepted_count: i64
    reject_count: i64
    missing_run_count_reject_count: i64
    missing_warmup_plan_reject_count: i64
    missing_output_contract_reject_count: i64
    missing_throughput_measurement_reject_count: i64
    missing_memory_usage_measurement_reject_count: i64
    invalid_run_count_reject_count: i64
    invalid_warmup_count_reject_count: i64
    last_reason: i64
    benchmark_executed: i64
    process_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    would_run_benchmark: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocAllocatorComparisonMeasurementPlanInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    measurement_plan_inventory_present: i64 = 0
    measurement_plan_ready: i64 = 0
    run_count_present: i64 = 0
    warmup_plan_present: i64 = 0
    output_contract_present: i64 = 0
    throughput_measurement_present: i64 = 0
    memory_usage_measurement_present: i64 = 0
    run_count: i64 = 0
    warmup_count: i64 = 0
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_run_count_reject_count: i64 = 0
    missing_warmup_plan_reject_count: i64 = 0
    missing_output_contract_reject_count: i64 = 0
    missing_throughput_measurement_reject_count: i64 = 0
    missing_memory_usage_measurement_reject_count: i64 = 0
    invalid_run_count_reject_count: i64 = 0
    invalid_warmup_count_reject_count: i64 = 0
    last_reason: i64 = 0
    benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    would_run_benchmark: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonMeasurementPlanInventory {
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_run_count_reject_count: i64 = 0
    missing_warmup_plan_reject_count: i64 = 0
    missing_output_contract_reject_count: i64 = 0
    missing_throughput_measurement_reject_count: i64 = 0
    missing_memory_usage_measurement_reject_count: i64 = 0
    invalid_run_count_reject_count: i64 = 0
    invalid_warmup_count_reject_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonMeasurementPlanInventoryReport(fields: HakoAllocAllocatorComparisonMeasurementPlanInventoryReportFields): HakoAllocAllocatorComparisonMeasurementPlanInventoryReport {
        local result = new HakoAllocAllocatorComparisonMeasurementPlanInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            measurement_plan_inventory_present: fields.measurement_plan_inventory_present,
            measurement_plan_ready: fields.measurement_plan_ready,
            run_count_present: fields.run_count_present,
            warmup_plan_present: fields.warmup_plan_present,
            output_contract_present: fields.output_contract_present,
            throughput_measurement_present: fields.throughput_measurement_present,
            memory_usage_measurement_present: fields.memory_usage_measurement_present,
            run_count: fields.run_count,
            warmup_count: fields.warmup_count,
            inventory_count: fields.inventory_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_run_count_reject_count: fields.missing_run_count_reject_count,
            missing_warmup_plan_reject_count: fields.missing_warmup_plan_reject_count,
            missing_output_contract_reject_count: fields.missing_output_contract_reject_count,
            missing_throughput_measurement_reject_count: fields.missing_throughput_measurement_reject_count,
            missing_memory_usage_measurement_reject_count: fields.missing_memory_usage_measurement_reject_count,
            invalid_run_count_reject_count: fields.invalid_run_count_reject_count,
            invalid_warmup_count_reject_count: fields.invalid_warmup_count_reject_count,
            last_reason: fields.last_reason,
            benchmark_executed: fields.benchmark_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            would_run_benchmark: fields.would_run_benchmark,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(
        accepted: i64,
        reason: i64,
        run_count_present: i64,
        warmup_plan_present: i64,
        output_contract_present: i64,
        throughput_measurement_present: i64,
        memory_usage_measurement_present: i64,
        run_count: i64,
        warmup_count: i64
    ): HakoAllocAllocatorComparisonMeasurementPlanInventoryReport {
        local fields = HakoAllocAllocatorComparisonMeasurementPlanInventoryReportFields {
            accepted: accepted,
            reason: reason,
            measurement_plan_inventory_present: accepted,
            measurement_plan_ready: accepted,
            run_count_present: run_count_present,
            warmup_plan_present: warmup_plan_present,
            output_contract_present: output_contract_present,
            throughput_measurement_present: throughput_measurement_present,
            memory_usage_measurement_present: memory_usage_measurement_present,
            run_count: run_count,
            warmup_count: warmup_count,
            inventory_count: me.inventory_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_run_count_reject_count: me.missing_run_count_reject_count,
            missing_warmup_plan_reject_count: me.missing_warmup_plan_reject_count,
            missing_output_contract_reject_count: me.missing_output_contract_reject_count,
            missing_throughput_measurement_reject_count: me.missing_throughput_measurement_reject_count,
            missing_memory_usage_measurement_reject_count: me.missing_memory_usage_measurement_reject_count,
            invalid_run_count_reject_count: me.invalid_run_count_reject_count,
            invalid_warmup_count_reject_count: me.invalid_warmup_count_reject_count,
            last_reason: me.last_reason,
            benchmark_executed: 0,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            would_run_benchmark: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeAllocatorComparisonMeasurementPlanInventoryReport(fields)
    }

    reject(
        reason: i64,
        run_count_present: i64,
        warmup_plan_present: i64,
        output_contract_present: i64,
        throughput_measurement_present: i64,
        memory_usage_measurement_present: i64,
        run_count: i64,
        warmup_count: i64
    ): HakoAllocAllocatorComparisonMeasurementPlanInventoryReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_run_count_reject_count += 1
        }
        if reason == 2 {
            me.missing_warmup_plan_reject_count += 1
        }
        if reason == 3 {
            me.missing_output_contract_reject_count += 1
        }
        if reason == 4 {
            me.missing_throughput_measurement_reject_count += 1
        }
        if reason == 5 {
            me.missing_memory_usage_measurement_reject_count += 1
        }
        if reason == 6 {
            me.invalid_run_count_reject_count += 1
        }
        if reason == 7 {
            me.invalid_warmup_count_reject_count += 1
        }
        return me.makeReport(0, reason, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
    }

    inventoryAllocatorComparisonMeasurementPlan(
        run_count_present: i64,
        warmup_plan_present: i64,
        output_contract_present: i64,
        throughput_measurement_present: i64,
        memory_usage_measurement_present: i64,
        run_count: i64,
        warmup_count: i64
    ): HakoAllocAllocatorComparisonMeasurementPlanInventoryReport {
        me.inventory_count += 1
        if run_count_present != 1 {
            return me.reject(1, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }
        if warmup_plan_present != 1 {
            return me.reject(2, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }
        if output_contract_present != 1 {
            return me.reject(3, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }
        if throughput_measurement_present != 1 {
            return me.reject(4, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }
        if memory_usage_measurement_present != 1 {
            return me.reject(5, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }
        if run_count < 1 {
            return me.reject(6, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }
        if warmup_count < 0 {
            return me.reject(7, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, run_count_present, warmup_plan_present, output_contract_present, throughput_measurement_present, memory_usage_measurement_present, run_count, warmup_count)
    }
}

// provider_call_external_api_adapter_preflight_box.hako -- MIMAP-402A
// Responsibility:
// - consume a provider-call external API adapter inventory report
// - record preflight readiness for a future external provider API call
// Non-responsibility:
// - external provider API calls, host allocator replacement, hooks, global
//   allocator install, backend matchers, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.provider_call_external_api_adapter_inventory_box as HakoAllocProviderCallExternalApiAdapterInventory

record HakoAllocProviderCallExternalApiAdapterPreflightReportFields {
    accepted: i64
    reason: i64
    adapter_preflight_present: i64
    adapter_inventory_present: i64
    adapter_inventory_accepted: i64
    adapter_inventory_reason: i64
    external_provider_adapter_present: i64
    external_provider_adapter_valid: i64
    external_provider_api_call_ready: i64
    external_provider_api_preflight_ready: i64
    external_provider_api_call_executed: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    preflight_count: i64
    accepted_count: i64
    reject_count: i64
    missing_inventory_reject_count: i64
    rejected_inventory_reject_count: i64
    missing_adapter_reject_count: i64
    invalid_adapter_reject_count: i64
    already_executed_reject_count: i64
    closed_execution_reject_count: i64
    closed_host_replacement_reject_count: i64
    closed_hook_reject_count: i64
    closed_backend_matcher_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_execute_provider_api: i64
    would_call_external_provider_api: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderCallExternalApiAdapterPreflightReport {
    accepted: i64 = 0
    reason: i64 = 0
    adapter_preflight_present: i64 = 0
    adapter_inventory_present: i64 = 0
    adapter_inventory_accepted: i64 = 0
    adapter_inventory_reason: i64 = 0
    external_provider_adapter_present: i64 = 0
    external_provider_adapter_valid: i64 = 0
    external_provider_api_call_ready: i64 = 0
    external_provider_api_preflight_ready: i64 = 0
    external_provider_api_call_executed: i64 = 0
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_inventory_reject_count: i64 = 0
    rejected_inventory_reject_count: i64 = 0
    missing_adapter_reject_count: i64 = 0
    invalid_adapter_reject_count: i64 = 0
    already_executed_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_execute_provider_api: i64 = 0
    would_call_external_provider_api: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderCallExternalApiAdapterPreflight {
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_inventory_reject_count: i64 = 0
    rejected_inventory_reject_count: i64 = 0
    missing_adapter_reject_count: i64 = 0
    invalid_adapter_reject_count: i64 = 0
    already_executed_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderCallExternalApiAdapterPreflightReport(fields: HakoAllocProviderCallExternalApiAdapterPreflightReportFields): HakoAllocProviderCallExternalApiAdapterPreflightReport {
        local result = new HakoAllocProviderCallExternalApiAdapterPreflightReport {
            accepted: fields.accepted,
            reason: fields.reason,
            adapter_preflight_present: fields.adapter_preflight_present,
            adapter_inventory_present: fields.adapter_inventory_present,
            adapter_inventory_accepted: fields.adapter_inventory_accepted,
            adapter_inventory_reason: fields.adapter_inventory_reason,
            external_provider_adapter_present: fields.external_provider_adapter_present,
            external_provider_adapter_valid: fields.external_provider_adapter_valid,
            external_provider_api_call_ready: fields.external_provider_api_call_ready,
            external_provider_api_preflight_ready: fields.external_provider_api_preflight_ready,
            external_provider_api_call_executed: fields.external_provider_api_call_executed,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            preflight_count: fields.preflight_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_inventory_reject_count: fields.missing_inventory_reject_count,
            rejected_inventory_reject_count: fields.rejected_inventory_reject_count,
            missing_adapter_reject_count: fields.missing_adapter_reject_count,
            invalid_adapter_reject_count: fields.invalid_adapter_reject_count,
            already_executed_reject_count: fields.already_executed_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            closed_host_replacement_reject_count: fields.closed_host_replacement_reject_count,
            closed_hook_reject_count: fields.closed_hook_reject_count,
            closed_backend_matcher_reject_count: fields.closed_backend_matcher_reject_count,
            last_reason: fields.last_reason,
            would_activate_provider: fields.would_activate_provider,
            would_call_provider: fields.would_call_provider,
            would_execute_provider_api: fields.would_execute_provider_api,
            would_call_external_provider_api: fields.would_call_external_provider_api,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, inventory: HakoAllocProviderCallExternalApiAdapterInventoryReport): HakoAllocProviderCallExternalApiAdapterPreflightReport {
        local present = accepted
        local ready = accepted
        local fields = HakoAllocProviderCallExternalApiAdapterPreflightReportFields {
            accepted: accepted,
            reason: reason,
            adapter_preflight_present: present,
            adapter_inventory_present: inventory.adapter_inventory_present,
            adapter_inventory_accepted: inventory.accepted,
            adapter_inventory_reason: inventory.reason,
            external_provider_adapter_present: inventory.external_provider_adapter_present,
            external_provider_adapter_valid: inventory.external_provider_adapter_valid,
            external_provider_api_call_ready: inventory.external_provider_api_call_ready,
            external_provider_api_preflight_ready: ready,
            external_provider_api_call_executed: 0,
            host_replacement_inactive: inventory.host_replacement_inactive,
            hooks_inactive: inventory.hooks_inactive,
            backend_matcher_inactive: inventory.backend_matcher_inactive,
            preflight_count: me.preflight_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_inventory_reject_count: me.missing_inventory_reject_count,
            rejected_inventory_reject_count: me.rejected_inventory_reject_count,
            missing_adapter_reject_count: me.missing_adapter_reject_count,
            invalid_adapter_reject_count: me.invalid_adapter_reject_count,
            already_executed_reject_count: me.already_executed_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            closed_host_replacement_reject_count: me.closed_host_replacement_reject_count,
            closed_hook_reject_count: me.closed_hook_reject_count,
            closed_backend_matcher_reject_count: me.closed_backend_matcher_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: inventory.would_activate_provider,
            would_call_provider: inventory.would_call_provider,
            would_execute_provider_api: inventory.would_execute_provider_api,
            would_call_external_provider_api: inventory.would_call_external_provider_api,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderCallExternalApiAdapterPreflightReport(fields)
    }

    reject(reason, inventory: HakoAllocProviderCallExternalApiAdapterInventoryReport): HakoAllocProviderCallExternalApiAdapterPreflightReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_inventory_reject_count += 1
        }
        if reason == 2 {
            me.rejected_inventory_reject_count += 1
        }
        if reason == 3 {
            me.missing_adapter_reject_count += 1
        }
        if reason == 4 {
            me.invalid_adapter_reject_count += 1
        }
        if reason == 5 {
            me.already_executed_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        if reason == 7 {
            me.closed_host_replacement_reject_count += 1
        }
        if reason == 8 {
            me.closed_hook_reject_count += 1
        }
        if reason == 9 {
            me.closed_backend_matcher_reject_count += 1
        }
        return me.makeReport(0, reason, inventory)
    }

    preflightProviderCallExternalApiAdapter(inventory: HakoAllocProviderCallExternalApiAdapterInventoryReport): HakoAllocProviderCallExternalApiAdapterPreflightReport {
        me.preflight_count += 1
        if inventory.adapter_inventory_present != 1 {
            return me.reject(1, inventory)
        }
        if inventory.accepted != 1 {
            return me.reject(2, inventory)
        }
        if inventory.external_provider_adapter_present != 1 {
            return me.reject(3, inventory)
        }
        if inventory.external_provider_adapter_valid != 1 {
            return me.reject(4, inventory)
        }
        if inventory.external_provider_api_call_executed != 0 {
            return me.reject(5, inventory)
        }
        if inventory.external_provider_api_call_ready != 1 {
            return me.reject(6, inventory)
        }
        if inventory.would_call_external_provider_api != 1 {
            return me.reject(6, inventory)
        }
        if inventory.would_replace_host_allocator != 0 {
            return me.reject(7, inventory)
        }
        if inventory.would_install_hook != 0 {
            return me.reject(8, inventory)
        }
        if inventory.would_add_backend_matcher != 0 {
            return me.reject(9, inventory)
        }
        if inventory.would_run_thread != 0 {
            return me.reject(9, inventory)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, inventory)
    }
}

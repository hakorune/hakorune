// allocator_comparison_baseline_diagnostic_box.hako -- MIMAP-428A
// Responsibility:
// - consume allocator comparison baseline inventory reports
// - summarize missing baseline inputs without benchmark or replacement execution
// Non-responsibility:
// - benchmark execution, hook installation, process allocator replacement,
//   backend matcher additions, global allocator install, or worker/thread execution

using selfhost.hako_alloc.memory.allocator_comparison_baseline_inventory_box as HakoAllocAllocatorComparisonBaselineInventory

record HakoAllocAllocatorComparisonBaselineDiagnosticReportFields {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    baseline_inventory_present: i64 = 0
    comparison_ready: i64 = 0
    blocked_input_present: i64 = 0
    missing_c_mimalloc_baseline_blocked: i64 = 0
    missing_hako_alloc_baseline_blocked: i64 = 0
    missing_throughput_target_blocked: i64 = 0
    missing_memory_usage_target_blocked: i64 = 0
    missing_workload_matrix_blocked: i64 = 0
    invalid_repeat_count_blocked: i64 = 0
    closed_seam_blocked: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_c_mimalloc_baseline_blocked_count: i64 = 0
    missing_hako_alloc_baseline_blocked_count: i64 = 0
    missing_throughput_target_blocked_count: i64 = 0
    missing_memory_usage_target_blocked_count: i64 = 0
    missing_workload_matrix_blocked_count: i64 = 0
    invalid_repeat_count_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonBaselineDiagnosticReport {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    baseline_inventory_present: i64 = 0
    comparison_ready: i64 = 0
    blocked_input_present: i64 = 0
    missing_c_mimalloc_baseline_blocked: i64 = 0
    missing_hako_alloc_baseline_blocked: i64 = 0
    missing_throughput_target_blocked: i64 = 0
    missing_memory_usage_target_blocked: i64 = 0
    missing_workload_matrix_blocked: i64 = 0
    invalid_repeat_count_blocked: i64 = 0
    closed_seam_blocked: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_c_mimalloc_baseline_blocked_count: i64 = 0
    missing_hako_alloc_baseline_blocked_count: i64 = 0
    missing_throughput_target_blocked_count: i64 = 0
    missing_memory_usage_target_blocked_count: i64 = 0
    missing_workload_matrix_blocked_count: i64 = 0
    invalid_repeat_count_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonBaselineDiagnostic {
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_c_mimalloc_baseline_blocked_count: i64 = 0
    missing_hako_alloc_baseline_blocked_count: i64 = 0
    missing_throughput_target_blocked_count: i64 = 0
    missing_memory_usage_target_blocked_count: i64 = 0
    missing_workload_matrix_blocked_count: i64 = 0
    invalid_repeat_count_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonBaselineDiagnosticReport(fields: HakoAllocAllocatorComparisonBaselineDiagnosticReportFields): HakoAllocAllocatorComparisonBaselineDiagnosticReport {
        local result = new HakoAllocAllocatorComparisonBaselineDiagnosticReport {
            accepted: fields.accepted,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            baseline_inventory_present: fields.baseline_inventory_present,
            comparison_ready: fields.comparison_ready,
            blocked_input_present: fields.blocked_input_present,
            missing_c_mimalloc_baseline_blocked: fields.missing_c_mimalloc_baseline_blocked,
            missing_hako_alloc_baseline_blocked: fields.missing_hako_alloc_baseline_blocked,
            missing_throughput_target_blocked: fields.missing_throughput_target_blocked,
            missing_memory_usage_target_blocked: fields.missing_memory_usage_target_blocked,
            missing_workload_matrix_blocked: fields.missing_workload_matrix_blocked,
            invalid_repeat_count_blocked: fields.invalid_repeat_count_blocked,
            closed_seam_blocked: fields.closed_seam_blocked,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            diagnostic_count: fields.diagnostic_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            missing_c_mimalloc_baseline_blocked_count: fields.missing_c_mimalloc_baseline_blocked_count,
            missing_hako_alloc_baseline_blocked_count: fields.missing_hako_alloc_baseline_blocked_count,
            missing_throughput_target_blocked_count: fields.missing_throughput_target_blocked_count,
            missing_memory_usage_target_blocked_count: fields.missing_memory_usage_target_blocked_count,
            missing_workload_matrix_blocked_count: fields.missing_workload_matrix_blocked_count,
            invalid_repeat_count_blocked_count: fields.invalid_repeat_count_blocked_count,
            closed_seam_blocked_count: fields.closed_seam_blocked_count,
            last_reason: fields.last_reason,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markBlocked(reason: i64) {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_c_mimalloc_baseline_blocked_count += 1
        }
        if reason == 2 {
            me.missing_hako_alloc_baseline_blocked_count += 1
        }
        if reason == 3 {
            me.missing_throughput_target_blocked_count += 1
        }
        if reason == 4 {
            me.missing_memory_usage_target_blocked_count += 1
        }
        if reason == 5 {
            me.missing_workload_matrix_blocked_count += 1
        }
        if reason == 6 {
            me.invalid_repeat_count_blocked_count += 1
        }
        if reason == 7 {
            me.closed_seam_blocked_count += 1
        }
    }

    reasonFrom(baseline: HakoAllocAllocatorComparisonBaselineInventoryReport): i64 {
        if baseline.process_replacement_executed != 0 {
            return 7
        }
        if baseline.hook_installed != 0 {
            return 7
        }
        if baseline.backend_matcher_added != 0 {
            return 7
        }
        if baseline.global_allocator_installed != 0 {
            return 7
        }
        if baseline.would_replace_host_allocator != 0 {
            return 7
        }
        if baseline.would_install_hook != 0 {
            return 7
        }
        if baseline.would_add_backend_matcher != 0 {
            return 7
        }
        if baseline.would_run_thread != 0 {
            return 7
        }
        if baseline.comparison_ready == 1 {
            return 0
        }
        if baseline.reason != 0 {
            return baseline.reason
        }
        return 1
    }

    makeReport(reason: i64, baseline: HakoAllocAllocatorComparisonBaselineInventoryReport): HakoAllocAllocatorComparisonBaselineDiagnosticReport {
        local blocked_input_present = 0
        if reason != 0 {
            blocked_input_present = 1
        }
        local missing_c_mimalloc_baseline_blocked = 0
        local missing_hako_alloc_baseline_blocked = 0
        local missing_throughput_target_blocked = 0
        local missing_memory_usage_target_blocked = 0
        local missing_workload_matrix_blocked = 0
        local invalid_repeat_count_blocked = 0
        local closed_seam_blocked = 0
        if reason == 1 {
            missing_c_mimalloc_baseline_blocked = 1
        }
        if reason == 2 {
            missing_hako_alloc_baseline_blocked = 1
        }
        if reason == 3 {
            missing_throughput_target_blocked = 1
        }
        if reason == 4 {
            missing_memory_usage_target_blocked = 1
        }
        if reason == 5 {
            missing_workload_matrix_blocked = 1
        }
        if reason == 6 {
            invalid_repeat_count_blocked = 1
        }
        if reason == 7 {
            closed_seam_blocked = 1
        }
        local fields = HakoAllocAllocatorComparisonBaselineDiagnosticReportFields {}
        fields = fields with {
            accepted: 1,
            reason,
            diagnostic_present: 1,
            baseline_inventory_present: baseline.baseline_inventory_present,
            comparison_ready: baseline.comparison_ready,
            blocked_input_present,
            missing_c_mimalloc_baseline_blocked,
            missing_hako_alloc_baseline_blocked,
            missing_throughput_target_blocked,
            missing_memory_usage_target_blocked,
            missing_workload_matrix_blocked,
            invalid_repeat_count_blocked,
            closed_seam_blocked,
            diagnostic_count: me.diagnostic_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            missing_c_mimalloc_baseline_blocked_count: me.missing_c_mimalloc_baseline_blocked_count,
            missing_hako_alloc_baseline_blocked_count: me.missing_hako_alloc_baseline_blocked_count,
            missing_throughput_target_blocked_count: me.missing_throughput_target_blocked_count,
            missing_memory_usage_target_blocked_count: me.missing_memory_usage_target_blocked_count,
            missing_workload_matrix_blocked_count: me.missing_workload_matrix_blocked_count,
            invalid_repeat_count_blocked_count: me.invalid_repeat_count_blocked_count,
            closed_seam_blocked_count: me.closed_seam_blocked_count,
            last_reason: me.last_reason
        }
        return me.makeAllocatorComparisonBaselineDiagnosticReport(fields)
    }

    diagnoseAllocatorComparisonBaseline(baseline: HakoAllocAllocatorComparisonBaselineInventoryReport): HakoAllocAllocatorComparisonBaselineDiagnosticReport {
        me.diagnostic_count += 1
        local reason = me.reasonFrom(baseline)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, baseline)
    }
}

// page_meta_local_free_head_preflight_box.hako -- local_free_head preflight
// Responsibility: prove that local_free_head is visible from .hako source and
// MIR metadata but remains closed as an ordinary FieldLoad/FieldStore lowering
// target. This preflight does not open free-list mutation, DirectArray backing,
// same/remote routing, AtomicRemoteHead, TLS transfer, or product activation.

static box HakoAllocPageMetaLocalFreeHeadPreflight {
    localFreeHeadPreflight(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local local_free_head = page.local_free_head
            page.used = local_free_head
        }
        return 0
    }
}

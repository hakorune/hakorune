// page_meta_free_head_pop_vocabulary_box.hako -- FreeHeadPop vocabulary pilot
// Responsibility: expose the ordinary page free-list allocation pop as a
// dedicated FastMemory MemOp vocabulary item. This does not lower FreeHeadPop,
// open refill, mutate free_head through ordinary FieldStore, add counters,
// route remote frees, transfer TLS backing, or activate product allocation.

static box HakoAllocPageMetaFreeHeadPopVocabulary {
    freeHeadPopVocabularyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local popped = mem.freeHeadPop(page)
            page.used = popped
        }
        return 0
    }
}

// page_meta_local_free_to_free_refill_counter_body_box.hako -- refill counter pilot
// Responsibility: prove that the single-block local_free -> free refill body
// can also update its source-level refill accounting fields through verified
// PageMetaLayoutV0 field access. This does not open multi-block transfer,
// branch routing, remote-owner routing, AtomicRemoteHead, TLS transfer, product
// allocator replacement, hooks, or winner claims.

static box HakoAllocPageMetaLocalFreeToFreeRefillCounterBody {
    localFreeToFreeRefillCounterBodyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local current = mem.currentAllocOwnerId()
            local same = mem.ownerEq(page.owner_worker_id, current)
            mem.assumeSameOwner(page, same)
            mem.assumeLocalFreeNonEmpty(page)

            local block = mem.localFreePop(page)
            mem.assumeFreeHeadBlockNext(block)
            local push_marker = mem.freeHeadPush(page, block)

            local collect_count = page.local_free_collect_count
            local next_collect_count = collect_count + 1
            page.local_free_collect_count = next_collect_count

            local collected_blocks = page.local_free_collected_blocks
            local next_collected_blocks = collected_blocks + 1
            page.local_free_collected_blocks = next_collected_blocks
        }

        return 0
    }
}

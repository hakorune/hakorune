// allocator_comparison_controlled_benchmark_execution_diagnostic_box.hako -- MIMAP-441A
// Responsibility:
// - consume allocator comparison controlled benchmark execution inventory reports
// - summarize missing/open controlled execution blockers without execution
// Non-responsibility:
// - benchmark execution, hook installation, process allocator replacement,
//   backend matcher additions, global allocator install, or worker/thread execution

using selfhost.hako_alloc.memory.allocator_comparison_controlled_benchmark_execution_inventory_box as HakoAllocAllocatorComparisonControlledBenchmarkExecutionInventory

record HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReportFields {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    controlled_benchmark_execution_inventory_present: i64 = 0
    controlled_benchmark_execution_shape_ready: i64 = 0
    blocked_execution_shape_present: i64 = 0
    missing_runner_blocked: i64 = 0
    workload_source_not_ready_blocked: i64 = 0
    measurement_source_not_ready_blocked: i64 = 0
    missing_output_contract_blocked: i64 = 0
    missing_evidence_storage_blocked: i64 = 0
    missing_representative_run_blocked: i64 = 0
    process_replacement_open_blocked: i64 = 0
    hook_open_blocked: i64 = 0
    backend_matcher_open_blocked: i64 = 0
    global_allocator_open_blocked: i64 = 0
    hidden_env_open_blocked: i64 = 0
    closed_seam_blocked: i64 = 0
    benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    controlled_benchmark_execution_planned: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_runner_blocked_count: i64 = 0
    workload_source_not_ready_blocked_count: i64 = 0
    measurement_source_not_ready_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_evidence_storage_blocked_count: i64 = 0
    missing_representative_run_blocked_count: i64 = 0
    process_replacement_open_blocked_count: i64 = 0
    hook_open_blocked_count: i64 = 0
    backend_matcher_open_blocked_count: i64 = 0
    global_allocator_open_blocked_count: i64 = 0
    hidden_env_open_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    controlled_benchmark_execution_inventory_present: i64 = 0
    controlled_benchmark_execution_shape_ready: i64 = 0
    blocked_execution_shape_present: i64 = 0
    missing_runner_blocked: i64 = 0
    workload_source_not_ready_blocked: i64 = 0
    measurement_source_not_ready_blocked: i64 = 0
    missing_output_contract_blocked: i64 = 0
    missing_evidence_storage_blocked: i64 = 0
    missing_representative_run_blocked: i64 = 0
    process_replacement_open_blocked: i64 = 0
    hook_open_blocked: i64 = 0
    backend_matcher_open_blocked: i64 = 0
    global_allocator_open_blocked: i64 = 0
    hidden_env_open_blocked: i64 = 0
    closed_seam_blocked: i64 = 0
    benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    controlled_benchmark_execution_planned: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_runner_blocked_count: i64 = 0
    workload_source_not_ready_blocked_count: i64 = 0
    measurement_source_not_ready_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_evidence_storage_blocked_count: i64 = 0
    missing_representative_run_blocked_count: i64 = 0
    process_replacement_open_blocked_count: i64 = 0
    hook_open_blocked_count: i64 = 0
    backend_matcher_open_blocked_count: i64 = 0
    global_allocator_open_blocked_count: i64 = 0
    hidden_env_open_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnostic {
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_runner_blocked_count: i64 = 0
    workload_source_not_ready_blocked_count: i64 = 0
    measurement_source_not_ready_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_evidence_storage_blocked_count: i64 = 0
    missing_representative_run_blocked_count: i64 = 0
    process_replacement_open_blocked_count: i64 = 0
    hook_open_blocked_count: i64 = 0
    backend_matcher_open_blocked_count: i64 = 0
    global_allocator_open_blocked_count: i64 = 0
    hidden_env_open_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport(fields: HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReportFields): HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport {
        local result = new HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport {
            accepted: fields.accepted,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            controlled_benchmark_execution_inventory_present: fields.controlled_benchmark_execution_inventory_present,
            controlled_benchmark_execution_shape_ready: fields.controlled_benchmark_execution_shape_ready,
            blocked_execution_shape_present: fields.blocked_execution_shape_present,
            missing_runner_blocked: fields.missing_runner_blocked,
            workload_source_not_ready_blocked: fields.workload_source_not_ready_blocked,
            measurement_source_not_ready_blocked: fields.measurement_source_not_ready_blocked,
            missing_output_contract_blocked: fields.missing_output_contract_blocked,
            missing_evidence_storage_blocked: fields.missing_evidence_storage_blocked,
            missing_representative_run_blocked: fields.missing_representative_run_blocked,
            process_replacement_open_blocked: fields.process_replacement_open_blocked,
            hook_open_blocked: fields.hook_open_blocked,
            backend_matcher_open_blocked: fields.backend_matcher_open_blocked,
            global_allocator_open_blocked: fields.global_allocator_open_blocked,
            hidden_env_open_blocked: fields.hidden_env_open_blocked,
            closed_seam_blocked: fields.closed_seam_blocked,
            benchmark_executed: 0,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            controlled_benchmark_execution_planned: fields.controlled_benchmark_execution_planned,
            diagnostic_count: fields.diagnostic_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            missing_runner_blocked_count: fields.missing_runner_blocked_count,
            workload_source_not_ready_blocked_count: fields.workload_source_not_ready_blocked_count,
            measurement_source_not_ready_blocked_count: fields.measurement_source_not_ready_blocked_count,
            missing_output_contract_blocked_count: fields.missing_output_contract_blocked_count,
            missing_evidence_storage_blocked_count: fields.missing_evidence_storage_blocked_count,
            missing_representative_run_blocked_count: fields.missing_representative_run_blocked_count,
            process_replacement_open_blocked_count: fields.process_replacement_open_blocked_count,
            hook_open_blocked_count: fields.hook_open_blocked_count,
            backend_matcher_open_blocked_count: fields.backend_matcher_open_blocked_count,
            global_allocator_open_blocked_count: fields.global_allocator_open_blocked_count,
            hidden_env_open_blocked_count: fields.hidden_env_open_blocked_count,
            closed_seam_blocked_count: fields.closed_seam_blocked_count,
            last_reason: fields.last_reason,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return result
    }

    markBlocked(reason: i64) {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_runner_blocked_count += 1
        }
        if reason == 2 {
            me.workload_source_not_ready_blocked_count += 1
        }
        if reason == 3 {
            me.measurement_source_not_ready_blocked_count += 1
        }
        if reason == 4 {
            me.missing_output_contract_blocked_count += 1
        }
        if reason == 5 {
            me.missing_evidence_storage_blocked_count += 1
        }
        if reason == 6 {
            me.missing_representative_run_blocked_count += 1
        }
        if reason == 7 {
            me.process_replacement_open_blocked_count += 1
        }
        if reason == 8 {
            me.hook_open_blocked_count += 1
        }
        if reason == 9 {
            me.backend_matcher_open_blocked_count += 1
        }
        if reason == 10 {
            me.global_allocator_open_blocked_count += 1
        }
        if reason == 11 {
            me.hidden_env_open_blocked_count += 1
        }
        if reason == 12 {
            me.closed_seam_blocked_count += 1
        }
    }

    reasonFrom(inventory: HakoAllocAllocatorComparisonControlledBenchmarkExecutionInventoryReport): i64 {
        if inventory.benchmark_executed != 0 {
            return 12
        }
        if inventory.process_replacement_executed != 0 {
            return 12
        }
        if inventory.hook_installed != 0 {
            return 12
        }
        if inventory.backend_matcher_added != 0 {
            return 12
        }
        if inventory.global_allocator_installed != 0 {
            return 12
        }
        if inventory.would_replace_host_allocator != 0 {
            return 12
        }
        if inventory.would_install_hook != 0 {
            return 12
        }
        if inventory.would_add_backend_matcher != 0 {
            return 12
        }
        if inventory.would_run_thread != 0 {
            return 12
        }
        if inventory.controlled_benchmark_execution_shape_ready == 1 {
            return 0
        }
        if inventory.reason != 0 {
            return inventory.reason
        }
        return 1
    }

    makeReport(reason: i64, inventory: HakoAllocAllocatorComparisonControlledBenchmarkExecutionInventoryReport): HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport {
        local blocked_execution_shape_present = 0
        if reason != 0 {
            blocked_execution_shape_present = 1
        }
        local missing_runner_blocked = 0
        local workload_source_not_ready_blocked = 0
        local measurement_source_not_ready_blocked = 0
        local missing_output_contract_blocked = 0
        local missing_evidence_storage_blocked = 0
        local missing_representative_run_blocked = 0
        local process_replacement_open_blocked = 0
        local hook_open_blocked = 0
        local backend_matcher_open_blocked = 0
        local global_allocator_open_blocked = 0
        local hidden_env_open_blocked = 0
        local closed_seam_blocked = 0
        if reason == 1 {
            missing_runner_blocked = 1
        }
        if reason == 2 {
            workload_source_not_ready_blocked = 1
        }
        if reason == 3 {
            measurement_source_not_ready_blocked = 1
        }
        if reason == 4 {
            missing_output_contract_blocked = 1
        }
        if reason == 5 {
            missing_evidence_storage_blocked = 1
        }
        if reason == 6 {
            missing_representative_run_blocked = 1
        }
        if reason == 7 {
            process_replacement_open_blocked = 1
        }
        if reason == 8 {
            hook_open_blocked = 1
        }
        if reason == 9 {
            backend_matcher_open_blocked = 1
        }
        if reason == 10 {
            global_allocator_open_blocked = 1
        }
        if reason == 11 {
            hidden_env_open_blocked = 1
        }
        if reason == 12 {
            closed_seam_blocked = 1
        }
        local fields = HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReportFields {}
        fields = fields with {
            accepted: 1,
            reason,
            diagnostic_present: 1,
            controlled_benchmark_execution_inventory_present: inventory.controlled_benchmark_execution_inventory_present,
            controlled_benchmark_execution_shape_ready: inventory.controlled_benchmark_execution_shape_ready,
            blocked_execution_shape_present,
            missing_runner_blocked,
            workload_source_not_ready_blocked,
            measurement_source_not_ready_blocked,
            missing_output_contract_blocked,
            missing_evidence_storage_blocked,
            missing_representative_run_blocked,
            process_replacement_open_blocked,
            hook_open_blocked,
            backend_matcher_open_blocked,
            global_allocator_open_blocked,
            hidden_env_open_blocked,
            closed_seam_blocked,
            controlled_benchmark_execution_planned: inventory.controlled_benchmark_execution_planned,
            diagnostic_count: me.diagnostic_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            missing_runner_blocked_count: me.missing_runner_blocked_count,
            workload_source_not_ready_blocked_count: me.workload_source_not_ready_blocked_count,
            measurement_source_not_ready_blocked_count: me.measurement_source_not_ready_blocked_count,
            missing_output_contract_blocked_count: me.missing_output_contract_blocked_count,
            missing_evidence_storage_blocked_count: me.missing_evidence_storage_blocked_count,
            missing_representative_run_blocked_count: me.missing_representative_run_blocked_count,
            process_replacement_open_blocked_count: me.process_replacement_open_blocked_count,
            hook_open_blocked_count: me.hook_open_blocked_count,
            backend_matcher_open_blocked_count: me.backend_matcher_open_blocked_count,
            global_allocator_open_blocked_count: me.global_allocator_open_blocked_count,
            hidden_env_open_blocked_count: me.hidden_env_open_blocked_count,
            closed_seam_blocked_count: me.closed_seam_blocked_count,
            last_reason: me.last_reason
        }
        return me.makeAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport(fields)
    }

    diagnoseAllocatorComparisonControlledBenchmarkExecution(inventory: HakoAllocAllocatorComparisonControlledBenchmarkExecutionInventoryReport): HakoAllocAllocatorComparisonControlledBenchmarkExecutionDiagnosticReport {
        me.diagnostic_count += 1
        local reason = me.reasonFrom(inventory)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, inventory)
    }
}

// page_meta_atomic_remote_head_push_vocabulary_box.hako -- AtomicRemoteHead vocabulary pilot
// Responsibility: prove that .hako hako_alloc can name the remote-free
// publication primitive without using ordinary remote_head FieldStore.
// This does not open CAS lowering, remote-owner routing, branch CFG lowering,
// TLS transfer, product allocator replacement, hooks, or winner claims.

static box HakoAllocPageMetaAtomicRemoteHeadPushVocabulary {
    atomicRemoteHeadPushVocabularyProbe(page_table, page_index, block) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local used = page.used
            mem.assumeRemoteOwner(page)
            mem.assumeRemoteFreeBlockNext(block)
            mem.atomicRemoteHeadPush(page, block)
            return used
        }
        return 0
    }
}

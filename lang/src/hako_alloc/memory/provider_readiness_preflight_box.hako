// provider_readiness_preflight_box.hako -- MIMAP-362A
// Responsibility:
// - preflight provider readiness from provider boundary diagnostic vocabulary
// - keep provider activation closed
// Non-responsibility:
// - provider selection, provider activation, host allocator replacement, hooks,
//   global allocator install, or backend matchers

using selfhost.hako_alloc.memory.provider_boundary_diagnostic_vocabulary_box as HakoAllocProviderBoundaryDiagnosticVocabularyBox

record HakoAllocProviderReadinessPreflightReportFields {
    accepted: i64
    reason: i64
    readiness_present: i64
    readiness_token: i64
    readiness_token_valid: i64
    vocabulary_present: i64
    vocabulary_accepted: i64
    vocabulary_reason: i64
    reason_count: i64
    provider_activation_inactive: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    preflight_count: i64
    accepted_count: i64
    reject_count: i64
    missing_vocabulary_reject_count: i64
    rejected_vocabulary_reject_count: i64
    invalid_vocabulary_reject_count: i64
    provider_inactive_reject_count: i64
    host_hook_backend_reject_count: i64
    closed_execution_reject_count: i64
    invalid_readiness_token_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderReadinessPreflightReport {
    accepted: i64 = 0
    reason: i64 = 0
    readiness_present: i64 = 0
    readiness_token: i64 = 0
    readiness_token_valid: i64 = 0
    vocabulary_present: i64 = 0
    vocabulary_accepted: i64 = 0
    vocabulary_reason: i64 = 0
    reason_count: i64 = 0
    provider_activation_inactive: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_vocabulary_reject_count: i64 = 0
    rejected_vocabulary_reject_count: i64 = 0
    invalid_vocabulary_reject_count: i64 = 0
    provider_inactive_reject_count: i64 = 0
    host_hook_backend_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    invalid_readiness_token_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderReadinessPreflight {
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_vocabulary_reject_count: i64 = 0
    rejected_vocabulary_reject_count: i64 = 0
    invalid_vocabulary_reject_count: i64 = 0
    provider_inactive_reject_count: i64 = 0
    host_hook_backend_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    invalid_readiness_token_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderReadinessPreflightReport(fields: HakoAllocProviderReadinessPreflightReportFields): HakoAllocProviderReadinessPreflightReport {
        local result = new HakoAllocProviderReadinessPreflightReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.readiness_present = fields.readiness_present
        result.readiness_token = fields.readiness_token
        result.readiness_token_valid = fields.readiness_token_valid
        result.vocabulary_present = fields.vocabulary_present
        result.vocabulary_accepted = fields.vocabulary_accepted
        result.vocabulary_reason = fields.vocabulary_reason
        result.reason_count = fields.reason_count
        result.provider_activation_inactive = fields.provider_activation_inactive
        result.host_replacement_inactive = fields.host_replacement_inactive
        result.hooks_inactive = fields.hooks_inactive
        result.backend_matcher_inactive = fields.backend_matcher_inactive
        result.preflight_count = fields.preflight_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_vocabulary_reject_count = fields.missing_vocabulary_reject_count
        result.rejected_vocabulary_reject_count = fields.rejected_vocabulary_reject_count
        result.invalid_vocabulary_reject_count = fields.invalid_vocabulary_reject_count
        result.provider_inactive_reject_count = fields.provider_inactive_reject_count
        result.host_hook_backend_reject_count = fields.host_hook_backend_reject_count
        result.closed_execution_reject_count = fields.closed_execution_reject_count
        result.invalid_readiness_token_reject_count = fields.invalid_readiness_token_reject_count
        result.last_reason = fields.last_reason
        result.would_activate_provider = fields.would_activate_provider
        result.would_replace_host_allocator = fields.would_replace_host_allocator
        result.would_install_hook = fields.would_install_hook
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        result.would_run_thread = fields.would_run_thread
        return result
    }

    makeReport(accepted, reason, vocab: HakoAllocProviderBoundaryDiagnosticVocabularyReport, readiness_token): HakoAllocProviderReadinessPreflightReport {
        local token_valid = 0
        if readiness_token > 0 {
            token_valid = 1
        }
        local fields = HakoAllocProviderReadinessPreflightReportFields {
            accepted: accepted,
            reason: reason,
            readiness_present: accepted,
            readiness_token: readiness_token,
            readiness_token_valid: token_valid,
            vocabulary_present: vocab.vocabulary_present,
            vocabulary_accepted: vocab.accepted,
            vocabulary_reason: vocab.reason,
            reason_count: vocab.reason_count,
            provider_activation_inactive: vocab.provider_activation_inactive,
            host_replacement_inactive: vocab.host_replacement_inactive,
            hooks_inactive: vocab.hooks_inactive,
            backend_matcher_inactive: vocab.backend_matcher_inactive,
            preflight_count: me.preflight_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_vocabulary_reject_count: me.missing_vocabulary_reject_count,
            rejected_vocabulary_reject_count: me.rejected_vocabulary_reject_count,
            invalid_vocabulary_reject_count: me.invalid_vocabulary_reject_count,
            provider_inactive_reject_count: me.provider_inactive_reject_count,
            host_hook_backend_reject_count: me.host_hook_backend_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            invalid_readiness_token_reject_count: me.invalid_readiness_token_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderReadinessPreflightReport(fields)
    }

    reject(reason, vocab: HakoAllocProviderBoundaryDiagnosticVocabularyReport, readiness_token): HakoAllocProviderReadinessPreflightReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_vocabulary_reject_count += 1
        }
        if reason == 2 {
            me.rejected_vocabulary_reject_count += 1
        }
        if reason == 3 {
            me.invalid_vocabulary_reject_count += 1
        }
        if reason == 4 {
            me.provider_inactive_reject_count += 1
        }
        if reason == 5 {
            me.host_hook_backend_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        if reason == 7 {
            me.invalid_readiness_token_reject_count += 1
        }
        return me.makeReport(0, reason, vocab, readiness_token)
    }

    preflightProviderReadiness(vocab: HakoAllocProviderBoundaryDiagnosticVocabularyReport, readiness_token): HakoAllocProviderReadinessPreflightReport {
        me.preflight_count += 1
        if vocab.vocabulary_present != 1 {
            return me.reject(1, vocab, readiness_token)
        }
        if vocab.accepted != 1 {
            return me.reject(2, vocab, readiness_token)
        }
        if vocab.reason_count != 8 {
            return me.reject(3, vocab, readiness_token)
        }
        if vocab.provider_activation_inactive != 1 {
            return me.reject(4, vocab, readiness_token)
        }
        if vocab.host_replacement_inactive != 1 {
            return me.reject(5, vocab, readiness_token)
        }
        if vocab.hooks_inactive != 1 {
            return me.reject(5, vocab, readiness_token)
        }
        if vocab.backend_matcher_inactive != 1 {
            return me.reject(5, vocab, readiness_token)
        }
        if vocab.would_activate_provider != 0 {
            return me.reject(6, vocab, readiness_token)
        }
        if vocab.would_replace_host_allocator != 0 {
            return me.reject(6, vocab, readiness_token)
        }
        if vocab.would_install_hook != 0 {
            return me.reject(6, vocab, readiness_token)
        }
        if vocab.would_add_backend_matcher != 0 {
            return me.reject(6, vocab, readiness_token)
        }
        if vocab.would_run_thread != 0 {
            return me.reject(6, vocab, readiness_token)
        }
        if readiness_token <= 0 {
            return me.reject(7, vocab, readiness_token)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, vocab, readiness_token)
    }
}

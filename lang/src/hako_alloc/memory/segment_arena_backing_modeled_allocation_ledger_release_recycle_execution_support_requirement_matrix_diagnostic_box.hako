box HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportRequirementMatrixDiagnostic {
    observed_count: i64 = 0
    accepted_matrix_count: i64 = 0
    rejected_matrix_count: i64 = 0
    unsatisfied_matrix_count: i64 = 0
    missing_inventory_reject_count: i64 = 0
    missing_report_reject_count: i64 = 0
    last_reason: i64 = 0

    makeExecutionSupportRequirementMatrixDiagnosticReport(fields: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportRequirementMatrixDiagnosticReportFields): HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportRequirementMatrixDiagnosticReport {
        local result = new HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportRequirementMatrixDiagnosticReport {
            observed: fields.observed,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            matrix_accepted: fields.matrix_accepted,
            matrix_reason: fields.matrix_reason,
            matrix_present: fields.matrix_present,
            requirements_satisfied: fields.requirements_satisfied,
            requirement_count: fields.requirement_count,
            unsatisfied_requirement_count: fields.unsatisfied_requirement_count,
            lifecycle_generation_required: fields.lifecycle_generation_required,
            pointer_residence_required: fields.pointer_residence_required,
            pointer_lookup_required: fields.pointer_lookup_required,
            arena_release_required: fields.arena_release_required,
            arena_recycle_required: fields.arena_recycle_required,
            segment_map_required: fields.segment_map_required,
            atomic_bitmap_required: fields.atomic_bitmap_required,
            osvm_required: fields.osvm_required,
            worker_tls_required: fields.worker_tls_required,
            provider_required: fields.provider_required,
            backend_matcher_required: fields.backend_matcher_required,
            matrix_count: fields.matrix_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            observed_count: fields.observed_count,
            accepted_matrix_count: fields.accepted_matrix_count,
            rejected_matrix_count: fields.rejected_matrix_count,
            unsatisfied_matrix_count: fields.unsatisfied_matrix_count,
            missing_inventory_reject_count: fields.missing_inventory_reject_count,
            missing_report_reject_count: fields.missing_report_reject_count,
            last_reason: fields.last_reason,

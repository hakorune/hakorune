// provider_call_dry_run_unsupported_behavior_box.hako -- MIMAP-384A
// Responsibility:
// - consume a provider-call capability gate inventory report
// - record unsupported provider-call dry-run outcome in model space
// Non-responsibility:
// - provider API calls, host allocator replacement, hooks, global allocator
//   install, backend matchers, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.provider_call_capability_gate_inventory_box as HakoAllocProviderCallCapabilityGateInventory

record HakoAllocProviderCallDryRunUnsupportedBehaviorReportFields {
    accepted: i64
    reason: i64
    dry_run_attempted: i64
    unsupported_outcome_present: i64
    gate_present: i64
    gate_accepted: i64
    gate_reason: i64
    provider_call_capability_present: i64
    provider_call_capability_valid: i64
    provider_call_unsupported: i64
    provider_call_inactive: i64
    provider_call_execution_closed: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    dry_run_count: i64
    accepted_count: i64
    reject_count: i64
    missing_gate_reject_count: i64
    rejected_gate_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
    accepted: i64 = 0
    reason: i64 = 0
    dry_run_attempted: i64 = 0
    unsupported_outcome_present: i64 = 0
    gate_present: i64 = 0
    gate_accepted: i64 = 0
    gate_reason: i64 = 0
    provider_call_capability_present: i64 = 0
    provider_call_capability_valid: i64 = 0
    provider_call_unsupported: i64 = 1
    provider_call_inactive: i64 = 1
    provider_call_execution_closed: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    dry_run_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_gate_reject_count: i64 = 0
    rejected_gate_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderCallDryRunUnsupportedBehavior {
    dry_run_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_gate_reject_count: i64 = 0
    rejected_gate_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderCallDryRunUnsupportedBehaviorReport(fields: HakoAllocProviderCallDryRunUnsupportedBehaviorReportFields): HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
        local result = new HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
            accepted: fields.accepted,
            reason: fields.reason,
            dry_run_attempted: fields.dry_run_attempted,
            unsupported_outcome_present: fields.unsupported_outcome_present,
            gate_present: fields.gate_present,
            gate_accepted: fields.gate_accepted,
            gate_reason: fields.gate_reason,
            provider_call_capability_present: fields.provider_call_capability_present,
            provider_call_capability_valid: fields.provider_call_capability_valid,
            provider_call_unsupported: fields.provider_call_unsupported,
            provider_call_inactive: fields.provider_call_inactive,
            provider_call_execution_closed: fields.provider_call_execution_closed,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            dry_run_count: fields.dry_run_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_gate_reject_count: fields.missing_gate_reject_count,
            rejected_gate_reject_count: fields.rejected_gate_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            last_reason: fields.last_reason,
            would_activate_provider: fields.would_activate_provider,
            would_call_provider: fields.would_call_provider,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, gate: HakoAllocProviderCallCapabilityGateInventoryReport): HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
        local attempted = accepted
        local outcome_present = accepted
        local fields = HakoAllocProviderCallDryRunUnsupportedBehaviorReportFields {
            accepted: accepted,
            reason: reason,
            dry_run_attempted: attempted,
            unsupported_outcome_present: outcome_present,
            gate_present: gate.gate_present,
            gate_accepted: gate.accepted,
            gate_reason: gate.reason,
            provider_call_capability_present: gate.provider_call_capability_present,
            provider_call_capability_valid: gate.provider_call_capability_valid,
            provider_call_unsupported: 1,
            provider_call_inactive: 1,
            provider_call_execution_closed: 1,
            host_replacement_inactive: gate.host_replacement_inactive,
            hooks_inactive: gate.hooks_inactive,
            backend_matcher_inactive: gate.backend_matcher_inactive,
            dry_run_count: me.dry_run_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_gate_reject_count: me.missing_gate_reject_count,
            rejected_gate_reject_count: me.rejected_gate_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: gate.would_activate_provider,
            would_call_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderCallDryRunUnsupportedBehaviorReport(fields)
    }

    reject(reason, gate: HakoAllocProviderCallCapabilityGateInventoryReport): HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_gate_reject_count += 1
        }
        if reason == 2 {
            me.rejected_gate_reject_count += 1
        }
        if reason == 3 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, gate)
    }

    dryRunProviderCallUnsupported(gate: HakoAllocProviderCallCapabilityGateInventoryReport): HakoAllocProviderCallDryRunUnsupportedBehaviorReport {
        me.dry_run_count += 1
        if gate.gate_present != 1 {
            return me.reject(1, gate)
        }
        if gate.accepted != 1 {
            return me.reject(2, gate)
        }
        if gate.provider_call_capability_present != 1 {
            return me.reject(2, gate)
        }
        if gate.provider_call_capability_valid != 1 {
            return me.reject(2, gate)
        }
        if gate.provider_call_execution_closed != 1 {
            return me.reject(3, gate)
        }
        if gate.provider_call_inactive != 1 {
            return me.reject(3, gate)
        }
        if gate.would_call_provider != 0 {
            return me.reject(3, gate)
        }
        if gate.would_replace_host_allocator != 0 {
            return me.reject(3, gate)
        }
        if gate.would_install_hook != 0 {
            return me.reject(3, gate)
        }
        if gate.would_add_backend_matcher != 0 {
            return me.reject(3, gate)
        }
        if gate.would_run_thread != 0 {
            return me.reject(3, gate)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, gate)
    }
}

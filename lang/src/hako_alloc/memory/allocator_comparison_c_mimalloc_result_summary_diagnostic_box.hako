    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnostic {
    diagnostic_count: usize = 0
    ready_count: usize = 0
    blocked_count: usize = 0
    missing_summary_blocked_count: usize = 0
    blocked_summary_blocked_count: usize = 0
    last_reason: i64 = 0

    makeAllocatorComparisonCMimallocResultSummaryDiagnosticReport(fields: HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReportFields): HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport {
        local result = new HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport {
            accepted: fields.accepted,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            summary_inventory_present: fields.summary_inventory_present,
            accepted_summary_present: fields.accepted_summary_present,
            blocked_summary_present: fields.blocked_summary_present,
            comparison_available: fields.comparison_available,
            hako_ready_execution_present: fields.hako_ready_execution_present,
            c_ready_evidence_present: fields.c_ready_evidence_present,
            memory_evidence_present: fields.memory_evidence_present,
            hako_allocation_count: fields.hako_allocation_count,
            hako_release_count: fields.hako_release_count,
            hako_reject_count: fields.hako_reject_count,
            hako_requested_bytes: fields.hako_requested_bytes,
            c_allocation_count: fields.c_allocation_count,
            c_free_count: fields.c_free_count,
            c_requested_bytes: fields.c_requested_bytes,
            c_peak_rss_bytes: fields.c_peak_rss_bytes,
            allocation_count_delta: fields.allocation_count_delta,
            requested_bytes_delta: fields.requested_bytes_delta,
            diagnostic_count: fields.diagnostic_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            missing_summary_blocked_count: fields.missing_summary_blocked_count,
            blocked_summary_blocked_count: fields.blocked_summary_blocked_count,
            last_reason: fields.last_reason,
            performance_conclusion_made: fields.performance_conclusion_made,
            memory_conclusion_made: fields.memory_conclusion_made,
            repeated_benchmark_executed: fields.repeated_benchmark_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            hidden_discovery_used: fields.hidden_discovery_used,
            provider_package_generated: fields.provider_package_generated,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markBlocked(reason: i64): void {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_summary_blocked_count += 1
        }
        if reason == 2 {
            me.blocked_summary_blocked_count += 1
        }
        return void
    }

    reasonFrom(report: HakoAllocAllocatorComparisonCMimallocResultSummaryInventoryReport): i64 {
        if report.summary_inventory_present != 1 {
            return 1
        }
        if report.accepted != 1 {
            return 2
        }
        if report.reason != 0 {
            return 2
        }
        if report.comparison_available != 1 {
            return 2
        }
        return 0
    }

    makeReport(reason: i64, report: HakoAllocAllocatorComparisonCMimallocResultSummaryInventoryReport): HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport {
        local accepted = 0
        local accepted_summary_present = 0
        local blocked_summary_present = 0
        if reason == 0 {
            accepted = 1
            accepted_summary_present = 1
        } else {
            blocked_summary_present = 1
        }
        local fields = HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReportFields {}
        fields = fields with {
            accepted,
            reason,
            diagnostic_present: 1,
            summary_inventory_present: report.summary_inventory_present,
            accepted_summary_present,
            blocked_summary_present,
            comparison_available: report.comparison_available,
            hako_ready_execution_present: report.hako_ready_execution_present,
            c_ready_evidence_present: report.c_ready_evidence_present,
            memory_evidence_present: report.memory_evidence_present,
            hako_allocation_count: report.hako_allocation_count,
            hako_release_count: report.hako_release_count,
            hako_reject_count: report.hako_reject_count,
            hako_requested_bytes: report.hako_requested_bytes,
            c_allocation_count: report.c_allocation_count,
            c_free_count: report.c_free_count,
            c_requested_bytes: report.c_requested_bytes,
            c_peak_rss_bytes: report.c_peak_rss_bytes,
            allocation_count_delta: report.allocation_count_delta,
            requested_bytes_delta: report.requested_bytes_delta,
            diagnostic_count: me.diagnostic_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            missing_summary_blocked_count: me.missing_summary_blocked_count,
            blocked_summary_blocked_count: me.blocked_summary_blocked_count,
            last_reason: me.last_reason,
            performance_conclusion_made: report.performance_conclusion_made,
            memory_conclusion_made: report.memory_conclusion_made,
            repeated_benchmark_executed: report.repeated_benchmark_executed,
            process_replacement_executed: report.process_replacement_executed,
            hook_installed: report.hook_installed,
            backend_matcher_added: report.backend_matcher_added,
            global_allocator_installed: report.global_allocator_installed,
            hidden_discovery_used: report.hidden_discovery_used,
            provider_package_generated: report.provider_package_generated,
            would_replace_host_allocator: report.would_replace_host_allocator,
            would_install_hook: report.would_install_hook,
            would_add_backend_matcher: report.would_add_backend_matcher,
            would_run_thread: report.would_run_thread
        }
        return me.makeAllocatorComparisonCMimallocResultSummaryDiagnosticReport(fields)
    }

    diagnoseAllocatorComparisonCMimallocResultSummary(report: HakoAllocAllocatorComparisonCMimallocResultSummaryInventoryReport): HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport {
        me.diagnostic_count += 1
        local reason = me.reasonFrom(report)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, report)
    }
}

// provider_call_real_api_execution_preflight_box.hako -- MIMAP-392A
// Responsibility:
// - consume a provider-call no-op execution seam report
// - inventory readiness for a future real provider API call
// Non-responsibility:
// - actual provider API calls, host allocator replacement, hooks, global
//   allocator install, backend matchers, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.provider_call_noop_execution_seam_pilot_box as HakoAllocProviderCallNoopExecutionSeamPilot

record HakoAllocProviderCallRealApiExecutionPreflightReportFields {
    accepted: i64
    reason: i64
    real_api_preflight_present: i64
    noop_seam_present: i64
    noop_seam_accepted: i64
    noop_seam_reason: i64
    provider_call_noop_execution_open: i64
    provider_call_noop_executed: i64
    provider_api_call_capability_present: i64
    provider_api_call_capability_valid: i64
    provider_api_call_ready: i64
    provider_api_call_executed: i64
    provider_call_execution_closed: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    preflight_count: i64
    accepted_count: i64
    reject_count: i64
    missing_noop_reject_count: i64
    rejected_noop_reject_count: i64
    missing_capability_reject_count: i64
    invalid_capability_reject_count: i64
    already_executed_reject_count: i64
    closed_execution_reject_count: i64
    closed_host_replacement_reject_count: i64
    closed_hook_reject_count: i64
    closed_backend_matcher_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_execute_provider_api: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderCallRealApiExecutionPreflightReport {
    accepted: i64 = 0
    reason: i64 = 0
    real_api_preflight_present: i64 = 0
    noop_seam_present: i64 = 0
    noop_seam_accepted: i64 = 0
    noop_seam_reason: i64 = 0
    provider_call_noop_execution_open: i64 = 0
    provider_call_noop_executed: i64 = 0
    provider_api_call_capability_present: i64 = 0
    provider_api_call_capability_valid: i64 = 0
    provider_api_call_ready: i64 = 0
    provider_api_call_executed: i64 = 0
    provider_call_execution_closed: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_noop_reject_count: i64 = 0
    rejected_noop_reject_count: i64 = 0
    missing_capability_reject_count: i64 = 0
    invalid_capability_reject_count: i64 = 0
    already_executed_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_execute_provider_api: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderCallRealApiExecutionPreflight {
    preflight_count: usize = 0
    accepted_count: usize = 0
    reject_count: usize = 0
    missing_noop_reject_count: usize = 0
    rejected_noop_reject_count: usize = 0
    missing_capability_reject_count: usize = 0
    invalid_capability_reject_count: usize = 0
    already_executed_reject_count: usize = 0
    closed_execution_reject_count: usize = 0
    closed_host_replacement_reject_count: usize = 0
    closed_hook_reject_count: usize = 0
    closed_backend_matcher_reject_count: usize = 0
    last_reason: i64 = 0

    makeProviderCallRealApiExecutionPreflightReport(fields: HakoAllocProviderCallRealApiExecutionPreflightReportFields): HakoAllocProviderCallRealApiExecutionPreflightReport {
        local result = new HakoAllocProviderCallRealApiExecutionPreflightReport {
            accepted: fields.accepted,
            reason: fields.reason,
            real_api_preflight_present: fields.real_api_preflight_present,
            noop_seam_present: fields.noop_seam_present,
            noop_seam_accepted: fields.noop_seam_accepted,
            noop_seam_reason: fields.noop_seam_reason,
            provider_call_noop_execution_open: fields.provider_call_noop_execution_open,
            provider_call_noop_executed: fields.provider_call_noop_executed,
            provider_api_call_capability_present: fields.provider_api_call_capability_present,
            provider_api_call_capability_valid: fields.provider_api_call_capability_valid,
            provider_api_call_ready: fields.provider_api_call_ready,
            provider_api_call_executed: fields.provider_api_call_executed,
            provider_call_execution_closed: fields.provider_call_execution_closed,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            preflight_count: fields.preflight_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_noop_reject_count: fields.missing_noop_reject_count,
            rejected_noop_reject_count: fields.rejected_noop_reject_count,
            missing_capability_reject_count: fields.missing_capability_reject_count,
            invalid_capability_reject_count: fields.invalid_capability_reject_count,
            already_executed_reject_count: fields.already_executed_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            closed_host_replacement_reject_count: fields.closed_host_replacement_reject_count,
            closed_hook_reject_count: fields.closed_hook_reject_count,
            closed_backend_matcher_reject_count: fields.closed_backend_matcher_reject_count,
            last_reason: fields.last_reason,
            would_activate_provider: fields.would_activate_provider,
            would_call_provider: fields.would_call_provider,
            would_execute_provider_api: fields.would_execute_provider_api,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, noop: HakoAllocProviderCallNoopExecutionSeamPilotReport, capability_present, capability_valid): HakoAllocProviderCallRealApiExecutionPreflightReport {
        local present = accepted
        local ready = accepted
        local would_api = accepted
        local fields = HakoAllocProviderCallRealApiExecutionPreflightReportFields {
            accepted: accepted,
            reason: reason,
            real_api_preflight_present: present,
            noop_seam_present: noop.noop_execution_seam_present,
            noop_seam_accepted: noop.accepted,
            noop_seam_reason: noop.reason,
            provider_call_noop_execution_open: noop.provider_call_noop_execution_open,
            provider_call_noop_executed: noop.provider_call_noop_executed,
            provider_api_call_capability_present: capability_present,
            provider_api_call_capability_valid: capability_valid,
            provider_api_call_ready: ready,
            provider_api_call_executed: 0,
            provider_call_execution_closed: noop.provider_call_execution_closed,
            host_replacement_inactive: noop.host_replacement_inactive,
            hooks_inactive: noop.hooks_inactive,
            backend_matcher_inactive: noop.backend_matcher_inactive,
            preflight_count: me.preflight_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_noop_reject_count: me.missing_noop_reject_count,
            rejected_noop_reject_count: me.rejected_noop_reject_count,
            missing_capability_reject_count: me.missing_capability_reject_count,
            invalid_capability_reject_count: me.invalid_capability_reject_count,
            already_executed_reject_count: me.already_executed_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            closed_host_replacement_reject_count: me.closed_host_replacement_reject_count,
            closed_hook_reject_count: me.closed_hook_reject_count,
            closed_backend_matcher_reject_count: me.closed_backend_matcher_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: noop.would_activate_provider,
            would_call_provider: noop.would_call_provider,
            would_execute_provider_api: would_api,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderCallRealApiExecutionPreflightReport(fields)
    }

    reject(reason, noop: HakoAllocProviderCallNoopExecutionSeamPilotReport, capability_present, capability_valid): HakoAllocProviderCallRealApiExecutionPreflightReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_noop_reject_count += 1
        }
        if reason == 2 {
            me.rejected_noop_reject_count += 1
        }
        if reason == 3 {
            me.missing_capability_reject_count += 1
        }
        if reason == 4 {
            me.invalid_capability_reject_count += 1
        }
        if reason == 5 {
            me.already_executed_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        if reason == 7 {
            me.closed_host_replacement_reject_count += 1
        }
        if reason == 8 {
            me.closed_hook_reject_count += 1
        }
        if reason == 9 {
            me.closed_backend_matcher_reject_count += 1
        }
        return me.makeReport(0, reason, noop, capability_present, capability_valid)
    }

    preflightProviderCallRealApiExecution(noop: HakoAllocProviderCallNoopExecutionSeamPilotReport, capability_present, capability_valid): HakoAllocProviderCallRealApiExecutionPreflightReport {
        me.preflight_count += 1
        if noop.noop_execution_seam_present != 1 {
            return me.reject(1, noop, capability_present, capability_valid)
        }
        if noop.accepted != 1 {
            return me.reject(2, noop, capability_present, capability_valid)
        }
        if capability_present != 1 {
            return me.reject(3, noop, capability_present, capability_valid)
        }
        if capability_valid != 1 {
            return me.reject(4, noop, capability_present, capability_valid)
        }
        if noop.provider_api_call_executed != 0 {
            return me.reject(5, noop, capability_present, capability_valid)
        }
        if noop.provider_call_execution_closed != 1 {
            return me.reject(6, noop, capability_present, capability_valid)
        }
        if noop.provider_call_noop_execution_open != 1 {
            return me.reject(6, noop, capability_present, capability_valid)
        }
        if noop.provider_call_noop_executed != 1 {
            return me.reject(6, noop, capability_present, capability_valid)
        }
        if noop.would_call_provider != 1 {
            return me.reject(6, noop, capability_present, capability_valid)
        }
        if noop.would_replace_host_allocator != 0 {
            return me.reject(7, noop, capability_present, capability_valid)
        }
        if noop.would_install_hook != 0 {
            return me.reject(8, noop, capability_present, capability_valid)
        }
        if noop.would_add_backend_matcher != 0 {
            return me.reject(9, noop, capability_present, capability_valid)
        }
        if noop.would_run_thread != 0 {
            return me.reject(9, noop, capability_present, capability_valid)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, noop, capability_present, capability_valid)
    }
}

// osvm_page_source_pilot_box.hako -- MIMAP-349A
// Responsibility:
// - record a bounded OSVM/page-source fact from an accepted atomic bitmap fact
// - keep providers, host allocator replacement, and hooks closed
// Non-responsibility:
// - provider activation, host allocator replacement, hooks, worker/TLS, or
//   backend matchers

record HakoAllocOSVMPageSourcePilotReportFields {
    accepted: i64
    reason: i64
    page_source_present: i64
    bitmap_present: i64
    bitmap_accepted: i64
    bitmap_reason: i64
    page_source_token: i64
    page_source_token_valid: i64
    bitmap_token: i64
    bitmap_token_valid: i64
    mutation_token: i64
    lookup_result_token: i64
    arena_handle_token: i64
    private_pointer_token: i64
    non_dereferenceable: i64
    closed_execution_blocker_count: i64
    page_source_count: i64
    accepted_count: i64
    reject_count: i64
    missing_bitmap_reject_count: i64
    rejected_bitmap_reject_count: i64
    dereference_request_reject_count: i64
    invalid_bitmap_reject_count: i64
    invalid_page_source_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    report_segment_id: i64
    report_arena_id: i64
    report_lifetime_generation: i64
    report_release_applied_recycle_token: i64
    report_continuation_token: i64
    report_application_token: i64
    report_applied_backing_bytes: usize
    report_applied_committed_bytes: usize
    report_remaining_source_bytes: usize
    would_dereference: i64
    would_release_arena_backing: i64
    would_recycle_arena_backing: i64
    would_mutate_segment_map: i64
    would_execute_atomic_bitmap: i64
    would_call_osvm: i64
    would_run_thread: i64
    would_activate_provider: i64
    would_add_backend_matcher: i64
}

box HakoAllocOSVMPageSourcePilotReport {
    accepted: i64 = 0
    reason: i64 = 0
    page_source_present: i64 = 0
    bitmap_present: i64 = 0
    bitmap_accepted: i64 = 0
    bitmap_reason: i64 = 0
    page_source_token: i64 = 0
    page_source_token_valid: i64 = 0
    bitmap_token: i64 = 0
    bitmap_token_valid: i64 = 0
    mutation_token: i64 = 0
    lookup_result_token: i64 = 0
    arena_handle_token: i64 = 0
    private_pointer_token: i64 = 0
    non_dereferenceable: i64 = 1
    closed_execution_blocker_count: i64 = 0
    page_source_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_bitmap_reject_count: i64 = 0
    rejected_bitmap_reject_count: i64 = 0
    dereference_request_reject_count: i64 = 0
    invalid_bitmap_reject_count: i64 = 0
    invalid_page_source_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    report_segment_id: i64 = -1
    report_arena_id: i64 = -1
    report_lifetime_generation: i64 = 0
    report_release_applied_recycle_token: i64 = 0
    report_continuation_token: i64 = 0
    report_application_token: i64 = 0
    report_applied_backing_bytes: usize = 0
    report_applied_committed_bytes: usize = 0
    report_remaining_source_bytes: usize = 0
    would_dereference: i64 = 0
    would_release_arena_backing: i64 = 0
    would_recycle_arena_backing: i64 = 0
    would_mutate_segment_map: i64 = 0
    would_execute_atomic_bitmap: i64 = 0
    would_call_osvm: i64 = 0
    would_run_thread: i64 = 0
    would_activate_provider: i64 = 0
    would_add_backend_matcher: i64 = 0
}

box HakoAllocOSVMPageSourcePilot {
    page_source_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_bitmap_reject_count: i64 = 0
    rejected_bitmap_reject_count: i64 = 0
    dereference_request_reject_count: i64 = 0
    invalid_bitmap_reject_count: i64 = 0
    invalid_page_source_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    closedExecutionBlockerCount(bitmap_report): i64 {
        local count = 0
        if bitmap_report.would_release_arena_backing != 0 {
            count += 1
        }
        if bitmap_report.would_recycle_arena_backing != 0 {
            count += 1
        }
        if bitmap_report.would_run_thread != 0 {
            count += 1
        }
        if bitmap_report.would_activate_provider != 0 {
            count += 1
        }
        if bitmap_report.would_add_backend_matcher != 0 {
            count += 1
        }
        return count
    }

    makeOSVMPageSourcePilotReport(fields: HakoAllocOSVMPageSourcePilotReportFields): HakoAllocOSVMPageSourcePilotReport {
        local result = new HakoAllocOSVMPageSourcePilotReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.page_source_present = fields.page_source_present
        result.bitmap_present = fields.bitmap_present
        result.bitmap_accepted = fields.bitmap_accepted
        result.bitmap_reason = fields.bitmap_reason
        result.page_source_token = fields.page_source_token
        result.page_source_token_valid = fields.page_source_token_valid
        result.bitmap_token = fields.bitmap_token
        result.bitmap_token_valid = fields.bitmap_token_valid
        result.mutation_token = fields.mutation_token
        result.lookup_result_token = fields.lookup_result_token
        result.arena_handle_token = fields.arena_handle_token
        result.private_pointer_token = fields.private_pointer_token
        result.non_dereferenceable = fields.non_dereferenceable
        result.closed_execution_blocker_count = fields.closed_execution_blocker_count
        result.page_source_count = fields.page_source_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_bitmap_reject_count = fields.missing_bitmap_reject_count
        result.rejected_bitmap_reject_count = fields.rejected_bitmap_reject_count
        result.dereference_request_reject_count = fields.dereference_request_reject_count
        result.invalid_bitmap_reject_count = fields.invalid_bitmap_reject_count
        result.invalid_page_source_reject_count = fields.invalid_page_source_reject_count
        result.closed_execution_reject_count = fields.closed_execution_reject_count
        result.last_reason = fields.last_reason
        result.report_segment_id = fields.report_segment_id
        result.report_arena_id = fields.report_arena_id
        result.report_lifetime_generation = fields.report_lifetime_generation
        result.report_release_applied_recycle_token = fields.report_release_applied_recycle_token
        result.report_continuation_token = fields.report_continuation_token
        result.report_application_token = fields.report_application_token
        result.report_applied_backing_bytes = fields.report_applied_backing_bytes
        result.report_applied_committed_bytes = fields.report_applied_committed_bytes
        result.report_remaining_source_bytes = fields.report_remaining_source_bytes
        result.would_dereference = fields.would_dereference
        result.would_release_arena_backing = fields.would_release_arena_backing
        result.would_recycle_arena_backing = fields.would_recycle_arena_backing
        result.would_mutate_segment_map = fields.would_mutate_segment_map
        result.would_execute_atomic_bitmap = fields.would_execute_atomic_bitmap
        result.would_call_osvm = fields.would_call_osvm
        result.would_run_thread = fields.would_run_thread
        result.would_activate_provider = fields.would_activate_provider
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        return result
    }

    makeReport(accepted, reason, page_source_present, bitmap_report, page_source_token): HakoAllocOSVMPageSourcePilotReport {
        local page_source_token_valid = 0
        if page_source_token > 0 {
            page_source_token_valid = 1
        }
        local fields = HakoAllocOSVMPageSourcePilotReportFields {
            accepted: accepted,
            reason: reason,
            page_source_present: page_source_present,
            bitmap_present: bitmap_report.bitmap_present,
            bitmap_accepted: bitmap_report.accepted,
            bitmap_reason: bitmap_report.reason,
            page_source_token: page_source_token,
            page_source_token_valid: page_source_token_valid,
            bitmap_token: bitmap_report.bitmap_token,
            bitmap_token_valid: bitmap_report.bitmap_token_valid,
            mutation_token: bitmap_report.mutation_token,
            lookup_result_token: bitmap_report.lookup_result_token,
            arena_handle_token: bitmap_report.arena_handle_token,
            private_pointer_token: bitmap_report.private_pointer_token,
            non_dereferenceable: bitmap_report.non_dereferenceable,
            closed_execution_blocker_count: me.closedExecutionBlockerCount(bitmap_report),
            page_source_count: me.page_source_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_bitmap_reject_count: me.missing_bitmap_reject_count,
            rejected_bitmap_reject_count: me.rejected_bitmap_reject_count,
            dereference_request_reject_count: me.dereference_request_reject_count,
            invalid_bitmap_reject_count: me.invalid_bitmap_reject_count,
            invalid_page_source_reject_count: me.invalid_page_source_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            report_segment_id: bitmap_report.report_segment_id,
            report_arena_id: bitmap_report.report_arena_id,
            report_lifetime_generation: bitmap_report.report_lifetime_generation,
            report_release_applied_recycle_token: bitmap_report.report_release_applied_recycle_token,
            report_continuation_token: bitmap_report.report_continuation_token,
            report_application_token: bitmap_report.report_application_token,
            report_applied_backing_bytes: bitmap_report.report_applied_backing_bytes,
            report_applied_committed_bytes: bitmap_report.report_applied_committed_bytes,
            report_remaining_source_bytes: bitmap_report.report_remaining_source_bytes,
            would_dereference: 0,
            would_release_arena_backing: bitmap_report.would_release_arena_backing,
            would_recycle_arena_backing: bitmap_report.would_recycle_arena_backing,
            would_mutate_segment_map: bitmap_report.would_mutate_segment_map,
            would_execute_atomic_bitmap: bitmap_report.would_execute_atomic_bitmap,
            would_call_osvm: page_source_present,
            would_run_thread: bitmap_report.would_run_thread,
            would_activate_provider: bitmap_report.would_activate_provider,
            would_add_backend_matcher: bitmap_report.would_add_backend_matcher
        }
        return me.makeOSVMPageSourcePilotReport(fields)
    }

    reject(reason, bitmap_report, page_source_token): HakoAllocOSVMPageSourcePilotReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_bitmap_reject_count += 1
        }
        if reason == 2 {
            me.rejected_bitmap_reject_count += 1
        }
        if reason == 3 {
            me.dereference_request_reject_count += 1
        }
        if reason == 4 {
            me.invalid_bitmap_reject_count += 1
        }
        if reason == 5 {
            me.invalid_page_source_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, 0, bitmap_report, page_source_token)
    }

    recordOSVMPageSourceFact(bitmap_report, page_source_token): HakoAllocOSVMPageSourcePilotReport {
        me.page_source_count += 1
        if bitmap_report.bitmap_present != 1 {
            return me.reject(1, bitmap_report, page_source_token)
        }
        if bitmap_report.accepted != 1 {
            return me.reject(2, bitmap_report, page_source_token)
        }
        if bitmap_report.non_dereferenceable != 1 {
            return me.reject(3, bitmap_report, page_source_token)
        }
        if bitmap_report.would_dereference != 0 {
            return me.reject(3, bitmap_report, page_source_token)
        }
        if bitmap_report.bitmap_token <= 0 {
            return me.reject(4, bitmap_report, page_source_token)
        }
        if bitmap_report.bitmap_token_valid != 1 {
            return me.reject(4, bitmap_report, page_source_token)
        }
        if page_source_token <= 0 {
            return me.reject(5, bitmap_report, page_source_token)
        }
        if me.closedExecutionBlockerCount(bitmap_report) != 0 {
            return me.reject(6, bitmap_report, page_source_token)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, bitmap_report, page_source_token)
    }
}

            report_applied_backing_bytes: fields.report_applied_backing_bytes,
            report_applied_committed_bytes: fields.report_applied_committed_bytes,
            report_remaining_source_bytes: fields.report_remaining_source_bytes,
            would_create_lifecycle_generation: fields.would_create_lifecycle_generation,
            would_create_pointer_residence: fields.would_create_pointer_residence,
            would_lookup_by_pointer: fields.would_lookup_by_pointer,
            would_release_arena_backing: fields.would_release_arena_backing,
            would_recycle_arena_backing: fields.would_recycle_arena_backing,
            would_use_segment_map: fields.would_use_segment_map,
            would_execute_atomic_bitmap: fields.would_execute_atomic_bitmap,
            would_call_osvm: fields.would_call_osvm,
            would_run_thread: fields.would_run_thread,
            would_activate_provider: fields.would_activate_provider,
            would_add_backend_matcher: fields.would_add_backend_matcher
        }
        return result
    }

    makeReport(accepted, reason, ledger_present, matrix_report): HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReport {
        local fields = HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReportFields {
            accepted: accepted,
            reason: reason,
            ledger_present: ledger_present,
            matrix_present: matrix_report.matrix_present,
            matrix_accepted: matrix_report.accepted,
            matrix_reason: matrix_report.reason,
            remaining_requirement_count: 8,
            remaining_supported_count: 0,
            remaining_unsupported_count: 8,
            arena_release_required: matrix_report.arena_release_required,
            arena_release_supported: 0,
            arena_recycle_required: matrix_report.arena_recycle_required,
            arena_recycle_supported: 0,
            segment_map_required: matrix_report.segment_map_required,
            segment_map_supported: 0,
            atomic_bitmap_required: matrix_report.atomic_bitmap_required,
            atomic_bitmap_supported: 0,
            osvm_required: matrix_report.osvm_required,
            osvm_supported: 0,
            worker_tls_required: matrix_report.worker_tls_required,
            worker_tls_supported: 0,
            provider_required: matrix_report.provider_required,
            provider_supported: 0,
            backend_matcher_required: matrix_report.backend_matcher_required,
            backend_matcher_supported: 0,
            ledger_count: me.ledger_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_matrix_reject_count: me.missing_matrix_reject_count,
            rejected_matrix_reject_count: me.rejected_matrix_reject_count,
            execution_open_reject_count: me.execution_open_reject_count,
            last_reason: me.last_reason,
            report_segment_id: matrix_report.report_segment_id,
            report_arena_id: matrix_report.report_arena_id,
            report_lifetime_generation: matrix_report.report_lifetime_generation,
            report_release_applied_recycle_token: matrix_report.report_release_applied_recycle_token,
            report_continuation_token: matrix_report.report_continuation_token,
            report_application_token: matrix_report.report_application_token,
            report_applied_backing_bytes: matrix_report.report_applied_backing_bytes,
            report_applied_committed_bytes: matrix_report.report_applied_committed_bytes,
            report_remaining_source_bytes: matrix_report.report_remaining_source_bytes,
            would_create_lifecycle_generation: matrix_report.would_create_lifecycle_generation,
            would_create_pointer_residence: matrix_report.would_create_pointer_residence,
            would_lookup_by_pointer: matrix_report.would_lookup_by_pointer,
            would_release_arena_backing: matrix_report.would_release_arena_backing,
            would_recycle_arena_backing: matrix_report.would_recycle_arena_backing,
            would_use_segment_map: matrix_report.would_use_segment_map,
            would_execute_atomic_bitmap: matrix_report.would_execute_atomic_bitmap,
            would_call_osvm: matrix_report.would_call_osvm,
            would_run_thread: matrix_report.would_run_thread,
            would_activate_provider: matrix_report.would_activate_provider,
            would_add_backend_matcher: matrix_report.would_add_backend_matcher
        }
        return me.makeRemainingExecutionPrerequisiteLedgerReport(fields)
    }

    reject(reason, matrix_report): HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_matrix_reject_count += 1
        }
        if reason == 2 {
            me.rejected_matrix_reject_count += 1
        }
        if reason == 3 {
            me.execution_open_reject_count += 1
        }
        return me.makeReport(0, reason, 0, matrix_report)
    }

    recordRemainingExecutionPrerequisiteLedger(matrix_report): HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReport {
        me.ledger_count += 1
        if matrix_report.matrix_present != 1 {
            return me.reject(1, matrix_report)
        }
        if matrix_report.accepted != 1 {
            return me.reject(2, matrix_report)
        }
        if matrix_report.would_release_arena_backing != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_recycle_arena_backing != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_use_segment_map != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_execute_atomic_bitmap != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_call_osvm != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_run_thread != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_activate_provider != 0 {
            return me.reject(3, matrix_report)
        }
        if matrix_report.would_add_backend_matcher != 0 {
            return me.reject(3, matrix_report)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, matrix_report)
    }
}

box HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedger {
    ledger_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_matrix_reject_count: i64 = 0
    rejected_matrix_reject_count: i64 = 0
    execution_open_reject_count: i64 = 0
    last_reason: i64 = 0

    makeRemainingExecutionPrerequisiteLedgerReport(fields: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReportFields): HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReport {
        local result = new HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleRemainingExecutionPrerequisiteLedgerReport {
            accepted: fields.accepted,
            reason: fields.reason,
            ledger_present: fields.ledger_present,
            matrix_present: fields.matrix_present,
            matrix_accepted: fields.matrix_accepted,
            matrix_reason: fields.matrix_reason,
            remaining_requirement_count: fields.remaining_requirement_count,
            remaining_supported_count: fields.remaining_supported_count,
            remaining_unsupported_count: fields.remaining_unsupported_count,
            arena_release_required: fields.arena_release_required,
            arena_release_supported: fields.arena_release_supported,

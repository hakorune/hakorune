// allocator_comparison_c_mimalloc_execution_inventory_box.hako -- MIMAP-448A
// Responsibility:
// - inventory explicit C mimalloc comparison execution inputs
// - keep C mimalloc execution and process replacement closed
// Non-responsibility:
// - running C mimalloc, replacing the process allocator, installing hooks,
//   adding backend matchers, or installing a global allocator

record HakoAllocAllocatorComparisonCMimallocExecutionInventoryReportFields {
    accepted: i64
    reason: i64
    c_mimalloc_execution_inventory_present: i64
    c_mimalloc_execution_ready: i64
    c_mimalloc_runner_present: i64
    representative_workload_contract_present: i64
    hako_representative_metrics_present: i64
    output_contract_present: i64
    memory_usage_contract_present: i64
    evidence_storage_present: i64
    run_count_present: i64
    run_count: i64
    inventory_count: i64
    accepted_count: i64
    reject_count: i64
    missing_runner_reject_count: i64
    missing_workload_reject_count: i64
    missing_hako_metrics_reject_count: i64
    missing_output_contract_reject_count: i64
    missing_memory_usage_contract_reject_count: i64
    missing_evidence_storage_reject_count: i64
    missing_run_count_reject_count: i64
    invalid_run_count_reject_count: i64
    last_reason: i64
    c_mimalloc_executed: i64
    process_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocAllocatorComparisonCMimallocExecutionInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    c_mimalloc_execution_inventory_present: i64 = 0
    c_mimalloc_execution_ready: i64 = 0
    c_mimalloc_runner_present: i64 = 0
    representative_workload_contract_present: i64 = 0
    hako_representative_metrics_present: i64 = 0
    output_contract_present: i64 = 0
    memory_usage_contract_present: i64 = 0
    evidence_storage_present: i64 = 0
    run_count_present: i64 = 0
    run_count: i64 = 0
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_runner_reject_count: i64 = 0
    missing_workload_reject_count: i64 = 0
    missing_hako_metrics_reject_count: i64 = 0
    missing_output_contract_reject_count: i64 = 0
    missing_memory_usage_contract_reject_count: i64 = 0
    missing_evidence_storage_reject_count: i64 = 0
    missing_run_count_reject_count: i64 = 0
    invalid_run_count_reject_count: i64 = 0
    last_reason: i64 = 0
    c_mimalloc_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonCMimallocExecutionInventory {
    inventory_count: usize = 0
    accepted_count: usize = 0
    reject_count: usize = 0
    missing_runner_reject_count: usize = 0
    missing_workload_reject_count: usize = 0
    missing_hako_metrics_reject_count: usize = 0
    missing_output_contract_reject_count: usize = 0
    missing_memory_usage_contract_reject_count: usize = 0
    missing_evidence_storage_reject_count: usize = 0
    missing_run_count_reject_count: usize = 0
    invalid_run_count_reject_count: usize = 0
    last_reason: i64 = 0

    makeAllocatorComparisonCMimallocExecutionInventoryReport(fields: HakoAllocAllocatorComparisonCMimallocExecutionInventoryReportFields): HakoAllocAllocatorComparisonCMimallocExecutionInventoryReport {
        local result = new HakoAllocAllocatorComparisonCMimallocExecutionInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            c_mimalloc_execution_inventory_present: fields.c_mimalloc_execution_inventory_present,
            c_mimalloc_execution_ready: fields.c_mimalloc_execution_ready,
            c_mimalloc_runner_present: fields.c_mimalloc_runner_present,
            representative_workload_contract_present: fields.representative_workload_contract_present,
            hako_representative_metrics_present: fields.hako_representative_metrics_present,
            output_contract_present: fields.output_contract_present,
            memory_usage_contract_present: fields.memory_usage_contract_present,
            evidence_storage_present: fields.evidence_storage_present,
            run_count_present: fields.run_count_present,
            run_count: fields.run_count,
            inventory_count: fields.inventory_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_runner_reject_count: fields.missing_runner_reject_count,
            missing_workload_reject_count: fields.missing_workload_reject_count,
            missing_hako_metrics_reject_count: fields.missing_hako_metrics_reject_count,
            missing_output_contract_reject_count: fields.missing_output_contract_reject_count,
            missing_memory_usage_contract_reject_count: fields.missing_memory_usage_contract_reject_count,
            missing_evidence_storage_reject_count: fields.missing_evidence_storage_reject_count,
            missing_run_count_reject_count: fields.missing_run_count_reject_count,
            invalid_run_count_reject_count: fields.invalid_run_count_reject_count,
            last_reason: fields.last_reason,
            c_mimalloc_executed: fields.c_mimalloc_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markReject(reason: i64) {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_runner_reject_count += 1
        }
        if reason == 2 {
            me.missing_workload_reject_count += 1
        }
        if reason == 3 {
            me.missing_hako_metrics_reject_count += 1
        }
        if reason == 4 {
            me.missing_output_contract_reject_count += 1
        }
        if reason == 5 {
            me.missing_memory_usage_contract_reject_count += 1
        }
        if reason == 6 {
            me.missing_evidence_storage_reject_count += 1
        }
        if reason == 7 {
            me.missing_run_count_reject_count += 1
        }
        if reason == 8 {
            me.invalid_run_count_reject_count += 1
        }
    }

    makeReport(
        accepted: i64,
        reason: i64,
        c_mimalloc_runner_present: i64,
        representative_workload_contract_present: i64,
        hako_representative_metrics_present: i64,
        output_contract_present: i64,
        memory_usage_contract_present: i64,
        evidence_storage_present: i64,
        run_count_present: i64,
        run_count: i64
    ): HakoAllocAllocatorComparisonCMimallocExecutionInventoryReport {
        local ready = 0
        if accepted == 1 {
            ready = 1
        }
        local fields = HakoAllocAllocatorComparisonCMimallocExecutionInventoryReportFields {
            accepted: accepted,
            reason: reason,
            c_mimalloc_execution_inventory_present: 1,
            c_mimalloc_execution_ready: ready,
            c_mimalloc_runner_present: c_mimalloc_runner_present,
            representative_workload_contract_present: representative_workload_contract_present,
            hako_representative_metrics_present: hako_representative_metrics_present,
            output_contract_present: output_contract_present,
            memory_usage_contract_present: memory_usage_contract_present,
            evidence_storage_present: evidence_storage_present,
            run_count_present: run_count_present,
            run_count: run_count,
            inventory_count: me.inventory_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_runner_reject_count: me.missing_runner_reject_count,
            missing_workload_reject_count: me.missing_workload_reject_count,
            missing_hako_metrics_reject_count: me.missing_hako_metrics_reject_count,
            missing_output_contract_reject_count: me.missing_output_contract_reject_count,
            missing_memory_usage_contract_reject_count: me.missing_memory_usage_contract_reject_count,
            missing_evidence_storage_reject_count: me.missing_evidence_storage_reject_count,
            missing_run_count_reject_count: me.missing_run_count_reject_count,
            invalid_run_count_reject_count: me.invalid_run_count_reject_count,
            last_reason: me.last_reason,
            c_mimalloc_executed: 0,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeAllocatorComparisonCMimallocExecutionInventoryReport(fields)
    }

    reject(
        reason: i64,
        c_mimalloc_runner_present: i64,
        representative_workload_contract_present: i64,
        hako_representative_metrics_present: i64,
        output_contract_present: i64,
        memory_usage_contract_present: i64,
        evidence_storage_present: i64,
        run_count_present: i64,
        run_count: i64
    ): HakoAllocAllocatorComparisonCMimallocExecutionInventoryReport {
        me.markReject(reason)
        return me.makeReport(0, reason, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
    }

    inventoryAllocatorComparisonCMimallocExecution(
        c_mimalloc_runner_present: i64,
        representative_workload_contract_present: i64,
        hako_representative_metrics_present: i64,
        output_contract_present: i64,
        memory_usage_contract_present: i64,
        evidence_storage_present: i64,
        run_count_present: i64,
        run_count: i64
    ): HakoAllocAllocatorComparisonCMimallocExecutionInventoryReport {
        me.inventory_count += 1
        if c_mimalloc_runner_present != 1 {
            return me.reject(1, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if representative_workload_contract_present != 1 {
            return me.reject(2, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if hako_representative_metrics_present != 1 {
            return me.reject(3, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if output_contract_present != 1 {
            return me.reject(4, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if memory_usage_contract_present != 1 {
            return me.reject(5, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if evidence_storage_present != 1 {
            return me.reject(6, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if run_count_present != 1 {
            return me.reject(7, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        if run_count < 1 {
            return me.reject(8, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
        }
        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, c_mimalloc_runner_present, representative_workload_contract_present, hako_representative_metrics_present, output_contract_present, memory_usage_contract_present, evidence_storage_present, run_count_present, run_count)
    }
}

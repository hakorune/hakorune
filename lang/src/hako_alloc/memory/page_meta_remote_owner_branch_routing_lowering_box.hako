// page_meta_remote_owner_branch_routing_lowering_box.hako
// MIM-PORT-FMEM-049: narrow producer pilot for remote-owner routing evidence.
//
// This proves that one .hako fastmem region can lower the owner equality
// predicate and the already-open owner-side remote drain/local-list mutation
// evidence together. It does not open source branch CFG lowering, full
// same/remote free bodies, TLS transfer, allocator activation, hooks, or
// winner claims.

static box HakoAllocPageMetaRemoteOwnerBranchRoutingLowering {
    remoteOwnerBranchRoutingLoweringProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local owner_worker_id = page.owner_worker_id
            local current_owner_id = mem.currentAllocOwnerId()
            local same_owner = mem.ownerEq(owner_worker_id, current_owner_id)
            local drained = mem.atomicRemoteHeadDrain(page)
            local drain_marker = mem.drainRemoteListToLocal(page, drained)
            page.used = same_owner
            return owner_worker_id
        }
        return 0
    }
}

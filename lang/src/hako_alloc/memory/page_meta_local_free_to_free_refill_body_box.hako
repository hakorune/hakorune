// page_meta_local_free_to_free_refill_body_box.hako -- single-block refill pilot
// Responsibility: prove that .hako hako_alloc can compose LocalFreePop and
// FreeHeadPush to move one block from PageMeta.local_free_head to
// PageMeta.free_head. This does not open multi-block transfer policy, counters,
// remote-owner routing, AtomicRemoteHead, TLS transfer, product allocator
// replacement, hooks, or winner claims.

static box HakoAllocPageMetaLocalFreeToFreeRefillBody {
    localFreeToFreeRefillBodyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local current = mem.currentAllocOwnerId()
            local same = mem.ownerEq(page.owner_worker_id, current)
            mem.assumeSameOwner(page, same)
            mem.assumeLocalFreeNonEmpty(page)

            local block = mem.localFreePop(page)
            mem.assumeFreeHeadBlockNext(block)
            local push_marker = mem.freeHeadPush(page, block)
        }

        return 0
    }
}

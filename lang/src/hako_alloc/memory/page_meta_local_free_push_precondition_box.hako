// page_meta_local_free_push_precondition_box.hako -- LocalFreePush precondition pilot
// Responsibility: prove that .hako hako_alloc can express the same-owner and
// block-next preconditions required before LocalFreePush lowering opens.
// This does not lower LocalFreePush, open LocalFreePop, route remote frees,
// open AtomicRemoteHead, transfer TLS backing, or activate product allocation.

static box HakoAllocPageMetaLocalFreePushPrecondition {
    localFreePushPreconditionProbe(page_table, page_index, block) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local owner_worker_id = page.owner_worker_id
            local current_owner_id = mem.currentAllocOwnerId()
            local same_owner = mem.ownerEq(owner_worker_id, current_owner_id)
            page.used = same_owner
            mem.assumeSameOwner(page, same_owner)
            mem.assumeLocalFreeBlockNext(block)
            mem.localFreePush(page, block)
        }
        return 0
    }
}

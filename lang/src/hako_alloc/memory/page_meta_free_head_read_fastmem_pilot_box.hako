// page_meta_free_head_read_fastmem_pilot_box.hako -- PageMeta free_head read pilot
// Responsibility: observe the free_head metadata field through verified
// PageMetaLayoutV0 access. This is read-only pointer-shaped metadata evidence;
// it does not store free_head, claim free-list semantics, mutate DirectArray
// storage, open local_free_head, remote_head, TLS transfer, or product
// allocator activation.

static box HakoAllocPageMetaFreeHeadReadFastmemPilot {
    freeHeadReadPageMetaProbe(page_table, page_index, next_used) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local owner_worker_id = page.owner_worker_id
            local free_head = page.free_head
            local block_size = page.block_size
            local capacity = page.capacity
            local used = page.used
            page.used = next_used
            local total = block_size + capacity
            return total + used + owner_worker_id
        }
        return 0
    }
}

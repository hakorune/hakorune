// page_source_policy_box.hako — hako_alloc OSVM page-source policy seam
// Responsibility: own allocator page-source policy over hako.osvm substrate rows.
// Non-responsibility: implement OS VM metal, facade lifecycle behavior, or allocator replacement.

using selfhost.runtime.substrate.osvm.osvm_core_box as OsVmCoreBox

static box HakoAllocPageSourcePolicy {
    reservePage(bytes: usize) {
        return OsVmCoreBox.reserve_bytes_usize(bytes)
    }

    commitPage(base: i64, bytes: usize) {
        return OsVmCoreBox.commit_bytes_usize(base, bytes)
    }

    decommitPage(base: i64, bytes: usize) {
        return OsVmCoreBox.decommit_bytes_usize(base, bytes)
    }

    unreservePage(base: i64, bytes: usize) {
        return OsVmCoreBox.unreserve_bytes_usize(base, bytes)
    }
}

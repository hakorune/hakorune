// page_map_release_box.hako — M172 page-map-backed release seam
// Responsibility: compose bridge-owned pointer ownership lookup with the
// landed same/remote free publish body and unregister the caller-visible ptr.
// Future allocator APIs and native metal stay outside this owner.

using selfhost.hako_alloc.memory.page_box as HakoAllocPageBox
using selfhost.hako_alloc.memory.page_map_bridge_box as HakoAllocPageMapBridgeBox
using selfhost.hako_alloc.memory.page_meta_same_remote_free_publish_body_runtime_box as HakoAllocPageMetaSameRemoteFreePublishBody
using selfhost.hako_alloc.memory.page_map_box as HakoAllocPageMapBox

box HakoAllocPageMapReleaseSeam {
    pages: ArrayBox = new ArrayBox()
    page_map: HakoAllocPageMap
    page_map_bridge: HakoAllocPageMapBridge
    same_remote_free_publish_body: HakoAllocPageMetaSameRemoteFreePublishBody
    page_count: usize = 0
    page_register_count: usize = 0
    release_count: usize = 0
    unregister_count: usize = 0
    lookup_miss_count: usize = 0
    stale_page_count: usize = 0
    page_release_reject_count: usize = 0
    reject_count: usize = 0

    birth(page_map) {
        me.page_map = page_map
        me.page_map_bridge = new HakoAllocPageMapBridge(page_map)
        me.same_remote_free_publish_body = new HakoAllocPageMetaSameRemoteFreePublishBody()
    }

    addPage(page) {
        if page == null {
            me.reject_count = me.reject_count + 1
            return 0
        }

        if page.page_id != me.page_count {
            me.reject_count = me.reject_count + 1
            return 0
        }

        me.pages.push(page)
        me.page_count = me.page_count + 1
        me.page_register_count = me.page_register_count + 1
        return 1
    }

    releasePtr(ptr) {
        local page_map_bridge = me.page_map_bridge
        local entry = page_map_bridge.lookup(ptr)
        if entry == null {
            me.lookup_miss_count = me.lookup_miss_count + 1
            me.reject_count = me.reject_count + 1
            return 0
        }

        local page_id = entry.page_id
        if page_id < 0 {
            me.stale_page_count = me.stale_page_count + 1
            me.reject_count = me.reject_count + 1
            return 0
        }

        if page_id >= me.page_count {
            me.stale_page_count = me.stale_page_count + 1
            me.reject_count = me.reject_count + 1
            return 0
        }

        local page = me.pages.get(page_id)
        if page == null {
            me.stale_page_count = me.stale_page_count + 1
            me.reject_count = me.reject_count + 1
            return 0
        }

        if page.blockIsLive(entry.block_id) == 0 {
            me.page_release_reject_count = me.page_release_reject_count + 1
            me.reject_count = me.reject_count + 1
            return 0
        }

        local same_owner = page.page_id == page_id
        local publish_used = me.same_remote_free_publish_body.sameRemoteFreePublishBodyProbe(page, entry.block_id, same_owner)
        if publish_used < 0 {
            me.page_release_reject_count = me.page_release_reject_count + 1
            me.reject_count = me.reject_count + 1
            return 0
        }

        if page_map_bridge.unregister(ptr) {
            me.unregister_count = me.unregister_count + 1
            me.release_count = me.release_count + 1
            return 1
        }

        me.reject_count = me.reject_count + 1
        return 0
    }

    liveCount() {
        return me.page_map_bridge.liveCount()
    }
}

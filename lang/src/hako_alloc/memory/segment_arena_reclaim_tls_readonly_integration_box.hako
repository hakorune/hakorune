    accepted: i64
    reason: i64
    integration_present: i64
    matrix_present: i64
    matrix_accepted: i64
    matrix_reason: i64
    support_gate_present: i64
    support_gate_accepted: i64
    support_gate_reason: i64
    pointer_lookup_prerequisite_present: i64
    pointer_lookup_prerequisite_accepted: i64
    pointer_lookup_prerequisite_reason: i64
    worker_tls_present: i64
    worker_tls_accepted: i64
    worker_tls_reason: i64
    readonly_integration_ready: i64
    provider_active: i64
    replacement_active: i64
    hook_installed: i64
    allocator_claim: i64
    winner_gate: i64
    report_segment_id: i64
    report_arena_id: i64
    report_lifetime_generation: i64
    report_release_applied_recycle_token: i64
    report_continuation_token: i64
    report_application_token: i64
    report_applied_backing_bytes: usize
    report_applied_committed_bytes: usize
    report_remaining_source_bytes: usize
    integration_count: i64
    accepted_count: i64
    reject_count: i64
    missing_matrix_reject_count: i64
    rejected_matrix_reject_count: i64
    missing_support_gate_reject_count: i64
    rejected_support_gate_reject_count: i64
    missing_pointer_lookup_prerequisite_reject_count: i64
    rejected_pointer_lookup_prerequisite_reject_count: i64
    missing_worker_tls_reject_count: i64
    rejected_worker_tls_reject_count: i64
    closed_provider_reject_count: i64
    closed_replacement_reject_count: i64
    closed_hook_reject_count: i64
    closed_allocator_claim_reject_count: i64
    closed_winner_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_replace_allocator_owner: i64
    would_enable_hook: i64
    would_claim_allocator: i64
    would_claim_selection: i64
    would_run_thread: i64
    would_use_worker_tls: i64
    would_add_backend_matcher: i64
}


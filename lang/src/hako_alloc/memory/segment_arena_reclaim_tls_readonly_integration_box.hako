// segment_arena_reclaim_tls_readonly_integration_box.hako -- MIMAP-646A read-only integration owner
// Responsibility:
// - compose the existing segment-arena reclaim/TLS proof surfaces into one
//   read-only integration owner
// - keep provider activation, replacement, hooks, global allocator claims, and
//   winner claims closed while the seam is read-only
// Non-responsibility:
// - provider activation, host allocator replacement, hook install, global
//   allocator claim, winner claim, thread scheduling, or backend shortcuts

using selfhost.hako_alloc.memory.segment_arena_backing_modeled_allocation_ledger_release_recycle_execution_readiness_matrix_box as HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionReadinessMatrix
using selfhost.hako_alloc.memory.segment_arena_backing_modeled_allocation_ledger_release_recycle_execution_support_gate_box as HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportGate
using selfhost.hako_alloc.memory.segment_arena_backing_modeled_allocation_ledger_release_recycle_pointer_derived_lookup_prerequisite_box as HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecyclePointerDerivedLookupPrerequisite
using selfhost.hako_alloc.memory.worker_tls_pilot_box as HakoAllocWorkerTlsPilot


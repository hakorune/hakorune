box HakoAllocSegmentArenaReclaimTlsReadonlyIntegration {
    integration_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_matrix_reject_count: i64 = 0
    rejected_matrix_reject_count: i64 = 0
    missing_support_gate_reject_count: i64 = 0
    rejected_support_gate_reject_count: i64 = 0
    missing_pointer_lookup_prerequisite_reject_count: i64 = 0
    rejected_pointer_lookup_prerequisite_reject_count: i64 = 0
    missing_worker_tls_reject_count: i64 = 0
    rejected_worker_tls_reject_count: i64 = 0
    closed_provider_reject_count: i64 = 0
    closed_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_allocator_claim_reject_count: i64 = 0
    closed_winner_reject_count: i64 = 0
    last_reason: i64 = 0

    inputSurfaceLeakCount(report): i64 {
        local count = 0
        if report.would_activate_provider != 0 {
            count += 1
        }
        if report.would_run_thread != 0 {
            count += 1
        }
        if report.would_add_backend_matcher != 0 {
            count += 1
        }
        return count
    }

    makeReadonlyIntegrationReport(fields: HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReportFields): HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReport {
        local result = new HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.integration_present = fields.integration_present
        result.matrix_present = fields.matrix_present
        result.matrix_accepted = fields.matrix_accepted
        result.matrix_reason = fields.matrix_reason
        result.support_gate_present = fields.support_gate_present
        result.support_gate_accepted = fields.support_gate_accepted
        result.support_gate_reason = fields.support_gate_reason
        result.pointer_lookup_prerequisite_present = fields.pointer_lookup_prerequisite_present
        result.pointer_lookup_prerequisite_accepted = fields.pointer_lookup_prerequisite_accepted
        result.pointer_lookup_prerequisite_reason = fields.pointer_lookup_prerequisite_reason
        result.worker_tls_present = fields.worker_tls_present
        result.worker_tls_accepted = fields.worker_tls_accepted
        result.worker_tls_reason = fields.worker_tls_reason
        result.readonly_integration_ready = fields.readonly_integration_ready
        result.provider_active = fields.provider_active
        result.replacement_active = fields.replacement_active
        result.hook_installed = fields.hook_installed
        result.allocator_claim = fields.allocator_claim
        result.winner_gate = fields.winner_gate
        result.report_segment_id = fields.report_segment_id
        result.report_arena_id = fields.report_arena_id
        result.report_lifetime_generation = fields.report_lifetime_generation
        result.report_release_applied_recycle_token = fields.report_release_applied_recycle_token
        result.report_continuation_token = fields.report_continuation_token
        result.report_application_token = fields.report_application_token
        result.report_applied_backing_bytes = fields.report_applied_backing_bytes
        result.report_applied_committed_bytes = fields.report_applied_committed_bytes
        result.report_remaining_source_bytes = fields.report_remaining_source_bytes
        result.integration_count = fields.integration_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_matrix_reject_count = fields.missing_matrix_reject_count
        result.rejected_matrix_reject_count = fields.rejected_matrix_reject_count
        result.missing_support_gate_reject_count = fields.missing_support_gate_reject_count
        result.rejected_support_gate_reject_count = fields.rejected_support_gate_reject_count
        result.missing_pointer_lookup_prerequisite_reject_count = fields.missing_pointer_lookup_prerequisite_reject_count
        result.rejected_pointer_lookup_prerequisite_reject_count = fields.rejected_pointer_lookup_prerequisite_reject_count
        result.missing_worker_tls_reject_count = fields.missing_worker_tls_reject_count
        result.rejected_worker_tls_reject_count = fields.rejected_worker_tls_reject_count
        result.closed_provider_reject_count = fields.closed_provider_reject_count
        result.closed_replacement_reject_count = fields.closed_replacement_reject_count
        result.closed_hook_reject_count = fields.closed_hook_reject_count
        result.closed_allocator_claim_reject_count = fields.closed_allocator_claim_reject_count
        result.closed_winner_reject_count = fields.closed_winner_reject_count
        result.last_reason = fields.last_reason
        result.would_activate_provider = fields.would_activate_provider
        result.would_replace_allocator_owner = fields.would_replace_allocator_owner
        result.would_enable_hook = fields.would_enable_hook
        result.would_claim_allocator = fields.would_claim_allocator
        result.would_claim_selection = fields.would_claim_selection
        result.would_run_thread = fields.would_run_thread
        result.would_use_worker_tls = fields.would_use_worker_tls
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        return result
    }

    reject(reason, matrix_report: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionReadinessMatrixReport, support_gate_report: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportGateReport, prerequisite_report: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecyclePointerDerivedLookupPrerequisiteReport, worker_report: HakoAllocWorkerTlsPilotReport): HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReport {
        me.reject_count += 1
        if reason == 1 {
            me.missing_matrix_reject_count += 1
        }
        if reason == 2 {
            me.rejected_matrix_reject_count += 1
        }
        if reason == 3 {
            me.missing_support_gate_reject_count += 1
        }
        if reason == 4 {
            me.rejected_support_gate_reject_count += 1
        }
        if reason == 5 {
            me.missing_pointer_lookup_prerequisite_reject_count += 1
        }
        if reason == 6 {
            me.rejected_pointer_lookup_prerequisite_reject_count += 1
        }
        if reason == 7 {
            me.missing_worker_tls_reject_count += 1
        }
        if reason == 8 {
            me.rejected_worker_tls_reject_count += 1
        }
        if reason == 9 {
            me.closed_provider_reject_count += 1
        }
        local fields = HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReportFields {
            accepted: 0,
            reason: reason,
            integration_present: 1,
            matrix_present: matrix_report.matrix_present,
            matrix_accepted: matrix_report.accepted,
            matrix_reason: matrix_report.reason,
            support_gate_present: support_gate_report.gate_present,
            support_gate_accepted: support_gate_report.accepted,
            support_gate_reason: support_gate_report.reason,
            pointer_lookup_prerequisite_present: prerequisite_report.prerequisite_present,
            pointer_lookup_prerequisite_accepted: prerequisite_report.accepted,
            pointer_lookup_prerequisite_reason: prerequisite_report.reason,
            worker_tls_present: worker_report.worker_tls_present,
            worker_tls_accepted: worker_report.accepted,
            worker_tls_reason: worker_report.reason,
            readonly_integration_ready: 0,
            provider_active: 0,
            replacement_active: 0,
            hook_installed: 0,
            allocator_claim: 0,
            winner_gate: 0,
            report_segment_id: 190,
            report_arena_id: 19,
            report_lifetime_generation: 3,
            report_release_applied_recycle_token: 97019005005,
            report_continuation_token: 98019005005,
            report_application_token: 99019005005,
            report_applied_backing_bytes: 4096,
            report_applied_committed_bytes: 4096,
            report_remaining_source_bytes: 8192,
            integration_count: me.integration_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_matrix_reject_count: me.missing_matrix_reject_count,
            rejected_matrix_reject_count: me.rejected_matrix_reject_count,
            missing_support_gate_reject_count: me.missing_support_gate_reject_count,
            rejected_support_gate_reject_count: me.rejected_support_gate_reject_count,
            missing_pointer_lookup_prerequisite_reject_count: me.missing_pointer_lookup_prerequisite_reject_count,
            rejected_pointer_lookup_prerequisite_reject_count: me.rejected_pointer_lookup_prerequisite_reject_count,
            missing_worker_tls_reject_count: me.missing_worker_tls_reject_count,
            rejected_worker_tls_reject_count: me.rejected_worker_tls_reject_count,
            closed_provider_reject_count: me.closed_provider_reject_count,
            closed_replacement_reject_count: me.closed_replacement_reject_count,
            closed_hook_reject_count: me.closed_hook_reject_count,
            closed_allocator_claim_reject_count: me.closed_allocator_claim_reject_count,
            closed_winner_reject_count: me.closed_winner_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: 0,
            would_replace_allocator_owner: 0,
            would_enable_hook: 0,
            would_claim_allocator: 0,
            would_claim_selection: 0,
            would_run_thread: 0,
            would_use_worker_tls: worker_report.would_use_worker_tls,
            would_add_backend_matcher: 0,
        }
        return me.makeReadonlyIntegrationReport(fields)
    }

    recordReadonlyIntegration(matrix_report: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionReadinessMatrixReport, support_gate_report: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecycleExecutionSupportGateReport, prerequisite_report: HakoAllocSegmentArenaBackingModeledAllocationLedgerReleaseRecyclePointerDerivedLookupPrerequisiteReport, worker_report: HakoAllocWorkerTlsPilotReport): HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReport {
        me.integration_count += 1

        if matrix_report.matrix_present != 1 {
            me.last_reason = 1
            return me.reject(1, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if matrix_report.accepted != 1 {
            me.last_reason = 2
            return me.reject(2, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if support_gate_report.gate_present != 1 {
            me.last_reason = 3
            return me.reject(3, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if support_gate_report.accepted != 1 {
            me.last_reason = 4
            return me.reject(4, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if prerequisite_report.prerequisite_present != 1 {
            me.last_reason = 5
            return me.reject(5, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if prerequisite_report.accepted != 1 {
            me.last_reason = 6
            return me.reject(6, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if worker_report.worker_tls_present != 1 {
            me.last_reason = 7
            return me.reject(7, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if worker_report.accepted != 1 {
            me.last_reason = 8
            return me.reject(8, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if me.inputSurfaceLeakCount(matrix_report) != 0 {
            me.last_reason = 9
            return me.reject(9, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if me.inputSurfaceLeakCount(support_gate_report) != 0 {
            me.last_reason = 9
            return me.reject(9, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if me.inputSurfaceLeakCount(prerequisite_report) != 0 {
            me.last_reason = 9
            return me.reject(9, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }
        if me.inputSurfaceLeakCount(worker_report) != 0 {
            me.last_reason = 9
            return me.reject(9, matrix_report, support_gate_report, prerequisite_report, worker_report)
        }

        me.accepted_count += 1
        me.last_reason = 0
        local fields = HakoAllocSegmentArenaReclaimTlsReadonlyIntegrationReportFields {
            accepted: 1,
            reason: 0,
            integration_present: 1,
            matrix_present: matrix_report.matrix_present,
            matrix_accepted: matrix_report.accepted,
            matrix_reason: matrix_report.reason,
            support_gate_present: support_gate_report.gate_present,
            support_gate_accepted: support_gate_report.accepted,
            support_gate_reason: support_gate_report.reason,
            pointer_lookup_prerequisite_present: prerequisite_report.prerequisite_present,
            pointer_lookup_prerequisite_accepted: prerequisite_report.accepted,
            pointer_lookup_prerequisite_reason: prerequisite_report.reason,
            worker_tls_present: worker_report.worker_tls_present,
            worker_tls_accepted: worker_report.accepted,
            worker_tls_reason: worker_report.reason,
            readonly_integration_ready: 1,
            provider_active: 0,
            replacement_active: 0,
            hook_installed: 0,
            allocator_claim: 0,
            winner_gate: 0,
            report_segment_id: 190,
            report_arena_id: 19,
            report_lifetime_generation: 3,
            report_release_applied_recycle_token: 97019005005,
            report_continuation_token: 98019005005,
            report_application_token: 99019005005,
            report_applied_backing_bytes: 4096,
            report_applied_committed_bytes: 4096,
            report_remaining_source_bytes: 8192,
            integration_count: me.integration_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_matrix_reject_count: me.missing_matrix_reject_count,
            rejected_matrix_reject_count: me.rejected_matrix_reject_count,
            missing_support_gate_reject_count: me.missing_support_gate_reject_count,
            rejected_support_gate_reject_count: me.rejected_support_gate_reject_count,
            missing_pointer_lookup_prerequisite_reject_count: me.missing_pointer_lookup_prerequisite_reject_count,
            rejected_pointer_lookup_prerequisite_reject_count: me.rejected_pointer_lookup_prerequisite_reject_count,
            missing_worker_tls_reject_count: me.missing_worker_tls_reject_count,
            rejected_worker_tls_reject_count: me.rejected_worker_tls_reject_count,
            closed_provider_reject_count: me.closed_provider_reject_count,
            closed_replacement_reject_count: me.closed_replacement_reject_count,
            closed_hook_reject_count: me.closed_hook_reject_count,
            closed_allocator_claim_reject_count: me.closed_allocator_claim_reject_count,
            closed_winner_reject_count: me.closed_winner_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: 0,
            would_replace_allocator_owner: 0,
            would_enable_hook: 0,
            would_claim_allocator: 0,
            would_claim_selection: 0,
            would_run_thread: 0,
            would_use_worker_tls: worker_report.would_use_worker_tls,
            would_add_backend_matcher: 0,
        }
        return me.makeReadonlyIntegrationReport(fields)
    }
}

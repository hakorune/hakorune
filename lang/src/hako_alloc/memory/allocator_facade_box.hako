// allocator_facade_box.hako — production-facing hako_alloc facade boundary
// Responsibility:
// - provide the public allocator port facade name under hako_alloc
// - delegate local policy/state to the existing page/free-list heap row
// - expose remote-free policy through the production facade seam
// - expose page-owned remote-free inbox composition through the facade seam
// - expose page-source policy through the production facade seam
// Non-responsibility:
// - process allocator replacement
// - direct ABI symbols or native metal calls
// - implementing pointer atomics, OS VM metal, or native pointer attrs

using selfhost.hako_alloc.memory.page_source_policy_box as HakoAllocPageSourcePolicy
using selfhost.hako_alloc.memory.page_heap_box as HakoAllocPageHeap
using selfhost.hako_alloc.memory.page_queue_lifecycle_box as HakoAllocLifecyclePageQueueBox
using selfhost.hako_alloc.memory.remote_free_policy_box as HakoAllocRemoteFreePolicy
using selfhost.hako_alloc.memory.remote_free_page_integration_box as RemoteFreeIntegration
using selfhost.hako_alloc.memory.stats_box as HakoAllocStats

box HakoAllocProductionFacade {
    heap: HakoAllocHeap = new HakoAllocHeap()
    lifecycle_queue: HakoAllocLifecyclePageQueue = new HakoAllocLifecyclePageQueue()
    stats_surface: HakoAllocStatsSurface = new HakoAllocStatsSurface()
    alloc_count: usize = 0
    free_count: usize = 0
    reject_count: usize = 0
    realloc_success_count: usize = 0
    realloc_reject_count: usize = 0

    allocate(size) {
        local handle = me.heap.allocate(size)
        if handle == null {
            me.reject_count = me.reject_count + 1
            return null
        }

        me.alloc_count = me.alloc_count + 1
        return handle
    }

    allocateResult(size) {
        local result = me.heap.allocateResult(size)
        if result.ok == 1 {
            me.alloc_count = me.alloc_count + 1
            return result
        }

        me.reject_count = me.reject_count + 1
        return result
    }

    release(handle) {
        if me.heap.release(handle) {
            me.free_count = me.free_count + 1
            return 1
        }

        me.reject_count = me.reject_count + 1
        return 0
    }

    isLiveHandle(handle): i64 {
        return me.heap.isLiveHandle(handle)
    }

    realloc(handle, requested_size) {
        local replacement = me.heap.realloc(handle, requested_size)
        if replacement == null {
            me.reject_count = me.reject_count + 1
            me.realloc_reject_count = me.realloc_reject_count + 1
            return null
        }

        me.realloc_success_count = me.realloc_success_count + 1
        return replacement
    }

    reallocResult(handle, requested_size) {
        local result = me.heap.reallocResult(handle, requested_size)
        if result.ok != 1 {
            me.reject_count = me.reject_count + 1
            me.realloc_reject_count = me.realloc_reject_count + 1
            return result
        }

        me.realloc_success_count = me.realloc_success_count + 1
        return result
    }

    reallocSuccessCount() {
        return me.realloc_success_count
    }

    reallocRejectCount() {
        return me.realloc_reject_count
    }

    requestedBytes() {
        return me.heap.requestedBytes()
    }

    outstandingBlocks() {
        return me.heap.outstandingBlocks()
    }

    smallFreeCount() {
        return me.heap.small_page.freeCount()
    }

    smallAllocCount() {
        return me.heap.small_page.alloc_count
    }

    smallReleaseCount() {
        return me.heap.small_page.free_count
    }

    smallReuseCount() {
        return me.heap.small_page.reuse_count
    }

    smallPeakUsed() {
        return me.heap.small_page.peak_used
    }

    mediumFreeCount() {
        return me.heap.medium_page.freeCount()
    }

    mediumAllocCount() {
        return me.heap.medium_page.alloc_count
    }

    mediumReleaseCount() {
        return me.heap.medium_page.free_count
    }

    mediumReuseCount() {
        return me.heap.medium_page.reuse_count
    }

    mediumPeakUsed() {
        return me.heap.medium_page.peak_used
    }

    statsSnapshot() {
        return me.stats_surface.snapshot(
            me.alloc_count,
            me.free_count,
            me.reject_count,
            me.requestedBytes(),
            me.outstandingBlocks(),
            me.smallAllocCount(),
            me.smallReleaseCount(),
            me.smallReuseCount(),
            me.smallPeakUsed(),
            me.smallFreeCount(),
            me.mediumAllocCount(),
            me.mediumReleaseCount(),
            me.mediumReuseCount(),
            me.mediumPeakUsed(),
            me.mediumFreeCount()
        )
    }

    lifecycleSelectionBegin() {
        return me.lifecycle_queue.beginSelection()
    }

    lifecycleSelectionConsider(page_id, decommitted, retired, reusable, available) {
        return me.lifecycle_queue.considerPage(page_id, decommitted, retired, reusable, available)
    }

    lifecycleSelectionFinish() {
        return me.lifecycle_queue.finishSelection()
    }

    lifecycleSelectedKind() {
        return me.lifecycle_queue.last_selected_kind
    }

    lifecycleSelectCount() {
        return me.lifecycle_queue.select_count
    }

    lifecycleReuseSelectCount() {
        return me.lifecycle_queue.reuse_select_count
    }

    lifecycleActiveSelectCount() {
        return me.lifecycle_queue.active_select_count
    }

    lifecycleDecommittedSkipCount() {
        return me.lifecycle_queue.decommitted_skip_count
    }

    lifecycleRetiredSkipCount() {
        return me.lifecycle_queue.retired_skip_count
    }

    lifecycleMissCount() {
        return me.lifecycle_queue.miss_count
    }

    remoteInitHead(head_cell) {
        return HakoAllocRemoteFreePolicy.initHead(head_cell)
    }

    remotePushRetry(head_cell, block_ptr, interferer_ptr) {
        return HakoAllocRemoteFreePolicy.pushRetry(head_cell, block_ptr, interferer_ptr)
    }

    remotePeekHead(head_cell) {
        return HakoAllocRemoteFreePolicy.peekHead(head_cell)
    }

    remotePeekNext(block_ptr) {
        return HakoAllocRemoteFreePolicy.peekNext(block_ptr)
    }

    remotePageInbox(page, head_cell) {
        return new HakoAllocRemoteFreePageInbox(page, head_cell)
    }

    remotePagePort(page_id, block_size, capacity, reserved, head_cell) {
        return new HakoAllocRemoteFreePagePort(page_id, block_size, capacity, reserved, head_cell)
    }

    remotePageCaptureExerciseWithPort(port, report, block_a, block_b) {
        local block0 = me.remotePageAcquire(port, 8)
        local block1 = me.remotePageAcquire(port, 16)
        local overflow_block = me.remotePageAcquire(port, 8)
        report.block0 = block0
        report.block1 = block1
        report.overflow_block = overflow_block

        local publish0 = me.remotePagePublishPort(port, block_a, block0, 0)
        local publish1 = me.remotePagePublishPort(port, block_b, block1, 0)
        report.publish0 = publish0
        report.publish1 = publish1

        local head = me.remotePagePeekPortHead(port)
        local next_b = me.remotePagePeekPortNext(port, block_b)
        local next_a = me.remotePagePeekPortNext(port, block_a)
        local head_is_b = 0
        local next_b_is_a = 0
        local next_a_empty = 0
        if head == block_b { head_is_b = 1 }
        if next_b == block_a { next_b_is_a = 1 }
        if next_a == 0 { next_a_empty = 1 }
        report.head_is_b = head_is_b
        report.next_b_is_a = next_b_is_a
        report.next_a_empty = next_a_empty

        local drained = me.remotePageCollectPendingPort(port)
        local collect_after_drain = me.remotePageCollectOnePort(port)
        report.drained = drained
        report.collect_after_drain = collect_after_drain

        local snapshot = me.remotePagePortSnapshot(port)
        report.page_used = snapshot.page_used
        report.page_local_free_count = snapshot.page_local_free_count
        report.page_retired = snapshot.page_retired
        report.page_local_release_count = snapshot.page_local_release_count
        report.inbox_init_status = snapshot.inbox_init_status
        report.inbox_push_count = snapshot.inbox_push_count
        report.inbox_collect_count = snapshot.inbox_collect_count
        report.inbox_retry_count = snapshot.inbox_retry_count
        report.inbox_reject_count = snapshot.inbox_reject_count
        report.inbox_pending_count = snapshot.inbox_pending_count
        return 1
    }

    remotePageExerciseFastWithPort(port, head_cell, block_a, block_b) {
        if me.remotePageResetPort(port, head_cell) != 1 { return 0 }

        local block0 = me.remotePageAcquire(port, 8)
        if block0 != 1 { return 0 }
        local block1 = me.remotePageAcquire(port, 16)
        if block1 != 0 { return 0 }
        local overflow_block = me.remotePageAcquire(port, 8)
        if overflow_block != -1 { return 0 }

        if me.remotePagePublishPort(port, block_a, block0, 0) != 1 { return 0 }
        if me.remotePagePublishPort(port, block_b, block1, 0) != 1 { return 0 }

        local head = me.remotePagePeekPortHead(port)
        if head != block_b { return 0 }
        local next_b = me.remotePagePeekPortNext(port, block_b)
        if next_b != block_a { return 0 }
        local next_a = me.remotePagePeekPortNext(port, block_a)
        if next_a != 0 { return 0 }

        local drained = me.remotePageCollectPendingPort(port)
        if drained != 2 { return 0 }
        local collect_after_drain = me.remotePageCollectOnePort(port)
        if collect_after_drain != 0 { return 0 }

        if me.remotePageExerciseStateOk(port) != 1 {
            return 0
        }
        return 1
    }

    remotePageAcquire(port, requested_size) {
        return port.acquire(requested_size)
    }

    remotePagePublishPort(port, block_ptr, block_id, interferer_ptr) {
        return port.publish(block_ptr, block_id, interferer_ptr)
    }

    remotePageCollectOnePort(port) {
        return port.collectOne()
    }

    remotePageCollectPendingPort(port) {
        return port.collectPending()
    }

    remotePagePeekPortHead(port) {
        return port.peekHead()
    }

    remotePagePeekPortNext(port, block_ptr) {
        return port.peekNext(block_ptr)
    }

    remotePagePortSnapshot(port) {
        return port.snapshot()
    }

    remotePageResetPort(port, head_cell) {
        return port.reset(head_cell)
    }

    remotePageExerciseStateOk(port) {
        return port.exerciseStateOk()
    }

    remotePagePortLocalFreeCount(port) {
        return port.pageLocalFreeCount()
    }

    remotePagePortUsed(port) {
        return port.pageUsed()
    }

    remotePagePortRetired(port) {
        return port.pageRetired()
    }

    remotePagePortLocalReleaseCount(port) {
        return port.pageLocalReleaseCount()
    }

    remotePagePortInboxInitStatus(port) {
        return port.inboxInitStatus()
    }

    remotePagePortInboxPushCount(port) {
        return port.inboxPushCount()
    }

    remotePagePortInboxCollectCount(port) {
        return port.inboxCollectCount()
    }

    remotePagePortInboxRetryCount(port) {
        return port.inboxRetryCount()
    }

    remotePagePortInboxRejectCount(port) {
        return port.inboxRejectCount()
    }

    remotePagePortInboxPendingCount(port) {
        return port.inboxPendingCount()
    }

    remotePagePublish(inbox, block_ptr, block_id, interferer_ptr) {
        return inbox.publish(block_ptr, block_id, interferer_ptr)
    }

    remotePageCollectOne(inbox) {
        return inbox.collectOne()
    }

    remotePageCollectPending(inbox) {
        return inbox.collectPending()
    }

    remotePagePeekInboxHead(inbox) {
        return inbox.peekHead()
    }

    remotePagePeekInboxNext(inbox, block_ptr) {
        return inbox.peekNext(block_ptr)
    }

    pageSourceReserve(bytes) {
        return HakoAllocPageSourcePolicy.reservePage(bytes)
    }

    pageSourceCommit(base, bytes) {
        return HakoAllocPageSourcePolicy.commitPage(base, bytes)
    }

    pageSourceDecommit(base, bytes) {
        return HakoAllocPageSourcePolicy.decommitPage(base, bytes)
    }
}

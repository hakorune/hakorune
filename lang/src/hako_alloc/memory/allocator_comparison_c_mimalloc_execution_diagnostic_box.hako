// allocator_comparison_c_mimalloc_execution_diagnostic_box.hako -- MIMAP-449A
// Responsibility:
// - consume C mimalloc execution inventory reports
// - classify missing inputs without running C mimalloc
// Non-responsibility:
// - C mimalloc execution, process allocator replacement, hook installation,
//   backend matcher additions, or global allocator installation

using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_execution_inventory_box as HakoAllocAllocatorComparisonCMimallocExecutionInventory


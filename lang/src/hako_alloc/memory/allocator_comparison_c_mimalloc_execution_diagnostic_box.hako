    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    c_mimalloc_execution_inventory_present: i64 = 0
    c_mimalloc_execution_ready: i64 = 0
    blocked_execution_present: i64 = 0
    c_mimalloc_runner_present: i64 = 0
    representative_workload_contract_present: i64 = 0
    hako_representative_metrics_present: i64 = 0
    output_contract_present: i64 = 0
    memory_usage_contract_present: i64 = 0
    evidence_storage_present: i64 = 0
    run_count_present: i64 = 0
    run_count: i64 = 0
    missing_runner_blocked: i64 = 0
    missing_workload_blocked: i64 = 0
    missing_hako_metrics_blocked: i64 = 0
    missing_output_contract_blocked: i64 = 0
    missing_memory_usage_contract_blocked: i64 = 0
    missing_evidence_storage_blocked: i64 = 0
    missing_run_count_blocked: i64 = 0
    invalid_run_count_blocked: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_runner_blocked_count: i64 = 0
    missing_workload_blocked_count: i64 = 0
    missing_hako_metrics_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_memory_usage_contract_blocked_count: i64 = 0
    missing_evidence_storage_blocked_count: i64 = 0
    missing_run_count_blocked_count: i64 = 0
    invalid_run_count_blocked_count: i64 = 0
    last_reason: i64 = 0
    c_mimalloc_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}


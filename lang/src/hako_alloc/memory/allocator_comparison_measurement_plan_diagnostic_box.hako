// allocator_comparison_measurement_plan_diagnostic_box.hako -- MIMAP-434A
// Responsibility:
// - consume allocator comparison measurement plan inventory reports
// - summarize missing or invalid measurement plan inputs without execution
// Non-responsibility:
// - benchmark execution, hook installation, process allocator replacement,
//   backend matcher additions, global allocator install, or worker/thread execution

using selfhost.hako_alloc.memory.allocator_comparison_measurement_plan_inventory_box as HakoAllocAllocatorComparisonMeasurementPlanInventory

record HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReportFields {
    accepted: i64
    reason: i64
    diagnostic_present: i64
    measurement_plan_inventory_present: i64
    measurement_plan_ready: i64
    blocked_measurement_present: i64
    missing_run_count_blocked: i64
    missing_warmup_plan_blocked: i64
    missing_output_contract_blocked: i64
    missing_throughput_measurement_blocked: i64
    missing_memory_usage_measurement_blocked: i64
    invalid_run_count_blocked: i64
    invalid_warmup_count_blocked: i64
    closed_seam_blocked: i64
    benchmark_executed: i64
    process_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    diagnostic_count: i64
    ready_count: i64
    blocked_count: i64
    missing_run_count_blocked_count: i64
    missing_warmup_plan_blocked_count: i64
    missing_output_contract_blocked_count: i64
    missing_throughput_measurement_blocked_count: i64
    missing_memory_usage_measurement_blocked_count: i64
    invalid_run_count_blocked_count: i64
    invalid_warmup_count_blocked_count: i64
    closed_seam_blocked_count: i64
    last_reason: i64
    would_run_benchmark: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReport {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    measurement_plan_inventory_present: i64 = 0
    measurement_plan_ready: i64 = 0
    blocked_measurement_present: i64 = 0
    missing_run_count_blocked: i64 = 0
    missing_warmup_plan_blocked: i64 = 0
    missing_output_contract_blocked: i64 = 0
    missing_throughput_measurement_blocked: i64 = 0
    missing_memory_usage_measurement_blocked: i64 = 0
    invalid_run_count_blocked: i64 = 0
    invalid_warmup_count_blocked: i64 = 0
    closed_seam_blocked: i64 = 0
    benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_run_count_blocked_count: i64 = 0
    missing_warmup_plan_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_throughput_measurement_blocked_count: i64 = 0
    missing_memory_usage_measurement_blocked_count: i64 = 0
    invalid_run_count_blocked_count: i64 = 0
    invalid_warmup_count_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0
    would_run_benchmark: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonMeasurementPlanDiagnostic {
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_run_count_blocked_count: i64 = 0
    missing_warmup_plan_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_throughput_measurement_blocked_count: i64 = 0
    missing_memory_usage_measurement_blocked_count: i64 = 0
    invalid_run_count_blocked_count: i64 = 0
    invalid_warmup_count_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonMeasurementPlanDiagnosticReport(fields: HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReportFields): HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReport {
        local result = new HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReport {
            accepted: fields.accepted,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            measurement_plan_inventory_present: fields.measurement_plan_inventory_present,
            measurement_plan_ready: fields.measurement_plan_ready,
            blocked_measurement_present: fields.blocked_measurement_present,
            missing_run_count_blocked: fields.missing_run_count_blocked,
            missing_warmup_plan_blocked: fields.missing_warmup_plan_blocked,
            missing_output_contract_blocked: fields.missing_output_contract_blocked,
            missing_throughput_measurement_blocked: fields.missing_throughput_measurement_blocked,
            missing_memory_usage_measurement_blocked: fields.missing_memory_usage_measurement_blocked,
            invalid_run_count_blocked: fields.invalid_run_count_blocked,
            invalid_warmup_count_blocked: fields.invalid_warmup_count_blocked,
            closed_seam_blocked: fields.closed_seam_blocked,
            benchmark_executed: fields.benchmark_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            diagnostic_count: fields.diagnostic_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            missing_run_count_blocked_count: fields.missing_run_count_blocked_count,
            missing_warmup_plan_blocked_count: fields.missing_warmup_plan_blocked_count,
            missing_output_contract_blocked_count: fields.missing_output_contract_blocked_count,
            missing_throughput_measurement_blocked_count: fields.missing_throughput_measurement_blocked_count,
            missing_memory_usage_measurement_blocked_count: fields.missing_memory_usage_measurement_blocked_count,
            invalid_run_count_blocked_count: fields.invalid_run_count_blocked_count,
            invalid_warmup_count_blocked_count: fields.invalid_warmup_count_blocked_count,
            closed_seam_blocked_count: fields.closed_seam_blocked_count,
            last_reason: fields.last_reason,
            would_run_benchmark: fields.would_run_benchmark,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markBlocked(reason: i64) {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_run_count_blocked_count += 1
        }
        if reason == 2 {
            me.missing_warmup_plan_blocked_count += 1
        }
        if reason == 3 {
            me.missing_output_contract_blocked_count += 1
        }
        if reason == 4 {
            me.missing_throughput_measurement_blocked_count += 1
        }
        if reason == 5 {
            me.missing_memory_usage_measurement_blocked_count += 1
        }
        if reason == 6 {
            me.invalid_run_count_blocked_count += 1
        }
        if reason == 7 {
            me.invalid_warmup_count_blocked_count += 1
        }
        if reason == 8 {
            me.closed_seam_blocked_count += 1
        }
    }

    reasonFrom(plan: HakoAllocAllocatorComparisonMeasurementPlanInventoryReport): i64 {
        if plan.benchmark_executed != 0 {
            return 8
        }
        if plan.process_replacement_executed != 0 {
            return 8
        }
        if plan.hook_installed != 0 {
            return 8
        }
        if plan.backend_matcher_added != 0 {
            return 8
        }
        if plan.global_allocator_installed != 0 {
            return 8
        }
        if plan.would_run_benchmark != 0 {
            return 8
        }
        if plan.would_replace_host_allocator != 0 {
            return 8
        }
        if plan.would_install_hook != 0 {
            return 8
        }
        if plan.would_add_backend_matcher != 0 {
            return 8
        }
        if plan.would_run_thread != 0 {
            return 8
        }
        if plan.measurement_plan_ready == 1 {
            return 0
        }
        if plan.reason != 0 {
            return plan.reason
        }
        return 1
    }

    makeReport(reason: i64, plan: HakoAllocAllocatorComparisonMeasurementPlanInventoryReport): HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReport {
        local blocked = 0
        if reason != 0 {
            blocked = 1
        }
        local missing_run_count_blocked = 0
        local missing_warmup_plan_blocked = 0
        local missing_output_contract_blocked = 0
        local missing_throughput_measurement_blocked = 0
        local missing_memory_usage_measurement_blocked = 0
        local invalid_run_count_blocked = 0
        local invalid_warmup_count_blocked = 0
        local closed_seam_blocked = 0
        if reason == 1 {
            missing_run_count_blocked = 1
        }
        if reason == 2 {
            missing_warmup_plan_blocked = 1
        }
        if reason == 3 {
            missing_output_contract_blocked = 1
        }
        if reason == 4 {
            missing_throughput_measurement_blocked = 1
        }
        if reason == 5 {
            missing_memory_usage_measurement_blocked = 1
        }
        if reason == 6 {
            invalid_run_count_blocked = 1
        }
        if reason == 7 {
            invalid_warmup_count_blocked = 1
        }
        if reason == 8 {
            closed_seam_blocked = 1
        }
        local fields = HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReportFields {
            accepted: 1,
            reason: reason,
            diagnostic_present: 1,
            measurement_plan_inventory_present: plan.measurement_plan_inventory_present,
            measurement_plan_ready: plan.measurement_plan_ready,
            blocked_measurement_present: blocked,
            missing_run_count_blocked: missing_run_count_blocked,
            missing_warmup_plan_blocked: missing_warmup_plan_blocked,
            missing_output_contract_blocked: missing_output_contract_blocked,
            missing_throughput_measurement_blocked: missing_throughput_measurement_blocked,
            missing_memory_usage_measurement_blocked: missing_memory_usage_measurement_blocked,
            invalid_run_count_blocked: invalid_run_count_blocked,
            invalid_warmup_count_blocked: invalid_warmup_count_blocked,
            closed_seam_blocked: closed_seam_blocked,
            benchmark_executed: 0,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            diagnostic_count: me.diagnostic_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            missing_run_count_blocked_count: me.missing_run_count_blocked_count,
            missing_warmup_plan_blocked_count: me.missing_warmup_plan_blocked_count,
            missing_output_contract_blocked_count: me.missing_output_contract_blocked_count,
            missing_throughput_measurement_blocked_count: me.missing_throughput_measurement_blocked_count,
            missing_memory_usage_measurement_blocked_count: me.missing_memory_usage_measurement_blocked_count,
            invalid_run_count_blocked_count: me.invalid_run_count_blocked_count,
            invalid_warmup_count_blocked_count: me.invalid_warmup_count_blocked_count,
            closed_seam_blocked_count: me.closed_seam_blocked_count,
            last_reason: me.last_reason,
            would_run_benchmark: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeAllocatorComparisonMeasurementPlanDiagnosticReport(fields)
    }

    diagnoseAllocatorComparisonMeasurementPlan(plan: HakoAllocAllocatorComparisonMeasurementPlanInventoryReport): HakoAllocAllocatorComparisonMeasurementPlanDiagnosticReport {
        me.diagnostic_count += 1
        local reason = me.reasonFrom(plan)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, plan)
    }
}

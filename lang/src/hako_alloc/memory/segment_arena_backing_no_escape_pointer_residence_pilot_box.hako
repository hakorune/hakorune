// segment_arena_backing_no_escape_pointer_residence_pilot_box.hako -- MIMAP-344A
// Responsibility:
// - record a private proof-scope no-escape pointer residence token from the
//   accepted remaining execution prerequisite ledger
// - keep escape blockers and closed execution seams explicit
// Non-responsibility:
// - pointer-derived lookup, dereference, arena release/recycle, segment-map
//   mutation, atomic bitmap execution, OSVM, worker/TLS, providers, or backend
//   matchers

record HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReportFields {
    accepted: i64
    reason: i64
    residence_present: i64
    ledger_present: i64
    ledger_accepted: i64
    ledger_reason: i64
    private_pointer_token: i64
    token_valid: i64
    no_escape_scope_id: i64
    no_escape_scope_open: i64
    non_dereferenceable: i64
    escape_to_return: i64
    escape_to_storage: i64
    escape_to_alias: i64
    closed_execution_blocker_count: i64
    residence_count: i64
    accepted_count: i64
    reject_count: i64
    missing_ledger_reject_count: i64
    rejected_ledger_reject_count: i64
    invalid_token_reject_count: i64
    escape_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    report_segment_id: i64
    report_arena_id: i64
    report_lifetime_generation: i64
    report_release_applied_recycle_token: i64
    report_continuation_token: i64
    report_application_token: i64
    report_applied_backing_bytes: usize
    report_applied_committed_bytes: usize
    report_remaining_source_bytes: usize
    would_lookup_by_pointer: i64
    would_release_arena_backing: i64
    would_recycle_arena_backing: i64
    would_use_segment_map: i64
    would_execute_atomic_bitmap: i64
    would_call_osvm: i64
    would_run_thread: i64
    would_activate_provider: i64
    would_add_backend_matcher: i64
}

box HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReport {
    accepted: i64 = 0
    reason: i64 = 0
    residence_present: i64 = 0
    ledger_present: i64 = 0
    ledger_accepted: i64 = 0
    ledger_reason: i64 = 0
    private_pointer_token: i64 = 0
    token_valid: i64 = 0
    no_escape_scope_id: i64 = 0
    no_escape_scope_open: i64 = 0
    non_dereferenceable: i64 = 1
    escape_to_return: i64 = 0
    escape_to_storage: i64 = 0
    escape_to_alias: i64 = 0
    closed_execution_blocker_count: i64 = 0
    residence_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_ledger_reject_count: i64 = 0
    rejected_ledger_reject_count: i64 = 0
    invalid_token_reject_count: i64 = 0
    escape_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    report_segment_id: i64 = -1
    report_arena_id: i64 = -1
    report_lifetime_generation: i64 = 0
    report_release_applied_recycle_token: i64 = 0
    report_continuation_token: i64 = 0
    report_application_token: i64 = 0
    report_applied_backing_bytes: usize = 0
    report_applied_committed_bytes: usize = 0
    report_remaining_source_bytes: usize = 0
    would_lookup_by_pointer: i64 = 0
    would_release_arena_backing: i64 = 0
    would_recycle_arena_backing: i64 = 0
    would_use_segment_map: i64 = 0
    would_execute_atomic_bitmap: i64 = 0
    would_call_osvm: i64 = 0
    would_run_thread: i64 = 0
    would_activate_provider: i64 = 0
    would_add_backend_matcher: i64 = 0
}

box HakoAllocSegmentArenaBackingNoEscapePointerResidencePilot {
    residence_count: usize = 0
    accepted_count: usize = 0
    reject_count: usize = 0
    missing_ledger_reject_count: usize = 0
    rejected_ledger_reject_count: usize = 0
    invalid_token_reject_count: usize = 0
    escape_reject_count: usize = 0
    closed_execution_reject_count: usize = 0
    last_reason: i64 = 0

    closedExecutionBlockerCount(ledger_report): i64 {
        local count = 0
        if ledger_report.would_lookup_by_pointer != 0 {
            count += 1
        }
        if ledger_report.would_release_arena_backing != 0 {
            count += 1
        }
        if ledger_report.would_recycle_arena_backing != 0 {
            count += 1
        }
        if ledger_report.would_use_segment_map != 0 {
            count += 1
        }
        if ledger_report.would_execute_atomic_bitmap != 0 {
            count += 1
        }
        if ledger_report.would_call_osvm != 0 {
            count += 1
        }
        if ledger_report.would_run_thread != 0 {
            count += 1
        }
        if ledger_report.would_activate_provider != 0 {
            count += 1
        }
        if ledger_report.would_add_backend_matcher != 0 {
            count += 1
        }
        return count
    }

    makeNoEscapePointerResidencePilotReport(fields: HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReportFields): HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReport {
        local result = new HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.residence_present = fields.residence_present
        result.ledger_present = fields.ledger_present
        result.ledger_accepted = fields.ledger_accepted
        result.ledger_reason = fields.ledger_reason
        result.private_pointer_token = fields.private_pointer_token
        result.token_valid = fields.token_valid
        result.no_escape_scope_id = fields.no_escape_scope_id
        result.no_escape_scope_open = fields.no_escape_scope_open
        result.non_dereferenceable = fields.non_dereferenceable
        result.escape_to_return = fields.escape_to_return
        result.escape_to_storage = fields.escape_to_storage
        result.escape_to_alias = fields.escape_to_alias
        result.closed_execution_blocker_count = fields.closed_execution_blocker_count
        result.residence_count = fields.residence_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_ledger_reject_count = fields.missing_ledger_reject_count
        result.rejected_ledger_reject_count = fields.rejected_ledger_reject_count
        result.invalid_token_reject_count = fields.invalid_token_reject_count
        result.escape_reject_count = fields.escape_reject_count
        result.closed_execution_reject_count = fields.closed_execution_reject_count
        result.last_reason = fields.last_reason
        result.report_segment_id = fields.report_segment_id
        result.report_arena_id = fields.report_arena_id
        result.report_lifetime_generation = fields.report_lifetime_generation
        result.report_release_applied_recycle_token = fields.report_release_applied_recycle_token
        result.report_continuation_token = fields.report_continuation_token
        result.report_application_token = fields.report_application_token
        result.report_applied_backing_bytes = fields.report_applied_backing_bytes
        result.report_applied_committed_bytes = fields.report_applied_committed_bytes
        result.report_remaining_source_bytes = fields.report_remaining_source_bytes
        result.would_lookup_by_pointer = fields.would_lookup_by_pointer
        result.would_release_arena_backing = fields.would_release_arena_backing
        result.would_recycle_arena_backing = fields.would_recycle_arena_backing
        result.would_use_segment_map = fields.would_use_segment_map
        result.would_execute_atomic_bitmap = fields.would_execute_atomic_bitmap
        result.would_call_osvm = fields.would_call_osvm
        result.would_run_thread = fields.would_run_thread
        result.would_activate_provider = fields.would_activate_provider
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        return result
    }

    makeReport(accepted, reason, residence_present, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias): HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReport {
        local token_valid = 0
        if private_pointer_token > 0 {
            token_valid = 1
        }
        local fields = HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReportFields {
            accepted: accepted,
            reason: reason,
            residence_present: residence_present,
            ledger_present: ledger_report.ledger_present,
            ledger_accepted: ledger_report.accepted,
            ledger_reason: ledger_report.reason,
            private_pointer_token: private_pointer_token,
            token_valid: token_valid,
            no_escape_scope_id: ledger_report.report_segment_id,
            no_escape_scope_open: accepted,
            non_dereferenceable: 1,
            escape_to_return: escape_to_return,
            escape_to_storage: escape_to_storage,
            escape_to_alias: escape_to_alias,
            closed_execution_blocker_count: me.closedExecutionBlockerCount(ledger_report),
            residence_count: me.residence_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_ledger_reject_count: me.missing_ledger_reject_count,
            rejected_ledger_reject_count: me.rejected_ledger_reject_count,
            invalid_token_reject_count: me.invalid_token_reject_count,
            escape_reject_count: me.escape_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            report_segment_id: ledger_report.report_segment_id,
            report_arena_id: ledger_report.report_arena_id,
            report_lifetime_generation: ledger_report.report_lifetime_generation,
            report_release_applied_recycle_token: ledger_report.report_release_applied_recycle_token,
            report_continuation_token: ledger_report.report_continuation_token,
            report_application_token: ledger_report.report_application_token,
            report_applied_backing_bytes: ledger_report.report_applied_backing_bytes,
            report_applied_committed_bytes: ledger_report.report_applied_committed_bytes,
            report_remaining_source_bytes: ledger_report.report_remaining_source_bytes,
            would_lookup_by_pointer: ledger_report.would_lookup_by_pointer,
            would_release_arena_backing: ledger_report.would_release_arena_backing,
            would_recycle_arena_backing: ledger_report.would_recycle_arena_backing,
            would_use_segment_map: ledger_report.would_use_segment_map,
            would_execute_atomic_bitmap: ledger_report.would_execute_atomic_bitmap,
            would_call_osvm: ledger_report.would_call_osvm,
            would_run_thread: ledger_report.would_run_thread,
            would_activate_provider: ledger_report.would_activate_provider,
            would_add_backend_matcher: ledger_report.would_add_backend_matcher
        }
        return me.makeNoEscapePointerResidencePilotReport(fields)
    }

    reject(reason, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias): HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_ledger_reject_count += 1
        }
        if reason == 2 {
            me.rejected_ledger_reject_count += 1
        }
        if reason == 3 {
            me.invalid_token_reject_count += 1
        }
        if reason == 4 {
            me.escape_reject_count += 1
        }
        if reason == 5 {
            me.escape_reject_count += 1
        }
        if reason == 6 {
            me.escape_reject_count += 1
        }
        if reason == 7 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, 0, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
    }

    recordNoEscapePointerResidence(ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias): HakoAllocSegmentArenaBackingNoEscapePointerResidencePilotReport {
        me.residence_count += 1

        if ledger_report.ledger_present != 1 {
            return me.reject(1, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }
        if ledger_report.accepted != 1 {
            return me.reject(2, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }
        if private_pointer_token <= 0 {
            return me.reject(3, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }
        if escape_to_return != 0 {
            return me.reject(4, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }
        if escape_to_storage != 0 {
            return me.reject(5, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }
        if escape_to_alias != 0 {
            return me.reject(6, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }
        if me.closedExecutionBlockerCount(ledger_report) != 0 {
            return me.reject(7, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, ledger_report, private_pointer_token, escape_to_return, escape_to_storage, escape_to_alias)
    }
}

// allocator_comparison_representative_benchmark_execution_diagnostic_box.hako -- MIMAP-445A
// Responsibility:
// - consume representative benchmark execution pilot reports
// - summarize execution-result readiness and blocked reasons without new execution
// Non-responsibility:
// - process allocator replacement, hook installation, backend matcher additions,
//   global allocator install, C mimalloc execution, or worker/thread execution

using selfhost.hako_alloc.memory.allocator_comparison_representative_benchmark_execution_pilot_box as HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionPilot

record HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReportFields {
    accepted: i64
    reason: i64
    diagnostic_present: i64
    representative_benchmark_execution_present: i64
    benchmark_executed: i64
    output_contract_present: i64
    evidence_storage_present: i64
    execution_metrics_present: i64
    ready_execution_present: i64
    blocked_execution_present: i64
    not_ready_blocked: i64
    invalid_run_count_blocked: i64
    missing_output_contract_blocked: i64
    missing_evidence_storage_blocked: i64
    closed_seam_blocked: i64
    allocation_count: i64
    release_count: i64
    reject_count: i64
    requested_bytes: i64
    outstanding_blocks: i64
    small_free_count: i64
    medium_free_count: i64
    process_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    diagnostic_count: i64
    ready_count: i64
    blocked_count: i64
    not_ready_blocked_count: i64
    invalid_run_count_blocked_count: i64
    missing_output_contract_blocked_count: i64
    missing_evidence_storage_blocked_count: i64
    closed_seam_blocked_count: i64
    last_reason: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    representative_benchmark_execution_present: i64 = 0
    benchmark_executed: i64 = 0
    output_contract_present: i64 = 0
    evidence_storage_present: i64 = 0
    execution_metrics_present: i64 = 0
    ready_execution_present: i64 = 0
    blocked_execution_present: i64 = 0
    not_ready_blocked: i64 = 0
    invalid_run_count_blocked: i64 = 0
    missing_output_contract_blocked: i64 = 0
    missing_evidence_storage_blocked: i64 = 0
    closed_seam_blocked: i64 = 0
    allocation_count: i64 = 0
    release_count: i64 = 0
    reject_count: i64 = 0
    requested_bytes: i64 = 0
    outstanding_blocks: i64 = 0
    small_free_count: i64 = 0
    medium_free_count: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    not_ready_blocked_count: i64 = 0
    invalid_run_count_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_evidence_storage_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnostic {
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    not_ready_blocked_count: i64 = 0
    invalid_run_count_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    missing_evidence_storage_blocked_count: i64 = 0
    closed_seam_blocked_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport(fields: HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReportFields): HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport {
        local result = new HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport {
            accepted: fields.accepted,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            representative_benchmark_execution_present: fields.representative_benchmark_execution_present,
            benchmark_executed: fields.benchmark_executed,
            output_contract_present: fields.output_contract_present,
            evidence_storage_present: fields.evidence_storage_present,
            execution_metrics_present: fields.execution_metrics_present,
            ready_execution_present: fields.ready_execution_present,
            blocked_execution_present: fields.blocked_execution_present,
            not_ready_blocked: fields.not_ready_blocked,
            invalid_run_count_blocked: fields.invalid_run_count_blocked,
            missing_output_contract_blocked: fields.missing_output_contract_blocked,
            missing_evidence_storage_blocked: fields.missing_evidence_storage_blocked,
            closed_seam_blocked: fields.closed_seam_blocked,
            allocation_count: fields.allocation_count,
            release_count: fields.release_count,
            reject_count: fields.reject_count,
            requested_bytes: fields.requested_bytes,
            outstanding_blocks: fields.outstanding_blocks,
            small_free_count: fields.small_free_count,
            medium_free_count: fields.medium_free_count,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            diagnostic_count: fields.diagnostic_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            not_ready_blocked_count: fields.not_ready_blocked_count,
            invalid_run_count_blocked_count: fields.invalid_run_count_blocked_count,
            missing_output_contract_blocked_count: fields.missing_output_contract_blocked_count,
            missing_evidence_storage_blocked_count: fields.missing_evidence_storage_blocked_count,
            closed_seam_blocked_count: fields.closed_seam_blocked_count,
            last_reason: fields.last_reason,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markBlocked(reason: i64) {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.not_ready_blocked_count += 1
        }
        if reason == 2 {
            me.invalid_run_count_blocked_count += 1
        }
        if reason == 3 {
            me.missing_output_contract_blocked_count += 1
        }
        if reason == 4 {
            me.missing_evidence_storage_blocked_count += 1
        }
        if reason == 5 {
            me.closed_seam_blocked_count += 1
        }
    }

    reportHasClosedSeam(report: HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionPilotReport): i64 {
        if report.process_replacement_executed != 0 {
            return 1
        }
        if report.hook_installed != 0 {
            return 1
        }
        if report.backend_matcher_added != 0 {
            return 1
        }
        if report.global_allocator_installed != 0 {
            return 1
        }
        if report.would_replace_host_allocator != 0 {
            return 1
        }
        if report.would_install_hook != 0 {
            return 1
        }
        if report.would_add_backend_matcher != 0 {
            return 1
        }
        if report.would_run_thread != 0 {
            return 1
        }
        return 0
    }

    reasonFrom(report: HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionPilotReport): i64 {
        if me.reportHasClosedSeam(report) != 0 {
            return 5
        }
        if report.accepted == 1 {
            if report.representative_benchmark_execution_present == 1 {
                if report.benchmark_executed == 1 {
                    return 0
                }
            }
        }
        if report.reason != 0 {
            return report.reason
        }
        return 1
    }

    makeReport(reason: i64, report: HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionPilotReport): HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport {
        local blocked = 0
        if reason != 0 {
            blocked = 1
        }
        local ready = 0
        if reason == 0 {
            ready = 1
        }
        local metrics_present = 0
        if report.allocation_count > 0 {
            metrics_present = 1
        }
        local not_ready_blocked = 0
        local invalid_run_count_blocked = 0
        local missing_output_contract_blocked = 0
        local missing_evidence_storage_blocked = 0
        local closed_seam_blocked = 0
        if reason == 1 {
            not_ready_blocked = 1
        }
        if reason == 2 {
            invalid_run_count_blocked = 1
        }
        if reason == 3 {
            missing_output_contract_blocked = 1
        }
        if reason == 4 {
            missing_evidence_storage_blocked = 1
        }
        if reason == 5 {
            closed_seam_blocked = 1
        }
        local fields = HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReportFields {
            accepted: 1,
            reason: reason,
            diagnostic_present: 1,
            representative_benchmark_execution_present: report.representative_benchmark_execution_present,
            benchmark_executed: report.benchmark_executed,
            output_contract_present: report.output_contract_present,
            evidence_storage_present: report.evidence_storage_present,
            execution_metrics_present: metrics_present,
            ready_execution_present: ready,
            blocked_execution_present: blocked,
            not_ready_blocked: not_ready_blocked,
            invalid_run_count_blocked: invalid_run_count_blocked,
            missing_output_contract_blocked: missing_output_contract_blocked,
            missing_evidence_storage_blocked: missing_evidence_storage_blocked,
            closed_seam_blocked: closed_seam_blocked,
            allocation_count: report.allocation_count,
            release_count: report.release_count,
            reject_count: report.reject_count,
            requested_bytes: report.requested_bytes,
            outstanding_blocks: report.outstanding_blocks,
            small_free_count: report.small_free_count,
            medium_free_count: report.medium_free_count,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            diagnostic_count: me.diagnostic_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            not_ready_blocked_count: me.not_ready_blocked_count,
            invalid_run_count_blocked_count: me.invalid_run_count_blocked_count,
            missing_output_contract_blocked_count: me.missing_output_contract_blocked_count,
            missing_evidence_storage_blocked_count: me.missing_evidence_storage_blocked_count,
            closed_seam_blocked_count: me.closed_seam_blocked_count,
            last_reason: me.last_reason,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport(fields)
    }

    diagnoseAllocatorComparisonRepresentativeBenchmarkExecution(report: HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionPilotReport): HakoAllocAllocatorComparisonRepresentativeBenchmarkExecutionDiagnosticReport {
        me.diagnostic_count += 1
        local reason = me.reasonFrom(report)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, report)
    }
}

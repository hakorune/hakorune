// page_meta_free_head_pop_precondition_box.hako -- FreeHeadPop verifier preconditions
// Responsibility: prove the ordinary page free-list pop route has enough
// verifier-owned evidence to become a FreeHeadPop access plan. This does not
// lower FreeHeadPop, mutate free_head through ordinary FieldStore, open refill,
// route remote frees, transfer TLS backing, or activate product allocation.

static box HakoAllocPageMetaFreeHeadPopPrecondition {
    freeHeadPopPreconditionProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local current = mem.currentAllocOwnerId()
            local same = mem.ownerEq(page.owner_worker_id, current)
            mem.assumeSameOwner(page, same)
            mem.assumeFreeHeadNonEmpty(page)
            local popped = mem.freeHeadPop(page)
            local used = page.used
            page.used = used + 1
        }
        return 0
    }
}

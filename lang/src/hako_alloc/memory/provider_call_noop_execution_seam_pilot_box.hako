// provider_call_noop_execution_seam_pilot_box.hako -- MIMAP-390A
// Responsibility:
// - consume a provider-call execution capability preflight report
// - record an explicit no-op provider-call execution seam crossing
// Non-responsibility:
// - actual provider API calls, host allocator replacement, hooks, global
//   allocator install, backend matchers, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.provider_call_execution_capability_preflight_box as HakoAllocProviderCallExecutionCapabilityPreflight

record HakoAllocProviderCallNoopExecutionSeamPilotReportFields {
    accepted: i64
    reason: i64
    noop_execution_seam_present: i64
    preflight_present: i64
    preflight_accepted: i64
    preflight_reason: i64
    provider_call_execution_ready: i64
    provider_call_execution_capability_present: i64
    provider_call_execution_capability_valid: i64
    provider_call_execution_closed: i64
    provider_call_noop_execution_open: i64
    provider_call_noop_executed: i64
    provider_api_call_executed: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    seam_count: i64
    accepted_count: i64
    reject_count: i64
    missing_preflight_reject_count: i64
    rejected_preflight_reject_count: i64
    not_ready_reject_count: i64
    closed_execution_reject_count: i64
    closed_host_replacement_reject_count: i64
    closed_hook_reject_count: i64
    closed_backend_matcher_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_execute_provider_api: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderCallNoopExecutionSeamPilotReport {
    accepted: i64 = 0
    reason: i64 = 0
    noop_execution_seam_present: i64 = 0
    preflight_present: i64 = 0
    preflight_accepted: i64 = 0
    preflight_reason: i64 = 0
    provider_call_execution_ready: i64 = 0
    provider_call_execution_capability_present: i64 = 0
    provider_call_execution_capability_valid: i64 = 0
    provider_call_execution_closed: i64 = 1
    provider_call_noop_execution_open: i64 = 0
    provider_call_noop_executed: i64 = 0
    provider_api_call_executed: i64 = 0
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    seam_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_preflight_reject_count: i64 = 0
    rejected_preflight_reject_count: i64 = 0
    not_ready_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_execute_provider_api: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderCallNoopExecutionSeamPilot {
    seam_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_preflight_reject_count: i64 = 0
    rejected_preflight_reject_count: i64 = 0
    not_ready_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderCallNoopExecutionSeamPilotReport(fields: HakoAllocProviderCallNoopExecutionSeamPilotReportFields): HakoAllocProviderCallNoopExecutionSeamPilotReport {
        local result = new HakoAllocProviderCallNoopExecutionSeamPilotReport {
            accepted: fields.accepted,
            reason: fields.reason,
            noop_execution_seam_present: fields.noop_execution_seam_present,
            preflight_present: fields.preflight_present,
            preflight_accepted: fields.preflight_accepted,
            preflight_reason: fields.preflight_reason,
            provider_call_execution_ready: fields.provider_call_execution_ready,
            provider_call_execution_capability_present: fields.provider_call_execution_capability_present,
            provider_call_execution_capability_valid: fields.provider_call_execution_capability_valid,
            provider_call_execution_closed: fields.provider_call_execution_closed,
            provider_call_noop_execution_open: fields.provider_call_noop_execution_open,
            provider_call_noop_executed: fields.provider_call_noop_executed,
            provider_api_call_executed: fields.provider_api_call_executed,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            seam_count: fields.seam_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_preflight_reject_count: fields.missing_preflight_reject_count,
            rejected_preflight_reject_count: fields.rejected_preflight_reject_count,
            not_ready_reject_count: fields.not_ready_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            closed_host_replacement_reject_count: fields.closed_host_replacement_reject_count,
            closed_hook_reject_count: fields.closed_hook_reject_count,
            closed_backend_matcher_reject_count: fields.closed_backend_matcher_reject_count,
            last_reason: fields.last_reason,
            would_activate_provider: fields.would_activate_provider,
            would_call_provider: fields.would_call_provider,
            would_execute_provider_api: fields.would_execute_provider_api,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, preflight: HakoAllocProviderCallExecutionCapabilityPreflightReport): HakoAllocProviderCallNoopExecutionSeamPilotReport {
        local seam_present = accepted
        local noop_open = accepted
        local noop_executed = accepted
        local fields = HakoAllocProviderCallNoopExecutionSeamPilotReportFields {
            accepted: accepted,
            reason: reason,
            noop_execution_seam_present: seam_present,
            preflight_present: preflight.preflight_present,
            preflight_accepted: preflight.accepted,
            preflight_reason: preflight.reason,
            provider_call_execution_ready: preflight.provider_call_execution_ready,
            provider_call_execution_capability_present: preflight.provider_call_execution_capability_present,
            provider_call_execution_capability_valid: preflight.provider_call_execution_capability_valid,
            provider_call_execution_closed: preflight.provider_call_execution_closed,
            provider_call_noop_execution_open: noop_open,
            provider_call_noop_executed: noop_executed,
            provider_api_call_executed: 0,
            host_replacement_inactive: preflight.host_replacement_inactive,
            hooks_inactive: preflight.hooks_inactive,
            backend_matcher_inactive: preflight.backend_matcher_inactive,
            seam_count: me.seam_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_preflight_reject_count: me.missing_preflight_reject_count,
            rejected_preflight_reject_count: me.rejected_preflight_reject_count,
            not_ready_reject_count: me.not_ready_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            closed_host_replacement_reject_count: me.closed_host_replacement_reject_count,
            closed_hook_reject_count: me.closed_hook_reject_count,
            closed_backend_matcher_reject_count: me.closed_backend_matcher_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: preflight.would_activate_provider,
            would_call_provider: preflight.would_call_provider,
            would_execute_provider_api: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderCallNoopExecutionSeamPilotReport(fields)
    }

    reject(reason, preflight: HakoAllocProviderCallExecutionCapabilityPreflightReport): HakoAllocProviderCallNoopExecutionSeamPilotReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_preflight_reject_count += 1
        }
        if reason == 2 {
            me.rejected_preflight_reject_count += 1
        }
        if reason == 3 {
            me.not_ready_reject_count += 1
        }
        if reason == 4 {
            me.closed_execution_reject_count += 1
        }
        if reason == 5 {
            me.closed_host_replacement_reject_count += 1
        }
        if reason == 6 {
            me.closed_hook_reject_count += 1
        }
        if reason == 7 {
            me.closed_backend_matcher_reject_count += 1
        }
        return me.makeReport(0, reason, preflight)
    }

    executeProviderCallNoopSeam(preflight: HakoAllocProviderCallExecutionCapabilityPreflightReport): HakoAllocProviderCallNoopExecutionSeamPilotReport {
        me.seam_count += 1
        if preflight.preflight_present != 1 {
            return me.reject(1, preflight)
        }
        if preflight.accepted != 1 {
            return me.reject(2, preflight)
        }
        if preflight.provider_call_execution_ready != 1 {
            return me.reject(3, preflight)
        }
        if preflight.provider_call_execution_capability_present != 1 {
            return me.reject(3, preflight)
        }
        if preflight.provider_call_execution_capability_valid != 1 {
            return me.reject(3, preflight)
        }
        if preflight.provider_call_execution_closed != 1 {
            return me.reject(4, preflight)
        }
        if preflight.would_call_provider != 1 {
            return me.reject(4, preflight)
        }
        if preflight.would_replace_host_allocator != 0 {
            return me.reject(5, preflight)
        }
        if preflight.would_install_hook != 0 {
            return me.reject(6, preflight)
        }
        if preflight.would_add_backend_matcher != 0 {
            return me.reject(7, preflight)
        }
        if preflight.would_run_thread != 0 {
            return me.reject(7, preflight)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, preflight)
    }
}

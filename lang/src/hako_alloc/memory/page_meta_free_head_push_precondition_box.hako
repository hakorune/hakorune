// page_meta_free_head_push_precondition_box.hako -- FreeHeadPush verifier precondition pilot
//
// This fixture proves that .hako hako_alloc can express the verifier-owned
// preconditions for publishing a block to PageMeta.free_head. It does not lower
// FreeHeadPush, compose refill, open remote-owner routing, or activate product
// allocator replacement.

static box HakoAllocPageMetaFreeHeadPushPrecondition {
    freeHeadPushPreconditionProbe(page_table, page_index, block) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)

            local page = page_table[page_index]
            local current = mem.currentAllocOwnerId()
            local same_owner = mem.ownerEq(page.owner_worker_id, current)
            mem.assumeSameOwner(page, same_owner)
            mem.assumeFreeHeadBlockNext(block)

            local push_marker = mem.freeHeadPush(page, block)
        }

        return 0
    }
}

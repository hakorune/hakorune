// allocator_comparison_c_mimalloc_explicit_runner_evidence_diagnostic_box.hako -- MIMAP-452A
// Responsibility:
// - consume MIMAP-451A explicit C mimalloc runner evidence reports
// - classify missing/failed evidence without rerunning the C runner
// Non-responsibility:
// - repeated benchmarks, process allocator replacement, hooks, backend matcher
//   additions, global allocator installation, provider package generation, or
//   worker/thread execution

using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_explicit_runner_execution_pilot_box as HakoAllocAllocatorComparisonCMimallocExplicitRunnerExecutionPilot

record HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReportFields {
    accepted: i64
    reason: i64
    diagnostic_present: i64
    execution_pilot_present: i64
    c_mimalloc_execution_evidence_present: i64
    blocked_evidence_present: i64
    explicit_runner_invoked: i64
    explicit_runner_output_present: i64
    explicit_runner_result_code: i64
    memory_usage_evidence_present: i64
    stable_output_contract_present: i64
    run_count: i64
    allocation_count: i64
    free_count: i64
    requested_bytes: i64
    peak_rss_bytes: i64
    missing_diagnostic_blocked: i64
    rejected_diagnostic_blocked: i64
    missing_runner_blocked: i64
    missing_output_blocked: i64
    missing_memory_evidence_blocked: i64
    missing_output_contract_blocked: i64
    failed_runner_blocked: i64
    invalid_run_count_blocked: i64
    diagnostic_count: i64
    ready_count: i64
    blocked_count: i64
    missing_diagnostic_blocked_count: i64
    rejected_diagnostic_blocked_count: i64
    missing_runner_blocked_count: i64
    missing_output_blocked_count: i64
    missing_memory_evidence_blocked_count: i64
    missing_output_contract_blocked_count: i64
    failed_runner_blocked_count: i64
    invalid_run_count_blocked_count: i64
    last_reason: i64
    c_mimalloc_executed: i64
    process_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    hidden_discovery_used: i64
    provider_package_generated: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport {
    accepted: i64 = 0
    reason: i64 = 0
    diagnostic_present: i64 = 0
    execution_pilot_present: i64 = 0
    c_mimalloc_execution_evidence_present: i64 = 0
    blocked_evidence_present: i64 = 0
    explicit_runner_invoked: i64 = 0
    explicit_runner_output_present: i64 = 0
    explicit_runner_result_code: i64 = 0
    memory_usage_evidence_present: i64 = 0
    stable_output_contract_present: i64 = 0
    run_count: i64 = 0
    allocation_count: i64 = 0
    free_count: i64 = 0
    requested_bytes: i64 = 0
    peak_rss_bytes: i64 = 0
    missing_diagnostic_blocked: i64 = 0
    rejected_diagnostic_blocked: i64 = 0
    missing_runner_blocked: i64 = 0
    missing_output_blocked: i64 = 0
    missing_memory_evidence_blocked: i64 = 0
    missing_output_contract_blocked: i64 = 0
    failed_runner_blocked: i64 = 0
    invalid_run_count_blocked: i64 = 0
    diagnostic_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_diagnostic_blocked_count: i64 = 0
    rejected_diagnostic_blocked_count: i64 = 0
    missing_runner_blocked_count: i64 = 0
    missing_output_blocked_count: i64 = 0
    missing_memory_evidence_blocked_count: i64 = 0
    missing_output_contract_blocked_count: i64 = 0
    failed_runner_blocked_count: i64 = 0
    invalid_run_count_blocked_count: i64 = 0
    last_reason: i64 = 0
    c_mimalloc_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    hidden_discovery_used: i64 = 0
    provider_package_generated: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnostic {
    diagnostic_count: usize = 0
    ready_count: usize = 0
    blocked_count: usize = 0
    missing_diagnostic_blocked_count: usize = 0
    rejected_diagnostic_blocked_count: usize = 0
    missing_runner_blocked_count: usize = 0
    missing_output_blocked_count: usize = 0
    missing_memory_evidence_blocked_count: usize = 0
    missing_output_contract_blocked_count: usize = 0
    failed_runner_blocked_count: usize = 0
    invalid_run_count_blocked_count: usize = 0
    last_reason: i64 = 0

    makeAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport(fields: HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReportFields): HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport {
        local result = new HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport {
            accepted: fields.accepted,
            reason: fields.reason,
            diagnostic_present: fields.diagnostic_present,
            execution_pilot_present: fields.execution_pilot_present,
            c_mimalloc_execution_evidence_present: fields.c_mimalloc_execution_evidence_present,
            blocked_evidence_present: fields.blocked_evidence_present,
            explicit_runner_invoked: fields.explicit_runner_invoked,
            explicit_runner_output_present: fields.explicit_runner_output_present,
            explicit_runner_result_code: fields.explicit_runner_result_code,
            memory_usage_evidence_present: fields.memory_usage_evidence_present,
            stable_output_contract_present: fields.stable_output_contract_present,
            run_count: fields.run_count,
            allocation_count: fields.allocation_count,
            free_count: fields.free_count,
            requested_bytes: fields.requested_bytes,
            peak_rss_bytes: fields.peak_rss_bytes,
            missing_diagnostic_blocked: fields.missing_diagnostic_blocked,
            rejected_diagnostic_blocked: fields.rejected_diagnostic_blocked,
            missing_runner_blocked: fields.missing_runner_blocked,
            missing_output_blocked: fields.missing_output_blocked,
            missing_memory_evidence_blocked: fields.missing_memory_evidence_blocked,
            missing_output_contract_blocked: fields.missing_output_contract_blocked,
            failed_runner_blocked: fields.failed_runner_blocked,
            invalid_run_count_blocked: fields.invalid_run_count_blocked,
            diagnostic_count: fields.diagnostic_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            missing_diagnostic_blocked_count: fields.missing_diagnostic_blocked_count,
            rejected_diagnostic_blocked_count: fields.rejected_diagnostic_blocked_count,
            missing_runner_blocked_count: fields.missing_runner_blocked_count,
            missing_output_blocked_count: fields.missing_output_blocked_count,
            missing_memory_evidence_blocked_count: fields.missing_memory_evidence_blocked_count,
            missing_output_contract_blocked_count: fields.missing_output_contract_blocked_count,
            failed_runner_blocked_count: fields.failed_runner_blocked_count,
            invalid_run_count_blocked_count: fields.invalid_run_count_blocked_count,
            last_reason: fields.last_reason,
            c_mimalloc_executed: fields.c_mimalloc_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            hidden_discovery_used: fields.hidden_discovery_used,
            provider_package_generated: fields.provider_package_generated,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    markBlocked(reason: i64) {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_diagnostic_blocked_count += 1
        }
        if reason == 2 {
            me.rejected_diagnostic_blocked_count += 1
        }
        if reason == 3 {
            me.missing_runner_blocked_count += 1
        }
        if reason == 4 {
            me.missing_output_blocked_count += 1
        }
        if reason == 5 {
            me.missing_memory_evidence_blocked_count += 1
        }
        if reason == 6 {
            me.missing_output_contract_blocked_count += 1
        }
        if reason == 7 {
            me.failed_runner_blocked_count += 1
        }
        if reason == 8 {
            me.invalid_run_count_blocked_count += 1
        }
    }

    reasonFrom(report: HakoAllocAllocatorComparisonCMimallocExplicitRunnerExecutionPilotReport): i64 {
        if report.accepted == 1 {
            if report.reason == 0 {
                if report.c_mimalloc_execution_evidence_present == 1 {
                    return 0
                }
            }
        }
        if report.reason != 0 {
            return report.reason
        }
        return 1
    }

    makeReport(reason: i64, report: HakoAllocAllocatorComparisonCMimallocExplicitRunnerExecutionPilotReport): HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport {
        local blocked = 0
        if reason != 0 {
            blocked = 1
        }
        local missing_diag = 0
        local rejected_diag = 0
        local missing_runner = 0
        local missing_output = 0
        local missing_memory = 0
        local missing_contract = 0
        local failed_runner = 0
        local invalid_run = 0
        if reason == 1 {
            missing_diag = 1
        }
        if reason == 2 {
            rejected_diag = 1
        }
        if reason == 3 {
            missing_runner = 1
        }
        if reason == 4 {
            missing_output = 1
        }
        if reason == 5 {
            missing_memory = 1
        }
        if reason == 6 {
            missing_contract = 1
        }
        if reason == 7 {
            failed_runner = 1
        }
        if reason == 8 {
            invalid_run = 1
        }
        local fields = HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReportFields {
            accepted: 1,
            reason: reason,
            diagnostic_present: 1,
            execution_pilot_present: report.execution_pilot_present,
            c_mimalloc_execution_evidence_present: report.c_mimalloc_execution_evidence_present,
            blocked_evidence_present: blocked,
            explicit_runner_invoked: report.explicit_runner_invoked,
            explicit_runner_output_present: report.explicit_runner_output_present,
            explicit_runner_result_code: report.explicit_runner_result_code,
            memory_usage_evidence_present: report.memory_usage_evidence_present,
            stable_output_contract_present: report.stable_output_contract_present,
            run_count: report.run_count,
            allocation_count: report.allocation_count,
            free_count: report.free_count,
            requested_bytes: report.requested_bytes,
            peak_rss_bytes: report.peak_rss_bytes,
            missing_diagnostic_blocked: missing_diag,
            rejected_diagnostic_blocked: rejected_diag,
            missing_runner_blocked: missing_runner,
            missing_output_blocked: missing_output,
            missing_memory_evidence_blocked: missing_memory,
            missing_output_contract_blocked: missing_contract,
            failed_runner_blocked: failed_runner,
            invalid_run_count_blocked: invalid_run,
            diagnostic_count: me.diagnostic_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            missing_diagnostic_blocked_count: me.missing_diagnostic_blocked_count,
            rejected_diagnostic_blocked_count: me.rejected_diagnostic_blocked_count,
            missing_runner_blocked_count: me.missing_runner_blocked_count,
            missing_output_blocked_count: me.missing_output_blocked_count,
            missing_memory_evidence_blocked_count: me.missing_memory_evidence_blocked_count,
            missing_output_contract_blocked_count: me.missing_output_contract_blocked_count,
            failed_runner_blocked_count: me.failed_runner_blocked_count,
            invalid_run_count_blocked_count: me.invalid_run_count_blocked_count,
            last_reason: me.last_reason,
            c_mimalloc_executed: report.c_mimalloc_executed,
            process_replacement_executed: report.process_replacement_executed,
            hook_installed: report.hook_installed,
            backend_matcher_added: report.backend_matcher_added,
            global_allocator_installed: report.global_allocator_installed,
            hidden_discovery_used: report.hidden_discovery_used,
            provider_package_generated: report.provider_package_generated,
            would_replace_host_allocator: report.would_replace_host_allocator,
            would_install_hook: report.would_install_hook,
            would_add_backend_matcher: report.would_add_backend_matcher,
            would_run_thread: report.would_run_thread
        }
        return me.makeAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport(fields)
    }

    diagnoseAllocatorComparisonCMimallocExplicitRunnerEvidence(report: HakoAllocAllocatorComparisonCMimallocExplicitRunnerExecutionPilotReport): HakoAllocAllocatorComparisonCMimallocExplicitRunnerEvidenceDiagnosticReport {
        me.diagnostic_count += 1
        local reason = me.reasonFrom(report)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, report)
    }
}

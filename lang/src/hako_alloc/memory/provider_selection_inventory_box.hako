// provider_selection_inventory_box.hako -- MIMAP-364A
// Responsibility:
// - record a provider selection candidate after provider readiness preflight
// - keep provider activation closed
// Non-responsibility:
// - provider activation, host allocator replacement, hooks, global allocator
//   install, backend matchers, or provider calls

using selfhost.hako_alloc.memory.provider_readiness_preflight_box as HakoAllocProviderReadinessPreflightBox

record HakoAllocProviderSelectionInventoryReportFields {
    accepted: i64
    reason: i64
    selection_present: i64
    readiness_present: i64
    readiness_accepted: i64
    readiness_reason: i64
    readiness_token: i64
    readiness_token_valid: i64
    provider_candidate_token: i64
    provider_candidate_token_valid: i64
    provider_kind: i64
    provider_kind_valid: i64
    provider_activation_inactive: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    selection_count: i64
    accepted_count: i64
    reject_count: i64
    missing_readiness_reject_count: i64
    rejected_readiness_reject_count: i64
    invalid_readiness_token_reject_count: i64
    invalid_candidate_token_reject_count: i64
    invalid_provider_kind_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    would_select_provider: i64
    would_activate_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderSelectionInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    selection_present: i64 = 0
    readiness_present: i64 = 0
    readiness_accepted: i64 = 0
    readiness_reason: i64 = 0
    readiness_token: i64 = 0
    readiness_token_valid: i64 = 0
    provider_candidate_token: i64 = 0
    provider_candidate_token_valid: i64 = 0
    provider_kind: i64 = 0
    provider_kind_valid: i64 = 0
    provider_activation_inactive: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    selection_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_readiness_reject_count: i64 = 0
    rejected_readiness_reject_count: i64 = 0
    invalid_readiness_token_reject_count: i64 = 0
    invalid_candidate_token_reject_count: i64 = 0
    invalid_provider_kind_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    would_select_provider: i64 = 0
    would_activate_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderSelectionInventory {
    selection_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_readiness_reject_count: i64 = 0
    rejected_readiness_reject_count: i64 = 0
    invalid_readiness_token_reject_count: i64 = 0
    invalid_candidate_token_reject_count: i64 = 0
    invalid_provider_kind_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderSelectionInventoryReport(fields: HakoAllocProviderSelectionInventoryReportFields): HakoAllocProviderSelectionInventoryReport {
        local result = new HakoAllocProviderSelectionInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            selection_present: fields.selection_present,
            readiness_present: fields.readiness_present,
            readiness_accepted: fields.readiness_accepted,
            readiness_reason: fields.readiness_reason,
            readiness_token: fields.readiness_token,
            readiness_token_valid: fields.readiness_token_valid,
            provider_candidate_token: fields.provider_candidate_token,
            provider_candidate_token_valid: fields.provider_candidate_token_valid,
            provider_kind: fields.provider_kind,
            provider_kind_valid: fields.provider_kind_valid,
            provider_activation_inactive: fields.provider_activation_inactive,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            selection_count: fields.selection_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_readiness_reject_count: fields.missing_readiness_reject_count,
            rejected_readiness_reject_count: fields.rejected_readiness_reject_count,
            invalid_readiness_token_reject_count: fields.invalid_readiness_token_reject_count,
            invalid_candidate_token_reject_count: fields.invalid_candidate_token_reject_count,
            invalid_provider_kind_reject_count: fields.invalid_provider_kind_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            last_reason: fields.last_reason,
            would_select_provider: fields.would_select_provider,
            would_activate_provider: fields.would_activate_provider,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, ready: HakoAllocProviderReadinessPreflightReport, candidate_token, provider_kind): HakoAllocProviderSelectionInventoryReport {
        local candidate_valid = 0
        if candidate_token > 0 {
            candidate_valid = 1
        }
        local kind_valid = 0
        if provider_kind > 0 {
            kind_valid = 1
        }
        local fields = HakoAllocProviderSelectionInventoryReportFields {
            accepted: accepted,
            reason: reason,
            selection_present: accepted,
            readiness_present: ready.readiness_present,
            readiness_accepted: ready.accepted,
            readiness_reason: ready.reason,
            readiness_token: ready.readiness_token,
            readiness_token_valid: ready.readiness_token_valid,
            provider_candidate_token: candidate_token,
            provider_candidate_token_valid: candidate_valid,
            provider_kind: provider_kind,
            provider_kind_valid: kind_valid,
            provider_activation_inactive: ready.provider_activation_inactive,
            host_replacement_inactive: ready.host_replacement_inactive,
            hooks_inactive: ready.hooks_inactive,
            backend_matcher_inactive: ready.backend_matcher_inactive,
            selection_count: me.selection_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_readiness_reject_count: me.missing_readiness_reject_count,
            rejected_readiness_reject_count: me.rejected_readiness_reject_count,
            invalid_readiness_token_reject_count: me.invalid_readiness_token_reject_count,
            invalid_candidate_token_reject_count: me.invalid_candidate_token_reject_count,
            invalid_provider_kind_reject_count: me.invalid_provider_kind_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            would_select_provider: accepted,
            would_activate_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderSelectionInventoryReport(fields)
    }

    reject(reason, ready: HakoAllocProviderReadinessPreflightReport, candidate_token, provider_kind): HakoAllocProviderSelectionInventoryReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_readiness_reject_count += 1
        }
        if reason == 2 {
            me.rejected_readiness_reject_count += 1
        }
        if reason == 3 {
            me.invalid_readiness_token_reject_count += 1
        }
        if reason == 4 {
            me.invalid_candidate_token_reject_count += 1
        }
        if reason == 5 {
            me.invalid_provider_kind_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, ready, candidate_token, provider_kind)
    }

    inventoryProviderSelection(ready: HakoAllocProviderReadinessPreflightReport, candidate_token, provider_kind): HakoAllocProviderSelectionInventoryReport {
        me.selection_count += 1
        if ready.readiness_present != 1 {
            return me.reject(1, ready, candidate_token, provider_kind)
        }
        if ready.accepted != 1 {
            return me.reject(2, ready, candidate_token, provider_kind)
        }
        if ready.readiness_token_valid != 1 {
            return me.reject(3, ready, candidate_token, provider_kind)
        }
        if candidate_token <= 0 {
            return me.reject(4, ready, candidate_token, provider_kind)
        }
        if provider_kind <= 0 {
            return me.reject(5, ready, candidate_token, provider_kind)
        }
        if ready.would_activate_provider != 0 {
            return me.reject(6, ready, candidate_token, provider_kind)
        }
        if ready.would_replace_host_allocator != 0 {
            return me.reject(6, ready, candidate_token, provider_kind)
        }
        if ready.would_install_hook != 0 {
            return me.reject(6, ready, candidate_token, provider_kind)
        }
        if ready.would_add_backend_matcher != 0 {
            return me.reject(6, ready, candidate_token, provider_kind)
        }
        if ready.would_run_thread != 0 {
            return me.reject(6, ready, candidate_token, provider_kind)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, ready, candidate_token, provider_kind)
    }
}

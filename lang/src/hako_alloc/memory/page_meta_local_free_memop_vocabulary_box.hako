// page_meta_local_free_memop_vocabulary_box.hako -- local free-list MemOp vocabulary
// Responsibility: prove that .hako source can name local free-list operations
// through dedicated FastMemory intrinsics. This opens source/MIR vocabulary
// only; it does not lower free-list mutation, route remote frees, open
// AtomicRemoteHead, transfer TLS backing, or activate product allocation.

static box HakoAllocPageMetaLocalFreeMemopVocabulary {
    localFreeMemopVocabularyProbe(page_table, page_index, block) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local push_marker = mem.localFreePush(page, block)
            local popped = mem.localFreePop(page)
            page.used = popped
        }
        return 0
    }
}

// segment_map_mutation_pilot_box.hako -- MIMAP-347A
// Responsibility:
// - record a bounded segment-map mutation fact from an accepted pointer lookup
// - keep dereference and downstream execution seams closed
// Non-responsibility:
// - dereference, arena release/recycle, atomic bitmap execution, OSVM,
//   worker/TLS, providers, or backend matchers

record HakoAllocSegmentMapMutationPilotReportFields {
    accepted: i64
    reason: i64
    mutation_present: i64
    lookup_present: i64
    lookup_accepted: i64
    lookup_reason: i64
    mutation_token: i64
    mutation_token_valid: i64
    lookup_result_token: i64
    lookup_result_valid: i64
    arena_handle_token: i64
    private_pointer_token: i64
    non_dereferenceable: i64
    closed_execution_blocker_count: i64
    mutation_count: i64
    accepted_count: i64
    reject_count: i64
    missing_lookup_reject_count: i64
    rejected_lookup_reject_count: i64
    dereference_request_reject_count: i64
    invalid_lookup_reject_count: i64
    invalid_mutation_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    report_segment_id: i64
    report_arena_id: i64
    report_lifetime_generation: i64
    report_release_applied_recycle_token: i64
    report_continuation_token: i64
    report_application_token: i64
    report_applied_backing_bytes: usize
    report_applied_committed_bytes: usize
    report_remaining_source_bytes: usize
    would_dereference: i64
    would_release_arena_backing: i64
    would_recycle_arena_backing: i64
    would_mutate_segment_map: i64
    would_execute_atomic_bitmap: i64
    would_call_osvm: i64
    would_run_thread: i64
    would_activate_provider: i64
    would_add_backend_matcher: i64
}

box HakoAllocSegmentMapMutationPilotReport {
    accepted: i64 = 0
    reason: i64 = 0
    mutation_present: i64 = 0
    lookup_present: i64 = 0
    lookup_accepted: i64 = 0
    lookup_reason: i64 = 0
    mutation_token: i64 = 0
    mutation_token_valid: i64 = 0
    lookup_result_token: i64 = 0
    lookup_result_valid: i64 = 0
    arena_handle_token: i64 = 0
    private_pointer_token: i64 = 0
    non_dereferenceable: i64 = 1
    closed_execution_blocker_count: i64 = 0
    mutation_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_lookup_reject_count: i64 = 0
    rejected_lookup_reject_count: i64 = 0
    dereference_request_reject_count: i64 = 0
    invalid_lookup_reject_count: i64 = 0
    invalid_mutation_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    report_segment_id: i64 = -1
    report_arena_id: i64 = -1
    report_lifetime_generation: i64 = 0
    report_release_applied_recycle_token: i64 = 0
    report_continuation_token: i64 = 0
    report_application_token: i64 = 0
    report_applied_backing_bytes: usize = 0
    report_applied_committed_bytes: usize = 0
    report_remaining_source_bytes: usize = 0
    would_dereference: i64 = 0
    would_release_arena_backing: i64 = 0
    would_recycle_arena_backing: i64 = 0
    would_mutate_segment_map: i64 = 0
    would_execute_atomic_bitmap: i64 = 0
    would_call_osvm: i64 = 0
    would_run_thread: i64 = 0
    would_activate_provider: i64 = 0
    would_add_backend_matcher: i64 = 0
}

box HakoAllocSegmentMapMutationPilot {
    mutation_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_lookup_reject_count: i64 = 0
    rejected_lookup_reject_count: i64 = 0
    dereference_request_reject_count: i64 = 0
    invalid_lookup_reject_count: i64 = 0
    invalid_mutation_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    closedExecutionBlockerCount(lookup_report): i64 {
        local count = 0
        if lookup_report.would_release_arena_backing != 0 {
            count += 1
        }
        if lookup_report.would_recycle_arena_backing != 0 {
            count += 1
        }
        if lookup_report.would_execute_atomic_bitmap != 0 {
            count += 1
        }
        if lookup_report.would_call_osvm != 0 {
            count += 1
        }
        if lookup_report.would_run_thread != 0 {
            count += 1
        }
        if lookup_report.would_activate_provider != 0 {
            count += 1
        }
        if lookup_report.would_add_backend_matcher != 0 {
            count += 1
        }
        return count
    }

    makeSegmentMapMutationPilotReport(fields: HakoAllocSegmentMapMutationPilotReportFields): HakoAllocSegmentMapMutationPilotReport {
        local result = new HakoAllocSegmentMapMutationPilotReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.mutation_present = fields.mutation_present
        result.lookup_present = fields.lookup_present
        result.lookup_accepted = fields.lookup_accepted
        result.lookup_reason = fields.lookup_reason
        result.mutation_token = fields.mutation_token
        result.mutation_token_valid = fields.mutation_token_valid
        result.lookup_result_token = fields.lookup_result_token
        result.lookup_result_valid = fields.lookup_result_valid
        result.arena_handle_token = fields.arena_handle_token
        result.private_pointer_token = fields.private_pointer_token
        result.non_dereferenceable = fields.non_dereferenceable
        result.closed_execution_blocker_count = fields.closed_execution_blocker_count
        result.mutation_count = fields.mutation_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_lookup_reject_count = fields.missing_lookup_reject_count
        result.rejected_lookup_reject_count = fields.rejected_lookup_reject_count
        result.dereference_request_reject_count = fields.dereference_request_reject_count
        result.invalid_lookup_reject_count = fields.invalid_lookup_reject_count
        result.invalid_mutation_reject_count = fields.invalid_mutation_reject_count
        result.closed_execution_reject_count = fields.closed_execution_reject_count
        result.last_reason = fields.last_reason
        result.report_segment_id = fields.report_segment_id
        result.report_arena_id = fields.report_arena_id
        result.report_lifetime_generation = fields.report_lifetime_generation
        result.report_release_applied_recycle_token = fields.report_release_applied_recycle_token
        result.report_continuation_token = fields.report_continuation_token
        result.report_application_token = fields.report_application_token
        result.report_applied_backing_bytes = fields.report_applied_backing_bytes
        result.report_applied_committed_bytes = fields.report_applied_committed_bytes
        result.report_remaining_source_bytes = fields.report_remaining_source_bytes
        result.would_dereference = fields.would_dereference
        result.would_release_arena_backing = fields.would_release_arena_backing
        result.would_recycle_arena_backing = fields.would_recycle_arena_backing
        result.would_mutate_segment_map = fields.would_mutate_segment_map
        result.would_execute_atomic_bitmap = fields.would_execute_atomic_bitmap
        result.would_call_osvm = fields.would_call_osvm
        result.would_run_thread = fields.would_run_thread
        result.would_activate_provider = fields.would_activate_provider
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        return result
    }

    makeReport(accepted, reason, mutation_present, lookup_report, mutation_token): HakoAllocSegmentMapMutationPilotReport {
        local mutation_token_valid = 0
        if mutation_token > 0 {
            mutation_token_valid = 1
        }
        local fields = HakoAllocSegmentMapMutationPilotReportFields {
            accepted: accepted,
            reason: reason,
            mutation_present: mutation_present,
            lookup_present: lookup_report.lookup_present,
            lookup_accepted: lookup_report.accepted,
            lookup_reason: lookup_report.reason,
            mutation_token: mutation_token,
            mutation_token_valid: mutation_token_valid,
            lookup_result_token: lookup_report.lookup_result_token,
            lookup_result_valid: lookup_report.lookup_result_valid,
            arena_handle_token: lookup_report.arena_handle_token,
            private_pointer_token: lookup_report.private_pointer_token,
            non_dereferenceable: lookup_report.non_dereferenceable,
            closed_execution_blocker_count: me.closedExecutionBlockerCount(lookup_report),
            mutation_count: me.mutation_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_lookup_reject_count: me.missing_lookup_reject_count,
            rejected_lookup_reject_count: me.rejected_lookup_reject_count,
            dereference_request_reject_count: me.dereference_request_reject_count,
            invalid_lookup_reject_count: me.invalid_lookup_reject_count,
            invalid_mutation_reject_count: me.invalid_mutation_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            report_segment_id: lookup_report.report_segment_id,
            report_arena_id: lookup_report.report_arena_id,
            report_lifetime_generation: lookup_report.report_lifetime_generation,
            report_release_applied_recycle_token: lookup_report.report_release_applied_recycle_token,
            report_continuation_token: lookup_report.report_continuation_token,
            report_application_token: lookup_report.report_application_token,
            report_applied_backing_bytes: lookup_report.report_applied_backing_bytes,
            report_applied_committed_bytes: lookup_report.report_applied_committed_bytes,
            report_remaining_source_bytes: lookup_report.report_remaining_source_bytes,
            would_dereference: 0,
            would_release_arena_backing: lookup_report.would_release_arena_backing,
            would_recycle_arena_backing: lookup_report.would_recycle_arena_backing,
            would_mutate_segment_map: mutation_present,
            would_execute_atomic_bitmap: lookup_report.would_execute_atomic_bitmap,
            would_call_osvm: lookup_report.would_call_osvm,
            would_run_thread: lookup_report.would_run_thread,
            would_activate_provider: lookup_report.would_activate_provider,
            would_add_backend_matcher: lookup_report.would_add_backend_matcher
        }
        return me.makeSegmentMapMutationPilotReport(fields)
    }

    reject(reason, lookup_report, mutation_token): HakoAllocSegmentMapMutationPilotReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_lookup_reject_count += 1
        }
        if reason == 2 {
            me.rejected_lookup_reject_count += 1
        }
        if reason == 3 {
            me.dereference_request_reject_count += 1
        }
        if reason == 4 {
            me.invalid_lookup_reject_count += 1
        }
        if reason == 5 {
            me.invalid_mutation_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, 0, lookup_report, mutation_token)
    }

    recordSegmentMapMutation(lookup_report, mutation_token): HakoAllocSegmentMapMutationPilotReport {
        me.mutation_count += 1
        if lookup_report.lookup_present != 1 {
            return me.reject(1, lookup_report, mutation_token)
        }
        if lookup_report.accepted != 1 {
            return me.reject(2, lookup_report, mutation_token)
        }
        if lookup_report.non_dereferenceable != 1 {
            return me.reject(3, lookup_report, mutation_token)
        }
        if lookup_report.would_dereference != 0 {
            return me.reject(3, lookup_report, mutation_token)
        }
        if lookup_report.lookup_result_token <= 0 {
            return me.reject(4, lookup_report, mutation_token)
        }
        if lookup_report.lookup_result_valid != 1 {
            return me.reject(4, lookup_report, mutation_token)
        }
        if mutation_token <= 0 {
            return me.reject(5, lookup_report, mutation_token)
        }
        if me.closedExecutionBlockerCount(lookup_report) != 0 {
            return me.reject(6, lookup_report, mutation_token)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, lookup_report, mutation_token)
    }
}

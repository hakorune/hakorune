// host_replacement_explicit_preflight_inventory_box.hako -- MIMAP-420A
// Responsibility:
// - consume real external provider API call first-pattern evidence
// - inventory explicit host-replacement preflight inputs
// Non-responsibility:
// - hook installation, backend matcher additions, process allocator
//   replacement, global allocator install, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.real_external_provider_api_call_first_pattern_pilot_box as HakoAllocRealExternalProviderApiCallFirstPatternPilot

record HakoAllocHostReplacementExplicitPreflightInventoryReportFields {
    accepted: i64
    reason: i64
    host_replacement_preflight_inventory_present: i64
    host_replacement_preflight_ready: i64
    real_external_call_present: i64
    real_external_call_accepted: i64
    real_external_call_executed: i64
    real_external_call_result_present: i64
    actual_external_provider_api_call_executed: i64
    explicit_request_present: i64
    hook_plan_present: i64
    rollback_plan_present: i64
    backend_no_growth_present: i64
    host_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    inventory_count: i64
    accepted_count: i64
    reject_count: i64
    missing_real_call_reject_count: i64
    rejected_real_call_reject_count: i64
    not_ready_reject_count: i64
    missing_explicit_request_reject_count: i64
    missing_hook_plan_reject_count: i64
    missing_rollback_plan_reject_count: i64
    missing_backend_no_growth_reject_count: i64
    closed_seam_reject_count: i64
    last_reason: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocHostReplacementExplicitPreflightInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    host_replacement_preflight_inventory_present: i64 = 0
    host_replacement_preflight_ready: i64 = 0
    real_external_call_present: i64 = 0
    real_external_call_accepted: i64 = 0
    real_external_call_executed: i64 = 0
    real_external_call_result_present: i64 = 0
    actual_external_provider_api_call_executed: i64 = 0
    explicit_request_present: i64 = 0
    hook_plan_present: i64 = 0
    rollback_plan_present: i64 = 0
    backend_no_growth_present: i64 = 0
    host_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_real_call_reject_count: i64 = 0
    rejected_real_call_reject_count: i64 = 0
    not_ready_reject_count: i64 = 0
    missing_explicit_request_reject_count: i64 = 0
    missing_hook_plan_reject_count: i64 = 0
    missing_rollback_plan_reject_count: i64 = 0
    missing_backend_no_growth_reject_count: i64 = 0
    closed_seam_reject_count: i64 = 0
    last_reason: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocHostReplacementExplicitPreflightInventory {
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_real_call_reject_count: i64 = 0
    rejected_real_call_reject_count: i64 = 0
    not_ready_reject_count: i64 = 0
    missing_explicit_request_reject_count: i64 = 0
    missing_hook_plan_reject_count: i64 = 0
    missing_rollback_plan_reject_count: i64 = 0
    missing_backend_no_growth_reject_count: i64 = 0
    closed_seam_reject_count: i64 = 0
    last_reason: i64 = 0

    makeHostReplacementExplicitPreflightInventoryReport(fields: HakoAllocHostReplacementExplicitPreflightInventoryReportFields): HakoAllocHostReplacementExplicitPreflightInventoryReport {
        local result = new HakoAllocHostReplacementExplicitPreflightInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            host_replacement_preflight_inventory_present: fields.host_replacement_preflight_inventory_present,
            host_replacement_preflight_ready: fields.host_replacement_preflight_ready,
            real_external_call_present: fields.real_external_call_present,
            real_external_call_accepted: fields.real_external_call_accepted,
            real_external_call_executed: fields.real_external_call_executed,
            real_external_call_result_present: fields.real_external_call_result_present,
            actual_external_provider_api_call_executed: fields.actual_external_provider_api_call_executed,
            explicit_request_present: fields.explicit_request_present,
            hook_plan_present: fields.hook_plan_present,
            rollback_plan_present: fields.rollback_plan_present,
            backend_no_growth_present: fields.backend_no_growth_present,
            host_replacement_executed: fields.host_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            inventory_count: fields.inventory_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_real_call_reject_count: fields.missing_real_call_reject_count,
            rejected_real_call_reject_count: fields.rejected_real_call_reject_count,
            not_ready_reject_count: fields.not_ready_reject_count,
            missing_explicit_request_reject_count: fields.missing_explicit_request_reject_count,
            missing_hook_plan_reject_count: fields.missing_hook_plan_reject_count,
            missing_rollback_plan_reject_count: fields.missing_rollback_plan_reject_count,
            missing_backend_no_growth_reject_count: fields.missing_backend_no_growth_reject_count,
            closed_seam_reject_count: fields.closed_seam_reject_count,
            last_reason: fields.last_reason,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(
        accepted: i64,
        reason: i64,
        real_call: HakoAllocRealExternalProviderApiCallFirstPatternPilotReport,
        explicit_request_present: i64,
        hook_plan_present: i64,
        rollback_plan_present: i64,
        backend_no_growth_present: i64
    ): HakoAllocHostReplacementExplicitPreflightInventoryReport {
        local fields = HakoAllocHostReplacementExplicitPreflightInventoryReportFields {
            accepted: accepted,
            reason: reason,
            host_replacement_preflight_inventory_present: accepted,
            host_replacement_preflight_ready: accepted,
            real_external_call_present: real_call.first_pattern_present,
            real_external_call_accepted: real_call.accepted,
            real_external_call_executed: real_call.real_external_provider_api_call_executed,
            real_external_call_result_present: real_call.real_external_provider_api_result_present,
            actual_external_provider_api_call_executed: real_call.actual_external_provider_api_call_executed,
            explicit_request_present: explicit_request_present,
            hook_plan_present: hook_plan_present,
            rollback_plan_present: rollback_plan_present,
            backend_no_growth_present: backend_no_growth_present,
            host_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            inventory_count: me.inventory_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_real_call_reject_count: me.missing_real_call_reject_count,
            rejected_real_call_reject_count: me.rejected_real_call_reject_count,
            not_ready_reject_count: me.not_ready_reject_count,
            missing_explicit_request_reject_count: me.missing_explicit_request_reject_count,
            missing_hook_plan_reject_count: me.missing_hook_plan_reject_count,
            missing_rollback_plan_reject_count: me.missing_rollback_plan_reject_count,
            missing_backend_no_growth_reject_count: me.missing_backend_no_growth_reject_count,
            closed_seam_reject_count: me.closed_seam_reject_count,
            last_reason: me.last_reason,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeHostReplacementExplicitPreflightInventoryReport(fields)
    }

    reject(
        reason: i64,
        real_call: HakoAllocRealExternalProviderApiCallFirstPatternPilotReport,
        explicit_request_present: i64,
        hook_plan_present: i64,
        rollback_plan_present: i64,
        backend_no_growth_present: i64
    ): HakoAllocHostReplacementExplicitPreflightInventoryReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_real_call_reject_count += 1
        }
        if reason == 2 {
            me.rejected_real_call_reject_count += 1
        }
        if reason == 3 {
            me.not_ready_reject_count += 1
        }
        if reason == 4 {
            me.missing_explicit_request_reject_count += 1
        }
        if reason == 5 {
            me.missing_hook_plan_reject_count += 1
        }
        if reason == 6 {
            me.missing_rollback_plan_reject_count += 1
        }
        if reason == 7 {
            me.missing_backend_no_growth_reject_count += 1
        }
        if reason == 8 {
            me.closed_seam_reject_count += 1
        }
        return me.makeReport(0, reason, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
    }

    inventoryHostReplacementExplicitPreflight(
        real_call: HakoAllocRealExternalProviderApiCallFirstPatternPilotReport,
        explicit_request_present: i64,
        hook_plan_present: i64,
        rollback_plan_present: i64,
        backend_no_growth_present: i64
    ): HakoAllocHostReplacementExplicitPreflightInventoryReport {
        me.inventory_count += 1
        if real_call.first_pattern_present != 1 {
            return me.reject(1, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.accepted != 1 {
            return me.reject(2, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.real_external_provider_api_call_executed != 1 {
            return me.reject(3, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.real_external_provider_api_result_present != 1 {
            return me.reject(3, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.actual_external_provider_api_call_executed != 1 {
            return me.reject(3, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if explicit_request_present != 1 {
            return me.reject(4, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if hook_plan_present != 1 {
            return me.reject(5, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if rollback_plan_present != 1 {
            return me.reject(6, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if backend_no_growth_present != 1 {
            return me.reject(7, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.host_replacement_inactive != 1 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.hooks_inactive != 1 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.backend_matcher_inactive != 1 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.would_replace_host_allocator != 0 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.would_install_hook != 0 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.would_add_backend_matcher != 0 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }
        if real_call.would_run_thread != 0 {
            return me.reject(8, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, real_call, explicit_request_present, hook_plan_present, rollback_plan_present, backend_no_growth_present)
    }
}

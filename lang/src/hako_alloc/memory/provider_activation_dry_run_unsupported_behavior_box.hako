// provider_activation_dry_run_unsupported_behavior_box.hako -- MIMAP-378A
// Responsibility:
// - consume an explicit provider activation input bundle
// - record a dry-run unsupported activation outcome
// Non-responsibility:
// - provider activation, provider API calls, host allocator replacement, hooks,
//   global allocator install, backend matchers, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.provider_activation_input_bundle_inventory_box as HakoAllocProviderActivationInputBundleInventory

record HakoAllocProviderActivationDryRunUnsupportedBehaviorReportFields {
    accepted: i64
    reason: i64
    dry_run_attempted: i64
    unsupported_outcome_present: i64
    bundle_present: i64
    bundle_accepted: i64
    bundle_reason: i64
    provider_candidate_token: i64
    provider_candidate_token_valid: i64
    provider_kind: i64
    provider_kind_valid: i64
    activation_request_token: i64
    activation_request_token_valid: i64
    activation_mode: i64
    activation_mode_valid: i64
    explicit_input_present: i64
    provider_activation_unsupported: i64
    provider_activation_inactive: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    dry_run_count: i64
    accepted_count: i64
    reject_count: i64
    missing_bundle_reject_count: i64
    rejected_bundle_reject_count: i64
    invalid_request_token_reject_count: i64
    invalid_mode_reject_count: i64
    unsupported_evidence_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderActivationDryRunUnsupportedBehaviorReport {
    accepted: i64 = 0
    reason: i64 = 0
    dry_run_attempted: i64 = 0
    unsupported_outcome_present: i64 = 0
    bundle_present: i64 = 0
    bundle_accepted: i64 = 0
    bundle_reason: i64 = 0
    provider_candidate_token: i64 = 0
    provider_candidate_token_valid: i64 = 0
    provider_kind: i64 = 0
    provider_kind_valid: i64 = 0
    activation_request_token: i64 = 0
    activation_request_token_valid: i64 = 0
    activation_mode: i64 = 0
    activation_mode_valid: i64 = 0
    explicit_input_present: i64 = 0
    provider_activation_unsupported: i64 = 1
    provider_activation_inactive: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    dry_run_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_bundle_reject_count: i64 = 0
    rejected_bundle_reject_count: i64 = 0
    invalid_request_token_reject_count: i64 = 0
    invalid_mode_reject_count: i64 = 0
    unsupported_evidence_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderActivationDryRunUnsupportedBehavior {
    dry_run_count: usize = 0
    accepted_count: usize = 0
    reject_count: usize = 0
    missing_bundle_reject_count: usize = 0
    rejected_bundle_reject_count: usize = 0
    invalid_request_token_reject_count: usize = 0
    invalid_mode_reject_count: usize = 0
    unsupported_evidence_reject_count: usize = 0
    closed_execution_reject_count: usize = 0
    last_reason: i64 = 0

    makeProviderActivationDryRunUnsupportedBehaviorReport(fields: HakoAllocProviderActivationDryRunUnsupportedBehaviorReportFields): HakoAllocProviderActivationDryRunUnsupportedBehaviorReport {
        local result = new HakoAllocProviderActivationDryRunUnsupportedBehaviorReport {
            accepted: fields.accepted,
            reason: fields.reason,
            dry_run_attempted: fields.dry_run_attempted,
            unsupported_outcome_present: fields.unsupported_outcome_present,
            bundle_present: fields.bundle_present,
            bundle_accepted: fields.bundle_accepted,
            bundle_reason: fields.bundle_reason,
            provider_candidate_token: fields.provider_candidate_token,
            provider_candidate_token_valid: fields.provider_candidate_token_valid,
            provider_kind: fields.provider_kind,
            provider_kind_valid: fields.provider_kind_valid,
            activation_request_token: fields.activation_request_token,
            activation_request_token_valid: fields.activation_request_token_valid,
            activation_mode: fields.activation_mode,
            activation_mode_valid: fields.activation_mode_valid,
            explicit_input_present: fields.explicit_input_present,
            provider_activation_unsupported: fields.provider_activation_unsupported,
            provider_activation_inactive: fields.provider_activation_inactive,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            dry_run_count: fields.dry_run_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_bundle_reject_count: fields.missing_bundle_reject_count,
            rejected_bundle_reject_count: fields.rejected_bundle_reject_count,
            invalid_request_token_reject_count: fields.invalid_request_token_reject_count,
            invalid_mode_reject_count: fields.invalid_mode_reject_count,
            unsupported_evidence_reject_count: fields.unsupported_evidence_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            last_reason: fields.last_reason,
            would_activate_provider: fields.would_activate_provider,
            would_call_provider: fields.would_call_provider,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, bundle: HakoAllocProviderActivationInputBundleInventoryReport): HakoAllocProviderActivationDryRunUnsupportedBehaviorReport {
        local fields = HakoAllocProviderActivationDryRunUnsupportedBehaviorReportFields {
            accepted: accepted,
            reason: reason,
            dry_run_attempted: accepted,
            unsupported_outcome_present: accepted,
            bundle_present: bundle.bundle_present,
            bundle_accepted: bundle.accepted,
            bundle_reason: bundle.reason,
            provider_candidate_token: bundle.provider_candidate_token,
            provider_candidate_token_valid: bundle.provider_candidate_token_valid,
            provider_kind: bundle.provider_kind,
            provider_kind_valid: bundle.provider_kind_valid,
            activation_request_token: bundle.activation_request_token,
            activation_request_token_valid: bundle.activation_request_token_valid,
            activation_mode: bundle.activation_mode,
            activation_mode_valid: bundle.activation_mode_valid,
            explicit_input_present: bundle.explicit_input_present,
            provider_activation_unsupported: bundle.provider_activation_unsupported,
            provider_activation_inactive: bundle.provider_activation_inactive,
            host_replacement_inactive: bundle.host_replacement_inactive,
            hooks_inactive: bundle.hooks_inactive,
            backend_matcher_inactive: bundle.backend_matcher_inactive,
            dry_run_count: me.dry_run_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_bundle_reject_count: me.missing_bundle_reject_count,
            rejected_bundle_reject_count: me.rejected_bundle_reject_count,
            invalid_request_token_reject_count: me.invalid_request_token_reject_count,
            invalid_mode_reject_count: me.invalid_mode_reject_count,
            unsupported_evidence_reject_count: me.unsupported_evidence_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: 0,
            would_call_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderActivationDryRunUnsupportedBehaviorReport(fields)
    }

    reject(reason, bundle: HakoAllocProviderActivationInputBundleInventoryReport): HakoAllocProviderActivationDryRunUnsupportedBehaviorReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_bundle_reject_count += 1
        }
        if reason == 2 {
            me.rejected_bundle_reject_count += 1
        }
        if reason == 3 {
            me.invalid_request_token_reject_count += 1
        }
        if reason == 4 {
            me.invalid_mode_reject_count += 1
        }
        if reason == 5 {
            me.unsupported_evidence_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, bundle)
    }

    dryRunProviderActivationUnsupported(bundle: HakoAllocProviderActivationInputBundleInventoryReport): HakoAllocProviderActivationDryRunUnsupportedBehaviorReport {
        me.dry_run_count += 1
        if bundle.bundle_present != 1 {
            return me.reject(1, bundle)
        }
        if bundle.accepted != 1 {
            return me.reject(2, bundle)
        }
        if bundle.activation_request_token_valid != 1 {
            return me.reject(3, bundle)
        }
        if bundle.activation_mode_valid != 1 {
            return me.reject(4, bundle)
        }
        if bundle.provider_activation_unsupported != 1 {
            return me.reject(5, bundle)
        }
        if bundle.provider_activation_inactive != 1 {
            return me.reject(5, bundle)
        }
        if bundle.host_replacement_inactive != 1 {
            return me.reject(6, bundle)
        }
        if bundle.hooks_inactive != 1 {
            return me.reject(6, bundle)
        }
        if bundle.backend_matcher_inactive != 1 {
            return me.reject(6, bundle)
        }
        if bundle.would_activate_provider != 0 {
            return me.reject(6, bundle)
        }
        if bundle.would_call_provider != 0 {
            return me.reject(6, bundle)
        }
        if bundle.would_replace_host_allocator != 0 {
            return me.reject(6, bundle)
        }
        if bundle.would_install_hook != 0 {
            return me.reject(6, bundle)
        }
        if bundle.would_add_backend_matcher != 0 {
            return me.reject(6, bundle)
        }
        if bundle.would_run_thread != 0 {
            return me.reject(6, bundle)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, bundle)
    }
}

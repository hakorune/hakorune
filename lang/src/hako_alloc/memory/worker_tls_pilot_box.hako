// worker_tls_pilot_box.hako -- MIMAP-350A
// Responsibility:
// - record a bounded worker/TLS fact from an accepted OSVM/page-source fact
// - compose the existing HakoAllocWorkerTlsCache internal substrate seam
// Non-responsibility:
// - source-level worker-local syntax, worker scheduling, provider activation,
//   host allocator replacement, hooks, or backend matchers

using selfhost.hako_alloc.memory.osvm_page_source_pilot_box as HakoAllocOSVMPageSourcePilotBox
using selfhost.hako_alloc.memory.worker_tls_cache_box as HakoAllocWorkerTlsCacheBox

record HakoAllocWorkerTlsPilotReportFields {
    accepted: i64
    reason: i64
    worker_tls_present: i64
    page_source_present: i64
    page_source_accepted: i64
    page_source_reason: i64
    page_source_token: i64
    bitmap_token: i64
    mutation_token: i64
    lookup_result_token: i64
    arena_handle_token: i64
    private_pointer_token: i64
    worker_id: i64
    worker_id_valid: i64
    tls_slot: i64
    tls_slot_valid: i64
    tls_stored_value: i64
    tls_loaded_value: i64
    tls_cleared_value: i64
    tls_store_rc: i64
    tls_clear_rc: i64
    tls_roundtrip_ok: i64
    worker_tls_count: i64
    accepted_count: i64
    reject_count: i64
    missing_page_source_reject_count: i64
    rejected_page_source_reject_count: i64
    invalid_worker_reject_count: i64
    invalid_tls_slot_reject_count: i64
    tls_roundtrip_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    report_segment_id: i64
    report_arena_id: i64
    report_lifetime_generation: i64
    report_release_applied_recycle_token: i64
    report_continuation_token: i64
    report_application_token: i64
    report_applied_backing_bytes: usize
    report_applied_committed_bytes: usize
    report_remaining_source_bytes: usize
    would_dereference: i64
    would_release_arena_backing: i64
    would_recycle_arena_backing: i64
    would_mutate_segment_map: i64
    would_execute_atomic_bitmap: i64
    would_call_osvm: i64
    would_use_worker_tls: i64
    would_run_thread: i64
    would_activate_provider: i64
    would_add_backend_matcher: i64
}

box HakoAllocWorkerTlsPilotReport {
    accepted: i64 = 0
    reason: i64 = 0
    worker_tls_present: i64 = 0
    page_source_present: i64 = 0
    page_source_accepted: i64 = 0
    page_source_reason: i64 = 0
    page_source_token: i64 = 0
    bitmap_token: i64 = 0
    mutation_token: i64 = 0
    lookup_result_token: i64 = 0
    arena_handle_token: i64 = 0
    private_pointer_token: i64 = 0
    worker_id: i64 = -1
    worker_id_valid: i64 = 0
    tls_slot: i64 = -1
    tls_slot_valid: i64 = 0
    tls_stored_value: i64 = 0
    tls_loaded_value: i64 = 0
    tls_cleared_value: i64 = 0
    tls_store_rc: i64 = -1
    tls_clear_rc: i64 = -1
    tls_roundtrip_ok: i64 = 0
    worker_tls_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_page_source_reject_count: i64 = 0
    rejected_page_source_reject_count: i64 = 0
    invalid_worker_reject_count: i64 = 0
    invalid_tls_slot_reject_count: i64 = 0
    tls_roundtrip_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    report_segment_id: i64 = -1
    report_arena_id: i64 = -1
    report_lifetime_generation: i64 = 0
    report_release_applied_recycle_token: i64 = 0
    report_continuation_token: i64 = 0
    report_application_token: i64 = 0
    report_applied_backing_bytes: usize = 0
    report_applied_committed_bytes: usize = 0
    report_remaining_source_bytes: usize = 0
    would_dereference: i64 = 0
    would_release_arena_backing: i64 = 0
    would_recycle_arena_backing: i64 = 0
    would_mutate_segment_map: i64 = 0
    would_execute_atomic_bitmap: i64 = 0
    would_call_osvm: i64 = 0
    would_use_worker_tls: i64 = 0
    would_run_thread: i64 = 0
    would_activate_provider: i64 = 0
    would_add_backend_matcher: i64 = 0
}

box HakoAllocWorkerTlsPilot {
    cache: HakoAllocWorkerTlsCache = new HakoAllocWorkerTlsCache()
    worker_tls_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_page_source_reject_count: i64 = 0
    rejected_page_source_reject_count: i64 = 0
    invalid_worker_reject_count: i64 = 0
    invalid_tls_slot_reject_count: i64 = 0
    tls_roundtrip_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    closedExecutionBlockerCount(page_report: HakoAllocOSVMPageSourcePilotReport): i64 {
        local count = 0
        if page_report.would_dereference != 0 {
            count += 1
        }
        if page_report.would_release_arena_backing != 0 {
            count += 1
        }
        if page_report.would_recycle_arena_backing != 0 {
            count += 1
        }
        if page_report.would_run_thread != 0 {
            count += 1
        }
        if page_report.would_activate_provider != 0 {
            count += 1
        }
        if page_report.would_add_backend_matcher != 0 {
            count += 1
        }
        return count
    }

    makeWorkerTlsPilotReport(fields: HakoAllocWorkerTlsPilotReportFields): HakoAllocWorkerTlsPilotReport {
        local result = new HakoAllocWorkerTlsPilotReport {
            accepted: fields.accepted,
            reason: fields.reason,
            worker_tls_present: fields.worker_tls_present,
            page_source_present: fields.page_source_present,
            page_source_accepted: fields.page_source_accepted,
            page_source_reason: fields.page_source_reason,
            page_source_token: fields.page_source_token,
            bitmap_token: fields.bitmap_token,
            mutation_token: fields.mutation_token,
            lookup_result_token: fields.lookup_result_token,
            arena_handle_token: fields.arena_handle_token,
            private_pointer_token: fields.private_pointer_token,
            worker_id: fields.worker_id,
            worker_id_valid: fields.worker_id_valid,
            tls_slot: fields.tls_slot,
            tls_slot_valid: fields.tls_slot_valid,
            tls_stored_value: fields.tls_stored_value,
            tls_loaded_value: fields.tls_loaded_value,
            tls_cleared_value: fields.tls_cleared_value,
            tls_store_rc: fields.tls_store_rc,
            tls_clear_rc: fields.tls_clear_rc,
            tls_roundtrip_ok: fields.tls_roundtrip_ok,
            worker_tls_count: fields.worker_tls_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_page_source_reject_count: fields.missing_page_source_reject_count,
            rejected_page_source_reject_count: fields.rejected_page_source_reject_count,
            invalid_worker_reject_count: fields.invalid_worker_reject_count,
            invalid_tls_slot_reject_count: fields.invalid_tls_slot_reject_count,
            tls_roundtrip_reject_count: fields.tls_roundtrip_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            last_reason: fields.last_reason,
            report_segment_id: fields.report_segment_id,
            report_arena_id: fields.report_arena_id,
            report_lifetime_generation: fields.report_lifetime_generation,
            report_release_applied_recycle_token: fields.report_release_applied_recycle_token,
            report_continuation_token: fields.report_continuation_token,
            report_application_token: fields.report_application_token,
            report_applied_backing_bytes: fields.report_applied_backing_bytes,
            report_applied_committed_bytes: fields.report_applied_committed_bytes,
            report_remaining_source_bytes: fields.report_remaining_source_bytes,
            would_dereference: fields.would_dereference,
            would_release_arena_backing: fields.would_release_arena_backing,
            would_recycle_arena_backing: fields.would_recycle_arena_backing,
            would_mutate_segment_map: fields.would_mutate_segment_map,
            would_execute_atomic_bitmap: fields.would_execute_atomic_bitmap,
            would_call_osvm: fields.would_call_osvm,
            would_use_worker_tls: fields.would_use_worker_tls,
            would_run_thread: fields.would_run_thread,
            would_activate_provider: fields.would_activate_provider,
            would_add_backend_matcher: fields.would_add_backend_matcher
        }
        return result
    }

    makeReport(accepted, reason, worker_tls_present, page_report: HakoAllocOSVMPageSourcePilotReport, slot, stored_value, loaded_value, cleared_value, store_rc, clear_rc, roundtrip_ok): HakoAllocWorkerTlsPilotReport {
        local worker_id = me.cache.lastWorkerId()
        local worker_id_valid = 0
        if worker_id >= 0 {
            worker_id_valid = 1
        }
        local tls_slot_valid = 0
        if slot >= 0 {
            tls_slot_valid = 1
        }
        local fields = HakoAllocWorkerTlsPilotReportFields {
            accepted: accepted,
            reason: reason,
            worker_tls_present: worker_tls_present,
            page_source_present: page_report.page_source_present,
            page_source_accepted: page_report.accepted,
            page_source_reason: page_report.reason,
            page_source_token: page_report.page_source_token,
            bitmap_token: page_report.bitmap_token,
            mutation_token: page_report.mutation_token,
            lookup_result_token: page_report.lookup_result_token,
            arena_handle_token: page_report.arena_handle_token,
            private_pointer_token: page_report.private_pointer_token,
            worker_id: worker_id,
            worker_id_valid: worker_id_valid,
            tls_slot: slot,
            tls_slot_valid: tls_slot_valid,
            tls_stored_value: stored_value,
            tls_loaded_value: loaded_value,
            tls_cleared_value: cleared_value,
            tls_store_rc: store_rc,
            tls_clear_rc: clear_rc,
            tls_roundtrip_ok: roundtrip_ok,
            worker_tls_count: me.worker_tls_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_page_source_reject_count: me.missing_page_source_reject_count,
            rejected_page_source_reject_count: me.rejected_page_source_reject_count,
            invalid_worker_reject_count: me.invalid_worker_reject_count,
            invalid_tls_slot_reject_count: me.invalid_tls_slot_reject_count,
            tls_roundtrip_reject_count: me.tls_roundtrip_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            report_segment_id: page_report.report_segment_id,
            report_arena_id: page_report.report_arena_id,
            report_lifetime_generation: page_report.report_lifetime_generation,
            report_release_applied_recycle_token: page_report.report_release_applied_recycle_token,
            report_continuation_token: page_report.report_continuation_token,
            report_application_token: page_report.report_application_token,
            report_applied_backing_bytes: page_report.report_applied_backing_bytes,
            report_applied_committed_bytes: page_report.report_applied_committed_bytes,
            report_remaining_source_bytes: page_report.report_remaining_source_bytes,
            would_dereference: 0,
            would_release_arena_backing: page_report.would_release_arena_backing,
            would_recycle_arena_backing: page_report.would_recycle_arena_backing,
            would_mutate_segment_map: page_report.would_mutate_segment_map,
            would_execute_atomic_bitmap: page_report.would_execute_atomic_bitmap,
            would_call_osvm: page_report.would_call_osvm,
            would_use_worker_tls: worker_tls_present,
            would_run_thread: 0,
            would_activate_provider: page_report.would_activate_provider,
            would_add_backend_matcher: page_report.would_add_backend_matcher
        }
        return me.makeWorkerTlsPilotReport(fields)
    }

    reject(reason, page_report: HakoAllocOSVMPageSourcePilotReport, slot, stored_value, loaded_value, cleared_value, store_rc, clear_rc, roundtrip_ok): HakoAllocWorkerTlsPilotReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_page_source_reject_count += 1
        }
        if reason == 2 {
            me.rejected_page_source_reject_count += 1
        }
        if reason == 3 {
            me.invalid_worker_reject_count += 1
        }
        if reason == 4 {
            me.invalid_tls_slot_reject_count += 1
        }
        if reason == 5 {
            me.tls_roundtrip_reject_count += 1
        }
        if reason == 6 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, 0, page_report, slot, stored_value, loaded_value, cleared_value, store_rc, clear_rc, roundtrip_ok)
    }

    recordWorkerTlsFact(page_report: HakoAllocOSVMPageSourcePilotReport, slot, value): HakoAllocWorkerTlsPilotReport {
        me.worker_tls_count += 1
        if page_report.page_source_present != 1 {
            return me.reject(1, page_report, slot, 0, 0, 0, -1, -1, 0)
        }
        if page_report.accepted != 1 {
            return me.reject(2, page_report, slot, 0, 0, 0, -1, -1, 0)
        }
        if slot < 0 {
            return me.reject(4, page_report, slot, 0, 0, 0, -1, -1, 0)
        }
        if me.closedExecutionBlockerCount(page_report) != 0 {
            return me.reject(6, page_report, slot, 0, 0, 0, -1, -1, 0)
        }

        local store_rc = me.cache.storeSlot(slot, value)
        local loaded_value = me.cache.loadSlot(slot)
        local clear_rc = me.cache.clearSlot(slot)
        local cleared_value = me.cache.loadSlot(slot)
        local roundtrip_ok = 0
        if store_rc == 0 {
            if clear_rc == 0 {
                if loaded_value == value {
                    if cleared_value == 0 {
                        roundtrip_ok = 1
                    }
                }
            }
        }
        if me.cache.lastWorkerId() < 0 {
            return me.reject(3, page_report, slot, value, loaded_value, cleared_value, store_rc, clear_rc, roundtrip_ok)
        }
        if roundtrip_ok != 1 {
            return me.reject(5, page_report, slot, value, loaded_value, cleared_value, store_rc, clear_rc, roundtrip_ok)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, page_report, slot, value, loaded_value, cleared_value, store_rc, clear_rc, roundtrip_ok)
    }
}

// page_meta_owner_eq_fastmem_pilot_box.hako -- PageMeta owner equality pilot
// Responsibility: observe owner equality through verified FastMemory
// PageMetaLayoutV0 access and the LLVM producer owner-runtime intrinsics.
// This does not mutate owner_worker_id, choose same/remote free routes, transfer
// TLS backing, reuse owner slots, open AtomicRemoteHead, or activate product
// allocator replacement.

static box HakoAllocPageMetaOwnerEqFastmemPilot {
    ownerEqPageMetaProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local owner_worker_id = page.owner_worker_id
            local current_owner_id = mem.currentAllocOwnerId()
            local same_owner = mem.ownerEq(owner_worker_id, current_owner_id)
            page.used = same_owner
        }
        return 0
    }
}

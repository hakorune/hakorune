// provider_call_execution_capability_preflight_box.hako -- MIMAP-388A
// Responsibility:
// - consume a provider-call modeled-open report
// - inventory the explicit capability preflight required before provider calls
// Non-responsibility:
// - provider API calls, host allocator replacement, hooks, global allocator
//   install, backend matchers, worker/TLS, or thread execution

using selfhost.hako_alloc.memory.provider_call_modeled_open_pilot_box as HakoAllocProviderCallModeledOpenPilot

record HakoAllocProviderCallExecutionCapabilityPreflightReportFields {
    accepted: i64
    reason: i64
    preflight_present: i64
    modeled_open_present: i64
    modeled_open_accepted: i64
    modeled_open_reason: i64
    provider_call_modeled_open: i64
    provider_call_model_active: i64
    provider_call_inactive: i64
    provider_call_execution_closed: i64
    provider_call_capability_present: i64
    provider_call_capability_valid: i64
    provider_call_execution_capability_present: i64
    provider_call_execution_capability_valid: i64
    provider_call_execution_ready: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    preflight_count: i64
    accepted_count: i64
    reject_count: i64
    missing_model_reject_count: i64
    inactive_model_reject_count: i64
    missing_capability_reject_count: i64
    invalid_capability_reject_count: i64
    closed_execution_reject_count: i64
    closed_host_replacement_reject_count: i64
    closed_hook_reject_count: i64
    closed_backend_matcher_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderCallExecutionCapabilityPreflightReport {
    accepted: i64 = 0
    reason: i64 = 0
    preflight_present: i64 = 0
    modeled_open_present: i64 = 0
    modeled_open_accepted: i64 = 0
    modeled_open_reason: i64 = 0
    provider_call_modeled_open: i64 = 0
    provider_call_model_active: i64 = 0
    provider_call_inactive: i64 = 1
    provider_call_execution_closed: i64 = 1
    provider_call_capability_present: i64 = 0
    provider_call_capability_valid: i64 = 0
    provider_call_execution_capability_present: i64 = 0
    provider_call_execution_capability_valid: i64 = 0
    provider_call_execution_ready: i64 = 0
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_model_reject_count: i64 = 0
    inactive_model_reject_count: i64 = 0
    missing_capability_reject_count: i64 = 0
    invalid_capability_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderCallExecutionCapabilityPreflight {
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_model_reject_count: i64 = 0
    inactive_model_reject_count: i64 = 0
    missing_capability_reject_count: i64 = 0
    invalid_capability_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    closed_host_replacement_reject_count: i64 = 0
    closed_hook_reject_count: i64 = 0
    closed_backend_matcher_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderCallExecutionCapabilityPreflightReport(fields: HakoAllocProviderCallExecutionCapabilityPreflightReportFields): HakoAllocProviderCallExecutionCapabilityPreflightReport {
        local result = new HakoAllocProviderCallExecutionCapabilityPreflightReport {
            accepted: fields.accepted,
            reason: fields.reason,
            preflight_present: fields.preflight_present,
            modeled_open_present: fields.modeled_open_present,
            modeled_open_accepted: fields.modeled_open_accepted,
            modeled_open_reason: fields.modeled_open_reason,
            provider_call_modeled_open: fields.provider_call_modeled_open,
            provider_call_model_active: fields.provider_call_model_active,
            provider_call_inactive: fields.provider_call_inactive,
            provider_call_execution_closed: fields.provider_call_execution_closed,
            provider_call_capability_present: fields.provider_call_capability_present,
            provider_call_capability_valid: fields.provider_call_capability_valid,
            provider_call_execution_capability_present: fields.provider_call_execution_capability_present,
            provider_call_execution_capability_valid: fields.provider_call_execution_capability_valid,
            provider_call_execution_ready: fields.provider_call_execution_ready,
            host_replacement_inactive: fields.host_replacement_inactive,
            hooks_inactive: fields.hooks_inactive,
            backend_matcher_inactive: fields.backend_matcher_inactive,
            preflight_count: fields.preflight_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_model_reject_count: fields.missing_model_reject_count,
            inactive_model_reject_count: fields.inactive_model_reject_count,
            missing_capability_reject_count: fields.missing_capability_reject_count,
            invalid_capability_reject_count: fields.invalid_capability_reject_count,
            closed_execution_reject_count: fields.closed_execution_reject_count,
            closed_host_replacement_reject_count: fields.closed_host_replacement_reject_count,
            closed_hook_reject_count: fields.closed_hook_reject_count,
            closed_backend_matcher_reject_count: fields.closed_backend_matcher_reject_count,
            last_reason: fields.last_reason,
            would_activate_provider: fields.would_activate_provider,
            would_call_provider: fields.would_call_provider,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(accepted, reason, modeled: HakoAllocProviderCallModeledOpenPilotReport, capability_present, capability_valid): HakoAllocProviderCallExecutionCapabilityPreflightReport {
        local present = accepted
        local ready = accepted
        local fields = HakoAllocProviderCallExecutionCapabilityPreflightReportFields {
            accepted: accepted,
            reason: reason,
            preflight_present: present,
            modeled_open_present: modeled.modeled_open_present,
            modeled_open_accepted: modeled.accepted,
            modeled_open_reason: modeled.reason,
            provider_call_modeled_open: modeled.provider_call_modeled_open,
            provider_call_model_active: modeled.provider_call_model_active,
            provider_call_inactive: modeled.provider_call_inactive,
            provider_call_execution_closed: modeled.provider_call_execution_closed,
            provider_call_capability_present: modeled.provider_call_capability_present,
            provider_call_capability_valid: modeled.provider_call_capability_valid,
            provider_call_execution_capability_present: capability_present,
            provider_call_execution_capability_valid: capability_valid,
            provider_call_execution_ready: ready,
            host_replacement_inactive: modeled.host_replacement_inactive,
            hooks_inactive: modeled.hooks_inactive,
            backend_matcher_inactive: modeled.backend_matcher_inactive,
            preflight_count: me.preflight_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_model_reject_count: me.missing_model_reject_count,
            inactive_model_reject_count: me.inactive_model_reject_count,
            missing_capability_reject_count: me.missing_capability_reject_count,
            invalid_capability_reject_count: me.invalid_capability_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            closed_host_replacement_reject_count: me.closed_host_replacement_reject_count,
            closed_hook_reject_count: me.closed_hook_reject_count,
            closed_backend_matcher_reject_count: me.closed_backend_matcher_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: modeled.would_activate_provider,
            would_call_provider: modeled.would_call_provider,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderCallExecutionCapabilityPreflightReport(fields)
    }

    reject(reason, modeled: HakoAllocProviderCallModeledOpenPilotReport, capability_present, capability_valid): HakoAllocProviderCallExecutionCapabilityPreflightReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_model_reject_count += 1
        }
        if reason == 2 {
            me.inactive_model_reject_count += 1
        }
        if reason == 3 {
            me.missing_capability_reject_count += 1
        }
        if reason == 4 {
            me.invalid_capability_reject_count += 1
        }
        if reason == 5 {
            me.closed_execution_reject_count += 1
        }
        if reason == 6 {
            me.closed_host_replacement_reject_count += 1
        }
        if reason == 7 {
            me.closed_hook_reject_count += 1
        }
        if reason == 8 {
            me.closed_backend_matcher_reject_count += 1
        }
        return me.makeReport(0, reason, modeled, capability_present, capability_valid)
    }

    preflightProviderCallExecutionCapability(modeled: HakoAllocProviderCallModeledOpenPilotReport, capability_present, capability_valid): HakoAllocProviderCallExecutionCapabilityPreflightReport {
        me.preflight_count += 1
        if modeled.modeled_open_present != 1 {
            return me.reject(1, modeled, capability_present, capability_valid)
        }
        if modeled.accepted != 1 {
            return me.reject(1, modeled, capability_present, capability_valid)
        }
        if modeled.provider_call_modeled_open != 1 {
            return me.reject(2, modeled, capability_present, capability_valid)
        }
        if modeled.provider_call_model_active != 1 {
            return me.reject(2, modeled, capability_present, capability_valid)
        }
        if modeled.provider_call_inactive != 0 {
            return me.reject(2, modeled, capability_present, capability_valid)
        }
        if capability_present != 1 {
            return me.reject(3, modeled, capability_present, capability_valid)
        }
        if capability_valid != 1 {
            return me.reject(4, modeled, capability_present, capability_valid)
        }
        if modeled.provider_call_execution_closed != 1 {
            return me.reject(5, modeled, capability_present, capability_valid)
        }
        if modeled.would_call_provider != 1 {
            return me.reject(5, modeled, capability_present, capability_valid)
        }
        if modeled.would_replace_host_allocator != 0 {
            return me.reject(6, modeled, capability_present, capability_valid)
        }
        if modeled.would_install_hook != 0 {
            return me.reject(7, modeled, capability_present, capability_valid)
        }
        if modeled.would_add_backend_matcher != 0 {
            return me.reject(8, modeled, capability_present, capability_valid)
        }
        if modeled.would_run_thread != 0 {
            return me.reject(8, modeled, capability_present, capability_valid)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, modeled, capability_present, capability_valid)
    }
}

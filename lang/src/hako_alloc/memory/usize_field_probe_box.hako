// usize_field_probe_box.hako — hako_alloc exact-usize stored field probe
// Responsibility: prove non-negative allocator field shapes before production migration.
// This module is not production allocator policy and does not source native memory.

box HakoAllocUsizeFieldProbe {
    capacity: usize = 0
    block_size: usize = 0
    used: usize = 0
    free_top: usize = 0
    local_free_top: usize = 0
    free_stack_values: ArrayBox = new ArrayBox()
    local_free_stack_values: ArrayBox = new ArrayBox()
    alloc_count: usize = 0
    requested_bytes: usize = 0
    request_accept_count: usize = 0
    request_oversize_reject_count: usize = 0
    byte_sum_count: usize = 0
    array_index_probe_count: usize = 0
    capacity_loop_count: usize = 0
    index_accept_count: usize = 0
    index_reject_count: usize = 0
    free_top_underflow_reject_count: usize = 0
    local_free_overflow_reject_count: usize = 0
    local_free_underflow_reject_count: usize = 0

    birth(capacity: usize, block_size: usize) {
        me.capacity = capacity
        me.block_size = block_size
        me.free_top = capacity
    }

    recordAllocation(requested_bytes: usize) {
        if me.used >= me.capacity {
            return 0
        }

        me.used = me.used + 1
        me.alloc_count = me.alloc_count + 1
        me.requested_bytes = me.requested_bytes + requested_bytes
        return 1
    }

    recordSizedRequest(requested_size: usize) {
        if requested_size > me.block_size {
            me.request_oversize_reject_count = me.request_oversize_reject_count + 1
            return 0
        }

        me.request_accept_count = me.request_accept_count + 1
        me.byte_sum_count = me.byte_sum_count + 1
        me.requested_bytes = me.requested_bytes + requested_size
        return 1
    }

    seedFreeStackValue(value) {
        me.free_stack_values.push(value)
        return 1
    }

    seedLocalFreeSlot() {
        me.local_free_stack_values.push(0)
        return 1
    }

    peekFreeTopBlock() {
        if me.free_top == 0 {
            me.free_top_underflow_reject_count = me.free_top_underflow_reject_count + 1
            return -1
        }

        local index = me.free_top - 1
        me.array_index_probe_count = me.array_index_probe_count + 1
        return me.free_stack_values.get(index)
    }

    takeFreeTop() {
        if me.free_top == 0 {
            me.free_top_underflow_reject_count = me.free_top_underflow_reject_count + 1
            return 0
        }

        me.free_top = me.free_top - 1
        return 1
    }

    pushLocalFreeTop() {
        return me.pushLocalFreeBlock(0)
    }

    pushLocalFreeBlock(value) {
        if me.local_free_top >= me.capacity {
            me.local_free_overflow_reject_count = me.local_free_overflow_reject_count + 1
            return 0
        }

        me.local_free_stack_values.set(me.local_free_top, value)
        me.local_free_top = me.local_free_top + 1
        return 1
    }

    collectLocalFreeTop() {
        local block_id = me.collectLocalFreeBlock()
        if block_id < 0 {
            return 0
        }

        return 1
    }

    collectLocalFreeBlock() {
        if me.local_free_top == 0 {
            me.local_free_underflow_reject_count = me.local_free_underflow_reject_count + 1
            return -1
        }

        me.local_free_top = me.local_free_top - 1
        me.array_index_probe_count = me.array_index_probe_count + 1
        return me.local_free_stack_values.get(me.local_free_top)
    }

    countToCapacity() {
        local i = 0
        loop(i < me.capacity) {
            me.capacity_loop_count = me.capacity_loop_count + 1
            i = i + 1
        }
        return me.capacity_loop_count
    }

    acceptIndex(index) {
        if index < 0 {
            me.index_reject_count = me.index_reject_count + 1
            return 0
        }

        if index >= me.capacity {
            me.index_reject_count = me.index_reject_count + 1
            return 0
        }

        me.index_accept_count = me.index_accept_count + 1
        return 1
    }
}

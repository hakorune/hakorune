// allocator_comparison_benchmark_execution_preflight_inventory_box.hako -- MIMAP-436A
// Responsibility:
// - inventory explicit preflight conditions before allocator comparison benchmark execution
// Non-responsibility:
// - benchmark execution, hook installation, process allocator replacement,
//   backend matcher additions, global allocator install, or worker/thread execution

record HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReportFields {
    accepted: i64 = 0
    reason: i64 = 0
    benchmark_execution_preflight_present: i64 = 0
    benchmark_execution_ready: i64 = 0
    benchmark_runner_selected: i64 = 0
    output_capture_present: i64 = 0
    measurement_storage_present: i64 = 0
    workload_matrix_ready: i64 = 0
    measurement_plan_ready: i64 = 0
    process_replacement_closed: i64 = 0
    hook_install_closed: i64 = 0
    backend_matcher_closed: i64 = 0
    global_allocator_closed: i64 = 0
    hidden_env_closed: i64 = 0
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_runner_reject_count: i64 = 0
    missing_output_capture_reject_count: i64 = 0
    missing_measurement_storage_reject_count: i64 = 0
    workload_matrix_not_ready_reject_count: i64 = 0
    measurement_plan_not_ready_reject_count: i64 = 0
    process_replacement_open_reject_count: i64 = 0
    hook_open_reject_count: i64 = 0
    backend_matcher_open_reject_count: i64 = 0
    global_allocator_open_reject_count: i64 = 0
    hidden_env_open_reject_count: i64 = 0
    last_reason: i64 = 0
    benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    would_run_benchmark: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    benchmark_execution_preflight_present: i64 = 0
    benchmark_execution_ready: i64 = 0
    benchmark_runner_selected: i64 = 0
    output_capture_present: i64 = 0
    measurement_storage_present: i64 = 0
    workload_matrix_ready: i64 = 0
    measurement_plan_ready: i64 = 0
    process_replacement_closed: i64 = 0
    hook_install_closed: i64 = 0
    backend_matcher_closed: i64 = 0
    global_allocator_closed: i64 = 0
    hidden_env_closed: i64 = 0
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_runner_reject_count: i64 = 0
    missing_output_capture_reject_count: i64 = 0
    missing_measurement_storage_reject_count: i64 = 0
    workload_matrix_not_ready_reject_count: i64 = 0
    measurement_plan_not_ready_reject_count: i64 = 0
    process_replacement_open_reject_count: i64 = 0
    hook_open_reject_count: i64 = 0
    backend_matcher_open_reject_count: i64 = 0
    global_allocator_open_reject_count: i64 = 0
    hidden_env_open_reject_count: i64 = 0
    last_reason: i64 = 0
    benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    would_run_benchmark: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventory {
    preflight_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_runner_reject_count: i64 = 0
    missing_output_capture_reject_count: i64 = 0
    missing_measurement_storage_reject_count: i64 = 0
    workload_matrix_not_ready_reject_count: i64 = 0
    measurement_plan_not_ready_reject_count: i64 = 0
    process_replacement_open_reject_count: i64 = 0
    hook_open_reject_count: i64 = 0
    backend_matcher_open_reject_count: i64 = 0
    global_allocator_open_reject_count: i64 = 0
    hidden_env_open_reject_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonBenchmarkExecutionPreflightInventoryReport(fields: HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReportFields): HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReport {
        local result = new HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            benchmark_execution_preflight_present: fields.benchmark_execution_preflight_present,
            benchmark_execution_ready: fields.benchmark_execution_ready,
            benchmark_runner_selected: fields.benchmark_runner_selected,
            output_capture_present: fields.output_capture_present,
            measurement_storage_present: fields.measurement_storage_present,
            workload_matrix_ready: fields.workload_matrix_ready,
            measurement_plan_ready: fields.measurement_plan_ready,
            process_replacement_closed: fields.process_replacement_closed,
            hook_install_closed: fields.hook_install_closed,
            backend_matcher_closed: fields.backend_matcher_closed,
            global_allocator_closed: fields.global_allocator_closed,
            hidden_env_closed: fields.hidden_env_closed,
            preflight_count: fields.preflight_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_runner_reject_count: fields.missing_runner_reject_count,
            missing_output_capture_reject_count: fields.missing_output_capture_reject_count,
            missing_measurement_storage_reject_count: fields.missing_measurement_storage_reject_count,
            workload_matrix_not_ready_reject_count: fields.workload_matrix_not_ready_reject_count,
            measurement_plan_not_ready_reject_count: fields.measurement_plan_not_ready_reject_count,
            process_replacement_open_reject_count: fields.process_replacement_open_reject_count,
            hook_open_reject_count: fields.hook_open_reject_count,
            backend_matcher_open_reject_count: fields.backend_matcher_open_reject_count,
            global_allocator_open_reject_count: fields.global_allocator_open_reject_count,
            hidden_env_open_reject_count: fields.hidden_env_open_reject_count,
            last_reason: fields.last_reason,
            benchmark_executed: fields.benchmark_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            would_run_benchmark: fields.would_run_benchmark,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(
        accepted: i64,
        reason: i64,
        benchmark_runner_selected: i64,
        output_capture_present: i64,
        measurement_storage_present: i64,
        workload_matrix_ready: i64,
        measurement_plan_ready: i64,
        process_replacement_closed: i64,
        hook_install_closed: i64,
        backend_matcher_closed: i64,
        global_allocator_closed: i64,
        hidden_env_closed: i64
    ): HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReport {
        local fields = HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReportFields {}
        fields = fields with {
            accepted,
            reason,
            benchmark_execution_preflight_present: accepted,
            benchmark_execution_ready: accepted,
            benchmark_runner_selected,
            output_capture_present,
            measurement_storage_present,
            workload_matrix_ready,
            measurement_plan_ready,
            process_replacement_closed,
            hook_install_closed,
            backend_matcher_closed,
            global_allocator_closed,
            hidden_env_closed,
            preflight_count: me.preflight_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_runner_reject_count: me.missing_runner_reject_count,
            missing_output_capture_reject_count: me.missing_output_capture_reject_count,
            missing_measurement_storage_reject_count: me.missing_measurement_storage_reject_count,
            workload_matrix_not_ready_reject_count: me.workload_matrix_not_ready_reject_count,
            measurement_plan_not_ready_reject_count: me.measurement_plan_not_ready_reject_count,
            process_replacement_open_reject_count: me.process_replacement_open_reject_count,
            hook_open_reject_count: me.hook_open_reject_count,
            backend_matcher_open_reject_count: me.backend_matcher_open_reject_count,
            global_allocator_open_reject_count: me.global_allocator_open_reject_count,
            hidden_env_open_reject_count: me.hidden_env_open_reject_count,
            last_reason: me.last_reason,
            benchmark_executed: 0,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            would_run_benchmark: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeAllocatorComparisonBenchmarkExecutionPreflightInventoryReport(fields)
    }

    reject(
        reason: i64,
        benchmark_runner_selected: i64,
        output_capture_present: i64,
        measurement_storage_present: i64,
        workload_matrix_ready: i64,
        measurement_plan_ready: i64,
        process_replacement_closed: i64,
        hook_install_closed: i64,
        backend_matcher_closed: i64,
        global_allocator_closed: i64,
        hidden_env_closed: i64
    ): HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_runner_reject_count += 1
        }
        if reason == 2 {
            me.missing_output_capture_reject_count += 1
        }
        if reason == 3 {
            me.missing_measurement_storage_reject_count += 1
        }
        if reason == 4 {
            me.workload_matrix_not_ready_reject_count += 1
        }
        if reason == 5 {
            me.measurement_plan_not_ready_reject_count += 1
        }
        if reason == 6 {
            me.process_replacement_open_reject_count += 1
        }
        if reason == 7 {
            me.hook_open_reject_count += 1
        }
        if reason == 8 {
            me.backend_matcher_open_reject_count += 1
        }
        if reason == 9 {
            me.global_allocator_open_reject_count += 1
        }
        if reason == 10 {
            me.hidden_env_open_reject_count += 1
        }
        return me.makeReport(0, reason, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
    }

    inventoryAllocatorComparisonBenchmarkExecutionPreflight(
        benchmark_runner_selected: i64,
        output_capture_present: i64,
        measurement_storage_present: i64,
        workload_matrix_ready: i64,
        measurement_plan_ready: i64,
        process_replacement_closed: i64,
        hook_install_closed: i64,
        backend_matcher_closed: i64,
        global_allocator_closed: i64,
        hidden_env_closed: i64
    ): HakoAllocAllocatorComparisonBenchmarkExecutionPreflightInventoryReport {
        me.preflight_count += 1
        if benchmark_runner_selected != 1 {
            return me.reject(1, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if output_capture_present != 1 {
            return me.reject(2, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if measurement_storage_present != 1 {
            return me.reject(3, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if workload_matrix_ready != 1 {
            return me.reject(4, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if measurement_plan_ready != 1 {
            return me.reject(5, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if process_replacement_closed != 1 {
            return me.reject(6, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if hook_install_closed != 1 {
            return me.reject(7, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if backend_matcher_closed != 1 {
            return me.reject(8, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if global_allocator_closed != 1 {
            return me.reject(9, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }
        if hidden_env_closed != 1 {
            return me.reject(10, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, benchmark_runner_selected, output_capture_present, measurement_storage_present, workload_matrix_ready, measurement_plan_ready, process_replacement_closed, hook_install_closed, backend_matcher_closed, global_allocator_closed, hidden_env_closed)
    }
}

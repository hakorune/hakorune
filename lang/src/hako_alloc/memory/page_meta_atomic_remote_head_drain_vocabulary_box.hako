// page_meta_atomic_remote_head_drain_vocabulary_box.hako -- AtomicRemoteHead drain vocabulary pilot
// Responsibility: prove that .hako hako_alloc can name the owner-side
// remote-free drain primitive without opening drain lowering, branch routing,
// TLS transfer, product allocator replacement, hooks, or winner claims.

static box HakoAllocPageMetaAtomicRemoteHeadDrainVocabulary {
    atomicRemoteHeadDrainVocabularyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local used = page.used
            local drained = mem.atomicRemoteHeadDrain(page)
            return used
        }
        return 0
    }
}

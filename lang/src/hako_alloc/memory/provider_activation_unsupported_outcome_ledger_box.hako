// provider_activation_unsupported_outcome_ledger_box.hako -- MIMAP-370A
// Responsibility:
// - ledger provider activation requests as unsupported outcomes after
//   provider selection inventory
// - keep provider activation closed
// Non-responsibility:
// - provider activation, host allocator replacement, hooks, global allocator
//   install, backend matchers, provider calls, or thread execution

using selfhost.hako_alloc.memory.provider_selection_inventory_box as HakoAllocProviderSelectionInventoryBox

record HakoAllocProviderActivationUnsupportedOutcomeLedgerReportFields {
    accepted: i64
    reason: i64
    outcome_present: i64
    selection_present: i64
    selection_accepted: i64
    selection_reason: i64
    provider_candidate_token: i64
    provider_candidate_token_valid: i64
    provider_kind: i64
    provider_kind_valid: i64
    provider_activation_unsupported: i64
    provider_activation_inactive: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    ledger_count: i64
    accepted_count: i64
    reject_count: i64
    missing_selection_reject_count: i64
    rejected_selection_reject_count: i64
    invalid_candidate_reject_count: i64
    invalid_kind_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    would_activate_provider: i64
    would_call_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderActivationUnsupportedOutcomeLedgerReport {
    accepted: i64 = 0
    reason: i64 = 0
    outcome_present: i64 = 0
    selection_present: i64 = 0
    selection_accepted: i64 = 0
    selection_reason: i64 = 0
    provider_candidate_token: i64 = 0
    provider_candidate_token_valid: i64 = 0
    provider_kind: i64 = 0
    provider_kind_valid: i64 = 0
    provider_activation_unsupported: i64 = 1
    provider_activation_inactive: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    ledger_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_selection_reject_count: i64 = 0
    rejected_selection_reject_count: i64 = 0
    invalid_candidate_reject_count: i64 = 0
    invalid_kind_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    would_activate_provider: i64 = 0
    would_call_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderActivationUnsupportedOutcomeLedger {
    ledger_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_selection_reject_count: i64 = 0
    rejected_selection_reject_count: i64 = 0
    invalid_candidate_reject_count: i64 = 0
    invalid_kind_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderActivationUnsupportedOutcomeLedgerReport(fields: HakoAllocProviderActivationUnsupportedOutcomeLedgerReportFields): HakoAllocProviderActivationUnsupportedOutcomeLedgerReport {
        local result = new HakoAllocProviderActivationUnsupportedOutcomeLedgerReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.outcome_present = fields.outcome_present
        result.selection_present = fields.selection_present
        result.selection_accepted = fields.selection_accepted
        result.selection_reason = fields.selection_reason
        result.provider_candidate_token = fields.provider_candidate_token
        result.provider_candidate_token_valid = fields.provider_candidate_token_valid
        result.provider_kind = fields.provider_kind
        result.provider_kind_valid = fields.provider_kind_valid
        result.provider_activation_unsupported = fields.provider_activation_unsupported
        result.provider_activation_inactive = fields.provider_activation_inactive
        result.host_replacement_inactive = fields.host_replacement_inactive
        result.hooks_inactive = fields.hooks_inactive
        result.backend_matcher_inactive = fields.backend_matcher_inactive
        result.ledger_count = fields.ledger_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_selection_reject_count = fields.missing_selection_reject_count
        result.rejected_selection_reject_count = fields.rejected_selection_reject_count
        result.invalid_candidate_reject_count = fields.invalid_candidate_reject_count
        result.invalid_kind_reject_count = fields.invalid_kind_reject_count
        result.closed_execution_reject_count = fields.closed_execution_reject_count
        result.last_reason = fields.last_reason
        result.would_activate_provider = fields.would_activate_provider
        result.would_call_provider = fields.would_call_provider
        result.would_replace_host_allocator = fields.would_replace_host_allocator
        result.would_install_hook = fields.would_install_hook
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        result.would_run_thread = fields.would_run_thread
        return result
    }

    makeReport(accepted, reason, selection: HakoAllocProviderSelectionInventoryReport): HakoAllocProviderActivationUnsupportedOutcomeLedgerReport {
        local fields = HakoAllocProviderActivationUnsupportedOutcomeLedgerReportFields {
            accepted: accepted,
            reason: reason,
            outcome_present: accepted,
            selection_present: selection.selection_present,
            selection_accepted: selection.accepted,
            selection_reason: selection.reason,
            provider_candidate_token: selection.provider_candidate_token,
            provider_candidate_token_valid: selection.provider_candidate_token_valid,
            provider_kind: selection.provider_kind,
            provider_kind_valid: selection.provider_kind_valid,
            provider_activation_unsupported: 1,
            provider_activation_inactive: selection.provider_activation_inactive,
            host_replacement_inactive: selection.host_replacement_inactive,
            hooks_inactive: selection.hooks_inactive,
            backend_matcher_inactive: selection.backend_matcher_inactive,
            ledger_count: me.ledger_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_selection_reject_count: me.missing_selection_reject_count,
            rejected_selection_reject_count: me.rejected_selection_reject_count,
            invalid_candidate_reject_count: me.invalid_candidate_reject_count,
            invalid_kind_reject_count: me.invalid_kind_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            would_activate_provider: 0,
            would_call_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderActivationUnsupportedOutcomeLedgerReport(fields)
    }

    reject(reason, selection: HakoAllocProviderSelectionInventoryReport): HakoAllocProviderActivationUnsupportedOutcomeLedgerReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_selection_reject_count += 1
        }
        if reason == 2 {
            me.rejected_selection_reject_count += 1
        }
        if reason == 3 {
            me.invalid_candidate_reject_count += 1
        }
        if reason == 4 {
            me.invalid_kind_reject_count += 1
        }
        if reason == 5 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, selection)
    }

    ledgerProviderUnsupportedOutcome(selection: HakoAllocProviderSelectionInventoryReport): HakoAllocProviderActivationUnsupportedOutcomeLedgerReport {
        me.ledger_count += 1
        if selection.selection_present != 1 {
            return me.reject(1, selection)
        }
        if selection.accepted != 1 {
            return me.reject(2, selection)
        }
        if selection.provider_candidate_token_valid != 1 {
            return me.reject(3, selection)
        }
        if selection.provider_kind_valid != 1 {
            return me.reject(4, selection)
        }
        if selection.would_activate_provider != 0 {
            return me.reject(5, selection)
        }
        if selection.would_replace_host_allocator != 0 {
            return me.reject(5, selection)
        }
        if selection.would_install_hook != 0 {
            return me.reject(5, selection)
        }
        if selection.would_add_backend_matcher != 0 {
            return me.reject(5, selection)
        }
        if selection.would_run_thread != 0 {
            return me.reject(5, selection)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, selection)
    }
}

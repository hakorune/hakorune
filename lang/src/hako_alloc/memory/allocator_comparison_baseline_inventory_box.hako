// allocator_comparison_baseline_inventory_box.hako -- MIMAP-427A
// Responsibility:
// - inventory explicit comparison baseline inputs for hako_alloc vs C mimalloc
// Non-responsibility:
// - benchmark execution, hook installation, process allocator replacement,
//   backend matcher additions, global allocator install, or worker/thread execution

record HakoAllocAllocatorComparisonBaselineInventoryReportFields {
    accepted: i64
    reason: i64
    baseline_inventory_present: i64
    comparison_ready: i64
    c_mimalloc_baseline_present: i64
    hako_alloc_baseline_present: i64
    throughput_target_present: i64
    memory_usage_target_present: i64
    workload_matrix_present: i64
    repeat_count: i64
    inventory_count: i64
    accepted_count: i64
    reject_count: i64
    missing_c_mimalloc_baseline_reject_count: i64
    missing_hako_alloc_baseline_reject_count: i64
    missing_throughput_target_reject_count: i64
    missing_memory_usage_target_reject_count: i64
    missing_workload_matrix_reject_count: i64
    invalid_repeat_count_reject_count: i64
    last_reason: i64
    process_replacement_executed: i64
    hook_installed: i64
    backend_matcher_added: i64
    global_allocator_installed: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocAllocatorComparisonBaselineInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    baseline_inventory_present: i64 = 0
    comparison_ready: i64 = 0
    c_mimalloc_baseline_present: i64 = 0
    hako_alloc_baseline_present: i64 = 0
    throughput_target_present: i64 = 0
    memory_usage_target_present: i64 = 0
    workload_matrix_present: i64 = 0
    repeat_count: i64 = 0
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_c_mimalloc_baseline_reject_count: i64 = 0
    missing_hako_alloc_baseline_reject_count: i64 = 0
    missing_throughput_target_reject_count: i64 = 0
    missing_memory_usage_target_reject_count: i64 = 0
    missing_workload_matrix_reject_count: i64 = 0
    invalid_repeat_count_reject_count: i64 = 0
    last_reason: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonBaselineInventory {
    inventory_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_c_mimalloc_baseline_reject_count: i64 = 0
    missing_hako_alloc_baseline_reject_count: i64 = 0
    missing_throughput_target_reject_count: i64 = 0
    missing_memory_usage_target_reject_count: i64 = 0
    missing_workload_matrix_reject_count: i64 = 0
    invalid_repeat_count_reject_count: i64 = 0
    last_reason: i64 = 0

    makeAllocatorComparisonBaselineInventoryReport(fields: HakoAllocAllocatorComparisonBaselineInventoryReportFields): HakoAllocAllocatorComparisonBaselineInventoryReport {
        local result = new HakoAllocAllocatorComparisonBaselineInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            baseline_inventory_present: fields.baseline_inventory_present,
            comparison_ready: fields.comparison_ready,
            c_mimalloc_baseline_present: fields.c_mimalloc_baseline_present,
            hako_alloc_baseline_present: fields.hako_alloc_baseline_present,
            throughput_target_present: fields.throughput_target_present,
            memory_usage_target_present: fields.memory_usage_target_present,
            workload_matrix_present: fields.workload_matrix_present,
            repeat_count: fields.repeat_count,
            inventory_count: fields.inventory_count,
            accepted_count: fields.accepted_count,
            reject_count: fields.reject_count,
            missing_c_mimalloc_baseline_reject_count: fields.missing_c_mimalloc_baseline_reject_count,
            missing_hako_alloc_baseline_reject_count: fields.missing_hako_alloc_baseline_reject_count,
            missing_throughput_target_reject_count: fields.missing_throughput_target_reject_count,
            missing_memory_usage_target_reject_count: fields.missing_memory_usage_target_reject_count,
            missing_workload_matrix_reject_count: fields.missing_workload_matrix_reject_count,
            invalid_repeat_count_reject_count: fields.invalid_repeat_count_reject_count,
            last_reason: fields.last_reason,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    makeReport(
        accepted: i64,
        reason: i64,
        c_mimalloc_baseline_present: i64,
        hako_alloc_baseline_present: i64,
        throughput_target_present: i64,
        memory_usage_target_present: i64,
        workload_matrix_present: i64,
        repeat_count: i64
    ): HakoAllocAllocatorComparisonBaselineInventoryReport {
        local fields = HakoAllocAllocatorComparisonBaselineInventoryReportFields {
            accepted: accepted,
            reason: reason,
            baseline_inventory_present: accepted,
            comparison_ready: accepted,
            c_mimalloc_baseline_present: c_mimalloc_baseline_present,
            hako_alloc_baseline_present: hako_alloc_baseline_present,
            throughput_target_present: throughput_target_present,
            memory_usage_target_present: memory_usage_target_present,
            workload_matrix_present: workload_matrix_present,
            repeat_count: repeat_count,
            inventory_count: me.inventory_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_c_mimalloc_baseline_reject_count: me.missing_c_mimalloc_baseline_reject_count,
            missing_hako_alloc_baseline_reject_count: me.missing_hako_alloc_baseline_reject_count,
            missing_throughput_target_reject_count: me.missing_throughput_target_reject_count,
            missing_memory_usage_target_reject_count: me.missing_memory_usage_target_reject_count,
            missing_workload_matrix_reject_count: me.missing_workload_matrix_reject_count,
            invalid_repeat_count_reject_count: me.invalid_repeat_count_reject_count,
            last_reason: me.last_reason,
            process_replacement_executed: 0,
            hook_installed: 0,
            backend_matcher_added: 0,
            global_allocator_installed: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeAllocatorComparisonBaselineInventoryReport(fields)
    }

    reject(
        reason: i64,
        c_mimalloc_baseline_present: i64,
        hako_alloc_baseline_present: i64,
        throughput_target_present: i64,
        memory_usage_target_present: i64,
        workload_matrix_present: i64,
        repeat_count: i64
    ): HakoAllocAllocatorComparisonBaselineInventoryReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_c_mimalloc_baseline_reject_count += 1
        }
        if reason == 2 {
            me.missing_hako_alloc_baseline_reject_count += 1
        }
        if reason == 3 {
            me.missing_throughput_target_reject_count += 1
        }
        if reason == 4 {
            me.missing_memory_usage_target_reject_count += 1
        }
        if reason == 5 {
            me.missing_workload_matrix_reject_count += 1
        }
        if reason == 6 {
            me.invalid_repeat_count_reject_count += 1
        }
        return me.makeReport(0, reason, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
    }

    inventoryAllocatorComparisonBaseline(
        c_mimalloc_baseline_present: i64,
        hako_alloc_baseline_present: i64,
        throughput_target_present: i64,
        memory_usage_target_present: i64,
        workload_matrix_present: i64,
        repeat_count: i64
    ): HakoAllocAllocatorComparisonBaselineInventoryReport {
        me.inventory_count += 1
        if c_mimalloc_baseline_present != 1 {
            return me.reject(1, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
        }
        if hako_alloc_baseline_present != 1 {
            return me.reject(2, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
        }
        if throughput_target_present != 1 {
            return me.reject(3, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
        }
        if memory_usage_target_present != 1 {
            return me.reject(4, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
        }
        if workload_matrix_present != 1 {
            return me.reject(5, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
        }
        if repeat_count < 1 {
            return me.reject(6, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, c_mimalloc_baseline_present, hako_alloc_baseline_present, throughput_target_present, memory_usage_target_present, workload_matrix_present, repeat_count)
    }
}

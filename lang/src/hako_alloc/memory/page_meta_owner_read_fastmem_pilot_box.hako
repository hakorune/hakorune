// page_meta_owner_read_fastmem_pilot_box.hako -- PageMeta owner scalar read pilot
// Responsibility: extend the first PageMeta fastmem body to read the
// owner_worker_id scalar as layout metadata. This is not allocator owner runtime
// routing and must not mutate owner identity, open TLS transfer, remote-free, or
// DirectArray/free-list storage.

static box HakoAllocPageMetaOwnerReadFastmemPilot {
    ownerReadPageMetaProbe(page_table, page_index, next_used) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local owner_worker_id = page.owner_worker_id
            local block_size = page.block_size
            local capacity = page.capacity
            local used = page.used
            page.used = next_used
            local total = block_size + capacity
            return total + used + owner_worker_id
        }
        return 0
    }
}

// page_meta_refill_then_free_head_alloc_body_box.hako -- refill-then-alloc pilot
// Responsibility: prove that a verified FreeHeadPush can provide the
// same-region free_head non-empty proof needed by a later FreeHeadPop. This
// body intentionally does not call mem.assumeFreeHeadNonEmpty(page).
// Multi-block refill, branch routing, remote-owner routing, AtomicRemoteHead,
// TLS transfer, product allocator replacement, hooks, and winner claims remain
// closed.

static box HakoAllocPageMetaRefillThenFreeHeadAllocBody {
    refillThenFreeHeadAllocBodyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local current = mem.currentAllocOwnerId()
            local same = mem.ownerEq(page.owner_worker_id, current)
            mem.assumeSameOwner(page, same)
            mem.assumeLocalFreeNonEmpty(page)

            local refill_block = mem.localFreePop(page)
            mem.assumeFreeHeadBlockNext(refill_block)
            local push_marker = mem.freeHeadPush(page, refill_block)

            local popped = mem.freeHeadPop(page)
            local used = page.used
            local next_used = used + 1
            page.used = next_used

            return popped + next_used
        }
        return 0
    }
}

// page_meta_free_head_alloc_body_box.hako -- page-local free_head alloc body pilot
// Responsibility: prove that .hako hako_alloc can compose same-owner,
// non-empty FreeHeadPop with the first ordinary page free-list allocation body
// update. This does not open refill, remote-owner routing, AtomicRemoteHead,
// TLS transfer, owner reuse, product allocator replacement, hooks, or winner
// claims.

static box HakoAllocPageMetaFreeHeadAllocBody {
    freeHeadAllocBodyProbe(page_table, page_index) {
        fastmem PageMapV0 {
            mem.assumeTableLength(page_table, 64)
            mem.assumeIndexInRange(page_index, 64)
            local page = page_table[page_index]
            local current = mem.currentAllocOwnerId()
            local same = mem.ownerEq(page.owner_worker_id, current)
            mem.assumeSameOwner(page, same)
            mem.assumeFreeHeadNonEmpty(page)
            local popped = mem.freeHeadPop(page)
            local used = page.used
            local next_used = used + 1
            page.used = next_used
            return popped + next_used
        }
        return 0
    }
}

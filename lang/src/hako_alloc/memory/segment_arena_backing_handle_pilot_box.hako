// segment_arena_backing_handle_pilot_box.hako -- MIMAP-345A
// Responsibility:
// - record a bounded arena backing handle token from an accepted no-escape
//   pointer residence report
// - keep arena release/recycle and every downstream execution seam closed
// Non-responsibility:
// - pointer-derived lookup, dereference, arena release/recycle, segment-map
//   mutation, atomic bitmap execution, OSVM, worker/TLS, providers, or backend
//   matchers

record HakoAllocSegmentArenaBackingHandlePilotReportFields {
    accepted: i64
    reason: i64
    handle_present: i64
    residence_present: i64
    residence_accepted: i64
    residence_reason: i64
    arena_handle_token: i64
    handle_valid: i64
    private_pointer_token: i64
    pointer_token_valid: i64
    no_escape_scope_id: i64
    non_dereferenceable: i64
    closed_execution_blocker_count: i64
    handle_count: i64
    accepted_count: i64
    reject_count: i64
    missing_residence_reject_count: i64
    rejected_residence_reject_count: i64
    invalid_pointer_token_reject_count: i64
    invalid_handle_reject_count: i64
    closed_execution_reject_count: i64
    last_reason: i64
    report_segment_id: i64
    report_arena_id: i64
    report_lifetime_generation: i64
    report_release_applied_recycle_token: i64
    report_continuation_token: i64
    report_application_token: i64
    report_applied_backing_bytes: usize
    report_applied_committed_bytes: usize
    report_remaining_source_bytes: usize
    would_lookup_by_pointer: i64
    would_release_arena_backing: i64
    would_recycle_arena_backing: i64
    would_use_segment_map: i64
    would_execute_atomic_bitmap: i64
    would_call_osvm: i64
    would_run_thread: i64
    would_activate_provider: i64
    would_add_backend_matcher: i64
}

box HakoAllocSegmentArenaBackingHandlePilotReport {
    accepted: i64 = 0
    reason: i64 = 0
    handle_present: i64 = 0
    residence_present: i64 = 0
    residence_accepted: i64 = 0
    residence_reason: i64 = 0
    arena_handle_token: i64 = 0
    handle_valid: i64 = 0
    private_pointer_token: i64 = 0
    pointer_token_valid: i64 = 0
    no_escape_scope_id: i64 = 0
    non_dereferenceable: i64 = 1
    closed_execution_blocker_count: i64 = 0
    handle_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_residence_reject_count: i64 = 0
    rejected_residence_reject_count: i64 = 0
    invalid_pointer_token_reject_count: i64 = 0
    invalid_handle_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0
    report_segment_id: i64 = -1
    report_arena_id: i64 = -1
    report_lifetime_generation: i64 = 0
    report_release_applied_recycle_token: i64 = 0
    report_continuation_token: i64 = 0
    report_application_token: i64 = 0
    report_applied_backing_bytes: usize = 0
    report_applied_committed_bytes: usize = 0
    report_remaining_source_bytes: usize = 0
    would_lookup_by_pointer: i64 = 0
    would_release_arena_backing: i64 = 0
    would_recycle_arena_backing: i64 = 0
    would_use_segment_map: i64 = 0
    would_execute_atomic_bitmap: i64 = 0
    would_call_osvm: i64 = 0
    would_run_thread: i64 = 0
    would_activate_provider: i64 = 0
    would_add_backend_matcher: i64 = 0
}

box HakoAllocSegmentArenaBackingHandlePilot {
    handle_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_residence_reject_count: i64 = 0
    rejected_residence_reject_count: i64 = 0
    invalid_pointer_token_reject_count: i64 = 0
    invalid_handle_reject_count: i64 = 0
    closed_execution_reject_count: i64 = 0
    last_reason: i64 = 0

    closedExecutionBlockerCount(residence_report): i64 {
        local count = 0
        if residence_report.would_lookup_by_pointer != 0 {
            count += 1
        }
        if residence_report.would_release_arena_backing != 0 {
            count += 1
        }
        if residence_report.would_recycle_arena_backing != 0 {
            count += 1
        }
        if residence_report.would_use_segment_map != 0 {
            count += 1
        }
        if residence_report.would_execute_atomic_bitmap != 0 {
            count += 1
        }
        if residence_report.would_call_osvm != 0 {
            count += 1
        }
        if residence_report.would_run_thread != 0 {
            count += 1
        }
        if residence_report.would_activate_provider != 0 {
            count += 1
        }
        if residence_report.would_add_backend_matcher != 0 {
            count += 1
        }
        return count
    }

    makeArenaBackingHandlePilotReport(fields: HakoAllocSegmentArenaBackingHandlePilotReportFields): HakoAllocSegmentArenaBackingHandlePilotReport {
        local result = new HakoAllocSegmentArenaBackingHandlePilotReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.handle_present = fields.handle_present
        result.residence_present = fields.residence_present
        result.residence_accepted = fields.residence_accepted
        result.residence_reason = fields.residence_reason
        result.arena_handle_token = fields.arena_handle_token
        result.handle_valid = fields.handle_valid
        result.private_pointer_token = fields.private_pointer_token
        result.pointer_token_valid = fields.pointer_token_valid
        result.no_escape_scope_id = fields.no_escape_scope_id
        result.non_dereferenceable = fields.non_dereferenceable
        result.closed_execution_blocker_count = fields.closed_execution_blocker_count
        result.handle_count = fields.handle_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_residence_reject_count = fields.missing_residence_reject_count
        result.rejected_residence_reject_count = fields.rejected_residence_reject_count
        result.invalid_pointer_token_reject_count = fields.invalid_pointer_token_reject_count
        result.invalid_handle_reject_count = fields.invalid_handle_reject_count
        result.closed_execution_reject_count = fields.closed_execution_reject_count
        result.last_reason = fields.last_reason
        result.report_segment_id = fields.report_segment_id
        result.report_arena_id = fields.report_arena_id
        result.report_lifetime_generation = fields.report_lifetime_generation
        result.report_release_applied_recycle_token = fields.report_release_applied_recycle_token
        result.report_continuation_token = fields.report_continuation_token
        result.report_application_token = fields.report_application_token
        result.report_applied_backing_bytes = fields.report_applied_backing_bytes
        result.report_applied_committed_bytes = fields.report_applied_committed_bytes
        result.report_remaining_source_bytes = fields.report_remaining_source_bytes
        result.would_lookup_by_pointer = fields.would_lookup_by_pointer
        result.would_release_arena_backing = fields.would_release_arena_backing
        result.would_recycle_arena_backing = fields.would_recycle_arena_backing
        result.would_use_segment_map = fields.would_use_segment_map
        result.would_execute_atomic_bitmap = fields.would_execute_atomic_bitmap
        result.would_call_osvm = fields.would_call_osvm
        result.would_run_thread = fields.would_run_thread
        result.would_activate_provider = fields.would_activate_provider
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        return result
    }

    makeReport(accepted, reason, handle_present, residence_report, arena_handle_token): HakoAllocSegmentArenaBackingHandlePilotReport {
        local handle_valid = 0
        if arena_handle_token > 0 {
            handle_valid = 1
        }
        local fields = HakoAllocSegmentArenaBackingHandlePilotReportFields {
            accepted: accepted,
            reason: reason,
            handle_present: handle_present,
            residence_present: residence_report.residence_present,
            residence_accepted: residence_report.accepted,
            residence_reason: residence_report.reason,
            arena_handle_token: arena_handle_token,
            handle_valid: handle_valid,
            private_pointer_token: residence_report.private_pointer_token,
            pointer_token_valid: residence_report.token_valid,
            no_escape_scope_id: residence_report.no_escape_scope_id,
            non_dereferenceable: residence_report.non_dereferenceable,
            closed_execution_blocker_count: me.closedExecutionBlockerCount(residence_report),
            handle_count: me.handle_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_residence_reject_count: me.missing_residence_reject_count,
            rejected_residence_reject_count: me.rejected_residence_reject_count,
            invalid_pointer_token_reject_count: me.invalid_pointer_token_reject_count,
            invalid_handle_reject_count: me.invalid_handle_reject_count,
            closed_execution_reject_count: me.closed_execution_reject_count,
            last_reason: me.last_reason,
            report_segment_id: residence_report.report_segment_id,
            report_arena_id: residence_report.report_arena_id,
            report_lifetime_generation: residence_report.report_lifetime_generation,
            report_release_applied_recycle_token: residence_report.report_release_applied_recycle_token,
            report_continuation_token: residence_report.report_continuation_token,
            report_application_token: residence_report.report_application_token,
            report_applied_backing_bytes: residence_report.report_applied_backing_bytes,
            report_applied_committed_bytes: residence_report.report_applied_committed_bytes,
            report_remaining_source_bytes: residence_report.report_remaining_source_bytes,
            would_lookup_by_pointer: residence_report.would_lookup_by_pointer,
            would_release_arena_backing: residence_report.would_release_arena_backing,
            would_recycle_arena_backing: residence_report.would_recycle_arena_backing,
            would_use_segment_map: residence_report.would_use_segment_map,
            would_execute_atomic_bitmap: residence_report.would_execute_atomic_bitmap,
            would_call_osvm: residence_report.would_call_osvm,
            would_run_thread: residence_report.would_run_thread,
            would_activate_provider: residence_report.would_activate_provider,
            would_add_backend_matcher: residence_report.would_add_backend_matcher
        }
        return me.makeArenaBackingHandlePilotReport(fields)
    }

    reject(reason, residence_report, arena_handle_token): HakoAllocSegmentArenaBackingHandlePilotReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_residence_reject_count += 1
        }
        if reason == 2 {
            me.rejected_residence_reject_count += 1
        }
        if reason == 3 {
            me.invalid_pointer_token_reject_count += 1
        }
        if reason == 4 {
            me.invalid_handle_reject_count += 1
        }
        if reason == 5 {
            me.closed_execution_reject_count += 1
        }
        return me.makeReport(0, reason, 0, residence_report, arena_handle_token)
    }

    recordArenaBackingHandle(residence_report, arena_handle_token): HakoAllocSegmentArenaBackingHandlePilotReport {
        me.handle_count += 1

        if residence_report.residence_present != 1 {
            return me.reject(1, residence_report, arena_handle_token)
        }
        if residence_report.accepted != 1 {
            return me.reject(2, residence_report, arena_handle_token)
        }
        if residence_report.private_pointer_token <= 0 {
            return me.reject(3, residence_report, arena_handle_token)
        }
        if residence_report.token_valid != 1 {
            return me.reject(3, residence_report, arena_handle_token)
        }
        if arena_handle_token <= 0 {
            return me.reject(4, residence_report, arena_handle_token)
        }
        if me.closedExecutionBlockerCount(residence_report) != 0 {
            return me.reject(5, residence_report, arena_handle_token)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, 1, residence_report, arena_handle_token)
    }
}

// provider_boundary_diagnostic_vocabulary_box.hako -- MIMAP-360A
// Responsibility:
// - publish provider boundary diagnostic reason vocabulary after MIMAP-352A
// - consume provider inactive boundary reports as the previous seam
// Non-responsibility:
// - provider selection, provider activation, host allocator replacement, hooks,
//   global allocator install, or backend matchers

using selfhost.hako_alloc.memory.provider_inactive_boundary_inventory_box as HakoAllocProviderInactiveBoundaryInventoryBox

record HakoAllocProviderBoundaryDiagnosticVocabularyReportFields {
    accepted: i64
    reason: i64
    vocabulary_present: i64
    provider_boundary_present: i64
    provider_boundary_accepted: i64
    provider_boundary_reason: i64
    provider_boundary_token: i64
    reason_count: i64
    accepted_reason_code: i64
    missing_boundary_reason_code: i64
    rejected_boundary_reason_code: i64
    provider_request_reason_code: i64
    host_replacement_reason_code: i64
    hook_request_reason_code: i64
    backend_matcher_reason_code: i64
    worker_thread_reason_code: i64
    vocabulary_count: i64
    accepted_count: i64
    reject_count: i64
    missing_boundary_reject_count: i64
    rejected_boundary_reject_count: i64
    provider_request_reject_count: i64
    host_replacement_reject_count: i64
    hook_request_reject_count: i64
    backend_matcher_reject_count: i64
    worker_thread_reject_count: i64
    last_reason: i64
    provider_activation_inactive: i64
    host_replacement_inactive: i64
    hooks_inactive: i64
    backend_matcher_inactive: i64
    would_activate_provider: i64
    would_replace_host_allocator: i64
    would_install_hook: i64
    would_add_backend_matcher: i64
    would_run_thread: i64
}

box HakoAllocProviderBoundaryDiagnosticVocabularyReport {
    accepted: i64 = 0
    reason: i64 = 0
    vocabulary_present: i64 = 0
    provider_boundary_present: i64 = 0
    provider_boundary_accepted: i64 = 0
    provider_boundary_reason: i64 = 0
    provider_boundary_token: i64 = 0
    reason_count: i64 = 0
    accepted_reason_code: i64 = 0
    missing_boundary_reason_code: i64 = 1
    rejected_boundary_reason_code: i64 = 2
    provider_request_reason_code: i64 = 3
    host_replacement_reason_code: i64 = 4
    hook_request_reason_code: i64 = 5
    backend_matcher_reason_code: i64 = 6
    worker_thread_reason_code: i64 = 7
    vocabulary_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_boundary_reject_count: i64 = 0
    rejected_boundary_reject_count: i64 = 0
    provider_request_reject_count: i64 = 0
    host_replacement_reject_count: i64 = 0
    hook_request_reject_count: i64 = 0
    backend_matcher_reject_count: i64 = 0
    worker_thread_reject_count: i64 = 0
    last_reason: i64 = 0
    provider_activation_inactive: i64 = 1
    host_replacement_inactive: i64 = 1
    hooks_inactive: i64 = 1
    backend_matcher_inactive: i64 = 1
    would_activate_provider: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocProviderBoundaryDiagnosticVocabulary {
    vocabulary_count: i64 = 0
    accepted_count: i64 = 0
    reject_count: i64 = 0
    missing_boundary_reject_count: i64 = 0
    rejected_boundary_reject_count: i64 = 0
    provider_request_reject_count: i64 = 0
    host_replacement_reject_count: i64 = 0
    hook_request_reject_count: i64 = 0
    backend_matcher_reject_count: i64 = 0
    worker_thread_reject_count: i64 = 0
    last_reason: i64 = 0

    makeProviderBoundaryDiagnosticVocabularyReport(fields: HakoAllocProviderBoundaryDiagnosticVocabularyReportFields): HakoAllocProviderBoundaryDiagnosticVocabularyReport {
        local result = new HakoAllocProviderBoundaryDiagnosticVocabularyReport()
        result.accepted = fields.accepted
        result.reason = fields.reason
        result.vocabulary_present = fields.vocabulary_present
        result.provider_boundary_present = fields.provider_boundary_present
        result.provider_boundary_accepted = fields.provider_boundary_accepted
        result.provider_boundary_reason = fields.provider_boundary_reason
        result.provider_boundary_token = fields.provider_boundary_token
        result.reason_count = fields.reason_count
        result.accepted_reason_code = fields.accepted_reason_code
        result.missing_boundary_reason_code = fields.missing_boundary_reason_code
        result.rejected_boundary_reason_code = fields.rejected_boundary_reason_code
        result.provider_request_reason_code = fields.provider_request_reason_code
        result.host_replacement_reason_code = fields.host_replacement_reason_code
        result.hook_request_reason_code = fields.hook_request_reason_code
        result.backend_matcher_reason_code = fields.backend_matcher_reason_code
        result.worker_thread_reason_code = fields.worker_thread_reason_code
        result.vocabulary_count = fields.vocabulary_count
        result.accepted_count = fields.accepted_count
        result.reject_count = fields.reject_count
        result.missing_boundary_reject_count = fields.missing_boundary_reject_count
        result.rejected_boundary_reject_count = fields.rejected_boundary_reject_count
        result.provider_request_reject_count = fields.provider_request_reject_count
        result.host_replacement_reject_count = fields.host_replacement_reject_count
        result.hook_request_reject_count = fields.hook_request_reject_count
        result.backend_matcher_reject_count = fields.backend_matcher_reject_count
        result.worker_thread_reject_count = fields.worker_thread_reject_count
        result.last_reason = fields.last_reason
        result.provider_activation_inactive = fields.provider_activation_inactive
        result.host_replacement_inactive = fields.host_replacement_inactive
        result.hooks_inactive = fields.hooks_inactive
        result.backend_matcher_inactive = fields.backend_matcher_inactive
        result.would_activate_provider = fields.would_activate_provider
        result.would_replace_host_allocator = fields.would_replace_host_allocator
        result.would_install_hook = fields.would_install_hook
        result.would_add_backend_matcher = fields.would_add_backend_matcher
        result.would_run_thread = fields.would_run_thread
        return result
    }

    makeReport(accepted, reason, boundary_report: HakoAllocProviderInactiveBoundaryInventoryReport): HakoAllocProviderBoundaryDiagnosticVocabularyReport {
        local fields = HakoAllocProviderBoundaryDiagnosticVocabularyReportFields {
            accepted: accepted,
            reason: reason,
            vocabulary_present: accepted,
            provider_boundary_present: boundary_report.provider_boundary_present,
            provider_boundary_accepted: boundary_report.accepted,
            provider_boundary_reason: boundary_report.reason,
            provider_boundary_token: boundary_report.provider_boundary_token,
            reason_count: 8,
            accepted_reason_code: 0,
            missing_boundary_reason_code: 1,
            rejected_boundary_reason_code: 2,
            provider_request_reason_code: 3,
            host_replacement_reason_code: 4,
            hook_request_reason_code: 5,
            backend_matcher_reason_code: 6,
            worker_thread_reason_code: 7,
            vocabulary_count: me.vocabulary_count,
            accepted_count: me.accepted_count,
            reject_count: me.reject_count,
            missing_boundary_reject_count: me.missing_boundary_reject_count,
            rejected_boundary_reject_count: me.rejected_boundary_reject_count,
            provider_request_reject_count: me.provider_request_reject_count,
            host_replacement_reject_count: me.host_replacement_reject_count,
            hook_request_reject_count: me.hook_request_reject_count,
            backend_matcher_reject_count: me.backend_matcher_reject_count,
            worker_thread_reject_count: me.worker_thread_reject_count,
            last_reason: me.last_reason,
            provider_activation_inactive: boundary_report.provider_activation_inactive,
            host_replacement_inactive: boundary_report.host_replacement_inactive,
            hooks_inactive: boundary_report.hooks_inactive,
            backend_matcher_inactive: boundary_report.backend_matcher_inactive,
            would_activate_provider: 0,
            would_replace_host_allocator: 0,
            would_install_hook: 0,
            would_add_backend_matcher: 0,
            would_run_thread: 0
        }
        return me.makeProviderBoundaryDiagnosticVocabularyReport(fields)
    }

    reject(reason, boundary_report: HakoAllocProviderInactiveBoundaryInventoryReport): HakoAllocProviderBoundaryDiagnosticVocabularyReport {
        me.reject_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_boundary_reject_count += 1
        }
        if reason == 2 {
            me.rejected_boundary_reject_count += 1
        }
        if reason == 3 {
            me.provider_request_reject_count += 1
        }
        if reason == 4 {
            me.host_replacement_reject_count += 1
        }
        if reason == 5 {
            me.hook_request_reject_count += 1
        }
        if reason == 6 {
            me.backend_matcher_reject_count += 1
        }
        if reason == 7 {
            me.worker_thread_reject_count += 1
        }
        return me.makeReport(0, reason, boundary_report)
    }

    inventoryProviderBoundaryDiagnostics(boundary_report: HakoAllocProviderInactiveBoundaryInventoryReport): HakoAllocProviderBoundaryDiagnosticVocabularyReport {
        me.vocabulary_count += 1
        if boundary_report.provider_boundary_present != 1 {
            return me.reject(1, boundary_report)
        }
        if boundary_report.accepted != 1 {
            return me.reject(2, boundary_report)
        }
        if boundary_report.would_activate_provider != 0 {
            return me.reject(3, boundary_report)
        }
        if boundary_report.would_replace_host_allocator != 0 {
            return me.reject(4, boundary_report)
        }
        if boundary_report.would_install_hook != 0 {
            return me.reject(5, boundary_report)
        }
        if boundary_report.would_add_backend_matcher != 0 {
            return me.reject(6, boundary_report)
        }
        if boundary_report.would_run_thread != 0 {
            return me.reject(7, boundary_report)
        }

        me.accepted_count += 1
        me.last_reason = 0
        return me.makeReport(1, 0, boundary_report)
    }
}

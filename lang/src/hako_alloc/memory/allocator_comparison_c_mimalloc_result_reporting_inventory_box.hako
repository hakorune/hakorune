// MIMAP-460A: reporting inventory over C mimalloc result summary diagnostics.
// This owner preserves stable scalar reporting fields only. It must not rerun
// benchmarks or make performance / memory-use conclusions.

using selfhost.hako_alloc.memory.allocator_comparison_c_mimalloc_result_summary_diagnostic_box as HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnostic

record HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReportFields {
    accepted: i64 = 0
    reason: i64 = 0
    reporting_inventory_present: i64 = 0
    summary_diagnostic_present: i64 = 0
    accepted_summary_diagnostic_present: i64 = 0
    blocked_summary_diagnostic_present: i64 = 0
    comparison_available: i64 = 0
    hako_ready_execution_present: i64 = 0
    c_ready_evidence_present: i64 = 0
    memory_evidence_present: i64 = 0
    hako_allocation_count: i64 = 0
    hako_requested_bytes: i64 = 0
    c_allocation_count: i64 = 0
    c_requested_bytes: i64 = 0
    c_peak_rss_bytes: i64 = 0
    allocation_count_delta: i64 = 0
    requested_bytes_delta: i64 = 0
    reporting_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_summary_diagnostic_reject_count: i64 = 0
    blocked_summary_diagnostic_reject_count: i64 = 0
    last_reason: i64 = 0
    performance_conclusion_made: i64 = 0
    memory_conclusion_made: i64 = 0
    repeated_benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    hidden_discovery_used: i64 = 0
    provider_package_generated: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReport {
    accepted: i64 = 0
    reason: i64 = 0
    reporting_inventory_present: i64 = 0
    summary_diagnostic_present: i64 = 0
    accepted_summary_diagnostic_present: i64 = 0
    blocked_summary_diagnostic_present: i64 = 0
    comparison_available: i64 = 0
    hako_ready_execution_present: i64 = 0
    c_ready_evidence_present: i64 = 0
    memory_evidence_present: i64 = 0
    hako_allocation_count: i64 = 0
    hako_requested_bytes: i64 = 0
    c_allocation_count: i64 = 0
    c_requested_bytes: i64 = 0
    c_peak_rss_bytes: i64 = 0
    allocation_count_delta: i64 = 0
    requested_bytes_delta: i64 = 0
    reporting_count: i64 = 0
    ready_count: i64 = 0
    blocked_count: i64 = 0
    missing_summary_diagnostic_reject_count: i64 = 0
    blocked_summary_diagnostic_reject_count: i64 = 0
    last_reason: i64 = 0
    performance_conclusion_made: i64 = 0
    memory_conclusion_made: i64 = 0
    repeated_benchmark_executed: i64 = 0
    process_replacement_executed: i64 = 0
    hook_installed: i64 = 0
    backend_matcher_added: i64 = 0
    global_allocator_installed: i64 = 0
    hidden_discovery_used: i64 = 0
    provider_package_generated: i64 = 0
    would_replace_host_allocator: i64 = 0
    would_install_hook: i64 = 0
    would_add_backend_matcher: i64 = 0
    would_run_thread: i64 = 0
}

box HakoAllocAllocatorComparisonCMimallocResultReportingInventory {
    reporting_count: usize = 0
    ready_count: usize = 0
    blocked_count: usize = 0
    missing_summary_diagnostic_reject_count: usize = 0
    blocked_summary_diagnostic_reject_count: usize = 0
    last_reason: i64 = 0

    makeAllocatorComparisonCMimallocResultReportingInventoryReport(fields: HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReportFields): HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReport {
        local result = new HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReport {
            accepted: fields.accepted,
            reason: fields.reason,
            reporting_inventory_present: fields.reporting_inventory_present,
            summary_diagnostic_present: fields.summary_diagnostic_present,
            accepted_summary_diagnostic_present: fields.accepted_summary_diagnostic_present,
            blocked_summary_diagnostic_present: fields.blocked_summary_diagnostic_present,
            comparison_available: fields.comparison_available,
            hako_ready_execution_present: fields.hako_ready_execution_present,
            c_ready_evidence_present: fields.c_ready_evidence_present,
            memory_evidence_present: fields.memory_evidence_present,
            hako_allocation_count: fields.hako_allocation_count,
            hako_requested_bytes: fields.hako_requested_bytes,
            c_allocation_count: fields.c_allocation_count,
            c_requested_bytes: fields.c_requested_bytes,
            c_peak_rss_bytes: fields.c_peak_rss_bytes,
            allocation_count_delta: fields.allocation_count_delta,
            requested_bytes_delta: fields.requested_bytes_delta,
            reporting_count: fields.reporting_count,
            ready_count: fields.ready_count,
            blocked_count: fields.blocked_count,
            missing_summary_diagnostic_reject_count: fields.missing_summary_diagnostic_reject_count,
            blocked_summary_diagnostic_reject_count: fields.blocked_summary_diagnostic_reject_count,
            last_reason: fields.last_reason,
            performance_conclusion_made: fields.performance_conclusion_made,
            memory_conclusion_made: fields.memory_conclusion_made,
            repeated_benchmark_executed: fields.repeated_benchmark_executed,
            process_replacement_executed: fields.process_replacement_executed,
            hook_installed: fields.hook_installed,
            backend_matcher_added: fields.backend_matcher_added,
            global_allocator_installed: fields.global_allocator_installed,
            hidden_discovery_used: fields.hidden_discovery_used,
            provider_package_generated: fields.provider_package_generated,
            would_replace_host_allocator: fields.would_replace_host_allocator,
            would_install_hook: fields.would_install_hook,
            would_add_backend_matcher: fields.would_add_backend_matcher,
            would_run_thread: fields.would_run_thread
        }
        return result
    }

    reasonFrom(report: HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport): i64 {
        if report.diagnostic_present != 1 {
            return 1
        }
        if report.accepted != 1 {
            return 2
        }
        if report.reason != 0 {
            return 2
        }
        if report.accepted_summary_present != 1 {
            return 2
        }
        if report.comparison_available != 1 {
            return 2
        }
        return 0
    }

    markBlocked(reason: i64): void {
        me.blocked_count += 1
        me.last_reason = reason
        if reason == 1 {
            me.missing_summary_diagnostic_reject_count += 1
        }
        if reason == 2 {
            me.blocked_summary_diagnostic_reject_count += 1
        }
        return void
    }

    makeReport(reason: i64, report: HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport): HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReport {
        local accepted = 0
        if reason == 0 {
            accepted = 1
        }
        local fields = HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReportFields {}
        fields = fields with {
            accepted,
            reason,
            reporting_inventory_present: 1,
            summary_diagnostic_present: report.diagnostic_present,
            accepted_summary_diagnostic_present: report.accepted_summary_present,
            blocked_summary_diagnostic_present: report.blocked_summary_present,
            comparison_available: report.comparison_available,
            hako_ready_execution_present: report.hako_ready_execution_present,
            c_ready_evidence_present: report.c_ready_evidence_present,
            memory_evidence_present: report.memory_evidence_present,
            hako_allocation_count: report.hako_allocation_count,
            hako_requested_bytes: report.hako_requested_bytes,
            c_allocation_count: report.c_allocation_count,
            c_requested_bytes: report.c_requested_bytes,
            c_peak_rss_bytes: report.c_peak_rss_bytes,
            allocation_count_delta: report.allocation_count_delta,
            requested_bytes_delta: report.requested_bytes_delta,
            reporting_count: me.reporting_count,
            ready_count: me.ready_count,
            blocked_count: me.blocked_count,
            missing_summary_diagnostic_reject_count: me.missing_summary_diagnostic_reject_count,
            blocked_summary_diagnostic_reject_count: me.blocked_summary_diagnostic_reject_count,
            last_reason: me.last_reason,
            performance_conclusion_made: report.performance_conclusion_made,
            memory_conclusion_made: report.memory_conclusion_made,
            repeated_benchmark_executed: report.repeated_benchmark_executed,
            process_replacement_executed: report.process_replacement_executed,
            hook_installed: report.hook_installed,
            backend_matcher_added: report.backend_matcher_added,
            global_allocator_installed: report.global_allocator_installed,
            hidden_discovery_used: report.hidden_discovery_used,
            provider_package_generated: report.provider_package_generated,
            would_replace_host_allocator: report.would_replace_host_allocator,
            would_install_hook: report.would_install_hook,
            would_add_backend_matcher: report.would_add_backend_matcher,
            would_run_thread: report.would_run_thread
        }
        return me.makeAllocatorComparisonCMimallocResultReportingInventoryReport(fields)
    }

    inventoryAllocatorComparisonCMimallocResultReporting(report: HakoAllocAllocatorComparisonCMimallocResultSummaryDiagnosticReport): HakoAllocAllocatorComparisonCMimallocResultReportingInventoryReport {
        me.reporting_count += 1
        local reason = me.reasonFrom(report)
        if reason == 0 {
            me.ready_count += 1
            me.last_reason = 0
        } else {
            me.markBlocked(reason)
        }
        return me.makeReport(reason, report)
    }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nyash.dev/schema/mir/json_v0.schema.json",
  "title": "Nyash MIR JSON v0",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": ["integer", "string" ] },
    "static_table_contract_specs": { "type": "array" },
    "static_data_plans": { "type": "array" },
    "verified_static_table_contracts": { "type": "array" },
    "functions": {
      "oneOf": [
        { "$ref": "#/definitions/functionList" },
        { "$ref": "#/definitions/functionMap" }
      ]
    }
  },
  "required": ["functions"],
  "definitions": {
    "functionList": {
      "type": "array",
      "items": { "$ref": "#/definitions/function" }
    },
    "functionMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/functionBody" }
    },
    "function": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" }
            },
            "required": ["name", "type"]
          }
        },
        "return_type": { "type": "string" },
        "entry_block": { "type": ["integer", "string"] },
        "metadata": { "$ref": "#/definitions/functionMetadata" },
        "blocks": { "$ref": "#/definitions/blocks" }
      },
      "required": ["name", "blocks"]
    },
    "functionBody": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "params": { "$ref": "#/definitions/function/properties/params" },
        "return_type": { "type": "string" },
        "entry_block": { "type": ["integer", "string"] },
        "metadata": { "$ref": "#/definitions/functionMetadata" },
        "blocks": { "$ref": "#/definitions/blocks" }
      },
      "required": ["blocks"]
    },
    "functionMetadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "value_types": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": ["string", "null"] },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "kind": { "type": "string" },
                  "box_type": { "type": "string" }
                }
              }
            ]
          }
        },
        "storage_classes": {
          "type": "object",
          "additionalProperties": {
            "enum": ["inline_i64", "inline_bool", "inline_f64", "borrowed_text", "box_ref", "opaque"]
          }
        }
      }
    },
    "blocks": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/definitions/block" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/block" }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": ["integer", "string"] },
        "instructions": { "$ref": "#/definitions/instructions" },
        "terminator": { "$ref": "#/definitions/instruction" }
      },
      "required": ["id", "instructions"]
    },
    "instructions": {
      "type": "array",
      "items": { "$ref": "#/definitions/instruction" }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "barrier",
            "array_element_write",
            "array_state_contract_claim",
            "binop",
            "boxcall",
            "branch",
            "call",
            "checked_callout",
            "checked_callout_fault",
            "checked_callout_normal_result",
            "checked_callout_end",
            "compare",
            "const",
            "copy",
            "copy_owned",
            "destroy_owned",
            "externcall",
            "field_get",
            "field_set",
            "jump",
            "keepalive",
            "local_contract_write",
            "record_field_contract_check",
            "record_value_publish",
            "memop",
            "mir_call",
            "newbox",
            "phi",
            "release_strong",
            "ret",
            "safepoint",
            "select",
            "static_data_load",
            "typeop",
            "unop",
            "weak_load",
            "weak_new",
            "while"
          ]
        },
        "kind": { "type": "string" }
      },
      "anyOf": [
        { "required": ["op"] },
        { "required": ["kind"] }
      ]
    }
  }
}

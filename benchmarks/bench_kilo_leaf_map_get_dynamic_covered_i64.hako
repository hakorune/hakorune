// kilo/map leaf-proof front:
// repeated integer-key MapBox.get over a covered dynamic i64 key.
//
// The C pair uses a small real i64 hashmap probe with the same covered key
// pattern. Do not compare this front against the old volatile-compare map
// placeholders.
static box Main {
  main() {
    local ops = 2000000
    local map = new MapBox()
    local i = 0

    map.set(0, 1)
    map.set(1, 2)
    map.set(2, 3)

    local sum = 0
    loop (i < ops) {
      local k = i % 3
      local v = map.get(k)
      sum = sum + v
      i = i + 1
    }

    return sum + map.get(1)
  }
}

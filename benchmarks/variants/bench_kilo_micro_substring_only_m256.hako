// BM-13 measurement copy (% 256 pair) of benchmarks/bench_kilo_micro_substring_only.hako
// See benchmarks/variants/README.md for the expected result.
// Only the final `return` is reduced with `% 256`.
static box Main {
  main() {
    local ops = 300000
    local text = "line-seed-abcdef"
    local len = text.length()
    local split = len / 2
    local i = 0
    local acc = 0

    loop (i < ops) {
      local left = text.substring(0, split)
      local right = text.substring(split, len)
      acc = acc + left.length() + right.length()
      i = i + 1
    }

    return (acc + len) % 256
  }
}

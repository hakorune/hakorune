// BM-13 measurement copy (% 256 pair) of benchmarks/bench_kilo_meso_substring_concat_len.hako
// See benchmarks/variants/README.md for the expected result.
// Only the final `return` is reduced with `% 256`.
static box Main {
  main() {
    local ops = 180000
    local text = "line-seed-abcdef"
    local len = 16
    local i = 0
    local acc = 0

    loop (i < ops) {
      local split = len / 2
      local left = text.substring(0, split)
      local right = text.substring(split, len)
      local out = left + "xx" + right
      acc = acc + out.length()
      i = i + 1
    }

    return (acc + len) % 256
  }
}

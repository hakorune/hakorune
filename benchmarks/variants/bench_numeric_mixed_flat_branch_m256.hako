// BM-13 measurement copy (% 256 pair) of benchmarks/bench_numeric_mixed_medium.hako
// See benchmarks/variants/README.md for the expected result.
// DIFFERENT WORKLOAD: the `if/else if/else` chain becomes three flat `if`s chosen by
// `k = m / 10` (one extra division and 1-2 extra compares per iteration).
// The result is the same as the original.
// Only the final `return` is reduced with `% 256`.
static box Main {
  main() {
    local i = 0
    local acc = 1
    local sum = 0
    local n = 800000

    loop(i < n) {
      local m = i % 31
      local k = m / 10

      if k == 0 {
        acc = acc + (((i * 3) + (m * 7) + acc) % 97) + 1
      }
      if k == 1 {
        acc = acc + (((i * 3) + (m * 7) + acc) % 89) + 3
      }
      if k > 1 {
        acc = acc + (m * m) + (((i * 3) + (m * 7) + acc) % 53)
      }

      sum = sum + (acc % 17)
      i = i + 1
    }

    return (sum + acc) % 256
  }
}

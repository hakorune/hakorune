// BM-13 measurement copy (% 256 pair) of benchmarks/bench_kilo_micro_concat_hh_len.hako
// See benchmarks/variants/README.md for the expected result.
// Only the final `return` is reduced with `% 256`.
static box Main {
  main() {
    local ops = 800000
    local text = "line-seed-abcdef"
    local suffix = "xy"
    local i = 0
    local acc = 0

    loop (i < ops) {
      local out = text + suffix
      acc = acc + out.length()
      i = i + 1
    }

    return (acc + text.length() + suffix.length()) % 256
  }
}

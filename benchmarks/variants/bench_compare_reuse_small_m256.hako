// BM-13 measurement copy (% 256 pair) of benchmarks/bench_compare_reuse_small.hako
// See benchmarks/variants/README.md for the expected result.
// Only the final `return` is reduced with `% 256`.
static box Main {
  main() {
    local i = 0
    local total = 0

    loop(i < 120000) {
      local m = i % 31

      if m < 20 {
        total = total + 1
      }

      // Same compare pattern again in the same block to trigger compare expr-cache reuse.
      if m < 20 {
        total = total + 2
      }

      i = i + 1
    }

    return (total) % 256
  }
}
